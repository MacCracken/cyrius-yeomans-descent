# world.cyr — M3 world tree: zone loader + rooms + exits.
#
# Loads CYML zone files (ADR 0005) at boot into an in-memory room tree.
# Each rooms file is a multi-entry CYML document: a file-level header
# with zone metadata, then one `[[entries]]` per room (header fields +
# markdown prose body). The loader interns room ids, copies the small
# fields inline, keeps the prose zero-copy (it points into the persistent
# CYML file buffer), and resolves every `exit_<dir>` id to a room index —
# rejecting dangling references so a bad exit graph fails at boot, not
# mid-walk.
#
# Loading happens exactly once, at startup, never in the tick — disk I/O can't
# block the single-thread loop (ADR 0003). Runtime reloading is **M15 (the zone
# registry)**, not the operator interface; when it lands, note that these loaders
# take ~285 kB of BUMP arena per load and `alloc()` has no free (see
# benches/bench_loaders.bcyr, which measures exactly that).
#
# M3-B scope: rooms only. Mob / object templates (kind = "mob" / "obj",
# their own files) land with the entities that consume them (M4/M5).

# === Directions ===
# Index order is fixed: it is the exit-slot order in every room and the
# target of verb_to_dir. n s e w u d.
enum Dir {
    DIR_N = 0;
    DIR_S = 1;
    DIR_E = 2;
    DIR_W = 3;
    DIR_U = 4;
    DIR_D = 5;
    NDIR  = 6;
}

# === Room layout (offsets in bytes) ===
#
# id / title are copied inline (bounded, untrusted-input-safe); prose is a
# zero-copy (ptr, len) into the CYML file buffer (which never frees).
enum RM {
    RM_ID        = 0;     # inline id bytes (RM_ID_CAP)
    RM_ID_LEN    = 48;
    RM_TITLE     = 56;    # inline title bytes (RM_TITLE_CAP)
    RM_TITLE_LEN = 136;
    RM_PROSE_PTR = 144;   # ptr into the file buffer (persists)
    RM_PROSE_LEN = 152;
    RM_EXIT      = 160;   # NDIR i64 exit room indices; -1 = no exit
    RM_MOB_HEAD  = 208;   # head of the room's mob-instance list (M4)
    RM_OBJ_HEAD  = 216;   # head of the room's object-instance list (M4)
    RM_MOBSPAWN  = 224;   # str: the `mobs` spawn id list (or 0)
    RM_OBJSPAWN  = 232;   # str: the `objects` spawn id list (or 0)
    RM_SIZE      = 240;
}
enum RmCap {
    RM_ID_CAP    = 48;
    RM_TITLE_CAP = 80;
}

# Hard per-file entry cap, from lib/cyml.cyr's 32-slot marker buffer
# (ADR 0005). A file over this is rejected rather than silently truncated.
enum WorldCap { MAX_ENTRIES = 32; }

# world_load return codes (0 = ok, negatives are distinct failures).
var WL_OK          = 0;
var WL_ERR_IO      = 0 - 1;   # file missing / unreadable / empty
var WL_ERR_EMPTY   = 0 - 2;   # zero rooms
var WL_ERR_OVERCAP = 0 - 3;   # more than MAX_ENTRIES rooms
var WL_ERR_KIND    = 0 - 4;   # an entry's kind != "room"
var WL_ERR_NOID    = 0 - 5;   # an entry has no id
var WL_ERR_DANGLE  = 0 - 6;   # an exit names a room that does not exist

# === World globals ===
var g_rooms      = 0;   # contiguous block of g_room_count RM_SIZE structs
var g_room_count = 0;
var g_start_room = 0;   # room index new players spawn into (default 0)
# Authored in the zone header and stored, but not read by anything today. Kept
# because it is part of the frozen zone format (ADR 0007 §5) — dropping it would
# be a format change — and because the operator channel (M18) is its consumer.
# H5 (1.6.14): the comment used to cite "prompts / Joshua"; there are no prompts
# using it and Joshua is backlog, so it named two consumers that do not exist.
var g_zone_name  = 0;   # str: human zone name
var g_zone_id    = 0;   # str: machine zone id (space-free, for log tokens)

# M7 — zone reset cadence. reset_secs is authored in the zone header
# (default 15 min); g_zone_last_reset_ms is set at boot and after each
# reset, so the timer tracks "since last reset", not "since server start".
var g_zone_reset_secs   = 900;
var g_zone_last_reset_ms = 0;

# H13 (1.6.8) — bound the authored cadence.
#
# `reset_secs` is read from the ZONE FILE, not just the YD_RESET_SECS operator
# knob, so it is authored data and gets treated as such. It fed an unchecked
# `secs * 1000` and three separate values drove the interval negative or zero,
# each of which makes `now - g_zone_last_reset_ms < interval_ms` false forever —
# a reset attempt on EVERY tick:
#
#   - `reset_secs = 0`. Reachable since M7-A; 0 is not "disabled", it is "always".
#   - `reset_secs = -1`. Newly reachable in 1.6.7, which taught `toml_int` to
#     read a sign. Before that a negative fell back to the default, so the sign
#     fix opened this door and this clamp is the other half of it.
#   - A value large enough to wrap. `parse_uint` accumulates `v * 10 + d` with no
#     overflow check, so ~20 digits lands anywhere, including negative — and even
#     a surviving huge positive overflows the `* 1000`.
#
# `maybe_zone_reset` defers while any player is in the zone, so the damage is
# confined to an EMPTY server: a `zone_reset_log` line every tick, forever,
# which is unbounded stdout and log growth on an idle box. Not an attack — the
# zone file is operator-authored — but it is a typo away and silent.
#
# Clamping rather than rejecting is deliberate: ADR 0007 §5 freezes the zone
# format for 1.x, and refusing to load a zone that loads today is exactly the
# compatibility break that section exists to prevent. The clamp is also what
# makes `* 1000` provably safe — RESET_SECS_MAX * 1000 is 86.4 million, nowhere
# near an i64.
# The bounds are deliberately as WIDE as they can be while still being safe.
# The point is to reject degenerate and wrapped values, not to impose a house
# style on cadence: a weekly (604800) or monthly reset is a perfectly ordinary
# thing to author, and a clamp that quietly rewrote one would be the very
# compatibility break ADR 0007 §5 exists to prevent. So the floor is the
# smallest value that is unambiguously a cadence rather than a typo, and the
# ceiling is a year — five orders of magnitude below where `* 1000` could
# overflow, and past anything a human writes on purpose.
enum ResetBounds {
    RESET_SECS_MIN = 1;
    RESET_SECS_MAX = 31536000;    # one year; * 1000 = 3.15e13, nowhere near i64
}
# The authored reset cadence, bounded into a range where `* 1000` is safe and
# the elapsed-window test cannot be degenerate. See the block above for why the
# bounds are this wide.
fn clamp_reset_secs(v): i64 {
    if (v < RESET_SECS_MIN) { return RESET_SECS_MIN; }
    if (v > RESET_SECS_MAX) { return RESET_SECS_MAX; }
    return v;
}

# Room at index i (no bounds check — callers hold valid indices).
fn room_at(i): i64 { return g_rooms + i * RM_SIZE; }
# Rooms loaded; 0 until world_load_rooms succeeds — look / move / fight all
# gate on this rather than assuming a zone exists.
fn world_room_count(): i64 { return g_room_count; }
# Index new players spawn (and the dead respawn) into: the header's `start`
# id when it resolved, else room 0 — also the fallback for a stale save.
# F2 (1.6.11) — -1 ("unplaced") when there are no rooms, never 0.
#
# This returned g_start_room unconditionally, and g_start_room is 0 both by
# default and after H9 zeroes it on a rejected load. So on a zone-less server it
# reported "room 0" of a zero-room world — a valid-LOOKING index into a null
# table, which is the most dangerous kind. Every caller that stores it into
# SS_ROOM then propagates the lie, and every downstream `room >= 0` guard
# (session_show_room, render_who, _build_record) reads it as placed.
#
# -1 is already the codebase's word for unplaced: session_new uses it, and
# session_enter_world / session_resume_world both early-return when there are no
# rooms, so nothing regresses. This just stops the accessor from inventing a
# room when the world has none.
fn world_start_room(): i64 {
    if (g_room_count == 0) { return 0 - 1; }
    return g_start_room;
}

# Inline id bytes of `r` — not NUL-terminated; saves record the id, not
# the index, so re-authoring a zone cannot teleport a returning player.
fn room_id_ptr(r): i64    { return r + RM_ID; }
# Id byte count, already clamped to RM_ID_CAP by the loader's capped copy.
fn room_id_len(r): i64    { return load64(r + RM_ID_LEN); }
# Resolve a room id → index: see `room_index_by_id` below (M3-B), used by
# M6-E load to place a player back into their recorded room.
fn room_title_ptr(r): i64 { return r + RM_TITLE; }
# Title byte count; 0 when the entry authored no `title` key at all.
fn room_title_len(r): i64 { return load64(r + RM_TITLE_LEN); }
# Prose lives in the CYML file buffer, not the room — valid only while that
# buffer is held, which it is for the run (the loader never frees it).
fn room_prose_ptr(r): i64 { return load64(r + RM_PROSE_PTR); }
# Prose byte count; the body is emitted to the client verbatim, unescaped.
fn room_prose_len(r): i64 { return load64(r + RM_PROSE_LEN); }

# Room contents list heads (mob.cyr owns the instance structs + list ops;
# world.cyr just holds the head pointers in the Room struct).
fn room_mob_head(r): i64      { return load64(r + RM_MOB_HEAD); }
# Overwrite the head only; mob_spawn / mob_remove own the MI_NEXT relinking.
fn room_set_mob_head(r, v): i64 { store64(r + RM_MOB_HEAD, v); return 0; }
# Head of the room's object-instance list (item.cyr OI_NEXT chain), or 0.
fn room_obj_head(r): i64      { return load64(r + RM_OBJ_HEAD); }
# H5 (1.6.14) — `room_set_obj_head` deleted. Never called, and its own comment
# said why: item.cyr's ilist_* primitives take the field ADDRESS and mutate it
# in place, so a setter has no role. Honest comment, dead function.
# str: the authored `mobs` id list (space-separated), or 0. Kept after boot
# because zone reset re-reads it to top the room back up to its population.
fn room_mobspawn(r): i64      { return load64(r + RM_MOBSPAWN); }
# str: the authored `objects` id list, or 0. Reset respawns only ids absent
# from the room, so player-dropped loot and corpses are left alone.
fn room_objspawn(r): i64      { return load64(r + RM_OBJSPAWN); }

# Exit room index in direction `dir` (0..NDIR), or -1 if no exit / OOB.
fn room_exit(r, dir): i64 {
    if (dir < 0)     { return 0 - 1; }
    if (dir >= NDIR) { return 0 - 1; }
    return load64(r + RM_EXIT + dir * 8);
}

# Map a movement Verb (parser.cyr) to a Dir index, or -1 if not a
# movement verb.
fn verb_to_dir(v): i64 {
    if (v == VERB_NORTH) { return DIR_N; }
    if (v == VERB_SOUTH) { return DIR_S; }
    if (v == VERB_EAST)  { return DIR_E; }
    if (v == VERB_WEST)  { return DIR_W; }
    if (v == VERB_UP)    { return DIR_U; }
    if (v == VERB_DOWN)  { return DIR_D; }
    return 0 - 1;
}

# Lowercase direction word for a Dir index (arrival/departure prose).
fn dir_name(dir): i64 {
    if (dir == DIR_N) { return "north"; }
    if (dir == DIR_S) { return "south"; }
    if (dir == DIR_E) { return "east"; }
    if (dir == DIR_W) { return "west"; }
    if (dir == DIR_U) { return "up"; }
    if (dir == DIR_D) { return "down"; }
    return "";
}

# The `exit_<dir>` header key for a Dir index.
fn exit_key(dir): i64 {
    if (dir == DIR_N) { return "exit_n"; }
    if (dir == DIR_S) { return "exit_s"; }
    if (dir == DIR_E) { return "exit_e"; }
    if (dir == DIR_W) { return "exit_w"; }
    if (dir == DIR_U) { return "exit_u"; }
    if (dir == DIR_D) { return "exit_d"; }
    return "";
}

# Copy up to `cap` bytes from a str into `dst`; return the bytes copied.
fn copy_str_capped(dst, cap, s): i64 {
    var p = str_data(s);
    var n = str_len(s);
    if (n > cap) { n = cap; }
    var i = 0;
    while (i < n) {
        store8(dst + i, load8(p + i) & 0xFF);
        i = i + 1;
    }
    return n;
}

# Byte-compare a str against a room's inline id. Returns 1 on equal.
fn id_eq_str(r, s): i64 {
    var n = load64(r + RM_ID_LEN);
    if (str_len(s) != n) { return 0; }
    var a = r + RM_ID;
    var b = str_data(s);
    var i = 0;
    while (i < n) {
        if ((load8(a + i) & 0xFF) != (load8(b + i) & 0xFF)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Find the room index whose id equals str `s`, or -1.
fn room_index_by_str(s): i64 {
    var i = 0;
    while (i < g_room_count) {
        if (id_eq_str(room_at(i), s) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Find the room index whose id equals the bytes buf[0..len), or -1.
# Used to place a player at a start room named by id.
fn room_index_by_id(buf, len): i64 {
    var i = 0;
    while (i < g_room_count) {
        var r = room_at(i);
        if (load64(r + RM_ID_LEN) == len) {
            var a = r + RM_ID;
            var j = 0;
            var same = 1;
            while (j < len) {
                if ((load8(a + j) & 0xFF) != (load8(buf + j) & 0xFF)) { same = 0; j = len; }
                j = j + 1;
            }
            if (same == 1) { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# H9 (1.6.5) — abandon a failed room load without leaving a live world behind.
#
# world_load_rooms is TWO-PASS: pass 2 resolves exits via room_index_by_id,
# which walks g_room_count, so unlike the other three loaders the count has to be
# live *during* parsing and cannot simply be published at the end. Zeroing it on
# the way out is the equivalent guarantee: a rejected file leaves no world, so
# cmd_serve's "running roomless" message is true and every
# `world_room_count() == 0` guard downstream actually holds.
fn _wl_rooms_fail(code): i64 {
    g_room_count = 0;
    g_start_room = 0;
    return code;
}

# === world_load_rooms — parse + build the room tree from a CYML file. ===
#
# Returns WL_OK on success, or a negative WL_ERR_* code. On success the
# world globals are populated and exits are resolved + validated; on ANY
# failure _wl_rooms_fail leaves no live world behind.
fn world_load_rooms(path): i64 {
    var r = cyml_parse_file_r(path);
    if (is_ok(r) == 0) { return _wl_rooms_fail(WL_ERR_IO); }
    var doc = result_unwrap(r);

    var n = cyml_doc_entry_count(doc);
    if (n <= 0)            { return _wl_rooms_fail(WL_ERR_EMPTY); }
    if (n > MAX_ENTRIES)   { return _wl_rooms_fail(WL_ERR_OVERCAP); }

    # Zone metadata from the file-level header.
    var start_id = 0;   # optional `start` room id (str); else room 0
    var fhdr = str_new(cyml_doc_header(doc), cyml_doc_header_len(doc));
    var fsecs = toml_parse(fhdr);
    if (vec_len(fsecs) > 0) {
        var fpairs = toml_section_pairs(vec_get(fsecs, 0));
        g_zone_name = toml_get(fpairs, "name");
        g_zone_id   = toml_get(fpairs, "zone");
        start_id = toml_get(fpairs, "start");
        # H13 — clamped; an authored 0 / negative / wrapped value would
        # otherwise reset the zone on every tick. See clamp_reset_secs.
        g_zone_reset_secs = clamp_reset_secs(toml_int(fpairs, "reset_secs", 900));   # M7-A
    }

    # H9 (1.6.5) — build into the global, but publish the COUNT only on the
    # success return below. Every `return WL_ERR_*` in the parse loop sits after
    # this point, so setting the count here meant a rejected file left a live,
    # partly-filled table behind: cmd_serve printed "no zone loaded" / "no mobs
    # loaded" and every `world_room_count() == 0` guard in session.cyr,
    # combat.cyr, item.cyr and server.cyr was defeated at the same moment. A
    # player could log in, walk into the prefix that did parse, and be stranded
    # in a room with no exits — with the operator told the load had failed.
    # Zeroing first is what makes cmd_serve's documented non-fatal behaviour
    # ("the server still runs, with the verbs answering their no-zone
    # placeholders") actually true.
    g_rooms = alloc(n * RM_SIZE);
    memset(g_rooms, 0, n * RM_SIZE);   # zero list heads / spawn ptrs
    g_room_count = n;
    g_start_room = 0;

    # Temp: each room's NDIR exit-target strings (or 0), resolved in pass 2.
    var exit_tmp = alloc(n * NDIR * 8);

    # --- Pass 1: load fields, stash exit-id strings ---
    var i = 0;
    while (i < n) {
        var e = cyml_doc_entry(doc, i);
        var hs = str_new(cyml_entry_header(e), cyml_entry_header_len(e));
        var secs = toml_parse(hs);
        if (vec_len(secs) == 0) { return _wl_rooms_fail(WL_ERR_NOID); }
        var pairs = toml_section_pairs(vec_get(secs, 0));

        var kind = toml_get(pairs, "kind");
        if (kind == 0) { return _wl_rooms_fail(WL_ERR_KIND); }
        if (str_eq_cstr(kind, "room") == 0) { return _wl_rooms_fail(WL_ERR_KIND); }

        var rm = room_at(i);
        var id = toml_get(pairs, "id");
        if (id == 0) { return _wl_rooms_fail(WL_ERR_NOID); }
        store64(rm + RM_ID_LEN, copy_str_capped(rm + RM_ID, RM_ID_CAP, id));

        var title = toml_get(pairs, "title");
        if (title == 0) {
            store64(rm + RM_TITLE_LEN, 0);
        } else {
            store64(rm + RM_TITLE_LEN, copy_str_capped(rm + RM_TITLE, RM_TITLE_CAP, title));
        }

        store64(rm + RM_PROSE_PTR, cyml_entry_body(e));
        store64(rm + RM_PROSE_LEN, cyml_entry_body_len(e));

        # Spawn lists (space-separated template ids, or absent). Instances
        # are created by world_spawn after mob/obj templates are loaded.
        store64(rm + RM_MOBSPAWN, toml_get(pairs, "mobs"));
        store64(rm + RM_OBJSPAWN, toml_get(pairs, "objects"));

        var dir = 0;
        while (dir < NDIR) {
            var v = toml_get(pairs, exit_key(dir));
            store64(exit_tmp + (i * NDIR + dir) * 8, v);
            store64(rm + RM_EXIT + dir * 8, 0 - 1);
            dir = dir + 1;
        }
        i = i + 1;
    }

    # --- Pass 2: resolve exit ids to room indices, reject dangling ---
    i = 0;
    while (i < n) {
        var rm = room_at(i);
        var dir = 0;
        while (dir < NDIR) {
            var v = load64(exit_tmp + (i * NDIR + dir) * 8);
            if (v != 0) {
                var idx = room_index_by_str(v);
                if (idx < 0) { return _wl_rooms_fail(WL_ERR_DANGLE); }
                store64(rm + RM_EXIT + dir * 8, idx);
            }
            dir = dir + 1;
        }
        i = i + 1;
    }

    # Resolve the spawn room: the zone header's `start` id, else room 0.
    if (start_id != 0) {
        var si = room_index_by_str(start_id);
        if (si >= 0) { g_start_room = si; }
    }

    return WL_OK;
}
