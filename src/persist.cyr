# persist.cyr — M6 player persistence (v0.7.0).
#
# Identity (ADR 0004): each player is an Ed25519 keypair whose 32-byte seed
# is derived deterministically from SHA-256(salt || passphrase) via sigil.
# Only the salt + public key are stored; the secret key is NEVER written to
# disk — it is re-derived from the typed passphrase at login. Login verifies
# by re-deriving and matching the stored public key.
#
# Persistence shape (ADR 0006): one TOML record per player at
# data/players/<name>.cyml, written crash-safely (.tmp + atomic rename).
# The record is Ed25519-signed over its own prefix; load verifies the
# signature before trusting any field, so silent corruption / tampering is
# rejected. Every login / save / creation is also appended to a libro
# hash-chain audit log (data/audit.libro) — the "T.Ron" tamper-evident trail.
#
# Included AFTER session/item/world/classes (it reads their enums) and after
# lib/sakshi+sigil+libro (it calls their crypto/chain surface). The login
# verbs it exposes are forward-referenced by session.cyr's phase router.

enum PersistConst {
    SALT_LEN    = 16;     # random per-account salt
    PK_LEN      = 32;     # Ed25519 public key
    SK_LEN      = 64;     # Ed25519 secret key (seed+pk, sigil layout)
    SIG_LEN     = 64;     # Ed25519 signature
    SEED_LEN    = 32;     # keypair seed = SHA-256(salt||pass)
    IDENT_LEN   = 120;    # SS_IDENT block: salt(16)|pk(32)|sk(64)|created(8)
    IDENT_PK    = 16;     #   pubkey offset within the block
    IDENT_SK    = 48;     #   seckey offset
    IDENT_CREATED = 112;  #   creation epoch-secs offset
    PASS_MIN    = 4;
    PASS_MAX    = 64;
    SAVE_CAP    = 4096;   # serialized record scratch
    SLURP_CAP   = 8192;   # file-read scratch
    PATH_CAP    = 320;
    # Save-record schema version (0.9.1 surface freeze). Bumped only on a
    # breaking change to the [player] field set; a server rejects records
    # stamped newer than it understands. Records from 0.7.0-0.9.0 carry no
    # `schema` field and are treated as v1 (back-compatible).
    SCHEMA_VERSION = 1;
    # The literal v1, for the missing-stamp default. Deliberately NOT spelled
    # SCHEMA_VERSION at the read site: a stamp-less record IS v1 forever, no
    # matter what version this server happens to be. See the gate in
    # player_auth_load (M11-A).
    SCHEMA_V1 = 1;
    # Bytes _build_record reserves for the trailing `sig = "<128 hex>"` line:
    # 6 for `sig = ` + 2 quotes + 128 hex + newline is 137, rounded up for room
    # (M11-D). The inventory loop stops before eating into it.
    SIG_TAIL = 192;
    # H8 — per-session `passwd` candidate: the 120-byte ident block, then the
    # confirm-side pk2/sk2 scratch. Sized here so nothing about the re-key
    # touches the shared g_persist_dec any more.
    CAND_LEN = 216;
    CAND_PK2 = 120;
    CAND_SK2 = 152;
}

# player_auth_load return codes. Positive is success; 0 is a wrong passphrase
# (re-promptable); negatives are terminal and each carries its own player-facing
# message in login_on_pass. Named at M11-B, when the schema case had to stop
# masquerading as tampering.
var PL_ERR_UNREADABLE = 0 - 2;   # malformed, truncated, or signature mismatch
var PL_ERR_SCHEMA     = 0 - 3;   # intact + signed, but written by a newer server

# rename(2) is not wrapped in the x86_64 stdlib (only sys_mkdir is); the
# syscall number is 82 — rename(const char *old, const char *new).
var SYS_RENAME_NR = 82;

var g_persist_save  = 0;
var g_persist_slurp = 0;
var g_persist_path  = 0;
var g_persist_tmp   = 0;
var g_persist_stat  = 0;
var g_persist_dec   = 0;   # decode scratch (salt/pk/sig + confirm keypair)
var g_ident_scratch = 0;   # ident_derive private (never aliased by callers)
var g_fmt_scratch   = 0;   # fmt_int_buf temp
var g_audit_chain   = 0;
var g_audit_store   = 0;
var g_persist_ready = 0;
# Highest save-record schema this server will load, seeded from SCHEMA_VERSION.
# A `var` rather than the enum constant so the test suite can raise the ceiling
# and drive a schema-2 world against a schema-1 build — `SCHEMA_VERSION` is a
# compile-time enum member and the suite compiles this same file, so there is no
# other seam. Production never writes to it (M11-A).
var g_schema_max = SCHEMA_VERSION;
# 0.8.1 — prior last_login captured at load, for the "last seen …"
# returning-player greeting.
var g_loaded_last_login = 0;

# Data paths. agnos's VFS requires ABSOLUTE paths (kernel `vfs.cyr`: a path that
# doesn't lead with '/' returns FS_NONE), and the world content is staged at the
# agnos-fs root `/data` (cf. cyrius-doom defaulting to `/DOOM1.WAD`). On Linux the
# server runs from the repo root with relative `data/...`. Defined here (before
# server.cyr in the include order) so both files share them.
#ifdef CYRIUS_TARGET_AGNOS
var DP_DATADIR   = "/data";
var DP_PLAYERS   = "/data/players";
var DP_PLAYERS_S = "/data/players/";
var DP_AUDIT     = "/data/audit.libro";
var DP_CONFIG    = "/data/server.cyml";
var DP_ROOMS     = "/data/zones/hub.rooms.cyml";
var DP_OBJS      = "/data/zones/hub.objs.cyml";
var DP_MOBS      = "/data/zones/hub.mobs.cyml";
var DP_CLASSES   = "/data/classes.cyml";
#else
var DP_DATADIR   = "data";
var DP_PLAYERS   = "data/players";
var DP_PLAYERS_S = "data/players/";
var DP_AUDIT     = "data/audit.libro";
var DP_CONFIG    = "data/server.cyml";
var DP_ROOMS     = "data/zones/hub.rooms.cyml";
var DP_OBJS      = "data/zones/hub.objs.cyml";
var DP_MOBS      = "data/zones/hub.mobs.cyml";
var DP_CLASSES   = "data/classes.cyml";
#endif

# === Boot: buffers + data dirs + audit chain. Idempotent. ===
fn persist_init(): i64 {
    if (g_persist_ready == 1) { return 0; }
    g_persist_save  = alloc(SAVE_CAP);
    g_persist_slurp = alloc(SLURP_CAP);
    g_persist_path  = alloc(PATH_CAP);
    g_persist_tmp   = alloc(PATH_CAP);
    g_persist_stat  = alloc(160);
    g_persist_dec   = alloc(256);
    g_ident_scratch = alloc(256);
    g_fmt_scratch   = alloc(32);
    sys_mkdir(DP_DATADIR, 0x1ED);        # 0755 — ignore EEXIST
    sys_mkdir(DP_PLAYERS, 0x1ED);
    # H4 (1.6.1) — a STREAMING chain, not a retaining one. descent is a
    # write-through consumer: audit_event appends an event, hands it straight to
    # the FileStore, and never reads g_audit_chain back — nothing in this tree
    # calls chain_verify / chain_len / chain_by_* on it. A retaining chain
    # therefore accumulated every login / save / security event for the process
    # lifetime with no way to bound it (chain_new leaves max_capacity 0 so
    # auto-rotate never fires; chain_apply_retention redistributes without
    # releasing). libro 2.8.4 adds this mode: entries are linked exactly as
    # before — each records its predecessor's hash — but only the head hash is
    # kept, so the in-memory cost is O(1) instead of O(events). The durable
    # chain in data/audit.libro is unchanged and verifies the same.
    if (g_audit_head == 0) { g_audit_head = alloc(AUDIT_HEAD_CAP); }
    if (g_audit_segbuf == 0) { g_audit_segbuf = alloc(PATH_CAP); }
    if (g_audit_mark == 0) { g_audit_mark = alloc(AUDIT_MARK_CAP); }
    g_audit_chain = chain_new_streaming();
    g_audit_store = filestore_open(str_from(DP_AUDIT));
    _audit_resume_head();
    audit_coalesce_init();          # 1.7.1 — the rollup window's table
    # 1.7.2 — operator config, then the env override, then one disk count.
    # Order matters: the env must win over the file, and the count must happen
    # after the players directory exists (sys_mkdir above).
    config_load(DP_CONFIG);
    config_apply_env();
    g_account_count = accounts_count_disk();
    g_persist_ready = 1;
    audit_size_check();             # 1.7.1 / ADR 0009 — one boot-time size warning
    return 0;
}

# === H11 (1.6.6) — resume the chain from the durable head, not from genesis. ===
#
# `filestore_open` opens the JSONL store for append and tells the in-memory chain
# nothing. Every restart therefore began at genesis: the first entry of the new
# run recorded `prev_hash = ""` instead of the last entry of the previous run, so
# a verifier walking data/audit.libro sees a **broken link at every restart
# boundary** — and cannot distinguish "the server restarted here" from "someone
# removed entries here". That is precisely the property the chain exists to
# provide, so it was tamper-evident only within a single process lifetime.
#
# We read the tail rather than the whole file. `filestore_load_all` would work
# and is what a query-shaped consumer would use, but it materialises every entry
# ever written at boot — reintroducing the unbounded growth 1.6.1 removed. Only
# the LAST line's hash matters, so seek to the end, pull back a window, and take
# the final complete record.
#
# Best-effort by design: a missing, empty or unreadable store leaves the chain at
# genesis, which is correct for a first run and no worse than the old behaviour
# for anything else.
fn _audit_resume_head(): i64 {
    if (g_audit_chain == 0) { return 0; }
    # 1.7.4 / ADR 0009 — THE CRASH WINDOW, and this is where it closes.
    #
    # 1.6.6 read the tail of the live file and stopped there. From 1.7.4 the live
    # file can be legitimately EMPTY OR ABSENT: rotation renames it away and the
    # first append recreates it, so a crash between those two leaves nothing to
    # read. Falling back to genesis there re-manufactures exactly the broken link
    # H11 removed — one per boundary, indistinguishable from a deletion, in a log
    # whose only job is to be tamper-evident. So the newest SEGMENT is consulted
    # second.
    var hn = _audit_tail_hash(DP_AUDIT, g_audit_head);
    if (hn == 0) {
        var hi = _audit_seg_hi();
        if (hi > 0) {
            if (_audit_seg_path(hi, g_audit_segbuf) > 0) {
                hn = _audit_tail_hash(g_audit_segbuf, g_audit_head);
            }
        }
    }
    if (hn == 0) { return 0; }
    chain_set_prev_hash(g_audit_chain, str_new(g_audit_head, hn));
    return 0;
}

# Extract the `"hash":"<hex>"` of the LAST complete JSONL record in buf[0,n).
# Returns a str, or 0 if no complete record is present. Scans backwards for the
# final occurrence so a partial leading line (the window may start mid-record)
# is ignored, and requires a trailing newline so a torn final write is skipped.
fn _audit_last_hash(buf, n): i64 {
    var end = n;
    while (end > 0) {
        if ((load8(buf + end - 1) & 0xFF) == 10) { break; }
        end = end - 1;
    }
    if (end == 0) { return 0; }
    var key = "\"hash\":\"";
    var klen = strlen(key);
    var found = 0 - 1;
    var i = 0;
    while (i + klen <= end) {
        var j = 0;
        var same = 1;
        while (j < klen) {
            if ((load8(buf + i + j) & 0xFF) != (load8(key + j) & 0xFF)) { same = 0; j = klen; }
            else { j = j + 1; }
        }
        if (same == 1) { found = i + klen; }
        i = i + 1;
    }
    if (found < 0) { return 0; }
    var stop = found;
    while (stop < end) {
        if ((load8(buf + stop) & 0xFF) == 34) { break; }   # closing quote
        stop = stop + 1;
    }
    if (stop <= found) { return 0; }
    return str_new(buf + found, stop - found);
}

# Lifetime count of durable audit entries actually written (1.7.1).
#
# An exact integer, incremented where the write happens. It exists because the
# suite used to measure audit activity by diffing the STORE FILE's byte length,
# which needed a 64 MB read buffer, could not distinguish two entries from one
# long one, and is the shape that let 1.6.12's "one entry per session" claim ship
# without a test that could see it. A counter at the call site cannot be wrong
# about how many entries were written.
var g_audit_emitted = 0;

# Owned storage for the chain's resumed prev-link (1.7.3). A SHA-256 hex digest
# is 64 bytes; 128 is headroom for a longer digest without another edit here.
enum AuditHead { AUDIT_HEAD_CAP = 128; }

# === ADR 0009 — audit-log rotation (1.7.4). ===
#
# Seal and continue: rename the live file to data/audit.libro.<N> and keep
# appending to the live path with the SAME streaming chain, so the first entry
# after the rename carries the sealed segment's tail hash as its prev_hash. The
# boundary is recorded BY THE CHAIN, not by external metadata. See
# docs/adr/0009-audit-log-rotation.md for why this needs no on-disk format change
# and why libro's own chain_rotate is a no-op here.
enum AuditRotate {
    # Sealed segments retained. The on-disk bound is the ADR's multiplication and
    # nothing else: AUDIT_SIZE_WARN_BYTES x AUDIT_SEG_KEEP = 8 MiB x 4 = 32 MiB of
    # sealed history, plus a live file at most 8 MiB + one check interval. ~40 MiB
    # total, with NO traffic term. 4 because the retained window is a forensic
    # tail, not an archive — at ~350 bytes/event that is ~96,000 events.
    AUDIT_SEG_KEEP = 4;
    # Highest segment number this build will create. Serial and never reused, so
    # the highest number is always the newest — which both the crash-window
    # fallback and the boundary walk assume.
    AUDIT_SEG_MAX = 4096;
    # Ticks between size probes. A TICK COUNT, not a clock: a `now - last` rule
    # never fires on AGNOS's frozen sys_uptime_ms, which would silently disable
    # rotation on one of the two supported targets. 24 ticks = 60 s at the
    # authored 2.5 s cadence; the probe is 2.6 us and zero arena, so it costs
    # nothing on the other 23.
    AUDIT_ROTATE_TICKS = 24;
    # "<segno> <hash>": 19 digits + a space + a 64-byte hash = 84, rounded up.
    # Well under the 153-byte str_builder doubling cliff _audit_rollup documents.
    AUDIT_MARK_CAP = 96;
}

var g_audit_segbuf = 0;      # a segment path, NUL-terminated
var g_audit_mark   = 0;      # marker details, "<segno> <hash>"
# Highest segment on disk; -1 means "not scanned yet". A top-level var because an
# enum cannot hold a negative literal.
var g_audit_seg_hi = 0 - 1;
# Test observables, same shape as g_audit_rollups / g_audit_dropped.
var g_audit_rotations = 0;
var g_audit_pruned    = 0;
var g_audit_head = 0;

# Append a security event to the libro audit chain (+ flush to the
# filestore). `action` is a literal; `who` / `wholen` the player name.
fn audit_event(sev, action, who, wholen): i64 {
    if (g_audit_chain == 0) { return 0; }
    # 1.7.1 — NEVER write an entry whose `details` is empty, because such an
    # entry reports ITSELF as tampered with.
    #
    # libro's read path (lib/libro.cyr:4155) substitutes `str_from("{}")` when a
    # loaded record's details is absent or zero-length. The hash is computed over
    # the details, so an entry WRITTEN with "" is READ BACK as "{}", recomputes to
    # a different hash, and fails entry_verify — and because each entry links to
    # its predecessor, it breaks chain verification from that point on. A
    # tamper-evident log that manufactures its own tamper reports is worse than no
    # log, because it trains an operator to ignore the alarm.
    #
    # Every call site passes SS_NAME_LEN, which is 0 until a name is accepted, so
    # any audit on a session that has not named itself yet writes one of these.
    # Measured in the live data/audit.libro at the time of the fix: 436 of 37902
    # records, all create.fail / create.dup / save / char.create.
    #
    # Writing exactly what the reader will reconstruct — "{}" — is what makes the
    # round trip hash-stable. The upstream substitution is arguably the real bug
    # (an entry should read back as it was written) and is filed against libro,
    # but this side of it is ours: we chose to pass an empty details.
    #
    # The existing records are deliberately NOT repaired. Rewriting a
    # hash-chained log is the one thing it exists to prevent.
    var det = str_from("{}");
    if (wholen > 0) {
        if (who != 0) { det = str_new(who, wholen); }
    }
    var e = chain_append(g_audit_chain, sev, str_from("persist"), str_from(action), det);
    g_audit_emitted = g_audit_emitted + 1;
    if (g_audit_store != 0) { filestore_append(g_audit_store, e); }
    # The streaming chain retains nothing, so this entry is ours to release once
    # the store has it — but ONLY because it is streaming. On a retaining chain
    # the entries vec still references it, and freeing here makes the next
    # _chain_prev_link read freed memory (verified: it segfaults, exit 139).
    # Gate on the mode rather than trusting the two lines to stay in step; one
    # comparison per audit event is nothing next to a latent use-after-free.
    if (chain_streaming(g_audit_chain) == 1) { entry_free(e); }
    return 0;
}

# === The audit rollup window (1.7.1). ===
#
# THE BUG. Every audit_event costs 1944 bytes that this process can never reuse —
# 1640 of BUMP arena (alloc() has no free at all) plus 304 of freelist blocks that
# nothing ever releases (libro's hasher_new and the SHA-256 context; there is no
# hasher_free, and the freelist never munmaps, so an un-freed block is as
# permanent as a bump byte). At 100 reconnects/s that is 667 MiB/hour with no
# ceiling: lib/alloc.cyr mmaps a fresh 256 MB chunk on overflow, so it grows until
# the kernel refuses and alloc() starts returning 0. Reachable unauthenticated —
# connect, give a name, fail the confirm five times, disconnect, repeat.
#
# Only 48 of those 1944 bytes are ours (three str_from/str_new headers; str_new
# BORROWS its payload rather than copying). 97% is inside lib/ and needs an
# upstream release. WHAT IS ENTIRELY OURS IS THE EVENT COUNT, and it is the only
# lever that exists.
#
# WHY NOT THE 1.7.0 CHARGE METER. It was the first thing considered and it cannot
# work, for a reason worth writing down: the meter's quantifier is "for every
# pass, cost <= 20 units" — a LATENCY bound. This needs "summed over the process
# lifetime, bytes <= ceiling" — an ACCUMULATION bound. Passes per second is
# bounded by nothing (server.cyr clamps the epoll timeout to 0 while g_rx_backlog
# is non-zero, deliberately), so a per-pass allowance is a rate multiplier, not a
# bound. And one audit_event is ~20 us = 0.08 charge units = zero in integers,
# while costing 1944 permanent bytes. A microsecond meter structurally cannot see
# a byte leak. That is how 1.7.0 walked past this bug with the right sessions
# under the wrong ruler.
#
# WHAT THIS IS. The first occurrence of each (severity, action) key in a 60 s
# window is written byte-for-byte as before. Every later occurrence increments an
# i64 in a fixed table and allocates NOTHING. One durable entry lands per key per
# window carrying the exact suppressed count plus up to six distinct names.
#
# THE KEY IS A COMPILE-TIME CALL-SITE CONSTANT, never a string and never attacker
# data. Keying on `details` would hand the attacker the key space — they choose
# the name, NAME_CAP is 32 — and a growing map would itself become the leak.
enum AuditKeys {
    AK_LOGIN_FAIL       = 0;
    AK_LOGIN_DUP        = 1;
    AK_LOGIN_OK         = 2;
    AK_LOAD_TAMPER      = 3;
    AK_CREATE_FAIL      = 4;
    AK_CREATE_DUP       = 5;
    AK_CHAR_CREATE      = 6;
    AK_PASSWD_FAIL      = 7;
    AK_PASSWD_ROLLBACK  = 8;
    AK_PASSWD_CHANGE    = 9;
    AK_SAVE             = 10;
    AK_SAVE_INV_TRUNC   = 11;
    AK_SAVE_FAIL_SWEEP  = 12;
    AK_SAVE_FAIL_DISC   = 13;
    AK_SAVE_FAIL_CREATE = 14;
    AK_AUDIT_SIZE       = 15;
    AK_ACCOUNTS_FULL    = 16;
    AK_AUDIT_ROTATE     = 17;
    AK_AUDIT_PRUNE      = 18;
    AK_AUDIT_ROTFAIL    = 19;
    AK_NKEYS            = 20;
}

# One table entry. Byte offsets, matching the house SS_* / g_persist_* style.
#
# The severity and the action LITERAL are stored on the verbatim occurrence rather
# than recovered from a key->action lookup function. That is deliberate: a lookup
# is 16 hand-written arms that can silently disagree with the call site, and the
# rollup would then name the wrong event. Storing what was actually passed cannot
# disagree with itself. Action strings are compile-time literals, so retaining the
# pointer is safe — nothing frees them.
enum AuditKeyEnt {
    AKE_SUPP    = 0;    # occurrences tallied and NOT written
    AKE_EMITTED = 8;    # verbatim entries written in the open window
    AKE_WOPEN   = 16;   # monotonic ms when the window opened
    AKE_SEV     = 24;   # severity of the first occurrence
    AKE_ACTION  = 32;   # action cstr (a literal; static for the process)
    AKE_NNAMES  = 40;   # distinct names captured this window
    AKE_NAMES   = 48;   # AUDIT_NAMES_MAX x AKE_NSTRIDE
    AKE_NSTRIDE = 24;   # 8 length + 16 bytes of name (NAME_MAX)
    AKE_SIZE    = 192;  # 48 + 6 * 24
}

enum AuditRollup {
    # (a) worst reporting latency for a suppressed occurrence: 60 s = 24 combat
    #     ticks, well inside operator reaction time.
    # (b) clock-arm ceiling: AK_NKEYS x (AUDIT_VERBATIM_MAX + 1) x (3600/60) =
    #     17 x 2 x 60 = 2040 entries/hour from the CLOCK arm. That half carries no
    #     rate term.
    #
    #     CORRECTED in 1.7.2. This used to claim the bound as a whole "carries NO
    #     rate term in it", and that was wrong twice over: the count arm adds one
    #     entry per AUDIT_SUPPRESS_MAX occurrences, which IS a rate term above the
    #     crossover of 8192/60 = 136 ev/s; and 1.7.1's count arm re-stamped
    #     AKE_WOPEN, which disabled the clock arm entirely under sustained load.
    #     The re-stamp is gone. The true ceiling is
    #         2040  +  (events/hour / 8192)
    #     — measured 120 entries/hour up to 136 ev/s and 441 at 1000 ev/s, i.e.
    #     734 KB/hour against the 667 MiB/hour this release began with. The bound
    #     holds and is worth having; the DESCRIPTION was the defect.
    AUDIT_WINDOW_MS = 60000;
    # Occurrence 1 of a window is byte-identical to 1.7.0: same severity, same
    # action, same bare-name details, zero added latency. With six name slots the
    # first SEVEN distinct names of a window are all durable, so a key firing <= 7
    # times per window loses no name at all. On a 30-player MUD `login.ok` never
    # fires 8x in a minute outside a flood, so normal operation is unchanged by
    # construction rather than by a second code path.
    AUDIT_VERBATIM_MAX = 1;
    # THE BOUND LIVES HERE, and this arm reads no clock.
    #
    # Fixed, not doubling. Derived in both directions: it must sit ABOVE the design
    # flood's per-window count (100 ev/s x 60 s = 6000) so that at and below that
    # rate the clock arm governs and the hourly cost carries no rate term — 8192 is
    # the smallest power of two above 6000. And it must be low enough that with the
    # clock DEAD the report cadence stays the same order as the window:
    # 8192/100 = 82 s against 60 s is 1.4x, not an order of magnitude.
    #
    # A frozen clock is therefore CHEAPER than a working one, not silent. That
    # matters because on AGNOS clock_now_ms is sys_uptime_ms, which
    # lib/syscalls_x86_64_agnos.cyr documents as FROZEN for a foreground `run`
    # program executing with interrupts cleared.
    AUDIT_SUPPRESS_MAX = 8192;
    AUDIT_NAMES_MAX = 6;
    # Scratch for the rollup details string. 1 ('+') + 20 (an i64 is at most 19
    # digits, so one of margin) + 6 x (1 separator + 16 name bytes) = 123, rounded
    # to 160. Must stay under the 153-byte str_builder doubling cliff in libro:
    # with the longest action literal, a 153-byte details lands a 512-byte line,
    # and 161 pulls a fourth doubling for +1032 bytes.
    AUDIT_DET_CAP = 160;
    # 1.7.1 / ADR 0009 — warn the operator here, and (in 1.7.2) rotate here. ONE
    # constant for both so the warning and the rotation trigger cannot drift
    # apart. 8 MiB is ~24,000 entries at the measured ~350 bytes/event, and a
    # streamed verify of one segment that size is ~156 ms.
    AUDIT_SIZE_WARN_BYTES = 8388608;
}

# The table, and the single reused details scratch. alloc()'d once and never
# again: 16 x 192 + 160 = 3232 bytes one-time, which is 1.66 audit events, for a
# ~3000x bound.
#
# alloc() rather than a top-level `var A[N]` on purpose. A top-level `var A[N]` is
# N i64 SLOTS (N x 8 bytes) while a LOCAL `var buf[N]` is N BYTES — two different
# meanings for one syntax, and lib/freelist.cyr and lib/dynlib.cyr both carry
# comments that get it backwards and are silently 8x over-allocated. alloc(n) is
# unambiguously n bytes.
var g_audit_tab = 0;
var g_audit_det = 0;
# Test observables. NOT exposed through @stats — ADR 0007 freezes its output.
var g_audit_rollups = 0;
var g_audit_dropped = 0;

# Allocate and zero the rollup table. Idempotent, and safe to call from both
# persist_init and audit_keyed's lazy guard — a bench or test that drives
# audit_keyed without a full persist_init still gets a table.
fn audit_coalesce_init(): i64 {
    if (g_audit_tab == 0) { g_audit_tab = alloc(AK_NKEYS * AKE_SIZE); }
    if (g_audit_det == 0) { g_audit_det = alloc(AUDIT_DET_CAP); }
    memset(g_audit_tab, 0, AK_NKEYS * AKE_SIZE);
    return 0;
}

# Drop all window state. For tests, and for a clean shutdown after a flush.
fn audit_coalesce_reset(): i64 {
    if (g_audit_tab == 0) { return 0; }
    memset(g_audit_tab, 0, AK_NKEYS * AKE_SIZE);
    g_audit_rollups = 0;
    g_audit_dropped = 0;
    return 0;
}

fn _audit_slot(key): i64 {
    return g_audit_tab + key * AKE_SIZE;
}

# Append the decimal form of `v` at dst+off; returns the new offset. Written here
# rather than using fmt_int_buf, which builds DOWNWARD from index 23 inside its own
# buffer and then shifts — so handing it a pointer into the middle of the scratch
# is a bug waiting to happen.
fn _audit_put_num(dst, off, v): i64 {
    if (v == 0) { store8(dst + off, 48); return off + 1; }
    var tmp[32];
    var n = 0;
    var x = v;
    while (x > 0) { store8(&tmp + n, 48 + (x % 10)); n = n + 1; x = x / 10; }
    var o = off;
    while (n > 0) { n = n - 1; store8(dst + o, load8(&tmp + n)); o = o + 1; }
    return o;
}

# Record `who` in this key's name set if it is not already there. Bounded by
# AUDIT_NAMES_MAX; extra distinct names are counted by AKE_SUPP but not named.
fn _audit_add_name(sl, who, wholen): i64 {
    if (wholen <= 0) { return 0; }
    if (who == 0)    { return 0; }
    var n = wholen;
    if (n > NAME_MAX) { n = NAME_MAX; }
    var have = load64(sl + AKE_NNAMES);
    var i = 0;
    while (i < have) {
        var ent = sl + AKE_NAMES + i * AKE_NSTRIDE;
        if (load64(ent) == n) {
            if (_audit_bytes_same(ent + 8, who, n) == 1) { return 0; }   # already named
        }
        i = i + 1;
    }
    if (have >= AUDIT_NAMES_MAX) { return 0; }
    var slot = sl + AKE_NAMES + have * AKE_NSTRIDE;
    store64(slot, n);
    memcpy(slot + 8, who, n);
    store64(sl + AKE_NNAMES, have + 1);
    return 1;
}

# Byte-equality over n bytes. Used by the name dedupe above, which needs it before
# it is declared — Cyrius resolves calls file-wide, so the definition sits here
# next to its only caller rather than being hoisted.
fn _audit_bytes_same(a, b, n): i64 {
    var i = 0;
    while (i < n) {
        if ((load8(a + i) & 0xFF) != (load8(b + i) & 0xFF)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Write the rollup entry for `key` and close its window. No-op if nothing was
# suppressed. `details` is a BARE SCALAR — "+<count> <name>[,<name>]*" — not a
# JSON object: libro's canonical hasher takes an allocating path for objects
# (4 vec_new plus a str_new per key = +672 bytes/entry) and a free one for
# scalars. The leading '+' is an unambiguous discriminator, because
# login_name_ok admits alnum only, so a verbatim details can never start with it.
fn _audit_rollup(key): i64 {
    var sl = _audit_slot(key);
    var supp = load64(sl + AKE_SUPP);
    if (supp <= 0) {
        store64(sl + AKE_EMITTED, 0);
        store64(sl + AKE_NNAMES, 0);
        return 0;
    }
    var off = 0;
    store8(g_audit_det + off, 43); off = off + 1;              # '+'
    off = _audit_put_num(g_audit_det, off, supp);
    var have = load64(sl + AKE_NNAMES);
    var i = 0;
    while (i < have) {
        if (off + 1 + NAME_MAX > AUDIT_DET_CAP) { i = have; continue; }
        if (i == 0) { store8(g_audit_det + off, 32); }         # ' '
        else        { store8(g_audit_det + off, 44); }         # ','
        off = off + 1;
        var ent = sl + AKE_NAMES + i * AKE_NSTRIDE;
        var ln = load64(ent);
        memcpy(g_audit_det + off, ent + 8, ln);
        off = off + ln;
        i = i + 1;
    }
    # The borrow is safe for exactly one call: str_new does not copy, and
    # chain_append hashes then filestore_append serialises synchronously before
    # audit_event returns. So one scratch buffer serves every rollup forever.
    audit_event(load64(sl + AKE_SEV), load64(sl + AKE_ACTION), g_audit_det, off);
    g_audit_rollups = g_audit_rollups + 1;
    g_audit_dropped = g_audit_dropped + supp;
    store64(sl + AKE_SUPP, 0);
    store64(sl + AKE_EMITTED, 0);
    store64(sl + AKE_NNAMES, 0);
    return 1;
}

# The coalescing entry point. Every call site goes through this instead of calling
# audit_event directly.
#
# Returns 1 if a durable entry was written, 0 if the occurrence was tallied.
fn audit_keyed(key, sev, action, who, wholen, now_ms): i64 {
    # Fail OPEN for an out-of-range key: behave exactly as 1.7.0 did rather than
    # index past a 3072-byte table. A forgotten AK_NKEYS bump degrades to today.
    # Fall back to a verbatim write, and report it as one. audit_event itself
    # always returns 0, so these cannot just forward its value.
    if (key < 0)         { audit_event(sev, action, who, wholen); return 1; }
    if (key >= AK_NKEYS) { audit_event(sev, action, who, wholen); return 1; }
    if (g_audit_tab == 0) { audit_coalesce_init(); }
    var sl = _audit_slot(key);

    # "A window is open" is AKE_EMITTED > 0, never a timestamp sentinel. This is
    # load-bearing: clock_now_ms is CLOCK_MONOTONIC and on AGNOS can read 0 and
    # stay there, so a `wopen == 0 means closed` test would re-open the window on
    # every event and write verbatim every time — silently removing the bound
    # entirely, on the one target where you cannot watch it happen. Same bug class
    # as save_sweep_due's `last == 0` (1.6.8) and chpass_rate_limited's.
    # AUDIT_VERBATIM_MAX is COMPARED here, not just documented. Until 1.7.2 this
    # read `== 0` and the constant appeared in exactly two places, both of them
    # prose — including the arithmetic above that multiplies by it. A constant
    # that no code reads cannot be a term in a bound.
    #
    # HONEST NOTE ON COVERAGE: at the current value of 1 this is behaviourally
    # identical to `== 0`, so no runtime test can distinguish them and the
    # mutation back to `== 0` SURVIVES. That is a real limit, not an oversight —
    # the change buys correctness if anyone ever retunes the constant, and it
    # buys nothing observable today. Recorded rather than papered over with an
    # assertion that would only appear to cover it.
    if (load64(sl + AKE_EMITTED) < AUDIT_VERBATIM_MAX) {
        store64(sl + AKE_WOPEN, now_ms);
        store64(sl + AKE_SEV, sev);
        store64(sl + AKE_ACTION, action);
        store64(sl + AKE_EMITTED, 1);
        audit_event(sev, action, who, wholen);
        return 1;
    }

    # Clock arm — freshness. An expired window rolls up and this occurrence opens
    # a fresh one.
    if (now_ms - load64(sl + AKE_WOPEN) >= AUDIT_WINDOW_MS) {
        _audit_rollup(key);
        store64(sl + AKE_WOPEN, now_ms);
        store64(sl + AKE_SEV, sev);
        store64(sl + AKE_ACTION, action);
        store64(sl + AKE_EMITTED, 1);
        audit_event(sev, action, who, wholen);
        return 1;
    }

    # Tally. This path allocates NOTHING.
    store64(sl + AKE_SUPP, load64(sl + AKE_SUPP) + 1);
    _audit_add_name(sl, who, wholen);

    # Count arm — the bound. Reads no clock, so it survives a dead one.
    if (load64(sl + AKE_SUPP) >= AUDIT_SUPPRESS_MAX) {
        _audit_rollup(key);
        # Mark the window still open so the next occurrence is tallied rather than
        # written verbatim — leaving EMITTED at 0 would make a sustained flood
        # alternate rollup/verbatim and double the entry count.
        #
        # 1.7.2 — AKE_WOPEN is deliberately NOT re-stamped here, and 1.7.1 did
        # re-stamp it. That one line pushed the window's start forward on every
        # count-arm fire, so above the crossover rate the 60 s clock arm never
        # came due again and the freshness guarantee quietly disappeared:
        # measured flat at 120 entries/hour up to 136 ev/s, then climbing to 441
        # entries/hour at 1000 ev/s, against a comment asserting the ceiling
        # "carries NO rate term in it".
        #
        # Worth naming for what it is: this release's sweep looked for "a
        # per-item cap that is not a bound on the loop", found the SIXTH
        # instance, and the sixth instance was inside 1.7.1's fix for the fifth.
        # The counter reset that hid it here is the same shape as G2's
        # SS_FAILS = 0, which is the reason 1.7.1 existed at all.
        store64(sl + AKE_EMITTED, 1);
    }
    return 0;
}

# Roll up any window that has expired. Called once per tick so a flood that STOPS
# still lands its tail promptly instead of waiting for its key to fire again.
fn audit_flush_due(now_ms): i64 {
    if (g_audit_tab == 0) { return 0; }
    var flushed = 0;
    var k = 0;
    while (k < AK_NKEYS) {
        var sl = _audit_slot(k);
        if (load64(sl + AKE_EMITTED) > 0) {
            if (now_ms - load64(sl + AKE_WOPEN) >= AUDIT_WINDOW_MS) {
                flushed = flushed + _audit_rollup(k);
                store64(sl + AKE_EMITTED, 0);
            }
        }
        k = k + 1;
    }
    return flushed;
}

# === Operator configuration (1.7.2). ===
#
# `data/server.cyml`, optional. Absent file, unreadable file, missing section or
# missing key all mean "defaults" — a server with no config file behaves exactly
# as 1.7.1 did, which is what makes this safe to add in a patch release.
#
# WHY A FILE RATHER THAN ONLY AN ENV KNOB. ADR 0007 §6 freezes the `YD_*` surface
# and its Consequences block new knobs for the 1.x line. A config file is a
# different surface, it uses the CYML parser this tree already has for zones and
# classes, and — the part that matters over time — the NEXT operator setting costs
# a key rather than another ADR amendment. `YD_MAX_ACCOUNTS` is honoured too and
# WINS over the file, because that is the order container deployments expect; the
# amendment recording both is in ADR 0007.
#
# Precedence, highest first:  YD_MAX_ACCOUNTS  >  data/server.cyml  >  built-in.
var g_max_accounts = 0;        # 0 = UNLIMITED, and that is the default

# Accounts currently on disk. Counted ONCE at boot and maintained in memory
# thereafter.
#
# Deliberately not recounted per creation: `dir_list` (lib/fs.cyr) allocates a
# 4096-byte scratch plus a vec plus a cloned Str per entry, all from the BUMP
# arena, which has no free. Counting on every character creation would be a
# permanent allocation per creation — precisely the defect class 1.7.1 spent a
# release bounding. One listing at boot, an increment per creation.
var g_account_count = 0;

# Read the DOCUMENT PREAMBLE rather than an `[[entries]]` block. CYML files in
# this tree are "preamble, then a list of entries with prose bodies" — the right
# shape for zones and classes, which are lists of things. A config file is not a
# list, so its settings are document-level keys and the file stays as small as it
# looks in docs/guides/running.md:
#
#     game = "yeomans-descent"
#     max_accounts = 2500
#
# No `[[entries]]`, no `---` body required.
fn config_load(path): i64 {
    var r = cyml_parse_file_r(path);
    if (is_ok(r) == 0) { return 0; }            # no file → defaults
    var doc = result_unwrap(r);
    var hl = cyml_doc_header_len(doc);
    if (hl <= 0) { return 0; }
    var hs = str_new(cyml_doc_header(doc), hl);
    var secs = toml_parse(hs);
    if (vec_len(secs) == 0) { return 0; }
    var pairs = toml_section_pairs(vec_get(secs, 0));
    # Negative or non-integer reads as 0 = unlimited: an unparseable cap must
    # never be MORE restrictive than the default, or a typo locks the operator
    # out of their own server.
    var m = toml_int(pairs, "max_accounts", 0);
    if (m < 0) { m = 0; }
    g_max_accounts = m;
    return 1;
}

# YD_MAX_ACCOUNTS overrides the file. Same shape as apply_idle_env's knobs.
fn config_apply_env(): i64 {
    var v = getenv("YD_MAX_ACCOUNTS");
    if (v == 0) { return 0; }
    var m = atoi(v);
    if (m < 0) { return 0; }
    g_max_accounts = m;
    return 1;
}

# Is the account cap reached? A pure predicate over its two inputs, so the rule is
# testable without a filesystem — and `cap <= 0` means UNLIMITED, which is both the
# default and the fail-open direction.
fn accounts_full(count, cap): i64 {
    if (cap <= 0)      { return 0; }
    if (count >= cap)  { return 1; }
    return 0;
}

# Count the records on disk. Called ONCE, from persist_init — see g_account_count
# for why never again.
#
# Counts every entry in the players directory rather than filtering on `.cyml`:
# nothing else writes there, and a filter that silently skipped an unexpected file
# would UNDERCOUNT, which is the direction that breaks the cap. Overcounting a
# stray file only makes the operator's limit slightly conservative.
fn accounts_count_disk(): i64 {
    var names = dir_list(str_from(DP_PLAYERS));
    var n = vec_len(names);
    if (n < 0) { return 0; }
    return n;
}

# === Audit-log size (1.7.1) — the seam ADR 0009's rotation inherits. ===
#
# Bytes in the durable audit store, or -1 if it cannot be read.
#
# `file_open` + `xlseek(SEEK_END)` + `file_close`, measured at ~2.6 us and ZERO
# arena. Deliberately not the two obvious alternatives:
#   - `xstat` is faster (~1 us) but sys_stat's arity differs per target, and that
#     split has already bitten this file once (see the #ifdef around _path_for's
#     existence check).
#   - `filestore_len` is not an option at all: it counts NEWLINES across the whole
#     file — 27.8 ms on the 13 MB working log, on a path that would run at boot.
fn _audit_store_size(): i64 {
    var fd = file_open(DP_AUDIT, O_RDONLY, 0);
    if (fd < 0) { return 0 - 1; }
    var n = xlseek(fd, 0, 2);          # 2 = SEEK_END
    file_close(fd);
    return n;
}

# Is the audit store large enough to warn about? A pure boundary predicate, so the
# threshold is testable without a 8 MiB file — and it is the same predicate ADR
# 0009's rotation trigger will call in 1.7.2, with the same constant, so the
# warning and the rotation can never disagree about where the line is.
fn audit_size_warn_due(size): i64 {
    if (size < 0) { return 0; }                       # unreadable is not "large"
    if (size >= AUDIT_SIZE_WARN_BYTES) { return 1; }
    return 0;
}

# Warn once, at boot, if the log is already oversized. Boot-only on purpose: no
# per-append cost, no latch to get wrong, and no recursion (this is the one
# audit_event whose own growth cannot compound).
#
# Nothing has ever told an operator this file is large. At the time this landed the
# working log was 13,336,880 bytes over 37,902 records and silent.
fn audit_size_check(): i64 {
    var n = _audit_store_size();
    if (audit_size_warn_due(n) == 0) { return 0; }
    audit_keyed(AK_AUDIT_SIZE, SEV_WARNING, "audit.size", 0, 0, clock_now_ms());
    return 1;
}

# === ADR 0009 rotation — segments, markers, and the crash window. ===

# data/audit.libro.<n>, NUL-terminated, into `out`. Returns the length excluding
# the NUL, or 0 if it would not fit.
#
# Derived from DP_AUDIT rather than a second literal: DP_AUDIT already carries the
# per-target #ifdef (agnos needs an absolute /data/...) AND is the seam the suite
# reassigns to a fixture. A second path constant would need both and would drift.
fn _audit_seg_path(n, out): i64 {
    var off = 0;
    var i = 0;
    while ((load8(DP_AUDIT + i) & 0xFF) != 0) {
        # 24 = '.' + at most 19 digits + NUL, with margin. DP_AUDIT is a var, so
        # a caller could point it anywhere; this is the only bound there is.
        if (off >= PATH_CAP - 24) { store8(out, 0); return 0; }
        store8(out + off, load8(DP_AUDIT + i));
        off = off + 1;
        i = i + 1;
    }
    store8(out + off, 46); off = off + 1;          # '.'
    off = _audit_put_num(out, off, n);             # 1.7.1's decimal appender
    store8(out + off, 0);
    return off;
}

# Highest existing segment number, 0 if none. Cached for the process.
#
# `dir_list` would answer this in one syscall and is REJECTED: lib/fs.cyr's
# dir_list alloc()s 4096 bytes of BUMP arena per call, permanently, and rotation
# calls this forever — precisely the leak class 1.7.1 spent a release removing.
# file_exists probing is ~2 us each and zero arena.
fn _audit_seg_hi(): i64 {
    if (g_audit_seg_hi >= 0) { return g_audit_seg_hi; }
    var hi = 0;
    var miss = 0;
    var n = 1;
    while (n <= AUDIT_SEG_MAX) {
        var got = 0;
        if (_audit_seg_path(n, g_audit_segbuf) > 0) { got = file_exists(g_audit_segbuf); }
        if (got == 1) { hi = n; miss = 0; }
        else {
            miss = miss + 1;
            # The retained run is contiguous and at most AUDIT_SEG_KEEP long, so
            # KEEP consecutive misses after a hit means nothing is above. Stopping
            # early is SAFE, not merely fast: an under-reported `hi` collides on
            # the next rotation, and the collision guard in audit_rotate_now
            # refuses rather than clobbering a sealed segment.
            if (hi > 0) {
                if (miss >= AUDIT_SEG_KEEP) { n = AUDIT_SEG_MAX; }
            }
        }
        n = n + 1;
    }
    g_audit_seg_hi = hi;
    return hi;
}

# Copy the hash of the LAST complete record of `path` into `out`. Returns the byte
# count, or 0 if the file is missing, empty, or holds no complete record.
#
# It COPIES, for the reason _audit_resume_head documents: _audit_last_hash returns
# a Str that BORROWS g_persist_slurp, and that buffer is reused constantly.
fn _audit_tail_hash(path, out): i64 {
    var fd = file_open(path, O_RDONLY, 0);
    if (fd < 0) { return 0; }
    var size = xlseek(fd, 0, 2);                   # SEEK_END
    if (size <= 0) { file_close(fd); return 0; }
    var want = SLURP_CAP - 1;
    if (size < want) { want = size; }
    xlseek(fd, size - want, 0);                    # SEEK_SET
    var n = sys_read(fd, g_persist_slurp, want);
    file_close(fd);
    if (n <= 0) { return 0; }
    var h = _audit_last_hash(g_persist_slurp, n);
    if (h == 0) { return 0; }
    var hn = str_len(h);
    if (hn > AUDIT_HEAD_CAP) { hn = AUDIT_HEAD_CAP; }
    memcpy(out, str_data(h), hn);
    return hn;
}

# "<segno> <hash>" into g_audit_mark; returns the length. A BARE SCALAR, not a
# JSON object, for the reason _audit_rollup records: libro's canonical hasher
# takes an allocating path for objects and a free one for scalars.
fn _audit_mark(n, hash, hlen): i64 {
    var off = _audit_put_num(g_audit_mark, 0, n);
    store8(g_audit_mark + off, 32); off = off + 1;   # ' '
    var k = hlen;
    if (off + k > AUDIT_MARK_CAP) { k = AUDIT_MARK_CAP - off; }
    if (k > 0) { memcpy(g_audit_mark + off, hash, k); off = off + k; }
    return off;
}

# Is this the tick that probes the log's size? Pure and total, taking the counter
# as a PARAMETER. A tick count rather than a clock because a `now - last` rule
# never fires on AGNOS's frozen sys_uptime_ms — which would silently disable
# rotation on exactly one of the two supported targets.
fn audit_rotate_check_due(ticks): i64 {
    if (ticks <= 0) { return 0; }
    if ((ticks % AUDIT_ROTATE_TICKS) == 0) { return 1; }
    return 0;
}

# Retire the segment that falls out of the keep window. The victim is
# `newest - AUDIT_SEG_KEEP` — arithmetic, not a scan — and it is self-correcting:
# already gone means a no-op.
fn _audit_prune(newest, now_ms): i64 {
    var victim = newest - AUDIT_SEG_KEEP;
    if (victim < 1) { return 0; }
    if (_audit_seg_path(victim, g_audit_segbuf) <= 0) { return 0; }
    if (file_exists(g_audit_segbuf) == 0) { return 0; }
    # Read the head hash and write the marker BEFORE the unlink. A deletion must
    # be attested inside the chain that survives, and the attestation IS the hash
    # — a marker naming a file with no hash attests nothing. Reading first is also
    # what makes the ordering mutation-visible: unlink first and _audit_tail_hash
    # returns 0, so the marker carries no hash.
    var hlen = _audit_tail_hash(g_audit_segbuf, g_audit_head);
    var mlen = _audit_mark(victim, g_audit_head, hlen);
    audit_keyed(AK_AUDIT_PRUNE, SEV_WARNING, "audit.prune", g_audit_mark, mlen, now_ms);
    _audit_seg_path(victim, g_audit_segbuf);       # rebuild: the read reused segbuf
    xunlink(g_audit_segbuf);
    g_audit_pruned = g_audit_pruned + 1;
    return 1;
}

# Seal the live log into the next segment and continue appending. Returns 1 if a
# rotation happened.
fn audit_rotate_now(now_ms): i64 {
    if (g_audit_chain == 0) { return 0; }
    var n = _audit_seg_hi() + 1;
    if (n > AUDIT_SEG_MAX) {
        audit_keyed(AK_AUDIT_ROTFAIL, SEV_WARNING, "audit.rotate.fail", 0, 0, now_ms);
        return 0;
    }
    if (_audit_seg_path(n, g_audit_segbuf) <= 0) {
        audit_keyed(AK_AUDIT_ROTFAIL, SEV_WARNING, "audit.rotate.fail", 0, 0, now_ms);
        return 0;
    }
    # Never clobber a sealed segment. rename(2) replaces its target silently, so a
    # stale g_audit_seg_hi — an operator dropping a file in mid-run — would be an
    # unrecoverable deletion of attested history. Dropping the cache here makes
    # the next check re-scan and self-heal.
    if (file_exists(g_audit_segbuf) == 1) {
        g_audit_seg_hi = 0 - 1;
        audit_keyed(AK_AUDIT_ROTFAIL, SEV_WARNING, "audit.rotate.fail", 0, 0, now_ms);
        return 0;
    }
    # Read the tail hash from the FILE, before the rename. NOT chain_head_hash,
    # which returns 0 on a streaming chain (ADR 0009 Context 3): filestore appends
    # under flock, so the on-disk tail is what a verifier actually compares.
    var hlen = _audit_tail_hash(DP_AUDIT, g_audit_head);
    # file_rename, not the raw syscall above: that one predates io.cyr's wrapper
    # and misses the agnos 4-arg form. And on failure we must NOT repoint anything
    # — the live file is still live, and a half-done rotation splits the chain.
    if (file_rename(DP_AUDIT, g_audit_segbuf) != 0) {
        audit_keyed(AK_AUDIT_ROTFAIL, SEV_WARNING, "audit.rotate.fail", 0, 0, now_ms);
        return 0;
    }
    g_audit_seg_hi = n;
    g_audit_rotations = g_audit_rotations + 1;
    # The first append after the rename recreates the live file, and its prev_hash
    # is the sealed tail — carried by the chain, not by metadata.
    var mlen = _audit_mark(n, g_audit_head, hlen);
    audit_keyed(AK_AUDIT_ROTATE, SEV_INFO, "audit.rotate", g_audit_mark, mlen, now_ms);
    _audit_prune(n, now_ms);
    return 1;
}

# Probe the size, rotate if it is over. The size predicate is audit_size_warn_due
# — the SAME function and constant the boot-time warning uses, which is what makes
# it impossible for the warning and the rotation to disagree about where the line
# is.
fn audit_rotate_maybe(now_ms): i64 {
    if (audit_size_warn_due(_audit_store_size()) == 0) { return 0; }
    return audit_rotate_now(now_ms);
}

# Roll up everything pending, whatever the clock says. For shutdown: a tally that
# never reaches the log is a flood nobody can see.
fn audit_flush_all(): i64 {
    if (g_audit_tab == 0) { return 0; }
    var flushed = 0;
    var k = 0;
    while (k < AK_NKEYS) {
        flushed = flushed + _audit_rollup(k);
        store64(_audit_slot(k) + AKE_EMITTED, 0);
        k = k + 1;
    }
    return flushed;
}

# === small utilities =======================================================

fn _slen(p): i64 {
    var i = 0;
    while ((load8(p + i) & 0xFF) != 0) { i = i + 1; }
    return i;
}

# The schema version a parsed record declares (M11-A).
#
# A MISSING `schema` key means the literal v1 — 0.7.0-0.9.0 records predate the
# stamp and *are* v1 forever, regardless of what version this server is. Reading
# the default as SCHEMA_VERSION (the pre-1.3.0 behaviour) meant those records
# would silently re-label themselves as whatever the current version happened to
# be, skipping every migration path the instant SCHEMA_VERSION moved off 1.
#
# `toml_int` returns its default for a non-integer or negative value, so
# `schema = "abc"` and `schema = -1` both land on v1. A nonsense `schema = 0`
# clamps up to v1 as well, so callers can branch on `>= 2` without a third case.
#
# Split out from the gate so it is testable while SCHEMA_VERSION is still 1 —
# the load path cannot yet branch on the answer (that arrives with M14), so the
# invariant "a stamp-less record reads as exactly 1" is otherwise unobservable.
fn _record_schema(pairs): i64 {
    var v = toml_int(pairs, "schema", SCHEMA_V1);
    if (v < SCHEMA_V1) { return SCHEMA_V1; }
    return v;
}

# Does a loaded str hold any control byte (< 0x20)? A 0 str is absent, not
# suspicious — callers treat that as "no value", so it reports clean. Used by
# the M11-C signed-prefix guard in player_auth_load.
fn _has_ctrl(v): i64 {
    if (v == 0) { return 0; }
    var p = str_data(v);
    var n = str_len(v);
    var i = 0;
    while (i < n) {
        if ((load8(p + i) & 0xFF) < 32) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _bytes_eq(a, b, n): i64 {
    var i = 0;
    while (i < n) {
        if ((load8(a + i) & 0xFF) != (load8(b + i) & 0xFF)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Build data/players/<lower(name)>.cyml (NUL-terminated) into `out`.
# Returns the path length (excluding the NUL).
# The shard directory character for a name: its lowercased first byte, or '_'
# for anything without one. Names are validated 2-16 alnum starting with a
# letter (login_name_ok), so in practice this is 'a'..'z'; the fallback exists
# so a caller that reaches here with an odd name still produces a legal path
# rather than a stray '/' or a NUL.
fn _shard_char(name, len): i64 {
    if (len <= 0) { return 95; }                 # '_'
    var c = ascii_lower(load8(name) & 0xFF);
    if (is_alnum(c) == 0) { return 95; }
    return c;
}

# Build the LEGACY flat path — `data/players/<name>.cyml`, the only layout before
# 1.7.2. Still read, never written: see _path_for.
fn _path_for_flat(name, len, out): i64 {
    var n = len;
    if (n > NAME_MAX) { n = NAME_MAX; }
    if (n < 0) { n = 0; }
    var pre = DP_PLAYERS_S;
    var off = 0;
    var i = 0;
    while ((load8(pre + i) & 0xFF) != 0) { store8(out + off, load8(pre + i)); off = off + 1; i = i + 1; }
    i = 0;
    while (i < n) { store8(out + off, ascii_lower(load8(name + i) & 0xFF)); off = off + 1; i = i + 1; }
    var suf = ".cyml";
    i = 0;
    while ((load8(suf + i) & 0xFF) != 0) { store8(out + off, load8(suf + i)); off = off + 1; i = i + 1; }
    store8(out + off, 0);
    return off;
}

# Build the SHARDED path — `data/players/<c>/<name>.cyml` (1.7.2).
#
# WHY. The flat directory held one file per account forever, and an operator who
# sets `max_accounts = 2500` (or leaves it unlimited, which is the default) ends
# up with thousands of entries in one directory: slow to list, slow to complete,
# and on some filesystems slow to open. One level of 36 buckets keeps it to tens
# of files per directory at the scales this server is now explicitly sized for.
#
# `n` IS BOUNDED HERE, at the primitive, and that is deliberate. PATH_CAP sized
# the two destination buffers and was compared against nothing — `_path_for` wrote
# prefix + len + suffix unconditionally, so a caller passing an unvalidated length
# would have overrun a 320-byte buffer. Not reachable today: login_name_ok gates
# the only write to SS_NAME_LEN and the only player_exists call on the login path,
# both rejecting len > NAME_MAX. But this is the same shape as the 0.9.0
# hex_decode_into finding — a primitive that trusts its caller — and this release
# makes the output LONGER, so the bound goes in first rather than afterwards.
fn _path_for(name, len, out): i64 {
    var n = len;
    if (n > NAME_MAX) { n = NAME_MAX; }
    if (n < 0) { n = 0; }
    var pre = DP_PLAYERS_S;
    var off = 0;
    var i = 0;
    while ((load8(pre + i) & 0xFF) != 0) { store8(out + off, load8(pre + i)); off = off + 1; i = i + 1; }
    store8(out + off, _shard_char(name, n)); off = off + 1;
    store8(out + off, 47); off = off + 1;        # '/'
    i = 0;
    while (i < n) { store8(out + off, ascii_lower(load8(name + i) & 0xFF)); off = off + 1; i = i + 1; }
    var suf = ".cyml";
    i = 0;
    while ((load8(suf + i) & 0xFF) != 0) { store8(out + off, load8(suf + i)); off = off + 1; i = i + 1; }
    store8(out + off, 0);
    return off;
}

# Ensure a name's shard directory exists. Cheap and unconditional: sys_mkdir on an
# existing directory returns EEXIST, which is ignored exactly as persist_init
# already does for data/ and data/players/.
fn _shard_mkdir(name, len): i64 {
    var pre = DP_PLAYERS_S;
    var off = 0;
    var i = 0;
    while ((load8(pre + i) & 0xFF) != 0) { store8(g_persist_tmp + off, load8(pre + i)); off = off + 1; i = i + 1; }
    store8(g_persist_tmp + off, _shard_char(name, len)); off = off + 1;
    store8(g_persist_tmp + off, 0);
    sys_mkdir(g_persist_tmp, 0x1ED);             # 0755 — EEXIST ignored
    return 0;
}

# === identity ==============================================================

# Derive the Ed25519 keypair for (salt, passphrase): seed = SHA-256(salt||pass).
# Writes 64-byte secret to sk_out and 32-byte public key to pk_out.
fn ident_derive(salt, pass, passlen, sk_out, pk_out): i64 {
    # SECURITY (0.9.0): g_ident_scratch is 256 bytes with the seed at offset
    # 200, so the passphrase copy region is [16, 200) = 184 bytes. Hard-clamp
    # passlen to PASS_MAX (64) so a missed caller-side bound can never overflow
    # — the returning-login path passes the raw line length (up to LINE_CAP).
    var n = passlen;
    if (n > PASS_MAX) { n = PASS_MAX; }
    if (n < 0) { n = 0; }
    var msg = g_ident_scratch;
    memcpy(msg, salt, SALT_LEN);
    memcpy(msg + SALT_LEN, pass, n);
    var seed = g_ident_scratch + 200;
    sha256(msg, SALT_LEN + n, seed);
    g_charge_derives = g_charge_derives + 1;   # 1.7.0 — counted, not predicted
    ed25519_keypair(seed, sk_out, pk_out);
    return 0;
}

# Clamp v into [lo, hi]. Used to bound every field loaded from a (player-
# owned, signed-but-not-value-validated) save record.
fn _clamp(v, lo, hi): i64 {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

# Lazily allocate the per-session identity block (zeroed). Returns its ptr.
fn sess_ident(s): i64 {
    var blk = load64(s + SS_IDENT);
    if (blk == 0) {
        blk = fl_alloc(IDENT_LEN);
        memset(blk, 0, IDENT_LEN);
        store64(s + SS_IDENT, blk);
    }
    return blk;
}

# Does a saved record exist for this name?
#
# `sys_stat` is one of the few stdlib calls whose ARITY differs by target:
# agnos is `sys_stat(path, pathlen, statbuf)` (its VFS takes counted paths)
# while Linux/macOS are `sys_stat(path, buf)`. Calling the 2-arg form on agnos
# put `g_persist_stat` in the `pathlen` slot and left `statbuf` garbage, so
# this returned a meaningless answer — and it is the branch that decides
# whether a connecting name is a RETURNING player (passphrase prompt) or a NEW
# one (character creation). `cyrius build --agnos` warned; the host build
# could not see it. `_path_for` already returns the length we need.
# 1.7.2 — a record may live at EITHER the sharded path (written since 1.7.2) or
# the legacy flat one (everything before it). Both are checked, sharded first,
# so an existing deployment keeps working with no operator action and no
# migration step. A name is "taken" if a record exists in either place —
# answering otherwise would let a second character claim a name whose record is
# still on disk.
fn player_exists(name, len): i64 {
    persist_init();
    var plen = _path_for(name, len, g_persist_path);
    #ifdef CYRIUS_TARGET_AGNOS
    if (sys_stat(g_persist_path, plen, g_persist_stat) == 0) { return 1; }
    var flen = _path_for_flat(name, len, g_persist_path);
    if (sys_stat(g_persist_path, flen, g_persist_stat) == 0) { return 1; }
    return 0;
    #else
    if (sys_stat(g_persist_path, g_persist_stat) == 0) { return 1; }
    _path_for_flat(name, len, g_persist_path);
    if (sys_stat(g_persist_path, g_persist_stat) == 0) { return 1; }
    return 0;
    #endif
}

# === serialization =========================================================
# Appenders over g_persist_save at a running offset.

# M11-D — bounded appenders.
#
# These write into g_persist_save, a fixed SAVE_CAP (4096) allocation. Until
# M11-D none of them checked anything: the only guard in _build_record was inside
# the inventory loop, and the record only fit because `name` caps at 16 and room
# ids are short. That is a WRITE-side heap overflow, which no amount of load-side
# clamping prevents — and every variable-length field 2.0 wants to add (an
# equipment list, a title, a guild roster) would have landed straight on it.
#
# The rule: once an append would exceed SAVE_CAP, every appender becomes a no-op
# and propagates the poisoned offset. _build_record checks ONCE at the end, so
# the callers stay readable and no partial record can ever be signed or written.
# SAVE_ERR is deliberately far above any real offset so it survives the
# arithmetic in the chained `off = _f...(off, ...)` calls without wrapping.
var SAVE_ERR = 0x40000000;

# Has the running offset already overflowed?
fn _sv_bad(off): i64 { if (off >= SAVE_ERR) { return 1; } return 0; }

# Append n bytes, or poison the offset if they would not fit.
fn _ap(off, ptr, n): i64 {
    if (_sv_bad(off) == 1) { return off; }
    if (off + n > SAVE_CAP) { return SAVE_ERR; }
    memcpy(g_persist_save + off, ptr, n);
    return off + n;
}
# Append a NUL-terminated literal.
fn _ac(off, cstr): i64 { return _ap(off, cstr, _slen(cstr)); }
# Append a decimal integer via the shared fmt scratch.
fn _ai(off, n): i64 {
    if (_sv_bad(off) == 1) { return off; }
    var l = fmt_int_buf(n, g_fmt_scratch);
    return _ap(off, g_fmt_scratch, l);
}
fn _fstr(off, key, valptr, vallen): i64 {
    off = _ac(off, key);
    off = _ac(off, " = \"");
    off = _ap(off, valptr, vallen);
    off = _ac(off, "\"\n");
    return off;
}
fn _fint(off, key, n): i64 {
    off = _ac(off, key);
    off = _ac(off, " = ");
    off = _ai(off, n);
    off = _ac(off, "\n");
    return off;
}

# === H17 (1.6.8) — hex straight into the record, allocating nothing. ===
#
# `hex_encode` (lib/sigil_hex.cyr) allocates its output with `alloc()`, the bump
# allocator that has no free at all. _build_record called it three times — salt,
# pubkey, signature — so every single save handed out 248 bytes that could never
# come back, on a five-minute autosave cadence, forever. Not the whole of the
# ~2.2 kB/save leak (most of it is inside libro's filestore_append and needs an
# upstream release, exactly like the 1.6.1 chain fix), but it is descent's share
# of it, and it goes to zero rather than getting smaller.
#
# Options (a) "pass an fl_alloc'd buffer" and (b) "pass a static buffer" both
# fail on the same fact: hex_encode allocates INTERNALLY and there is no
# `hex_encode_into` to thread a destination through. lib/ must not be modified.
# Since a local hex loop has to be written either way, write it straight into
# the record and skip the intermediate buffer entirely.
#
# BYTE-IDENTITY IS THE WHOLE GAME. These bytes are inside the signed prefix. If
# this encoder disagrees with lib/sigil_hex.cyr by one character — uppercase, a
# different pad, a changed separator — every existing save record fails Ed25519
# verification on its owner's next login, the player is told their record was
# tampered with, and a false SEV_SECURITY entry is written. Silent, total,
# irreversible character loss across the whole playerbase. So `_hex_at` is a
# separate function specifically so a test can assert it agrees with hex_encode
# byte-for-byte over a range of inputs, rather than relying on anyone rereading
# the constants: see the `hex-identity` group.
#
# Nothing encoded here is secret — the salt is stored in cleartext, the pubkey
# is public by definition, and the signature is public — so no wipe is needed.
# The secret key at blk + IDENT_SK is never an argument to this.

# Write `n` bytes as lowercase hex into g_persist_save at `off`. Returns the new
# offset, or SAVE_ERR if it would not fit. Same 48/87 constants as sigil_hex.
fn _hex_at(off, ptr, n): i64 {
    if (_sv_bad(off) == 1) { return off; }
    if (off + n * 2 > SAVE_CAP) { return SAVE_ERR; }
    var i = 0;
    while (i < n) {
        var b = load8(ptr + i) & 0xFF;
        var hi = (b >> 4) & 0xF;
        var lo = b & 0xF;
        if (hi < 10) { store8(g_persist_save + off, 48 + hi); }
        else         { store8(g_persist_save + off, 87 + hi); }
        if (lo < 10) { store8(g_persist_save + off + 1, 48 + lo); }
        else         { store8(g_persist_save + off + 1, 87 + lo); }
        off = off + 2;
        i = i + 1;
    }
    return off;
}
# `key = "<hex>"` — the same framing _fstr emits, so the record is unchanged.
fn _fhex(off, key, ptr, n): i64 {
    off = _ac(off, key);
    off = _ac(off, " = \"");
    off = _hex_at(off, ptr, n);
    return _ac(off, "\"\n");
}

# Serialize the session into g_persist_save and append the Ed25519 record
# signature (signed over the prefix). Returns total length, or -1 on overflow.
fn _build_record(s): i64 {
    var blk = sess_ident(s);
    var off = 0;
    off = _ac(off, "[player]\n");
    off = _fint(off, "schema", SCHEMA_VERSION);   # 0.9.1 migration hook
    off = _fstr(off, "name", load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN));
    off = _fhex(off, "salt",   blk, SALT_LEN);                    # H17 — no alloc
    off = _fhex(off, "pubkey", blk + IDENT_PK, PK_LEN);           # H17 — no alloc
    off = _fint(off, "class", load64(s + SS_CLASS));
    var room = load64(s + SS_ROOM);
    if (room >= 0) {
        var r = room_at(room);
        off = _fstr(off, "room", room_id_ptr(r), room_id_len(r));
    } else {
        off = _fstr(off, "room", "", 0);
    }
    off = _fint(off, "hp",    load64(s + SS_HP));
    off = _fint(off, "maxhp", load64(s + SS_MAXHP));
    off = _fint(off, "ac",    load64(s + SS_AC));
    off = _fint(off, "hit",   load64(s + SS_HIT));
    off = _fint(off, "ndice", load64(s + SS_NDICE));
    off = _fint(off, "dsize", load64(s + SS_DSIZE));
    off = _fint(off, "dmod",  load64(s + SS_DMOD));
    off = _fint(off, "str", load64(s + SS_STR));
    off = _fint(off, "dex", load64(s + SS_DEX));
    off = _fint(off, "con", load64(s + SS_CON));
    off = _fint(off, "tec", load64(s + SS_TEC));
    off = _fint(off, "energy",    load64(s + SS_ENERGY));
    off = _fint(off, "maxenergy", load64(s + SS_MAXENERGY));
    off = _fint(off, "created",    load64(blk + IDENT_CREATED));
    off = _fint(off, "last_login", get_epoch_secs());
    # inventory — comma-joined template ids
    off = _ac(off, "inv = \"");
    var it = load64(s + SS_INV);
    var first = 1;
    var stop = 0;      # 1.7.2 — set by either walk when the byte budget is spent
    while (it != 0) {
        if (oi_tpl_id_len(it) > 0) {
            # G1 (1.6.13) — TRUNCATE the inventory here, do not poison the record.
            #
            # This used to set SAVE_ERR, which M11-D then turned into "refuse the
            # whole record". So a player over the byte budget stopped persisting
            # entirely — not just the overflow items, but their room, HP, class
            # and every future change. Measured: the record is refused from the
            # 113th item (at the 31-byte id maximum) and keeps being refused
            # until something is dropped, with nothing said to the player.
            #
            # Losing the tail of an over-long inventory is a bounded, one-time
            # loss. Losing every future save is unbounded and silent, and it is
            # the worse of the two by a wide margin. The carry cap in item.cyr
            # should make this unreachable; this is the net under it, and it
            # writes an audit entry so the operator can see it happened.
            if (off > SAVE_CAP - SIG_TAIL) {
                audit_keyed(AK_SAVE_INV_TRUNC, SEV_WARNING, "save.inv.truncated",
                load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), clock_now_ms());
                it = 0;
                continue;
            }
            if (_sv_bad(off) == 1) { it = 0; continue; }
            if (first == 0) { off = _ac(off, ","); }
            off = _ap(off, oi_tpl_id_ptr(it), oi_tpl_id_len(it));
            first = 0;
        }
        # F11 (1.6.11) — descend one level into a carried container.
        #
        # This walked only the top-level SS_INV chain, so anything sitting in a
        # bag the player was holding was never written — and session_drop_inv
        # then obj_free'd it, which recurses through OI_CONTENTS. Put your scrip
        # in a sack, log out, and the scrip was gone. Silent, and caused by
        # 1.6.7's `put` accepting a carried container in the first place.
        #
        # The contents are FLATTENED into the same comma-separated list rather
        # than nested. That keeps the frozen v1 `inv` field byte-compatible
        # (ADR 0007 §3) — it is still a list of template ids — at the cost of
        # the nesting not surviving a reconnect: the items come back loose in
        # your hands. Losing the arrangement is a fair trade against losing the
        # items; representing nesting needs a schema change, i.e. 2.0.
        #
        # One level is enough: cmd_put caps nesting at depth 1 by refusing to
        # put a non-empty container into anything.
        var inner = oi_contents(it);
        while (inner != 0) {
            if (oi_tpl_id_len(inner) > 0) {
                # 1.7.2 — TRUNCATE HERE TOO. This loop used to set `off =
                # SAVE_ERR`, which M11-D turns into "refuse the whole record" —
                # ten lines below the comment above saying, in those words, to
                # truncate and not poison the record.
                #
                # So G1's fix was real for the top-level walk and undone for the
                # contents walk, and the 1.6.13 defect stayed fully reachable
                # THROUGH A BAG: `inv_count` walks only the top-level SS_INV
                # chain, `cmd_put` moves items into a carried container without
                # counting them, and F11 flattens one level back into the same
                # `inv` field. Probe-confirmed: 3 top-level items — far under
                # MAX_INV — plus 200 in one bag refuses the record whole, and it
                # keeps being refused until something is dropped, silently.
                #
                # An ordinary player with a sack does this. No malice required.
                #
                # `stop` rather than `it = 0` inside this loop: the outer body
                # ends with `it = oi_next(it)`, so zeroing `it` here would
                # dereference null on the way out.
                if (off > SAVE_CAP - SIG_TAIL) {
                    audit_keyed(AK_SAVE_INV_TRUNC, SEV_WARNING, "save.inv.truncated",
                    load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN),
                    clock_now_ms());
                    stop = 1;
                    inner = 0;
                    continue;
                }
                if (_sv_bad(off) == 1) { stop = 1; inner = 0; continue; }
                if (first == 0) { off = _ac(off, ","); }
                off = _ap(off, oi_tpl_id_ptr(inner), oi_tpl_id_len(inner));
                first = 0;
            }
            inner = oi_next(inner);
        }
        if (stop == 1) { it = 0; continue; }
        it = oi_next(it);
    }
    off = _ac(off, "\"\n");
    # M11-D — one check, here. If any append overflowed, the record is refused
    # whole: nothing is signed, nothing is written, and player_save reports the
    # I/O failure. A partially-built record must never reach the signer, or we
    # would hand the player a validly-signed truncation of their own character.
    if (_sv_bad(off) == 1) { return 0 - 1; }
    # sign the prefix [0, off) with the session's (re-derived) secret key
    var sig = g_persist_dec;
    g_charge_signs = g_charge_signs + 1;       # 1.7.0 — counted, not predicted
    ed25519_sign(blk + IDENT_SK, g_persist_save, off, sig);
    off = _fhex(off, "sig", sig, SIG_LEN);                        # H17 — no alloc
    if (_sv_bad(off) == 1) { return 0 - 1; }
    return off;
}

# === save (crash-safe) =====================================================
# Returns 1 saved, 0 not-authed (nothing to persist), -1 on I/O failure.
fn player_save(s): i64 {
    if (load64(s + SS_AUTHED) == 0) { return 0; }
    persist_init();
    # 1.7.3 — stamp the ATTEMPT before anything can fail, so a save that fails at
    # any point below still backs off (see save_sweep_due). Stamping only on the
    # success path would leave every failure mode retrying every tick, which is
    # the defect this fixes.
    store64(s + SS_LAST_SAVE_TRY_MS, clock_now_ms());
    var total = _build_record(s);
    if (total < 0) { return 0 - 1; }
    _shard_mkdir(load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN));   # 1.7.2
    var plen = _path_for(load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), g_persist_path);
    # tmp = path + ".tmp"
    memcpy(g_persist_tmp, g_persist_path, plen);
    memcpy(g_persist_tmp + plen, ".tmp", 4);
    store8(g_persist_tmp + plen + 4, 0);
    var w = file_write_all(g_persist_tmp, g_persist_save, total);
    if (w < 0) { return 0 - 1; }
    # atomic publish: rename clobbers the previous record in one step, so a
    # crash mid-write leaves either the old record or the new one — never a
    # torn file. A stale <name>.cyml.tmp from a crashed write is simply
    # overwritten on the next save.
    if (syscall(SYS_RENAME_NR, g_persist_tmp, g_persist_path) != 0) { return 0 - 1; }
    # 1.7.2 — the record is now durably at the sharded path, so retire any legacy
    # flat copy. Lazy per-player migration: nothing to run, nothing to schedule,
    # and a deployment converts itself as players save.
    #
    # STRICTLY AFTER the rename returned 0, never before. Unlinking first would
    # mean a failed write leaves no record at all — trading a layout change for
    # data loss. The flat file is only ever read as a fallback, so a crash between
    # the two leaves a harmless duplicate that the next save clears.
    _path_for_flat(load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), g_persist_tmp);
    syscall(87, g_persist_tmp);                  # unlink; ENOENT is the normal case
    store64(s + SS_LAST_SAVE_MS, clock_now_ms());
    store64(s + SS_SAVE_DIRTY, 0);
    audit_keyed(AK_SAVE, SEV_INFO, "save", load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), clock_now_ms());
    return 1;
}

# === load + authenticate ===================================================
# Find the byte offset where the trailing `sig = "..."` line begins — this
# is exactly the length of the signed prefix. -1 if not found.
fn _find_sig_offset(buf, n): i64 {
    var i = 0;
    var lim = n - 5;
    while (i < lim) {
        if (load8(buf + i) == 10) {     # '\n'
            var p = buf + i + 1;
            if ((load8(p) & 0xFF) == 115) {       # s
                if ((load8(p + 1) & 0xFF) == 105) {   # i
                    if ((load8(p + 2) & 0xFF) == 103) {   # g
                        if ((load8(p + 3) & 0xFF) == 32) { return i + 1; }  # ' '
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Re-instantiate inventory from a comma-separated template-id list.
fn _restore_inv(s, ids, len): i64 {
    var i = 0;
    while (i < len) {
        var start = i;
        while (i < len) {
            if ((load8(ids + i) & 0xFF) == 44) { break; }   # ','
            i = i + 1;
        }
        var idlen = i - start;
        if (idlen > 0) {
            var tpl = obj_tpl_by_id(ids + start, idlen);
            if (tpl != 0) { ilist_push(s + SS_INV, item_new(tpl)); }
        }
        if (i < len) { i = i + 1; }
    }
    return 0;
}

# Verify the passphrase against the stored record and, on success, restore
# the full session. Returns:
#    1  authenticated + loaded
#    0  wrong passphrase (re-promptable — the only non-terminal failure)
#   -1  no record on disk
#   -2  PL_ERR_UNREADABLE — malformed, truncated, or signature mismatch
#   -3  PL_ERR_SCHEMA — intact and correctly signed, but stamped newer than
#       g_schema_max. Distinct from -2 since 1.3.0 (M11-B): this is a rolled-back
#       deploy, not an attack, and must not be reported to the player as one.
fn player_auth_load(s, pass, passlen): i64 {
    persist_init();
    # H5 (1.6.2) — reject an out-of-range passphrase BEFORE touching the record.
    # These same two bounds used to sit after file_read_all + toml_parse +
    # ed25519_verify, so a zero-length or absurd passphrase paid the full
    # ~7 ms verify before being thrown out. Identical semantics (0 = wrong
    # passphrase, re-promptable); it just stops paying for the answer first.
    if (passlen < PASS_MIN) { return 0; }
    if (passlen > PASS_MAX) { return 0; }
    var nm = load64(s + SS_NAME_BUF);
    var nl = load64(s + SS_NAME_LEN);
    # 1.7.2 — sharded path first, then the legacy flat one. Without this fallback
    # every character created before 1.7.2 becomes unloadable the moment the
    # layout changes: player_exists would still find the flat record and route
    # them to the passphrase prompt, and this read would come back empty. A
    # migration that locks out existing players is not a migration.
    _path_for(nm, nl, g_persist_path);
    var n = file_read_all(g_persist_path, g_persist_slurp, SLURP_CAP - 1);
    if (n <= 0) {
        _path_for_flat(nm, nl, g_persist_path);
        n = file_read_all(g_persist_path, g_persist_slurp, SLURP_CAP - 1);
    }
    if (n <= 0) { return 0 - 1; }
    store8(g_persist_slurp + n, 0);

    # The record is a single [player] section; toml_parse returns a vec of
    # sections (mirror world.cyr's zone-header read).
    var secs = toml_parse(str_new(g_persist_slurp, n));
    if (vec_len(secs) == 0) { return 0 - 2; }
    var pairs = toml_section_pairs(vec_get(secs, 0));
    var saltv = toml_get(pairs, "salt");
    var pkv   = toml_get(pairs, "pubkey");
    var sigv  = toml_get(pairs, "sig");
    if (saltv == 0) { return 0 - 2; }
    if (pkv == 0)   { return 0 - 2; }
    if (sigv == 0)  { return 0 - 2; }

    var salt   = g_persist_dec;          # [0,16)
    var filepk = g_persist_dec + 16;     # [16,48)
    var filesig = g_persist_dec + 48;    # [48,112)
    # SECURITY (0.9.0): hex_decode_into writes str_len/2 bytes with NO
    # destination bound, and this runs BEFORE signature verification — an
    # over-long salt/pubkey/sig hex would overflow the 256-byte g_persist_dec.
    # Require the exact hex lengths up front so a corrupt/planted record is
    # rejected before any decode.
    if (str_len(saltv) != SALT_LEN * 2) { return 0 - 2; }
    if (str_len(pkv)   != PK_LEN * 2)   { return 0 - 2; }
    if (str_len(sigv)  != SIG_LEN * 2)  { return 0 - 2; }
    if (hex_decode_into(str_data(saltv), str_len(saltv), salt) == 0) { return 0 - 2; }
    if (hex_decode_into(str_data(pkv), str_len(pkv), filepk) == 0) { return 0 - 2; }
    if (hex_decode_into(str_data(sigv), str_len(sigv), filesig) == 0) { return 0 - 2; }

    # M11-C — refuse a record whose string values could split the signed prefix.
    #
    # _find_sig_offset ends the signed region at the FIRST line beginning `sig `,
    # so a value containing a newline followed by a forged `sig = "..."` line
    # would move that boundary: everything after the planted line falls outside
    # the signature, and the real trailing `sig` is never reached. No v1 field
    # can carry a newline today (names are alnum-validated, room ids and template
    # ids come from authored CYML), which is why this has never been reachable —
    # but the check has to exist BEFORE 2.0 adds a free-text field, not after.
    # Cheap and unconditional: no legitimate value holds a control byte.
    if (_has_ctrl(toml_get(pairs, "name")) == 1) { return 0 - 2; }
    if (_has_ctrl(toml_get(pairs, "room")) == 1) { return 0 - 2; }
    if (_has_ctrl(toml_get(pairs, "inv")) == 1)  { return 0 - 2; }

    # === Authentication BEFORE integrity (1.7.0). ===
    #
    # This function tests two independent things, and BOTH must pass:
    #   authentication — does the typed passphrase derive the key the record
    #                    names?  (ident_derive + _bytes_eq, measured 1077 us)
    #   integrity      — is the record signed by that key?
    #                    (ed25519_verify below, measured 7107 us)
    #
    # It used to evaluate them verify-first, so a WRONG PASSPHRASE paid the full
    # 7107 us verify to learn what the 1077 us derive already knew. Same
    # conjunction, cheaper order: 8006 us -> 1066 us on the line an attacker can
    # queue for free, measured independently twice (8006->1066 and 7780->1012).
    #
    # There is direct precedent forty lines above, at the passlen bounds H5
    # (1.6.2) hoisted ahead of this same verify, in the same words: it just stops
    # paying for the answer first.
    #
    # NOTHING IS TRUSTED EARLIER. Both inputs to the moved code are established
    # independently of the signature: `salt` and `filepk` are exact-length-checked
    # and hex-decoded above (SALT_LEN*2 / PK_LEN*2, before any decode, which is
    # the 0.9.0 overflow guard), and `pass` is bounds-checked here. The verify
    # still gates every field restore below, and the schema check still sits
    # AFTER the verify so a forged stamp on an unverified record cannot choose
    # the error code (M11-B).
    #
    # ONE DETECTION NUANCE, deliberately accepted. A tampered record now reports
    # `load.tamper` only once a passphrase matching the record's pubkey is typed.
    # For the realistic tamper — edit a field, leave salt+pubkey alone — that is
    # unchanged: the owner's passphrase still matches, so the verify still runs
    # and still audits. Only a FULL salt+pubkey substitution degrades to a
    # wrong-passphrase result, and an attacker able to rewrite the pubkey has
    # already destroyed the record for its owner and holds write access to
    # data/players/, which is a strictly larger problem than this signal.
    if (passlen < PASS_MIN) { return 0; }
    if (passlen > PASS_MAX) { return 0; }
    var blk = sess_ident(s);
    ident_derive(salt, pass, passlen, blk + IDENT_SK, blk + IDENT_PK);
    if (_bytes_eq(blk + IDENT_PK, filepk, PK_LEN) == 0) { return 0; }

    # Integrity: the record must be self-consistent under its own pubkey.
    var prefix = _find_sig_offset(g_persist_slurp, n);
    if (prefix < 0) { return 0 - 2; }
    # 1.7.0 — counted, not predicted. This counter is also the GUARD for the
    # reorder above: a wrong passphrase must reach here zero times, and
    # `auth-order` in the suite asserts exactly that. Revert the reorder and the
    # count becomes 1 and the test fails, which is the only way to hold a pure
    # reordering in place without a timing assertion.
    g_charge_verifies = g_charge_verifies + 1;
    if (ed25519_verify(filepk, g_persist_slurp, prefix, filesig) != 1) {
        audit_keyed(AK_LOAD_TAMPER, SEV_SECURITY, "load.tamper", nm, nl, clock_now_ms());
        return 0 - 2;
    }

    # 0.9.1 — reject a record stamped with a newer schema than this server
    # understands (the post-1.0 migration hook).
    #
    # M11-A: the version comes from _record_schema, which pins a missing stamp
    # to the literal v1 rather than to SCHEMA_VERSION. See that function for why
    # the difference only bites once SCHEMA_VERSION moves off 1 — and why the fix
    # therefore had to land before the bump rather than inside it.
    #
    # M11-B: this returns its OWN code, not the tamper code. A record from a
    # newer server is intact and honestly signed — it just post-dates us, which
    # is the normal consequence of rolling a deploy back. Reporting it as
    # "tampered with" told every returning player their character had been
    # attacked, and wrote a SEV_SECURITY entry into the audit chain for what is
    # an operator versioning event. It still refuses the session: a downgraded
    # server must never half-load a record whose fields it does not understand.
    if (_record_schema(pairs) > g_schema_max) {
        return PL_ERR_SCHEMA;
    }

    # Commit the authenticated identity into the session. Deliberately still
    # here, AFTER the verify, even though the derive that produced it moved
    # above: a record that fails integrity must not leave committed state
    # behind. (ident_derive has already written IDENT_SK / IDENT_PK by this
    # point — that is scratch the next login overwrites and session_free wipes;
    # the salt and the created stamp are what make the block authoritative.)
    memcpy(blk, salt, SALT_LEN);
    store64(blk + IDENT_CREATED, toml_int(pairs, "created", get_epoch_secs()));

    # Restore state. SECURITY (0.9.0): the Ed25519 signature proves the record's
    # AUTHOR, not its field values — a player owns their key and can re-sign a
    # record with any numbers. So validate every loaded field. The class index
    # feeds class_name_ptr() pointer math (`g_classes + cls*CL_SIZE`) → OOB read
    # if unbounded; ndice feeds the roll() loop → DoS. Clamp them all.
    var cls = toml_int(pairs, "class", 0 - 1);
    if (cls < 0) { cls = 0 - 1; }
    if (cls >= g_class_count) { cls = 0 - 1; }   # out-of-range → classless, not OOB
    store64(s + SS_CLASS, cls);
    store64(s + SS_HP,    _clamp(toml_int(pairs, "hp", PC_HP), 0, 1000000));
    store64(s + SS_MAXHP, _clamp(toml_int(pairs, "maxhp", PC_HP), 1, 1000000));
    # H3 — hp and maxhp were each clamped to an absolute range but never
    # against EACH OTHER, and nothing downstream ever pulls hp back down:
    # classes_upkeep only regenerates while `hp < max`, ability_heal caps on the
    # way up, and player_died assigns hp = maxhp. So a record carrying
    # hp = 1000000 with maxhp = 30 produced a permanently million-HP character.
    #
    # A player owns their signing key (ADR 0004), so re-signing arbitrary values
    # is entirely within their power — this is the 0.9.0 rule again: a signature
    # proves AUTHORSHIP, not field validity. Relational invariants need checking
    # too, not just per-field ranges. Load-side only; no schema change.
    var mh = load64(s + SS_MAXHP);
    if (load64(s + SS_HP) > mh) { store64(s + SS_HP, mh); }
    store64(s + SS_AC,    _clamp(toml_int(pairs, "ac", PC_AC), 0 - 100, 100));
    store64(s + SS_HIT,   _clamp(toml_int(pairs, "hit", PC_HIT), 0 - 100, 1000));
    store64(s + SS_NDICE, _clamp(toml_int(pairs, "ndice", PC_NDICE), 1, 100));
    store64(s + SS_DSIZE, _clamp(toml_int(pairs, "dsize", PC_DSIZE), 1, 1000));
    store64(s + SS_DMOD,  _clamp(toml_int(pairs, "dmod", PC_DMOD), 0 - 1000, 10000));
    store64(s + SS_STR, _clamp(toml_int(pairs, "str", 10), 1, 1000));
    store64(s + SS_DEX, _clamp(toml_int(pairs, "dex", 10), 1, 1000));
    store64(s + SS_CON, _clamp(toml_int(pairs, "con", 10), 1, 1000));
    store64(s + SS_TEC, _clamp(toml_int(pairs, "tec", 10), 1, 1000));
    store64(s + SS_ENERGY,    _clamp(toml_int(pairs, "energy", 0), 0, 1000000));
    store64(s + SS_MAXENERGY, _clamp(toml_int(pairs, "maxenergy", 0), 0, 1000000));
    store64(s + SS_TARGET, 0);

    var roomv = toml_get(pairs, "room");
    var ridx = 0 - 1;
    if (roomv != 0) {
        if (str_len(roomv) > 0) { ridx = room_index_by_id(str_data(roomv), str_len(roomv)); }
    }
    if (ridx < 0) { ridx = world_start_room(); }
    store64(s + SS_ROOM, ridx);

    var invv = toml_get(pairs, "inv");
    if (invv != 0) { _restore_inv(s, str_data(invv), str_len(invv)); }

    g_loaded_last_login = toml_int(pairs, "last_login", 0);   # 0.8.1 greeting
    store64(s + SS_AUTHED, 1);
    store64(s + SS_SAVE_DIRTY, 0);
    audit_keyed(AK_LOGIN_OK, SEV_INFO, "login.ok", nm, nl, clock_now_ms());
    return 1;
}

# 0.8.1 — append a coarse "N <unit>s ago" relative time for `secs` seconds.
fn _plural_s(s, n): i64 {
    if (n != 1) { session_appendtx_cstr(s, "s"); }
    return 0;
}
# Coarse relative time into `s`'s tx: minutes, hours or days, never exact.
# Only the returning-player greeting uses it, so bucket precision is enough
# and sub-minute reconnects read as "moments ago".
fn session_append_ago(s, secs): i64 {
    if (secs < 60)    { session_appendtx_cstr(s, "moments ago"); return 0; }
    if (secs < 3600)  {
        var m = secs / 60;
        session_appendtx_num(s, m); session_appendtx_cstr(s, " minute");
        _plural_s(s, m); session_appendtx_cstr(s, " ago");
        return 0;
    }
    if (secs < 86400) {
        var h = secs / 3600;
        session_appendtx_num(s, h); session_appendtx_cstr(s, " hour");
        _plural_s(s, h); session_appendtx_cstr(s, " ago");
        return 0;
    }
    var d = secs / 86400;
    session_appendtx_num(s, d); session_appendtx_cstr(s, " day"); _plural_s(s, d); session_appendtx_cstr(s, " ago");
    return 0;
}

# === login phase handlers (M6-B/E) =========================================
# Forward-referenced from session.cyr's phase router.

# Prompt a known name for its passphrase. Echo goes off BEFORE the prompt is
# queued so the secret never round-trips to the terminal; login_on_pass owns
# turning it back on. Also the re-prompt on a wrong passphrase.
fn login_begin_pass(s): i64 {
    store64(s + SS_PHASE, PHASE_PASS);
    session_echo_off(s);   # 0.8.1 — don't echo the passphrase
    session_appendtx_cstr(s, "Passphrase: ");
    return 0;
}
# Prompt an unknown name to choose a passphrase. Doubles as the restart point
# for every creation failure (too short/long, confirm mismatch), so it must
# re-assert both the phase and echo-off rather than assume them.
fn login_begin_newpass(s): i64 {
    store64(s + SS_PHASE, PHASE_NEWPASS);
    session_echo_off(s);   # 0.8.1
    session_appendtx_cstr(s, "New operative — choose a passphrase (4-64 chars): ");
    return 0;
}

# Returning player: verify + restore + drop into the recorded room.
fn login_on_pass(s, buf, len): i64 {
    var rc = player_auth_load(s, buf, len);
    if (rc == 1) {
        # H11 (1.6.6) — refuse a second concurrent session for one character,
        # checked AFTER the passphrase proves who they are (so this cannot be
        # used to probe who is online) but BEFORE session_resume_world places
        # them, and before any tick can save the duplicate over the live record.
        if (session_already_online(load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), s) == 1) {
            session_echo_on(s);
            session_appendtx_cstr(s, "\r\nThat character is already connected from another session.\r\n");
            store64(s + SS_QUIT, 1);
            audit_keyed(AK_LOGIN_DUP, SEV_WARNING, "login.dup",
            load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), clock_now_ms());
            return 0;
        }
        store64(s + SS_FAILS, 0);
        store64(s + SS_PHASE, PHASE_CMD);
        session_echo_on(s);   # 0.8.1 — restore echo now the passphrase is in
        session_appendtx_cstr(s, "\r\nThe lock yields. Welcome back to the Under-Grid.\r\n");
        if (g_loaded_last_login > 0) {
            session_appendtx_cstr(s, "Last seen ");
            session_append_ago(s, get_epoch_secs() - g_loaded_last_login);
            session_appendtx_cstr(s, ".\r\n");
        }
        session_resume_world(s);
        session_send_cmd_prompt(s);
        return 0;
    }
    if (rc == 0) {
        # H5 (1.6.2) — bound the attempts. This path used to re-prompt forever,
        # so a burst of wrong passphrases was limited only by how fast the loop
        # could verify them. The dispatch cap already meters the rate; this caps
        # the total, and closes the socket rather than leaving an attacker a free
        # oracle. Hardcoded — ADR 0007 §6 freezes the YD_* knob set for all 1.x.
        var fails = load64(s + SS_FAILS) + 1;
        store64(s + SS_FAILS, fails);
        # G3 (1.6.12) — one entry per session at the cap, not one per attempt.
        # Same reasoning as _confirm_mismatch below: the rate here is the
        # attacker's, each entry is 1640 B of unreclaimable arena, and the
        # flood signal is fully preserved.
        if (fails >= MAX_LOGIN_FAILS) {
            audit_keyed(AK_LOGIN_FAIL, SEV_WARNING, "login.fail",
            load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), clock_now_ms());
            session_appendtx_cstr(s, "\r\nToo many failed attempts. Closing.\r\n");
            store64(s + SS_QUIT, 1);
            return 0;
        }
        session_appendtx_cstr(s, "\r\nThat passphrase is wrong.\r\n");
        login_begin_pass(s);   # re-prompt, echo stays off
        return 0;
    }
    # A good passphrase clears the count — the cap is on CONSECUTIVE failures,
    # so a player who fumbles once and then succeeds is not penalised later.
    session_echo_on(s);
    if (rc == PL_ERR_SCHEMA) {
        # M11-B — intact, correctly signed, just newer than us. Almost always a
        # rolled-back deploy, so say that rather than accusing anyone.
        session_appendtx_cstr(s, "\r\nYour record was written by a newer server than this one.");
        session_appendtx_cstr(s, " No changes have been made to it.\r\n");
    } else {
        session_appendtx_cstr(s, "\r\nYour record is unreadable or has been tampered with.");
        session_appendtx_cstr(s, " An operator must intervene.\r\n");
    }
    store64(s + SS_QUIT, 1);
    return 0;
}

# New player: capture passphrase → derive keypair → ask to confirm.
fn login_on_newpass(s, buf, len): i64 {
    if (len < PASS_MIN) { session_appendtx_cstr(s, "Too short. "); return login_begin_newpass(s); }
    if (len > PASS_MAX) { session_appendtx_cstr(s, "Too long. "); return login_begin_newpass(s); }
    var blk = sess_ident(s);
    random_bytes(blk, SALT_LEN);
    ident_derive(blk, buf, len, blk + IDENT_SK, blk + IDENT_PK);
    store64(s + SS_PHASE, PHASE_CONFIRMPASS);
    session_appendtx_cstr(s, "Confirm passphrase: ");
    return 0;
}

# E3 (1.6.10) — a failed confirm costs a counted attempt, and enough of them
# close the session.
#
# `login_on_newpass` derives a fresh Ed25519 keypair on every in-range line and
# `login_on_confirm` derives again to compare, so one mismatched pair is two
# derivations — measured 2.16 ms of server CPU for 10 bytes of attacker input,
# about 215 us per byte. The cycle was unbounded: no counter, no rate limit, and
# — alone among the failure paths in this file — no audit event either, so a
# flood left no trace at all.
#
# 1.6.2 capped the returning-player path at MAX_LOGIN_FAILS and left the
# structurally identical creation path open, which is the easier of the two to
# reach because it needs no account to exist. SS_FAILS is reused deliberately:
# session_new zeroes it and nothing else touches it before authentication, so
# the two paths share one budget per connection, which is the honest bound —
# an attacker should not get five guesses AND five creations.
#
# This only bounds anything because E1 made SS_QUIT authoritative on the tick
# path; before that, setting it here would have been the same no-op that
# MAX_LOGIN_FAILS was.
fn _confirm_mismatch(s): i64 {
    var fails = load64(s + SS_FAILS) + 1;
    store64(s + SS_FAILS, fails);
    # G3 (1.6.12) — one durable audit entry per session, not one per attempt.
    #
    # Every audit_event costs 1640 bytes of BUMP arena that alloc() can never
    # reclaim (1416 B of it inside libro's filestore_append, which is upstream
    # and CLAUDE.md forbids touching) plus ~360 B appended to a never-rotated
    # data/audit.libro. Measured on the unauthenticated creation path: 5 attempts
    # x 1640 B = 8.2 kB per connection, ~755 kB/s of permanently-lost arena at
    # single-core saturation. E3 bounded the attempts per CONNECTION; it did not
    # bound reconnects, and nothing else did either.
    #
    # The event exists to make a flood VISIBLE, and logging at the cap keeps
    # exactly that: every session that hammers the limit still writes one
    # SEV_WARNING naming it. What is given up is per-attempt granularity on a
    # path whose rate the ATTACKER sets — which is the path where granularity
    # buys the least and costs the most.
    #
    # CORRECTED in 1.7.1. This paragraph used to end: "The authenticated `passwd`
    # path keeps its per-attempt entry, because a real player sets that rate."
    # That premise was false. _chpass_mismatch caps the attempts inside ONE re-key
    # and then clears SS_FAILS and returns to the prompt, so `passwd` could be
    # re-entered immediately and forever; and registration is open, so the
    # "authenticated" account costs an attacker four lines. It was a second
    # unbounded lever, not a player-paced one. 1.7.1 bounds the rate
    # (CHPASS_MIN_INTERVAL_MS) and routes every site through the rollup window, so
    # the argument no longer rests on who is typing.
    #
    # Also corrected: logging "at the cap" was never one entry per session either.
    # SS_FAILS keeps incrementing past MAX_LOGIN_FAILS, so `fails >= MAX` stays
    # true and every further line dispatched to a condemned session audits again.
    # Harmless now that the window coalesces it; recorded so nobody re-derives it
    # as a fresh bug.
    # 1.7.6 — audit EVERY attempt again, reversing G3 (1.6.12).
    #
    # G3 moved this to fire once at the cap because each entry cost 1944
    # permanently-unreclaimable bytes and the attacker set the rate. The rollup
    # window (1.7.1) removed that: the first occurrence of a key in a window is
    # written and every later one increments an i64 and allocates NOTHING. So
    # per-attempt granularity now costs the SAME arena as per-session and reports
    # a truer number — the rollup's count is the real attempt total rather than a
    # count of sessions that happened to hit the cap.
    #
    # This is the trade G3 made under duress being taken back once the constraint
    # that forced it was gone, rather than left in place because the code looked
    # deliberate.
    audit_keyed(AK_CREATE_FAIL, SEV_WARNING, "create.fail",
    load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), clock_now_ms());
    if (fails >= MAX_LOGIN_FAILS) {
        session_echo_on(s);
        session_appendtx_cstr(s, "\r\nToo many failed attempts. Closing.\r\n");
        store64(s + SS_QUIT, 1);
        return 0;
    }
    session_appendtx_cstr(s, "\r\nThose don't match. Let's begin again.\r\n");
    return login_begin_newpass(s);
}

# The name was claimed while this session was mid-creation (E4). Refuse rather
# than overwrite: the other session's identity is already sealed or on disk, and
# writing ours would destroy a character that is not ours.
fn _create_taken(s): i64 {
    session_echo_on(s);
    session_appendtx_cstr(s, "\r\nThat name was just taken. Please reconnect and choose another.\r\n");
    store64(s + SS_QUIT, 1);
    audit_keyed(AK_CREATE_DUP, SEV_WARNING, "create.dup",
    load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), clock_now_ms());
    return 0;
}

# Second half of creation: re-derive from the confirm line and require the
# same public key — the passphrase is never stored, so equality of derived
# pubkeys IS the comparison. On match the identity is sealed (created stamp,
# SS_AUTHED) and class selection follows; classes.cyr writes the first record.
fn login_on_confirm(s, buf, len): i64 {
    var blk = sess_ident(s);
    # A valid passphrase is <= PASS_MAX (the new-pass step enforced it), so an
    # over-long confirm cannot match — treat as a mismatch (ident_derive also
    # clamps, so this is purely for clean behaviour).
    if (len > PASS_MAX) {
        return _confirm_mismatch(s);
    }
    var pk2 = g_persist_dec + 128;
    var sk2 = g_persist_dec + 160;
    ident_derive(blk, buf, len, sk2, pk2);
    if (_bytes_eq(pk2, blk + IDENT_PK, PK_LEN) == 0) {
        return _confirm_mismatch(s);
    }
    # E4 (1.6.10) — the same character must not be created twice concurrently.
    #
    # H11 (1.6.6) refused a second session for an existing character, but wired
    # the check only into login_on_pass — the RETURNING-player path. Creation had
    # none, and the window is not a race: it is the whole passphrase + confirm +
    # class-prompt sequence, bounded only by the 5-minute idle reap. Two sessions
    # that both type the same unused name each forge their own salt and keypair,
    # each set SS_AUTHED, and each write data/players/<name>.cyml — with DIFFERENT
    # pubkeys, so the last writer's passphrase becomes the only one that opens the
    # account and the first player's character is silently gone.
    #
    # It has to sit HERE and not at the name prompt: session_already_online
    # requires SS_AUTHED on the other session, and at the name prompt neither is
    # authed yet. player_exists is re-tested too, for a record that appeared
    # during the window.
    if (session_already_online(load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), s) == 1) {
        return _create_taken(s);
    }
    if (player_exists(load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN)) == 1) {
        return _create_taken(s);
    }
    # 1.7.2 — the account cap, if the operator set one.
    #
    # OFF by default (`max_accounts = 0` means unlimited), because how many
    # characters a world should hold is an operator's decision and not this
    # server's. Set it in `data/server.cyml` or with `YD_MAX_ACCOUNTS`.
    #
    # Checked HERE, at the commit point, and not at the name prompt: this is the
    # line after which a record exists, and it is the same place the duplicate and
    # already-online checks sit for the same reason. Refusing earlier would tell a
    # prospective player the world is full before they had even chosen a
    # passphrase, and refusing later would leave a record behind.
    #
    # It is a bound on ACCOUNTS, not on attempts — an attacker who cannot create
    # can still connect, so this does not replace the login and passwd rate limits.
    # What it bounds is permanent disk: every account leaves a file forever.
    if (accounts_full(g_account_count, g_max_accounts) == 1) {
        session_echo_on(s);
        session_appendtx_cstr(s, "\r\nThis world is not accepting new characters.");
        session_appendtx_cstr(s, " Please contact the operator.\r\n");
        store64(s + SS_QUIT, 1);
        audit_keyed(AK_ACCOUNTS_FULL, SEV_WARNING, "accounts.full",
        load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), clock_now_ms());
        return 0;
    }
    g_account_count = g_account_count + 1;
    store64(s + SS_FAILS, 0);   # sealed — the creation attempt count resets
    store64(blk + IDENT_CREATED, get_epoch_secs());
    store64(s + SS_AUTHED, 1);
    session_echo_on(s);   # 0.8.1 — passphrase set; restore echo
    audit_keyed(AK_CHAR_CREATE, SEV_INFO, "char.create",
    load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), clock_now_ms());
    session_appendtx_cstr(s, "\r\nIdentity sealed into the grid.\r\n");
    store64(s + SS_PHASE, PHASE_CLASS);
    class_send_prompt(s);
    return 0;
}

# === 0.8.1 — passwd: change passphrase from inside the world. =============
# Re-keys the player: a fresh random salt + the new passphrase derive a new
# Ed25519 identity, the record is re-signed and saved. Two-step (new +
# confirm) with echo suppressed, mirroring character creation but returning
# to the command prompt. Phases PHASE_CHPASS_NEW / PHASE_CHPASS_CONFIRM.

# Entry point for the in-world `passwd` verb. An unauthed session owns no
# record and no salt, so re-keying it would be meaningless — refuse rather
# than mint an identity outside the login flow.
fn passwd_begin(s): i64 {
    if (load64(s + SS_AUTHED) == 0) {
        session_appendtx_cstr(s, "You have no persistent record to re-key.\r\n");
        return 0;
    }
    # 1.7.1 — bound the RATE, not just the attempts per invocation.
    #
    # G2 (1.6.12) capped the attempts inside one re-key at MAX_LOGIN_FAILS, and on
    # hitting that cap it clears SS_FAILS and returns to the command prompt — so
    # `passwd` could be re-entered immediately, forever. Its own comment says the
    # cap "bounds the work per invocation", which was true and was not a bound on
    # anything an attacker cares about: PHASE_CHPASS_CONFIRM is the dearest line in
    # the game reachable without a victim's credential (a derive AND a sign, 2461
    # us measured), and registration is open.
    #
    # This is the FOURTH appearance of the shape "a per-item cap is not a bound on
    # how many items there are" — after H5 (1.6.2) on the login path, E3 (1.6.10)
    # on creation, and G2 itself here. `grep -n MAX_LOGIN_FAILS src/` was always
    # the whole answer; what it does not show is where the counter gets RESET.
    #
    # Refused rather than queued: a re-key is interactive, and silently deferring
    # one would leave the player at a prompt that does nothing.
    if (chpass_rate_limited(s, clock_now_ms()) == 1) {
        session_appendtx_cstr(s, "You changed your passphrase very recently. Try again shortly.\r\n");
        return 0;
    }
    store64(s + SS_LAST_CHPASS_MS, clock_now_ms());
    store64(s + SS_PHASE, PHASE_CHPASS_NEW);
    session_echo_off(s);
    session_appendtx_cstr(s, "New passphrase (4-64 chars): ");
    return 0;
}

# Lazily allocate this session's `passwd` candidate block, zeroed (H8, 1.6.4).
fn sess_cand(s): i64 {
    var c = load64(s + SS_IDENT_CAND);
    if (c == 0) {
        c = fl_alloc(CAND_LEN);
        memset(c, 0, CAND_LEN);
        store64(s + SS_IDENT_CAND, c);
    }
    return c;
}

# Wipe and release the candidate. Called on commit and on every rewind — a
# half-finished re-key must not leave a derived secret key sitting in a reusable
# freelist block.
fn sess_cand_clear(s): i64 {
    var c = load64(s + SS_IDENT_CAND);
    if (c == 0) { return 0; }
    memset(c, 0, CAND_LEN);
    fl_free(c);
    store64(s + SS_IDENT_CAND, 0);
    return 0;
}

# Stash the candidate identity in a PER-SESSION block (not SS_IDENT — that still
# holds the live key until confirm commits). The block is salt|pk|sk, 112 bytes
# of the 120-byte ident layout.
#
# H8: this used to be g_persist_dec, a global, held across a network round trip.
# player_auth_load decodes salt[0,16) / pubkey[16,48) / sig[48,112) into exactly
# those bytes, and _build_record signs into [0,64) — so one interleaved save or
# login between the two prompts refused the correct passphrase. On a passphrase
# collision it was worse than a refusal: _bytes_eq passed against clobbered
# bytes and 64 SIGNATURE bytes were installed as the secret key, producing a
# record that cannot verify under its own pubkey — permanent character loss plus
# a false SEV_SECURITY "load.tamper" entry on the next login.
fn chpass_on_new(s, buf, len): i64 {
    if (len < PASS_MIN) { session_appendtx_cstr(s, "Too short. New passphrase (4-64 chars): "); return 0; }
    if (len > PASS_MAX) { session_appendtx_cstr(s, "Too long. New passphrase (4-64 chars): "); return 0; }
    var cand = sess_cand(s);             # candidate salt|pk|sk (per session)
    random_bytes(cand, SALT_LEN);
    ident_derive(cand, buf, len, cand + IDENT_SK, cand + IDENT_PK);
    store64(s + SS_PHASE, PHASE_CHPASS_CONFIRM);
    session_appendtx_cstr(s, "Confirm new passphrase: ");
    return 0;
}

# G2 (1.6.12) — a failed re-key costs a counted attempt, and enough abandon it.
#
# The THIRD instance of one defect. `chpass_on_new` derives a fresh Ed25519
# keypair on every in-range line and `chpass_on_confirm` derives again to
# compare, rewinding to PHASE_CHPASS_NEW on mismatch — so 100% of attacker lines
# cost a full derivation and the cycle never terminates. Measured: 1000 lines =
# 1103 ms of single-threaded loop time, and afterwards SS_FAILS == 0, SS_QUIT ==
# 0, still cycling.
#
# 1.6.2 capped the login path. E3 (1.6.10) capped the creation path and its
# comment called that path "structurally identical" to the login one — and this
# path is structurally identical to BOTH and was not looked at. The lesson is in
# the CHANGELOG rather than here, but the shape is: fixing an instance is not
# fixing the class, and `grep -n ident_derive src/` was always the whole answer.
#
# Unlike creation, this does not close the socket. The session is an
# authenticated player who may simply be fumbling, so the re-key is abandoned
# and they are returned to the command prompt with their existing passphrase
# untouched — they can type `passwd` again. That still bounds the work per
# invocation, which is the point, and it costs a legitimate user nothing.
fn _chpass_mismatch(s): i64 {
    sess_cand_clear(s);
    var fails = load64(s + SS_FAILS) + 1;
    store64(s + SS_FAILS, fails);
    audit_keyed(AK_PASSWD_FAIL, SEV_WARNING, "passwd.fail",
    load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), clock_now_ms());
    if (fails >= MAX_LOGIN_FAILS) {
        store64(s + SS_FAILS, 0);
        store64(s + SS_PHASE, PHASE_CMD);
        session_echo_on(s);
        session_appendtx_cstr(s, "\r\nToo many failed attempts — re-key abandoned.");
        session_appendtx_cstr(s, " Your passphrase is UNCHANGED.\r\n");
        session_send_cmd_prompt(s);
        return 0;
    }
    store64(s + SS_PHASE, PHASE_CHPASS_NEW);
    session_appendtx_cstr(s, "\r\nThose don't match. New passphrase (4-64 chars): ");
    return 0;
}

# Commit half of the re-key. A mismatch rewinds to PHASE_CHPASS_NEW with the
# live key untouched. On match only 112 bytes (salt|pk|sk) are copied over the
# ident block, deliberately sparing IDENT_CREATED, then player_save re-signs
# the record under the new key — the old signature no longer verifies.
fn chpass_on_confirm(s, buf, len): i64 {
    var cand = sess_cand(s);
    var pk2 = cand + CAND_PK2;
    var sk2 = cand + CAND_SK2;
    if (len > PASS_MAX) {   # over-long → cannot match the (<=PASS_MAX) candidate
        return _chpass_mismatch(s);
    }
    ident_derive(cand, buf, len, sk2, pk2);
    if (_bytes_eq(pk2, cand + IDENT_PK, PK_LEN) == 0) {
        return _chpass_mismatch(s);
    }
    # Commit: copy candidate salt+pk+sk into the live ident block (preserve
    # the original creation timestamp), re-sign + save under the new key.
    var blk = sess_ident(s);
    # H10 (1.6.5) — commit ONLY if the record actually persisted.
    #
    # This used to discard player_save's return, then write a SEV_INFO
    # "passwd.change" entry and tell the player "your record is re-keyed" —
    # while the on-disk record still held the OLD pubkey. The next login would
    # reject the new passphrase and the retired one would still work. Reachable
    # from any I/O failure (ENOSPC, EIO, a failed rename), not just the
    # over-cap-inventory route M11-D added.
    #
    # The rollback matters as much as the check: the live ident block has
    # already been overwritten by the memcpy above, so on failure it has to go
    # back, or the session keeps a key the record does not have.
    var keep[120];
    memcpy(&keep, blk, IDENT_LEN);
    memcpy(blk, cand, IDENT_SK + SK_LEN);
    sess_cand_clear(s);                     # H8 — wipe the derived key, then free
    if (player_save(s) != 1) {
        memcpy(blk, &keep, IDENT_LEN);      # roll the identity back
        store64(s + SS_PHASE, PHASE_CMD);
        session_echo_on(s);
        # 1.7.1 — renamed from "passwd.fail". This is H10's ROLLBACK (the re-key
        # derived fine and the save failed, so the identity was restored), not a
        # wrong passphrase. Sharing one action string with _chpass_mismatch was
        # merely imprecise before; with per-key rollup counting it would report a
        # disk failure and a mistyped passphrase as one number, which is actively
        # misleading in the log an operator reaches for first.
        audit_keyed(AK_PASSWD_ROLLBACK, SEV_WARNING, "passwd.rollback",
        load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), clock_now_ms());
        session_appendtx_cstr(s, "\r\nThe re-key could not be saved. Your passphrase is UNCHANGED.\r\n");
        session_send_cmd_prompt(s);
        return 0;
    }
    store64(s + SS_FAILS, 0);   # G2 — a successful re-key clears the count
    store64(s + SS_PHASE, PHASE_CMD);
    session_echo_on(s);
    audit_keyed(AK_PASSWD_CHANGE, SEV_INFO, "passwd.change",
    load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), clock_now_ms());
    session_appendtx_cstr(s, "\r\nPassphrase changed. Your record is re-keyed.\r\n");
    session_send_cmd_prompt(s);
    return 0;
}
