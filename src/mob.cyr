# mob.cyr — M4 mobs: templates + live instances + room placement.
#
# Mob templates load from a CYML `<zone>.mobs.cyml` file (ADR 0005,
# `kind = "mob"` entries), immutable for the run. A mob *instance* is a
# live spawn of a template in a room, carrying mutable combat state
# (current HP, who it is fighting). Rooms hold their occupants on an
# intrusive list threaded through MI_NEXT (head in the Room struct's
# RM_MOB_HEAD, world.cyr).
#
# Stats are era-standard tabletop ([ADR 0001](../docs/adr/0001-tick-based-combat-over-cooldowns.md)):
# AC (lower = harder to hit), a flat to-hit bonus, and a damage dice
# profile (NdM+K). Combat math consumes them in combat.cyr.

# === Mob template layout (offsets in bytes) ===
enum MT {
    MT_ID      = 0;      # inline id bytes (MT_ID_CAP)
    MT_ID_LEN  = 32;
    MT_NAME    = 40;     # inline display name ("a rust-drone", MT_NAME_CAP)
    MT_NAME_LEN = 104;
    MT_KW      = 112;    # inline keywords, NUL-terminated (MT_KW_CAP)
    MT_KW_LEN  = 176;
    MT_LEVEL   = 184;
    MT_HP      = 192;    # max HP
    MT_AC      = 200;    # armour class (lower = better defence)
    MT_HIT     = 208;    # flat to-hit bonus
    MT_NDICE   = 216;    # damage: number of dice
    MT_DSIZE   = 224;    #         die size
    MT_DMOD    = 232;    #         flat modifier
    MT_DESC_PTR = 240;   # description prose (zero-copy into CYML buffer)
    MT_DESC_LEN = 248;
    MT_LOOT    = 256;    # str: space-separated object ids dropped on death
    MT_SIZE    = 264;
}
enum MtCap {
    MT_ID_CAP   = 32;
    MT_NAME_CAP = 64;
    MT_KW_CAP   = 64;
}

# === Mob instance layout ===
enum MI {
    MI_TPL    = 0;       # ptr to the template
    MI_HP     = 8;       # current HP
    MI_ROOM   = 16;      # room index it occupies
    MI_TARGET = 24;      # session it is fighting (0 = none)
    MI_NEXT   = 32;      # intrusive room-occupant list
    MI_STUN   = 40;      # ticks it is stunned (skips its attack) — M5
    # M13 — the actor tick.
    MI_HOME   = 48;      # room it was authored into; MI_ROOM is where it is NOW
    MI_ACTED  = 56;      # g_tick_count of its last turn (re-entry guard)
    MI_SIZE   = 64;
}

var g_mob_tpls      = 0;   # contiguous block of MT_SIZE templates
var g_mob_tpl_count = 0;

# Live-instance counters (M12-D). Incremented where an instance is minted,
# decremented where it is freed, so a soak can assert the world returns to a
# bounded steady state instead of climbing forever.
#
# These exist because there is no other way to see it: lib/freelist.cyr exposes
# only fl_init / fl_alloc / fl_free / fl_calloc — no occupancy or arena
# accessor — and CLAUDE.md forbids modifying lib/. Cheap enough to leave in the
# production build (two adds per spawn), and `@stats` is the natural place to
# surface them once the operator channel lands at M18.
var g_mob_live = 0;
var g_obj_live = 0;

# === Template accessors ===
fn mt_at(i): i64          { return g_mob_tpls + i * MT_SIZE; }
# Inline name bytes. The loader caps at CAP-1 into zeroed space, so it is also a cstr.
fn mt_name_ptr(t): i64    { return t + MT_NAME; }
# Bytes stored, not authored: a name over MT_NAME_CAP-1 was truncated at load time.
fn mt_name_len(t): i64    { return load64(t + MT_NAME_LEN); }
# Keyword blob as a cstr — kw_matches scans to the NUL, no length travels with it.
fn mt_kw_ptr(t): i64      { return t + MT_KW; }         # NUL-terminated
# Authored level, default 1. Flavour only so far — combat reads ac/hit/dice, not this.
fn mt_level(t): i64       { return load64(t + MT_LEVEL); }
# Max HP. mob_spawn seeds instance HP from it; mob_condition scales its prose by it.
fn mt_hp(t): i64          { return load64(t + MT_HP); }
# Armour class the player's to-hit roll is checked against — lower is harder to hit.
fn mt_ac(t): i64          { return load64(t + MT_AC); }
# Flat to-hit bonus on the mob's own swing, rolled against the player's effective AC.
fn mt_hit(t): i64         { return load64(t + MT_HIT); }
# Dice count of the NdM+K profile; parse_dice falls back to 1d4+0 on a malformed value.
fn mt_ndice(t): i64       { return load64(t + MT_NDICE); }
# Die size of the damage profile — fed to roll() together with ndice and dmod.
fn mt_dsize(t): i64       { return load64(t + MT_DSIZE); }
# Flat +K of the damage profile, 0 when the authored value omits it.
fn mt_dmod(t): i64        { return load64(t + MT_DMOD); }
# Prose body, zero-copy into the CYML file buffer — not NUL-terminated, pair with len.
fn mt_desc_ptr(t): i64    { return load64(t + MT_DESC_PTR); }
# Body length. 0 for a bodyless entry, which examine renders as name plus condition only.
fn mt_desc_len(t): i64    { return load64(t + MT_DESC_LEN); }
# str of space-separated object ids, or 0. corpse_of resolves them into the corpse.
fn mt_loot(t): i64        { return load64(t + MT_LOOT); }   # str or 0

# === Instance accessors ===
fn mi_tpl(m): i64         { return load64(m + MI_TPL); }
# Live HP. Death is hp <= 0, checked after every swing — there is no alive flag.
fn mi_hp(m): i64          { return load64(m + MI_HP); }
# Post-spawn HP mutator — mob_spawn seeds MI_HP directly. Damage can drive it negative,
# so callers test <= 0, never == 0.
fn mi_set_hp(m, v): i64   { store64(m + MI_HP, v); return 0; }
# Room index. combat_round compares it to the player's to spot a target that left.
fn mi_room(m): i64        { return load64(m + MI_ROOM); }
# Session it fights, 0 = idle. Bookkeeping — the tick drives combat from the session.
fn mi_target(m): i64      { return load64(m + MI_TARGET); }
# Set by cmd_kill so the mob is marked as fighting back; cleared by combat_disengage.
fn mi_set_target(m, v): i64 { store64(m + MI_TARGET, v); return 0; }
# Next occupant in the room's intrusive list; the head lives in the Room struct.
fn mi_next(m): i64        { return load64(m + MI_NEXT); }
# Remaining stunned ticks (bash / EMP). Non-zero means the mob forfeits its swing.
fn mi_stun(m): i64        { return load64(m + MI_STUN); }
# Abilities set the tick count; combat_round spends one as it burns the mob's turn.
fn mi_set_stun(m, v): i64 { store64(m + MI_STUN, v); return 0; }
# Instances carry no name of their own — hop to the template; cstr-safe, see mt_name_ptr.
fn mi_name_ptr(m): i64    { return mt_name_ptr(mi_tpl(m)); }
# Template name length, for the (ptr, len) appends in room listings and combat prose.
fn mi_name_len(m): i64    { return mt_name_len(mi_tpl(m)); }

# Read an int field from a TOML pairs vec, or `def` if absent / non-numeric.
fn toml_int(pairs, key, def): i64 {
    var v = toml_get(pairs, key);
    if (v == 0) { return def; }
    var n = parse_uint(str_data(v), str_len(v));
    if (n < 0) { return def; }
    return n;
}

# Parse a dice profile "NdM" or "NdM+K" from a str into out_n / out_d /
# out_mod. Defaults to 1d4+0 on a malformed value.
fn parse_dice(s, out_n, out_d, out_mod): i64 {
    store64(out_n, 1);
    store64(out_d, 4);
    store64(out_mod, 0);
    if (s == 0) { return 0; }
    var p = str_data(s);
    var len = str_len(s);
    var i = 0;
    # leading dice count
    var nd = 0; var seen = 0;
    while (i < len) {
        var c = load8(p + i) & 0xFF;
        if (c < 48) { break; }
        if (c > 57) { break; }
        nd = nd * 10 + (c - 48); seen = 1; i = i + 1;
    }
    if (seen == 0) { return 0; }
    if (i >= len) { return 0; }
    if ((load8(p + i) & 0xFF) != 100) { return 0; }   # 'd'
    i = i + 1;
    var ds = 0; seen = 0;
    while (i < len) {
        var c = load8(p + i) & 0xFF;
        if (c < 48) { break; }
        if (c > 57) { break; }
        ds = ds * 10 + (c - 48); seen = 1; i = i + 1;
    }
    if (seen == 0) { return 0; }
    store64(out_n, nd);
    store64(out_d, ds);
    # optional +K
    if (i < len) {
        if ((load8(p + i) & 0xFF) == 43) {   # '+'
            i = i + 1;
            var k = 0;
            while (i < len) {
                var c = load8(p + i) & 0xFF;
                if (c < 48) { break; }
                if (c > 57) { break; }
                k = k * 10 + (c - 48); i = i + 1;
            }
            store64(out_mod, k);
        }
    }
    return 0;
}

# === world_load_mobs — parse a `<zone>.mobs.cyml` into templates. ===
# Returns the template count (>= 0), or a negative WL_ERR_* code.
fn world_load_mobs(path): i64 {
    var r = cyml_parse_file_r(path);
    if (is_ok(r) == 0) { return WL_ERR_IO; }
    var doc = result_unwrap(r);
    var n = cyml_doc_entry_count(doc);
    if (n <= 0)          { return WL_ERR_EMPTY; }
    if (n > MAX_ENTRIES) { return WL_ERR_OVERCAP; }

    # H9 (1.6.5) — build into the global, but publish the COUNT only on the
    # success return below. Every `return WL_ERR_*` in the parse loop sits after
    # this point, so setting the count here meant a rejected file left a live,
    # partly-filled table behind: cmd_serve printed "no zone loaded" / "no mobs
    # loaded" and every `world_room_count() == 0` guard in session.cyr,
    # combat.cyr, item.cyr and server.cyr was defeated at the same moment. A
    # player could log in, walk into the prefix that did parse, and be stranded
    # in a room with no exits — with the operator told the load had failed.
    # Zeroing first is what makes cmd_serve's documented non-fatal behaviour
    # ("the server still runs, with the verbs answering their no-zone
    # placeholders") actually true.
    g_mob_tpls = alloc(n * MT_SIZE);
    memset(g_mob_tpls, 0, n * MT_SIZE);
    g_mob_tpl_count = 0;   # published on success only

    var i = 0;
    while (i < n) {
        var e = cyml_doc_entry(doc, i);
        var hs = str_new(cyml_entry_header(e), cyml_entry_header_len(e));
        var secs = toml_parse(hs);
        if (vec_len(secs) == 0) { return WL_ERR_NOID; }
        var pairs = toml_section_pairs(vec_get(secs, 0));

        var kind = toml_get(pairs, "kind");
        if (kind == 0) { return WL_ERR_KIND; }
        if (str_eq_cstr(kind, "mob") == 0) { return WL_ERR_KIND; }

        var t = mt_at(i);
        var id = toml_get(pairs, "id");
        if (id == 0) { return WL_ERR_NOID; }
        store64(t + MT_ID_LEN, copy_str_capped(t + MT_ID, MT_ID_CAP, id));

        var name = toml_get(pairs, "name");
        # cap at CAP-1 so the memset-zeroed tail leaves a NUL — mob names
        # are used as cstrs in combat / room prose.
        if (name != 0) { store64(t + MT_NAME_LEN, copy_str_capped(t + MT_NAME, MT_NAME_CAP - 1, name)); }

        var kw = toml_get(pairs, "keywords");
        if (kw != 0) {
            # cap at CAP-1 so the memset-zeroed tail leaves a NUL terminator.
            store64(t + MT_KW_LEN, copy_str_capped(t + MT_KW, MT_KW_CAP - 1, kw));
        }

        store64(t + MT_LEVEL, toml_int(pairs, "level", 1));
        store64(t + MT_HP,    toml_int(pairs, "hp", 10));
        store64(t + MT_AC,    toml_int(pairs, "ac", 10));
        store64(t + MT_HIT,   toml_int(pairs, "hit", 0));

        var nd[8]; var dd[8]; var dm[8];
        parse_dice(toml_get(pairs, "damage"), &nd, &dd, &dm);
        store64(t + MT_NDICE, load64(&nd));
        store64(t + MT_DSIZE, load64(&dd));
        store64(t + MT_DMOD,  load64(&dm));

        store64(t + MT_DESC_PTR, cyml_entry_body(e));
        store64(t + MT_DESC_LEN, cyml_entry_body_len(e));
        store64(t + MT_LOOT, toml_get(pairs, "loot"));   # str or 0
        i = i + 1;
    }
    g_mob_tpl_count = n;   # H9 — publish only now that every entry parsed
    return n;
}

# Qualitative health of a mob instance, from its HP fraction (0.6.1).
# Lets a player read the state of a fight without exposing hidden numbers.
fn mob_condition(m): i64 {
    var max = mt_hp(mi_tpl(m));
    if (max <= 0) { return "unhurt"; }
    var hp = mi_hp(m);
    if (hp >= max) { return "unhurt"; }
    var pct = hp * 100 / max;
    if (pct >= 75) { return "lightly wounded"; }
    if (pct >= 50) { return "wounded"; }
    if (pct >= 25) { return "badly wounded"; }
    return "near death";
}

# Find a mob template by id, or 0.
fn mob_tpl_by_id(buf, len): i64 {
    var i = 0;
    while (i < g_mob_tpl_count) {
        var t = mt_at(i);
        if (load64(t + MT_ID_LEN) == len) {
            var a = t + MT_ID;
            var j = 0;
            var same = 1;
            while (j < len) {
                if ((load8(a + j) & 0xFF) != (load8(buf + j) & 0xFF)) { same = 0; j = len; }
                j = j + 1;
            }
            if (same == 1) { return t; }
        }
        i = i + 1;
    }
    return 0;
}

# === mob_spawn — create a live instance of `tpl` in room `room_idx`. ===
fn mob_spawn(tpl, room_idx): i64 {
    # M12-B — freelist, not the bump allocator: alloc() has no free(), so every
    # instance minted here used to leak for the process lifetime. fl_alloc
    # REUSES freed blocks and does not zero them, so memset first — the bump
    # allocator handed out fresh (zero) pages and this code leaned on that.
    var m = fl_alloc(MI_SIZE);
    memset(m, 0, MI_SIZE);
    g_mob_live = g_mob_live + 1;   # M12-D
    store64(m + MI_TPL, tpl);
    store64(m + MI_HP, mt_hp(tpl));
    store64(m + MI_ROOM, room_idx);
    store64(m + MI_HOME, room_idx);   # M13 — wander changes MI_ROOM, never this
    store64(m + MI_ACTED, 0);
    store64(m + MI_TARGET, 0);
    store64(m + MI_STUN, 0);
    # push onto the room's mob list
    var r = room_at(room_idx);
    store64(m + MI_NEXT, room_mob_head(r));
    room_set_mob_head(r, m);
    return m;
}

# Return a mob instance to the freelist (M12-B). Only mob_remove calls this,
# and only after the instance is off the room list AND every session reference
# has been dropped by sessions_forget_mob — see the note there for why the
# ordering is not negotiable.
fn _mob_free(m): i64 {
    g_mob_live = g_mob_live - 1;
    fl_free(m);
    return 0;
}

# Take a mob off its room's occupant list WITHOUT freeing it. Split out at M13
# because wander needs to relink an instance into a different room — the same
# unlink, but the instance lives on. Callers that are retiring the mob want
# mob_remove instead.
fn mob_unlink(m): i64 {
    var r = room_at(mi_room(m));
    var head = room_mob_head(r);
    if (head == m) { room_set_mob_head(r, mi_next(m)); store64(m + MI_NEXT, 0); return 0; }
    var prev = head;
    while (prev != 0) {
        if (mi_next(prev) == m) {
            store64(prev + MI_NEXT, mi_next(m));
            store64(m + MI_NEXT, 0);
            return 0;
        }
        prev = mi_next(prev);
    }
    return 0;
}

# Unlink a mob instance from its room's list, then free it (on death /
# despawn). The caller MUST have cleared every SS_TARGET pointing at `m` first.
fn mob_remove(m): i64 {
    mob_unlink(m);
    _mob_free(m);
    return 0;
}

# Find a mob in `room_idx` whose keywords the typed noun prefixes, or 0.
fn mob_in_room_by_kw(room_idx, noun_ptr, noun_len): i64 {
    if (room_idx < 0) { return 0; }
    var m = room_mob_head(room_at(room_idx));
    while (m != 0) {
        if (kw_matches(noun_ptr, noun_len, mt_kw_ptr(mi_tpl(m))) == 1) { return m; }
        m = mi_next(m);
    }
    return 0;
}

# === world_spawn_all — populate every room from its `mobs` spawn list. ===
# Splits each room's RM_MOBSPAWN string on spaces; each token is a mob
# template id, spawned once. Unknown ids are skipped (logged by caller).
fn world_spawn_all(): i64 {
    var spawned = 0;
    var ri = 0;
    while (ri < g_room_count) {
        var r = room_at(ri);
        var s = room_mobspawn(r);
        if (s != 0) {
            var p = str_data(s);
            var len = str_len(s);
            var i = 0;
            while (i < len) {
                # skip spaces
                var c = load8(p + i) & 0xFF;
                if (c == 32) { i = i + 1; continue; }
                # token [start, i)
                var start = i;
                while (i < len) {
                    if ((load8(p + i) & 0xFF) == 32) { break; }
                    i = i + 1;
                }
                var tpl = mob_tpl_by_id(p + start, i - start);
                if (tpl != 0) { mob_spawn(tpl, ri); spawned = spawned + 1; }
            }
        }
        ri = ri + 1;
    }
    return spawned;
}

# === M7-C — mob respawn (top-up to the authored multiset) =================
# A reset restores each room to its authored mob population WITHOUT
# duplicating mobs still alive: for template T authored k times in a room,
# spawn (k - currently-alive-of-T) fresh instances. Each token is acted on
# only at its first occurrence so duplicate tokens ("scavver scavver")
# resolve to a count, not k separate spawns. Spawned mobs are full-HP at
# their authored room (mob_spawn).

# Living instances of `tpl` currently in room `ri`.
# How many live instances of `tpl` belong to room `ri` — counted by MI_HOME,
# across the whole world, NOT by who is standing in ri right now.
#
# M13: once mobs wander, current-room counting breaks the zone reset. A mob that
# walked from its authored room to the next one leaves a deficit behind it, so
# every reset would spawn a replacement and the pair would never be reconciled —
# mob population climbing by one per reset, forever. Home is the authored fact;
# MI_ROOM is just where it happens to be standing.
fn _mob_alive_count(ri, tpl): i64 {
    var n = 0;
    var r = 0;
    while (r < g_room_count) {
        var m = room_mob_head(room_at(r));
        while (m != 0) {
            if (mi_tpl(m) == tpl) {
                if (load64(m + MI_HOME) == ri) { n = n + 1; }
            }
            m = mi_next(m);
        }
        r = r + 1;
    }
    return n;
}

# How many tokens in spawn string [p,len) resolve to `tpl`.
fn _spawn_count_of(p, len, tpl): i64 {
    var n = 0;
    var i = 0;
    while (i < len) {
        if ((load8(p + i) & 0xFF) == 32) { i = i + 1; continue; }
        var st = i;
        while (i < len) { if ((load8(p + i) & 0xFF) == 32) { break; } i = i + 1; }
        if (mob_tpl_by_id(p + st, i - st) == tpl) { n = n + 1; }
    }
    return n;
}

# Is the token at byte offset `start` the FIRST token resolving to `tpl`?
fn _spawn_is_first(p, len, start, tpl): i64 {
    var i = 0;
    while (i < len) {
        if ((load8(p + i) & 0xFF) == 32) { i = i + 1; continue; }
        var st = i;
        while (i < len) { if ((load8(p + i) & 0xFF) == 32) { break; } i = i + 1; }
        if (mob_tpl_by_id(p + st, i - st) == tpl) {
            if (st == start) { return 1; }
            return 0;
        }
    }
    return 0;
}

# Top one room up to its authored mob population. Returns mobs spawned.
fn zone_reset_room_mobs(ri): i64 {
    var s = room_mobspawn(room_at(ri));
    if (s == 0) { return 0; }
    var p = str_data(s);
    var len = str_len(s);
    var spawned = 0;
    var i = 0;
    while (i < len) {
        if ((load8(p + i) & 0xFF) == 32) { i = i + 1; continue; }
        var start = i;
        while (i < len) { if ((load8(p + i) & 0xFF) == 32) { break; } i = i + 1; }
        var tpl = mob_tpl_by_id(p + start, i - start);
        if (tpl != 0) {
            if (_spawn_is_first(p, len, start, tpl) == 1) {
                var deficit = _spawn_count_of(p, len, tpl) - _mob_alive_count(ri, tpl);
                while (deficit > 0) { mob_spawn(tpl, ri); spawned = spawned + 1; deficit = deficit - 1; }
            }
        }
    }
    return spawned;
}

# === M13 — the actor tick: mobs get a turn. ===
#
# Until 1.5.0 a mob was furniture: it stood in its authored room forever and did
# nothing until a player typed `kill`. It now gets one turn per server tick —
# wander, assist a room-mate, or break off at low health.
#
# Everything here is paid out of the 50 ms p99 drift budget (ADR 0001) on a
# single-threaded loop, so the sweep is O(rooms + living mobs) with no inner
# scan: one pass over the room list, one pass over each room's occupants.
#
# Rates are per-tick probabilities against a 2.5 s cadence: WANDER_CHANCE 1-in-20
# is roughly one move per 50 s of real time, which reads as restless rather than
# frantic. All three are hardcoded constants, NOT authored template fields —
# `kind = "mob"` keys are frozen by [ADR 0007](../docs/adr/0007-frozen-1.0-surface.md)
# §5 for all of 1.x, so an authored `morale` or `aggression` belongs to M19.
enum ActorTick {
    WANDER_CHANCE   = 20;   # 1-in-N per tick for an idle mob to move
    ASSIST_CHANCE   = 3;    # 1-in-N for an idle mob to join a room-mate's fight
    MORALE_FLEE_PCT = 20;   # break off below this % of max HP
}

# Can this mob act at all this tick? Stunned mobs forfeit their turn (the same
# rule combat_round applies to their swing), and a mob already engaged is driven
# from the session side, not here.
fn _mob_can_act(m): i64 {
    if (mi_stun(m) > 0) { return 0; }
    if (mi_hp(m) <= 0)  { return 0; }
    return 1;
}

# Move `m` to `dest`, unlinking from its current room's occupant list and
# pushing onto the destination's. Broadcasts departure and arrival to whoever
# is watching. The mob's MI_HOME is deliberately untouched — see
# _mob_alive_count for why the zone reset depends on that.
fn mob_move_to(m, dest, dir): i64 {
    var from = mi_room(m);
    # Departure line first, while the watchers can still see it leave.
    room_combat_line(from, 0, mi_name_ptr(m), mi_name_len(m),
    " heads ", dir_name(dir), strlen(dir_name(dir)), ".\r\n");
    mob_unlink(m);
    store64(m + MI_ROOM, dest);
    var r = room_at(dest);
    store64(m + MI_NEXT, room_mob_head(r));
    room_set_mob_head(r, m);
    room_combat_line(dest, 0, mi_name_ptr(m), mi_name_len(m), " arrives.", 0, 0, "\r\n");
    return 0;
}

# Is `b` the same room as `a`, or one exit away from it?
fn _room_adjacent(a, b): i64 {
    if (a == b) { return 1; }
    var d = 0;
    while (d < NDIR) {
        if (room_exit(room_at(a), d) == b) { return 1; }
        d = d + 1;
    }
    return 0;
}

# Collect the directions out of `m`'s current room that stay within one move of
# its HOME room, into `out`. Returns how many.
#
# **The leash.** Unbounded wander is a content bug, not a feature: the first live
# run of M13 had the Foundry Sentinel — the endgame boss, authored into
# `foundry.overseer` — walk the length of the zone and turn up in `hub.gate`, the
# newbie start room. A wandering population eventually diffuses evenly across the
# map, which erases the authored difficulty curve entirely.
#
# The proper fix is an authored per-template flag ("this one is a sentinel, it
# does not roam"), but `kind = "mob"` keys are frozen by ADR 0007 §5 for all of
# 1.x — that is M19's, alongside `morale` and aggression. A home leash needs no
# new authored field: it is a spatial rule, so every mob paces the neighbourhood
# it was placed in and the zone keeps the shape its author gave it.
fn _mob_leashed_dirs(m, out): i64 {
    var here = room_at(mi_room(m));
    var home = load64(m + MI_HOME);
    var nd = 0;
    var d = 0;
    while (d < NDIR) {
        var dest = room_exit(here, d);
        if (dest >= 0) {
            if (_room_adjacent(home, dest) == 1) { store64(out + nd * 8, d); nd = nd + 1; }
        }
        d = d + 1;
    }
    return nd;
}

# One idle mob's turn: maybe pace to an adjacent room, within its leash.
fn _mob_wander(m): i64 {
    if (rng_below(WANDER_CHANCE) != 0) { return 0; }
    var dirs[48];
    var nd = _mob_leashed_dirs(m, &dirs);
    if (nd == 0) { return 0; }
    var pick = load64(&dirs + rng_below(nd) * 8);
    mob_move_to(m, room_exit(room_at(mi_room(m)), pick), pick);
    return 1;
}

# An idle mob joins a room-mate's fight. Anything already engaged in this room
# tells us a player is worth attacking; the mob picks that player as its target,
# and the tick's combat pass does the rest. The player's SS_TARGET is left
# alone — being jumped by a second mob does not retarget your own swing.
fn _mob_assist(m): i64 {
    if (rng_below(ASSIST_CHANCE) != 0) { return 0; }
    var other = room_mob_head(room_at(mi_room(m)));
    while (other != 0) {
        if (other != m) {
            var s = mi_target(other);
            if (s != 0) {
                # Only assist against someone standing here — a target that
                # walked out is stale until that mob's own turn clears it.
                if (load64(s + SS_ROOM) == mi_room(m)) {
                    mi_set_target(m, s);
                    room_combat_line(mi_room(m), 0, mi_name_ptr(m), mi_name_len(m),
                    " snaps round and joins the fight!", 0, 0, "\r\n");
                    return 1;
                }
            }
        }
        other = mi_next(other);
    }
    return 0;
}

# A badly hurt mob breaks off and bolts, mirroring the player's `flee`. Below
# MORALE_FLEE_PCT of max HP it drops its target and takes an exit if there is
# one; cornered (no exits) it fights on, which is the interesting case.
#
# Note this clears the mob's grip on the player but NOT the player's SS_TARGET:
# the player stays swinging at empty air for one tick and then combat_round's
# own room check disengages them, which reads as the mob getting away.
fn _mob_flee(m): i64 {
    var maxhp = mt_hp(mi_tpl(m));
    if (maxhp <= 0) { return 0; }
    if (mi_hp(m) * 100 >= maxhp * MORALE_FLEE_PCT) { return 0; }
    var dirs[48];
    var nd = _mob_leashed_dirs(m, &dirs);
    if (nd == 0) { return 0; }          # cornered — it has to fight
    mi_set_target(m, 0);
    room_combat_line(mi_room(m), 0, mi_name_ptr(m), mi_name_len(m),
    " breaks and flees!", 0, 0, "\r\n");
    var pick = load64(&dirs + rng_below(nd) * 8);
    mob_move_to(m, room_exit(room_at(mi_room(m)), pick), pick);
    return 1;
}

# One tick for every living mob in the world.
#
# The walk captures `next` BEFORE the mob acts, because a wander unlinks it from
# the list being walked — reading mi_next afterward would follow a pointer into
# the destination room's list and either skip occupants or loop. MI_ACTED is the
# second half of that guard: a mob that wanders *forward* into a room this sweep
# has not reached yet would otherwise take a second turn in the same tick.
#
# `tick` is passed rather than read from g_tick_count: that global lives in
# server.cyr, which is included AFTER this file, and leaning on forward global
# resolution is exactly the kind of silent-wrong this guard exists to avoid.
#
# Returns the number of mobs that TOOK A TURN, not the number that visibly did
# something — wander and assist are 1-in-N rolls, so an "acted" count is
# probabilistic and cannot be asserted on. Turns taken is deterministic, which
# makes the re-entry guard testable: sweeping twice at the same tick must report
# a full count and then zero.
fn mob_tick_all(tick): i64 {
    var took_turn = 0;
    var ri = 0;
    while (ri < g_room_count) {
        var m = room_mob_head(room_at(ri));
        while (m != 0) {
            var nxt = mi_next(m);          # BEFORE any move
            if (load64(m + MI_ACTED) != tick) {
                store64(m + MI_ACTED, tick);
                took_turn = took_turn + 1;
                if (_mob_can_act(m) == 1) {
                    if (mi_target(m) != 0) {
                        # H7-a (1.6.4) — reap a stale latch FIRST. A mob whose
                        # target has left the room used to keep it forever: the
                        # engaged arm only ever offered _mob_flee, which returns
                        # above MORALE_FLEE_PCT, and an assisting mob is never
                        # attacked so its HP never falls. It therefore never
                        # cleared, never wandered and never assisted again —
                        # M13's wander decayed to zero in exactly the rooms
                        # players use. Also fixes the same latch leaking from a
                        # cmd_kill retarget.
                        var tgt = mi_target(m);
                        if (load64(tgt + SS_ROOM) != mi_room(m)) {
                            mi_set_target(m, 0);
                        } else {
                            # H7-b — and it actually swings now. Skipped when the
                            # player is already fighting THIS mob, or
                            # combat_round would swing it a second time.
                            if (load64(tgt + SS_TARGET) != m) { mob_swing(tgt, m); }
                            _mob_flee(m);    # engaged: break off?
                        }
                    } else {
                        _mob_assist(m);      # idle: join in?
                        if (mi_target(m) == 0) { _mob_wander(m); }
                    }
                }
            }
            m = nxt;
        }
        ri = ri + 1;
    }
    return took_turn;
}

# Top up every room in the zone. Returns total mobs spawned this reset.
fn zone_reset_mobs(): i64 {
    var spawned = 0;
    var ri = 0;
    while (ri < g_room_count) {
        spawned = spawned + zone_reset_room_mobs(ri);
        ri = ri + 1;
    }
    return spawned;
}
