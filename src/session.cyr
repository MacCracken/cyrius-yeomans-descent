# session.cyr — M1-B per-connection session struct + lifecycle.
#
# One Session per accepted client. Heap-allocated at accept via
# fl_alloc, returned to the freelist at disconnect — per ADR 0003 the
# long-running event loop pays for per-conn-lifetime memory exactly
# once per session.
#
# At M1-B the session holds:
#   - the socket fd
#   - rx + tx byte buffers
#   - a coarse phase enum (banner / cmd) — login flow lands at M1-E
#   - an unused telnet-state pointer slot (M1-C will fill it)
#   - an unused player-id slot (M6 will fill it)
#   - a last-activity timestamp (M1-F idle timeout will consume it)
#
# At M1-B the rx path is a stub echo — every line the client sends is
# echoed back. M1-C swaps that for the RFC 854 IAC parser; M2 adds
# verb-noun dispatch on top.

# === Struct field offsets (all i64 / 8 bytes per CLAUDE.md conventions) ===

enum SS {
    SS_FD         = 0;    # connected socket fd (non-blocking)
    SS_PHASE      = 8;    # current PHASE_*
    SS_LAST_MS    = 16;   # monotonic ms of last byte exchanged
    SS_RX_BUF     = 24;   # ptr to raw socket-read scratch (RX_CAP bytes)
    SS_RX_LEN     = 32;   # raw bytes read, pending Telnet decode
    SS_TX_BUF     = 40;   # ptr to tx queue (TX_CAP bytes)
    SS_TX_LEN     = 48;   # bytes queued (write end)
    SS_TX_OFF     = 56;   # bytes already drained to the socket
    SS_OUT_ARMED  = 64;   # 1 iff the fd is currently registered with EPOLLOUT
    SS_TS         = 72;   # Telnet parser state ptr (M1-C)
    SS_FAILS      = 80;   # consecutive failed login attempts (H5, 1.6.2).
    # Was SS_PLAYER, declared at M1-B and never read
    # by anything in the tree — reused rather than
    # growing the struct.
    SS_LINE_BUF   = 88;   # ptr to decoded-data line accumulator (LINE_CAP)
    SS_LINE_LEN   = 96;   # decoded data bytes in the current partial line
    SS_NAME_BUF   = 104;  # ptr to captured player name (NAME_CAP bytes)
    SS_NAME_LEN   = 112;  # length of the captured name
    SS_NEXT       = 120;  # intrusive active-session list (server.cyr owns it)
    SS_PREV       = 128;  # — used by the tick idle sweep (M1-F)
    SS_QUIT       = 136;  # 1 once the `quit` verb asks for teardown (M2)
    SS_ROOM       = 144;  # current room index (M3); -1 until placed
    # Combat stats (M4). Defaults until classes (M5) / persistence (M6).
    SS_HP         = 152;  # current hit points
    SS_MAXHP      = 160;  # max hit points
    SS_AC         = 168;  # armour class (lower = better defence)
    SS_TARGET     = 176;  # mob instance being fought (0 = not engaged)
    SS_HIT        = 184;  # to-hit bonus
    SS_NDICE      = 192;  # weapon damage: dice count
    SS_DSIZE      = 200;  #                die size
    SS_DMOD       = 208;  #                flat modifier
    SS_INV        = 216;  # head of the player's inventory list (M4-E)
    # Class + attributes + ability state (M5).
    SS_CLASS      = 224;  # class index (-1 until chosen)
    SS_STR        = 232;  # strength    — physical damage
    SS_DEX        = 240;  # dexterity   — accuracy / evasion
    SS_CON        = 248;  # constitution — max HP
    SS_TEC        = 256;  # tech        — ability power
    SS_ENERGY     = 264;  # current ability energy
    SS_MAXENERGY  = 272;
    SS_CD0        = 280;  # ability-slot 0 cooldown (ticks remaining)
    SS_CD1        = 288;  # ability-slot 1 cooldown
    SS_CD2        = 296;  # ability-slot 2 cooldown
    SS_GUARD      = 304;  # AC-buff ticks remaining (brace / bypass)
    SS_STIM       = 312;  # damage/hit-buff ticks remaining (stim)
    SS_STEALTH    = 320;  # 1 while sneaking (backstab primed)
    # M6 identity / persistence (transient — the seckey is NEVER serialized;
    # it is re-derived from the typed passphrase at login per ADR 0004).
    SS_IDENT        = 328; # ptr to 120B ident block: salt(16)|pubkey(32)|seckey(64)|created(8)
    SS_AUTHED       = 336; # 1 once the passphrase verified / char created
    SS_SAVE_DIRTY   = 344; # 1 if state changed since the last save (debounce)
    SS_LAST_SAVE_MS = 352; # monotonic ms of the last successful save
    # H8 (1.6.4) — in-flight `passwd` candidate, PER SESSION. The candidate used
    # to live in the global g_persist_dec across a network round trip, which is
    # byte-for-byte the region player_auth_load decodes salt|pubkey|sig into and
    # overlaps _build_record's signature buffer. Any interleaved save or login —
    # including a FAILED login against any account, since hex_decode_into writes
    # before the verify — destroyed it.
    SS_IDENT_CAND   = 360; # 0 or fl_alloc(CAND_LEN): salt|pk|sk | pk2 | sk2
    # H15 (1.6.8) — "this session has queued bytes the tick has not written yet".
    # A NEW slot, not a reuse: SS_FAILS already took the one dead slot (SS_PLAYER),
    # and enum names share one flat global namespace, so a colliding constant
    # would silently resolve to somebody else's offset. Bumping SS_SIZE in the
    # same edit keeps session_new's memset(s, 0, SS_SIZE) covering it — which
    # matters, because fl_alloc hands back blocks WITHOUT zeroing them.
    SS_TX_DIRTY     = 368;
    # 1.7.1 — monotonic ms when this session last STARTED a `passwd` re-key.
    # A new slot for the same reason SS_TX_DIRTY was: enum names share one flat
    # global namespace, and SS_LAST_SAVE_MS is a different rule doing a different
    # job (see chpass_rate_limited). Bumping SS_SIZE in the same edit keeps
    # session_new's memset(s, 0, SS_SIZE) covering it, which matters because
    # fl_alloc hands back blocks WITHOUT zeroing them.
    SS_LAST_CHPASS_MS = 376;
    # 1.7.3 — monotonic ms of the last save ATTEMPT, success or failure.
    #
    # Distinct from SS_LAST_SAVE_MS, which records the last SUCCESS and must keep
    # meaning that: it is what `save` verb rate-limiting and the autosave cadence
    # are written against, and stamping it on a failure would claim a record was
    # written when it was not.
    SS_LAST_SAVE_TRY_MS = 384;
    SS_SIZE         = 392;
}

# The published epoll fd, used by room broadcasts (M3-C) and combat
# flushes (M4) to push bytes to sessions immediately. Single-thread loop,
# so a global is safe. Declared here (ahead of combat.cyr); cmd_serve
# (server.cyr) assigns it at startup. 0 outside a running server — flushes
# then no-op safely (drain to a real fd happens only when armed).
var g_epfd = 0;

# 0.9.1 surface freeze — the @-admin namespace (@stats/@who/@reset) is gated
# behind YD_ADMIN (default off): unguarded admin verbs are a production-surface
# concern. Full operator auth (which replaces this env gate) is tracked as
# [roadmap M18](../docs/development/roadmap.md#m17m23--the-2x-tail) — renumbered
# from the old M8, whose anchor this used to link to and which no longer exists.
# cmd_serve sets this from the env at startup. Declared here (ahead of
# server.cyr) so cmd_on_line / cmd_help_text can read it.
var g_admin_enabled = 0;

# Starting combatant profile (a scavenged sidearm). Replaced by class +
# attribute scaling at M5, restored from save at M6.
enum PlayerStat {
    PC_HP    = 30;
    PC_AC    = 8;
    PC_HIT   = 1;
    PC_NDICE = 1;
    PC_DSIZE = 6;
    PC_DMOD  = 1;
}

enum SessConst {
    RX_CAP   = 4096;      # raw socket-read scratch (decoded each readable)
    TX_CAP   = 4096;      # banner + a few command replies
    LINE_CAP = 4096;      # one full decoded line — M2 parser caps at this
    NAME_CAP = 32;        # name buffer (NAME_MAX + headroom)
    NAME_MAX = 16;        # longest accepted player name
    NAME_MIN = 2;         # shortest accepted player name
    # H5 (1.6.2) — most lines one readable event may dispatch. A 4 KB read can
    # hold ~800 short lines, and each login-phase line costs a full record read +
    # ed25519_verify; unmetered, one write froze the single-threaded loop for
    # 65-87 s (measured). 8 is far past any human's typing burst, and the
    # remainder is retained rather than dropped.
    RX_MAX_LINES = 8;
    # Minimum gap between two `save` verbs on one session (H6, 1.6.3).
    SAVE_MIN_INTERVAL_MS = 1000;
    # H16 (1.6.8) — minimum gap between two SWEEP saves of one session. This is
    # the 5-minute autosave cadence M6-D has always had; it just used to be
    # enforced by ticking the whole sweep once every 300 s instead of per
    # session. Deliberately NOT SAVE_MIN_INTERVAL_MS: that one is the anti-burst
    # gate on the `save` verb, a different rule doing a different job, and
    # collapsing the two would turn the autosave into a per-second storm.
    SAVE_SWEEP_MIN_MS = 300000;
    # 1.7.3 — minimum gap between two autosave ATTEMPTS on one session.
    #
    # `player_save` clears SS_SAVE_DIRTY only after a successful rename, so once
    # saves start failing the session stays dirty and stays due — on EVERY tick,
    # not every 300 s, because the "last success" stamp never advances either. At
    # SAVE_BATCH_MAX = 4 that is four signed saves every 2.5 s, unbounded in time,
    # from sessions merely sitting there. Under ENOSPC the audit log then grows
    # fastest exactly when it can least afford to.
    #
    # 30 s rather than a full SAVE_SWEEP_MIN_MS: a transient failure (a full disk
    # that gets cleared) should recover in seconds, not in five minutes, and 30 s
    # is already a 12x cut in attempt rate. This bounds the RETRY, not the
    # cadence — a healthy session's autosave is still governed by
    # SAVE_SWEEP_MIN_MS.
    SAVE_RETRY_MIN_MS = 30000;
    # Consecutive failed passphrase attempts before the session is closed.
    MAX_LOGIN_FAILS = 5;
    # 1.7.1 — minimum gap between two `passwd` re-key STARTS on one session.
    #
    # Why this exists at all. G2 (1.6.12) capped the attempts within ONE re-key at
    # MAX_LOGIN_FAILS — and then, on hitting the cap, resets SS_FAILS to 0 and
    # returns the player to the command prompt so they can type `passwd` again.
    # That bounds the work per INVOCATION and leaves invocations unbounded, which
    # the G2 comment says outright ("That still bounds the work per invocation,
    # which is the point"). PHASE_CHPASS_CONFIRM is the dearest line in the game
    # that needs no victim's credential — an ident_derive AND a record sign, two
    # Ed25519 operations in one line, measured 2461 us — and registration is open,
    # so the "authenticated" account an attacker needs costs four lines.
    #
    # Deliberately 10x SAVE_MIN_INTERVAL_MS, not equal to it. A re-key is a rare,
    # deliberate act; the anti-burst gate on `save` is tuned for a verb a player
    # may reasonably repeat. Ten seconds costs a legitimate user essentially
    # nothing — reaching this gate at all means failing five confirms in a row
    # inside one invocation, since a mismatch re-prompts WITHIN the re-key rather
    # than requiring a new one — and it is 10x the bound.
    CHPASS_MIN_INTERVAL_MS = 10000;
}

# Is this session standing in a room that actually exists? (H18, 1.6.9.)
#
# `room_at` is documented "no bounds check — callers hold valid indices", and it
# computes `g_rooms + i * RM_SIZE`. On a server with no zone loaded g_rooms is 0
# and SS_ROOM is -1 (session_new's "unplaced"; session_enter_world and
# session_resume_world both early-return when there are no rooms), so that
# arithmetic yields -240 and dereferencing it takes the whole process down.
#
# Every command verb that touches the room guards on `world_room_count() == 0`
# — except one, which is how `examine <anything>` became a remote crash any
# logged-in player could fire (see cmd_examine). This checks the INDEX rather
# than just the count, because the count alone does not tell you the session's
# own room is in range.
fn session_room_ok(s): i64 {
    var room = load64(s + SS_ROOM);
    if (room < 0) { return 0; }
    if (room >= world_room_count()) { return 0; }
    return 1;
}

# Has this session saved too recently for another `save` verb to do real work?
# Split out from cmd_dispatch so the rule is testable without standing up a full
# session + parser + world (H6, 1.6.3). A zero SS_LAST_SAVE_MS — a session that
# has never saved — is never rate-limited, which the `last == 0` line below
# states outright.
#
# Corrected in 1.6.8: this comment used to justify that line by claiming
# clock_now_ms() is large enough that the subtraction covers it. It is not —
# clock_now_ms() is CLOCK_MONOTONIC, milliseconds since boot — so the guard is
# load-bearing rather than belt-and-braces. The code was always right; the
# reasoning was not, and save_sweep_due was written from the wrong version.
fn save_rate_limited(s): i64 {
    var last = load64(s + SS_LAST_SAVE_MS);
    if (last == 0) { return 0; }
    if (clock_now_ms() - last < SAVE_MIN_INTERVAL_MS) { return 1; }
    return 0;
}

# Has this session started a `passwd` re-key too recently to start another?
# (1.7.1 — see CHPASS_MIN_INTERVAL_MS for why the rate, not just the per-attempt
# count, has to be bounded.)
#
# `now_ms` is a PARAMETER rather than a clock_now_ms() call inside, unlike
# save_rate_limited above. That is the deliberate difference: it makes the rule
# total over its domain and testable without arranging a clock, which is the seam
# save_sweep_due and tick_step already use and the one 1.7.0 settled on after two
# timing-flaky tests. save_rate_limited is left alone — changing its signature
# would be churn in a release that is not about it.
#
# A zero SS_LAST_CHPASS_MS — a session that has never re-keyed — is never limited.
# That guard is LOAD-BEARING, not belt-and-braces: clock_now_ms() is
# CLOCK_MONOTONIC (ms since BOOT), so `now - 0 < INTERVAL` is true on any host up
# for less than ten seconds, and without it the first `passwd` of a freshly booted
# server would be refused. This is the exact bug 1.6.8 fixed in save_sweep_due,
# which had been written from a version of the comment that got the reasoning
# backwards.
fn chpass_rate_limited(s, now_ms): i64 {
    var last = load64(s + SS_LAST_CHPASS_MS);
    if (last == 0) { return 0; }
    if (now_ms - last < CHPASS_MIN_INTERVAL_MS) { return 1; }
    return 0;
}

# Is this session due for an autosave? (H16, 1.6.8.)
#
# Split out for the same reason save_rate_limited was: it makes the rule
# testable without a server, and the rule is the entire safety argument for
# metering the sweep.
#
# SS_LAST_SAVE_MS == 0 means "never saved" — session_new memsets, and
# player_auth_load clears SS_SAVE_DIRTY without stamping a time — and it is
# tested EXPLICITLY, exactly as save_rate_limited above tests it.
#
# It has to be. `clock_now_ms()` is CLOCK_MONOTONIC: milliseconds since BOOT,
# not since the epoch. Leaning on `now - 0` being larger than the interval is
# leaning on the machine having been up for five minutes, which is false on a
# freshly-booted host — and a freshly-booted host running a freshly-started
# server is not a corner case, it is a reboot. Without this line, every
# character created in the first five minutes of uptime silently skips the
# autosave. (CI caught this; the comment that used to be here asserted the
# opposite, and was wrong.)
fn save_sweep_due(s, now): i64 {
    if (load64(s + SS_SAVE_DIRTY) == 0) { return 0; }
    # 1.7.3 — back off after a recent ATTEMPT, whether or not it worked. Without
    # this a failing save re-attempts every tick forever; see SAVE_RETRY_MIN_MS.
    # A zero stamp means "never attempted", which must not be read as "attempted
    # at time 0" — clock_now_ms is ms since BOOT, so on a young host that would
    # suppress the first autosave of every session.
    var tried = load64(s + SS_LAST_SAVE_TRY_MS);
    if (tried != 0) {
        if (now - tried < SAVE_RETRY_MIN_MS) { return 0; }
    }
    var last = load64(s + SS_LAST_SAVE_MS);
    if (last == 0) { return 1; }
    if (now - last < SAVE_SWEEP_MIN_MS) { return 0; }
    return 1;
}

enum Phase {
    PHASE_NAME        = 0;  # awaiting name entry (first prompt after MOTD)
    PHASE_CLASS       = 2;  # awaiting class selection (M5-A)
    PHASE_CMD         = 1;  # in the world, accepting commands
    PHASE_PASS        = 3;  # returning char: awaiting passphrase (M6 auth)
    PHASE_NEWPASS     = 4;  # new char: choose a passphrase
    PHASE_CONFIRMPASS = 5;  # new char: confirm the passphrase
    PHASE_CHPASS_NEW     = 6;  # in-world `passwd`: choose a new passphrase (0.8.1)
    PHASE_CHPASS_CONFIRM = 7;  # in-world `passwd`: confirm it
}

# === session_new — alloc + zero-init a Session for an accepted fd. ===
fn session_new(fd, now_ms): i64 {
    var s = fl_alloc(SS_SIZE);
    var rxb = fl_alloc(RX_CAP);
    var txb = fl_alloc(TX_CAP);
    var lnb = fl_alloc(LINE_CAP);
    var nmb = fl_alloc(NAME_CAP);
    memset(s, 0, SS_SIZE);
    store64(s + SS_FD, fd);
    store64(s + SS_PHASE, PHASE_NAME);
    store64(s + SS_LAST_MS, now_ms);
    store64(s + SS_RX_BUF, rxb);
    store64(s + SS_TX_BUF, txb);
    store64(s + SS_LINE_BUF, lnb);
    store64(s + SS_NAME_BUF, nmb);
    store64(s + SS_TS, telnet_state_new());
    store64(s + SS_ROOM, 0 - 1);   # unplaced until login (M3)
    # Default combatant profile (M4).
    store64(s + SS_HP, PC_HP);
    store64(s + SS_MAXHP, PC_HP);
    store64(s + SS_AC, PC_AC);
    store64(s + SS_TARGET, 0);
    store64(s + SS_HIT, PC_HIT);
    store64(s + SS_NDICE, PC_NDICE);
    store64(s + SS_DSIZE, PC_DSIZE);
    store64(s + SS_DMOD, PC_DMOD);
    store64(s + SS_CLASS, 0 - 1);   # no class until selected (M5)
    return s;
}

# === session_free — close fd, return buffers to the freelist. ===
fn session_free(s): i64 {
    sock_close(load64(s + SS_FD));
    telnet_state_free(load64(s + SS_TS));
    fl_free(load64(s + SS_RX_BUF));
    fl_free(load64(s + SS_TX_BUF));
    fl_free(load64(s + SS_LINE_BUF));
    fl_free(load64(s + SS_NAME_BUF));
    if (load64(s + SS_IDENT) != 0) {
        memset(load64(s + SS_IDENT), 0, IDENT_LEN);   # F5 — the LIVE secret key
        fl_free(load64(s + SS_IDENT));
    }
    # H8 — a session dropped mid-`passwd` must not leak its candidate key.
    # F5 (1.6.11) — WIPE before free. lib/freelist.cyr hands a freed block to
    # the next fl_alloc of that size class without zeroing it, and both of
    # these hold Ed25519 secret keys: SS_IDENT the live one for the whole
    # session, SS_IDENT_CAND up to two derived candidates mid-`passwd`.
    #
    # The 1.6.4 entry claims the candidate is "wiped and freed on commit, on
    # both rewinds, and in session_free". Three of those four were true:
    # sess_cand_clear does memset-then-free and is called on commit and both
    # rewinds; this site did a bare fl_free. SS_IDENT was never wiped at all
    # and was never claimed to be — which is worse, since it is the live key.
    if (load64(s + SS_IDENT_CAND) != 0) {
        memset(load64(s + SS_IDENT_CAND), 0, CAND_LEN);
        fl_free(load64(s + SS_IDENT_CAND));
    }
    fl_free(s);
    return 0;
}

# === session_appendtx — copy `len` bytes into the tx queue. ===
#
# Truncates on overflow (returns the number of bytes actually queued).
# At M1-B the queue is one banner + short replies — overflow is a bug,
# not an expected condition, but we cap rather than corrupt memory.
fn session_appendtx(s, buf, len): i64 {
    var pos = load64(s + SS_TX_LEN);
    var cap = TX_CAP;
    var room = cap - pos;
    var n = len;
    if (n > room) { n = room; }
    if (n <= 0) { return 0; }
    memcpy(load64(s + SS_TX_BUF) + pos, buf, n);
    store64(s + SS_TX_LEN, pos + n);
    return n;
}

# Convenience: append a NUL-terminated cstring.
fn session_appendtx_cstr(s, cstr): i64 {
    return session_appendtx(s, cstr, strlen(cstr));
}

# === session_appendtx_prose — append PLAYER-AUTHORED bytes safely (M10-A). ===
#
# Use this for anything a player typed. Use session_appendtx for server literals
# and authored zone prose.
#
# The bug it fixes: telnet_feed decodes `IAC IAC` into a literal 0xFF data byte —
# correct RFC 854 behaviour, and the suite asserts it. session_push_line_byte then
# drops only `b < 32`, so that 0xFF lands in the line buffer, and cmd_say handed
# the buffer straight to every listener's socket. RFC 854 requires a data-stream
# 0xFF be re-sent as `IAC IAC`; sending it bare means a conformant client reads
# the start of a Telnet command. One player could inject IAC into another
# player's protocol stream. (The comment on that filter claiming "telnet IAC is
# already stripped upstream" was wrong: IAC is stripped as *framing*, and the
# escaped literal is deliberately preserved as data.)
#
# Two rules:
#   0xFF        -> doubled, per RFC 854.
#   < 32, 127   -> dropped. C0 controls and DEL: ESC (0x1B) among them, so player
#                  text cannot forge the SGR runs ansi_title()/ansi_actor() emit.
#
# C1 (0x80-0x9F) is deliberately NOT dropped, though it is nominally a control
# range: as raw bytes those are UTF-8 continuation bytes, and the tokenizer
# explicitly passes UTF-8 through. Dropping them would corrupt every non-ASCII
# name and message to fix nothing — they are inert to a Telnet client.
#
# Bounded, and atomic per escape pair. It writes into the tx queue directly
# rather than delegating, because session_appendtx truncates silently at TX_CAP:
# a 4096-byte all-0xFF say escapes to 8192, and a truncation landing *between*
# the two bytes of a pair would emit the exact lone 0xFF this exists to prevent.
# Returns bytes written.
# === Crypto and fan-out accounting (1.7.0). ===
#
# Four counters, incremented at the call sites of the only work in this server
# that costs milliseconds instead of microseconds. They exist because 1.7.0's
# defect was a COMMENT doing arithmetic against a cost that was 7x wrong, with
# no instrument to contradict it.
#
# The distinction that makes this the right shape: a static table mapping a line
# to a predicted cost can be wrong the same way that comment was wrong. A
# counter at the call site cannot be wrong about how many times
# `ed25519_verify` actually ran. So the expensive half is COUNTED, never
# predicted — including an `ed25519_sign` reached from PHASE_CMD by the `save`
# verb, which no phase table would see.
#
# Declared here rather than in persist.cyr because the include order is
# session -> ... -> persist -> server, and all three files charge into them.
var g_charge_derives     = 0;   # ed25519_keypair  (ident_derive, persist.cyr)
var g_charge_signs       = 0;   # ed25519_sign     (_build_record, persist.cyr)
var g_charge_verifies    = 0;   # ed25519_verify   (player_auth_load, persist.cyr)
var g_charge_prose_bytes = 0;   # bytes ESCAPED by session_appendtx_prose

# Monotonic, never reset — a window takes a base snapshot instead (1.7.0), so
# these stay valid as a lifetime total for `@stats` and for tests that want a
# before/after delta across an arbitrary span.
fn charge_totals(): i64 {
    return g_charge_derives + g_charge_signs + g_charge_verifies;
}

# === The charge window (1.7.0). ===
#
# WHY NOT A COUNT. `DRAIN_LINES_MAX` / `EVENT_LINES_MAX` budget 16 LINES per
# pass, and the census measured the cost of one line spanning 1.7 us (a line
# rejected on length) to 8411 us (a successful login) — a spread of ~4800x. No
# value of N is right: 16 dear lines is 211 ms, and the N that fits one dear
# line is 1, which would starve `look`. A count budget cannot see cost.
#
# WHY NOT A CLOCK. Three disqualifiers, all in-tree. On agnos `clock_now_ms` is
# `sys_uptime_ms`, documented FROZEN for a foreground `run` program executing
# with interrupts cleared — a frozen deadline is silently NO budget, which is
# the 16.5 s-per-pass defect G1 fixed, failing silently where a frozen tick
# fails loudly. agnos resolution is 10 ms, so any budget under that is
# unenforceable there. And `clock_now_ns()` measured 1321 ns (no vDSO — Cyrius
# links freestanding, so it is the raw syscall), a ~90% overhead on a 1.5 us
# `look`. A charge check is one integer compare.
#
# WHAT THIS IS. Units of ~CHARGE_UNIT_US microseconds, charged from the COUNTERS
# above — actual `ed25519_*` calls and actual escaped bytes, never a predicted
# per-line cost. The distinction is the whole point: a table can be wrong the
# way the old comment was wrong; a call-site counter cannot be wrong about how
# many times the expensive thing ran. It also catches cost no phase table could
# see, like the `ed25519_sign` the `save` verb reaches from PHASE_CMD.
enum ChargeUnits {
    # One unit ~= 250 us, so the cheapest thing worth charging (a keypair
    # derivation) is 7 units: coarse enough to keep the table small integers,
    # fine enough that a 5 ms cap is 20 steps.
    CHARGE_UNIT_US = 250;

    # Reference-host microseconds per operation, divided by CHARGE_UNIT_US and
    # rounded UP — overcharging costs a little throughput, undercharging costs
    # the bound. Derivations are in docs/development/state.md; the suite asserts
    # each one against its MEAS_* figure so the arithmetic cannot rot in a
    # comment the way the DRAIN_LINES_MAX comment did.
    CHG_DERIVE = 7;    #  1750 us >= 1723 measured (ident_derive)
    CHG_SIGN   = 10;   #  2500 us >= 2270 measured (dearest sign-bearing line)
    CHG_VERIFY = 47;   # 11750 us >= 11371 measured; 7+47=54u covers a 13458 us login

    # Broadcast fan-out, charged in BYTES because bytes are what the per-recipient
    # IAC-escape loop walks. 6.195 ns/byte reference => 250000/6.195 = 40355,
    # rounded DOWN so the charge errs high.
    PROSE_BYTES_PER_UNIT = 40000;
}

# The installed cap for the current window, and the accumulator snapshot it was
# opened against. A cap of 0 means UNMETERED, which is what every pre-1.7.0
# caller gets without touching a single signature.
var g_charge_cap        = 0;
var g_charge_base_d     = 0;
var g_charge_base_s     = 0;
var g_charge_base_v     = 0;
var g_charge_base_prose = 0;

# Units spent since the window opened. Pure function of the counters and the
# base, so a test can drive it without a socket.
fn charge_spent(): i64 {
    var u = (g_charge_derives  - g_charge_base_d) * CHG_DERIVE;
    u = u + (g_charge_signs    - g_charge_base_s) * CHG_SIGN;
    u = u + (g_charge_verifies - g_charge_base_v) * CHG_VERIFY;
    u = u + (g_charge_prose_bytes - g_charge_base_prose) / PROSE_BYTES_PER_UNIT;
    return u;
}

# Open a window: SNAPSHOT the accumulators and install `cap`.
#
# Snapshotting rather than zeroing is deliberate and load-bearing twice over: it
# keeps `save_sweep`'s four `ed25519_sign`s — which run earlier in the same
# `advance_tick` — out of this window's spend, and it survives someone
# reordering `advance_tick` later.
fn charge_window_open(cap): i64 {
    g_charge_cap        = cap;
    g_charge_base_d     = g_charge_derives;
    g_charge_base_s     = g_charge_signs;
    g_charge_base_v     = g_charge_verifies;
    g_charge_base_prose = g_charge_prose_bytes;
    return cap;
}

# Close it. Back to unmetered, so a caller that never opens a window behaves
# exactly as it did before 1.7.0 — the omission fails OPEN to a known bound (the
# line count) rather than closed to a wedged server.
fn charge_window_close(): i64 {
    g_charge_cap = 0;
    return 0;
}

# === The guard. Pure, total, no clock, no globals read. ===
#
# Every input is a parameter precisely so the suite can enumerate the domain
# instead of arranging a socket. Four clauses, in this order:
#
#   unmetered  — no window installed; behave as 1.6.15 did.
#   progress   — the FIRST line of a window always runs, whatever it costs.
#                Without this a line dearer than the whole cap (a successful
#                login is 54 units against a cap of 20) could never run and the
#                session would wedge forever. This is also what bounds the
#                overrun at exactly one line and no more.
#   metered    — the cap is spent. Catches cost nothing could have predicted.
#   pre-charge — a line whose KNOWN crypto cannot fit waits for the next pass
#                rather than overshooting by a whole ed25519_verify. This is
#                what makes the worst window max(cap, dearest) instead of
#                (cap - 1) + dearest.
fn charge_stop(spent, cap, bound): i64 {
    if (cap <= 0)      { return 0; }        # unmetered
    if (spent == 0)    { return 0; }        # progress: always admit one
    if (spent >= cap)  { return 1; }        # metered
    if (bound > 0) {
        if (spent + bound > cap) { return 1; }   # pre-charge
    }
    return 0;
}

# The crypto a line in `phase` is KNOWN to cost, in units, or 0 for "not flat,
# meter it after the fact".
#
# Exact rather than heuristic for the phases listed, because none of them has an
# attacker-controlled amplifier — verified by measurement: a 4-byte and a
# 64-byte passphrase cost 8263 vs 8240 us, and a 500-byte and a 1099-byte record
# 8240 vs 8300 us. The cost IS the crypto and the crypto is fixed by the phase.
#
# PHASE_CMD and PHASE_NAME return 0 deliberately. PHASE_CMD spans 46 us (`look`)
# to 4050 us (a 4 kB `say` at MAX_SESSIONS) and no static number describes it;
# PHASE_NAME is a single stat(2). Both are charged by what they actually consume.
# The bound is the crypto the line is CERTAIN to perform, not the most it could.
# That distinction is worth stating because the conservative reading looks safer
# and is strictly worse:
#
#   PHASE_PASS performs a derive unconditionally, and an ed25519_verify ONLY if
#   the derived key matches (that is the 1.7.0 reorder). So the certain cost is
#   CHG_DERIVE; the verify is charged after the fact when it actually happens.
#
# Both readings give the SAME worst case, because the progress clause is what
# absorbs an over-cap line either way: a window is at most max(cap, dearest) =
# 54 units, whether the dear line was pre-charged or charged afterwards. But
# bound = CHG_DERIVE admits TWO wrong passphrases per window (0 -> 7 -> 14, then
# 14 + 7 = 21 > 20 stops) where bound = derive + verify admits only one. Same
# bound, twice the throughput on the wrong-passphrase path — which is both the
# attack path and the legitimate-typo path. Same reasoning for
# PHASE_CHPASS_CONFIRM, whose sign happens only once the confirm matches.
fn line_crypto_bound(phase): i64 {
    if (phase == PHASE_PASS)            { return CHG_DERIVE; }
    if (phase == PHASE_NEWPASS)         { return CHG_DERIVE; }
    if (phase == PHASE_CONFIRMPASS)     { return CHG_DERIVE; }
    if (phase == PHASE_CHPASS_NEW)      { return CHG_DERIVE; }
    if (phase == PHASE_CHPASS_CONFIRM)  { return CHG_DERIVE; }
    if (phase == PHASE_CLASS)           { return CHG_SIGN; }   # apply_class always saves
    return 0;
}

# Escape player-authored bytes into the tx queue, IAC-doubling 0xFF and dropping
# control bytes, truncating at TX_CAP rather than overrunning. Returns bytes
# written.
fn session_appendtx_prose(s, buf, len): i64 {
    var pos = load64(s + SS_TX_LEN);
    var room = TX_CAP - pos;
    if (room <= 0) { return 0; }
    var dst = load64(s + SS_TX_BUF) + pos;
    var i = 0;
    var w = 0;
    while (i < len) {
        var b = load8(buf + i) & 0xFF;
        if (b == 255) {
            # Both bytes or neither — never split a pair at the boundary.
            if (w + 2 > room) { i = len; continue; }
            store8(dst + w, 255);
            store8(dst + w + 1, 255);
            w = w + 2;
        } else {
            if (b >= 32) {
                if (b != 127) {
                    if (w + 1 > room) { i = len; continue; }
                    store8(dst + w, b);
                    w = w + 1;
                }
            }
        }
        i = i + 1;
    }
    # Charge the bytes ACTUALLY escaped, not `len`. Charging `len` after a
    # TX_CAP truncation would bill a peer for work the server declined to do,
    # which turns the meter itself into a cheap way to exhaust a shared budget.
    g_charge_prose_bytes = g_charge_prose_bytes + w;
    store64(s + SS_TX_LEN, pos + w);
    return w;
}

# === Password echo suppression (0.8.1). ===
# Telnet convention: the server announcing WILL ECHO makes a conformant
# client stop local-echoing the user's keystrokes; the server then withholds
# the typed bytes (we never echo input), so a passphrase never reaches the
# screen. WONT ECHO hands echo back to the client. Sent as a raw 3-byte IAC
# salvo around the login / passwd prompts; clients that ignore ECHO just
# show the passphrase as before (no worse than pre-0.8.1).
fn session_echo_off(s): i64 {
    # Track that WE asked to echo (Q_WANTYES) so the client's DO ECHO ack lands as
    # a confirmation, not a naive refusal — ECHO is tracked-but-unpreferred. Guard
    # SS_TS: test harnesses build bare sessions with no telnet state (SS_TS == 0).
    var ts = load64(s + SS_TS);
    if (ts != 0) { opt_set_us(ts, OPT_ECHO, Q_WANTYES); }
    var b[3];
    store8(&b + 0, IAC); store8(&b + 1, WILL); store8(&b + 2, OPT_ECHO);
    return session_appendtx(s, &b, 3);
}
# Hand echo back (WONT ECHO) once passphrase entry is over. Our option state is
# forced to Q_NO before the salvo so a straggling DO ECHO can't be mistaken for
# an ack of the WILL from session_echo_off. SS_TS == 0 in bare test sessions.
fn session_echo_on(s): i64 {
    var ts = load64(s + SS_TS);
    if (ts != 0) { opt_set_us(ts, OPT_ECHO, Q_NO); }   # back to client-echo line mode
    var b[3];
    store8(&b + 0, IAC); store8(&b + 1, WONT); store8(&b + 2, OPT_ECHO);
    return session_appendtx(s, &b, 3);
}

# Append a signed integer in decimal. Used by the M1-H status verb.
fn session_appendtx_num(s, n): i64 {
    if (n == 0) {
        var z[1];
        store8(&z, 48);
        session_appendtx(s, &z, 1);
        return 0;
    }
    if (n < 0) {
        var m[1];
        store8(&m, 45);          # '-'
        session_appendtx(s, &m, 1);
        n = 0 - n;
    }
    var tmp[24];
    var len = 0;
    while (n > 0) {
        store8(&tmp + len, 48 + (n % 10));
        n = n / 10;
        len = len + 1;
    }
    var out[24];
    var i = 0;
    while (i < len) {
        store8(&out + i, load8(&tmp + len - 1 - i));
        i = i + 1;
    }
    session_appendtx(s, &out, len);
    return 0;
}

# === session_telnet_announce — queue the opening option salvo. ===
#
# Runs telnet_announce on the session's parser and copies the resulting
# IAC bytes into the tx queue. Called once at accept, ahead of the
# banner, so a conformant client negotiates ECHO / SGA before any
# application bytes arrive.
fn session_telnet_announce(s): i64 {
    var ts = load64(s + SS_TS);
    telnet_announce(ts);
    var txl = telnet_tx_len(ts);
    if (txl > 0) {
        session_appendtx(s, telnet_tx_buf(ts), txl);
        telnet_tx_consume(ts);
    }
    return 0;
}

# === session_drain — try to write any queued tx bytes to the socket. ===
#
# Returns:
#   2 = drained completely (queue is now empty)
#   1 = partial (would-block; caller should arm EPOLLOUT)
#   0 = nothing to drain
#   negative = socket error (caller should disconnect)
fn session_drain(s): i64 {
    var tx_len = load64(s + SS_TX_LEN);
    var tx_off = load64(s + SS_TX_OFF);
    if (tx_off >= tx_len) { return 0; }
    var fd = load64(s + SS_FD);
    var done = 0;
    var rc = 1;
    while (done == 0) {
        if (tx_off >= tx_len) { done = 1; rc = 2; continue; }
        var n = sys_write(fd, load64(s + SS_TX_BUF) + tx_off, tx_len - tx_off);
        if (n < 0) {
            # EAGAIN / EWOULDBLOCK (-11) means the kernel buffer is full —
            # we keep the unsent bytes and let the caller arm EPOLLOUT.
            # Anything else is a real error.
            if (n == 0 - 11) { done = 1; rc = 1; continue; }
            done = 1;
            rc = n;
            continue;
        }
        if (n == 0) { done = 1; rc = 1; continue; }
        tx_off = tx_off + n;
    }
    if (rc == 2) {
        # Empty queue — reset offsets so the next append starts at 0.
        store64(s + SS_TX_LEN, 0);
        store64(s + SS_TX_OFF, 0);
    } else {
        # H15 (1.6.8) — compact the unsent remainder down to offset 0.
        #
        # A PARTIAL drain used to leave tx_off > 0 with the queue still starting
        # there, so every byte already written to the socket went on occupying
        # buffer. session_appendtx measures its room as TX_CAP - SS_TX_LEN and
        # has no idea the front of the buffer is dead space: a backpressured
        # client therefore hit the cap early and lost prose SILENTLY, because
        # session_appendtx reports a short write only through a return value
        # that no caller reads. Pre-existing, and coalescing would have made it
        # the common case rather than the rare one.
        if (tx_off > 0) {
            # Downward move, and lib/string.cyr's memcpy copies strictly
            # ascending (index 0 upward), so an overlapping dst < src is safe —
            # every byte is read before the write that would clobber it. There
            # is no memmove in the stdlib; this is why one is not needed.
            var buf = load64(s + SS_TX_BUF);
            memcpy(buf, buf + tx_off, tx_len - tx_off);
            store64(s + SS_TX_LEN, tx_len - tx_off);
            store64(s + SS_TX_OFF, 0);
        } else {
            store64(s + SS_TX_OFF, tx_off);
        }
    }
    return rc;
}

# === H15 (1.6.8) — the capacity valve that makes coalescing safe. ===
#
# TX_CAP is 4096 and session_appendtx TRUNCATES at it, silently. Deferring every
# write to the end of the tick means a whole tick's prose has to fit at once,
# and it does not: measured, a room of 36 co-located combatants overflows the
# cap, and at 128 every session pins at TX_CAP and most lose their own damage
# line, condition line and prompt off the end. The session hurt worst is the one
# last in the walk — it accumulates everyone else's third-person lines before
# its own first-person prose is appended.
#
# So: before appending, if this append would come near the cap, write out what
# is already queued. In the ordinary case — a handful of players in a room — it
# never fires and the coalescing win is untouched. In the pathological case the
# session degrades to roughly today's per-line flushing instead of dropping
# bytes on the floor. That is what makes the fix safe at ANY population rather
# than at the one that happened to be measured.
#
# The 256-byte margin is headroom for the append that follows: the longest
# single broadcast line is a name plus prose plus SGR codes, comfortably inside
# it, and leaving slack costs nothing.
enum TxValve { TX_FLUSH_MARGIN = 256; }
# Make room for an append of `need` bytes, writing out what is already queued if
# it would otherwise come near TX_CAP. Returns 1 if it flushed. See the block
# above for why coalescing is unsafe without this.
fn session_tx_reserve(s, need): i64 {
    if (load64(s + SS_TX_LEN) + need <= TX_CAP - TX_FLUSH_MARGIN) { return 0; }
    flush_session(g_epfd, s);   # forward ref → server.cyr
    return 1;
}

# === Login flow (M1-E scaffold). ===
#
# MOTD → name prompt → MOTD-2 → command prompt. The name is captured
# but NOT authenticated — real identity / auth lands at M6 (ADR 0004).
# Reserved handles and ill-formed names are refused with a re-prompt.

# ASCII-only case fold: 'A'-'Z' shift by 32, every other byte passes through
# unchanged, so high-bit bytes survive a fold intact. No ctype table, no locale —
# names and keywords are compared byte-wise on the wire.
fn ascii_lower(c): i64 {
    if (c >= 65) { if (c <= 90) { return c + 32; } }
    return c;
}

# Case-insensitive compare of buf[0..len] against NUL-terminated lit.
fn name_eq_ci(buf, len, lit): i64 {
    var i = 0;
    while (i < len) {
        var lc = load8(lit + i) & 0xFF;
        if (lc == 0) { return 0; }                  # lit shorter than buf
        if (ascii_lower(load8(buf + i) & 0xFF) != ascii_lower(lc)) { return 0; }
        i = i + 1;
    }
    if ((load8(lit + i) & 0xFF) != 0) { return 0; } # lit longer than buf
    return 1;
}

# ASCII letter test — the class login_name_ok demands of a name's first byte.
fn is_alpha(c): i64 {
    if (c >= 65)  { if (c <= 90)  { return 1; } }
    if (c >= 97)  { if (c <= 122) { return 1; } }
    return 0;
}
# ASCII letter or digit — the whole alphabet a player name may draw from.
fn is_alnum(c): i64 {
    if (is_alpha(c) == 1) { return 1; }
    if (c >= 48) { if (c <= 57) { return 1; } }
    return 0;
}

# Validate a candidate player name. Returns 1 if acceptable. Rules:
#   - length in [NAME_MIN, NAME_MAX]
#   - first char a letter (rules out leading '_' and digits)
#   - every char alphanumeric
#   - not a reserved handle (system / admin)
fn login_name_ok(buf, len): i64 {
    if (len < NAME_MIN) { return 0; }
    if (len > NAME_MAX) { return 0; }
    if (is_alpha(load8(buf) & 0xFF) == 0) { return 0; }
    var i = 0;
    while (i < len) {
        if (is_alnum(load8(buf + i) & 0xFF) == 0) { return 0; }
        i = i + 1;
    }
    if (name_eq_ci(buf, len, "system") == 1) { return 0; }
    if (name_eq_ci(buf, len, "admin")  == 1) { return 0; }
    return 1;
}

# The pre-login banner, queued once per connection ahead of the name prompt.
# Plain ASCII + CR LF on purpose: telnet_announce deliberately sends no option
# salvo, so this lands on a stock cooked-line-mode client with nothing
# negotiated — no SGA, no ECHO, and no reason to assume a capable terminal.
fn session_send_motd(s): i64 {
    session_appendtx_cstr(s, "\r\n");
    session_appendtx_cstr(s, "  ============================================\r\n");
    session_appendtx_cstr(s, "        Y E O M A N ' S   D E S C E N T\r\n");
    session_appendtx_cstr(s, "     a MUD of the techno-feudal Under-Grid\r\n");
    session_appendtx_cstr(s, "  ============================================\r\n");
    session_appendtx_cstr(s, "\r\n");
    return 0;
}
# Name prompt. No trailing CR LF — the client types on the prompt line. Re-sent
# verbatim by login_on_name after a refused name, so it must stay idempotent.
fn session_send_name_prompt(s): i64 {
    session_appendtx_cstr(s, "By what name are you known? ");
    return 0;
}
# The in-world prompt. cmd_on_line re-sends it after each command, but only
# while the phase is still PHASE_CMD — a verb that switches phase (passwd) has
# already queued its own prompt, and a second one would double up.
fn session_send_cmd_prompt(s): i64 {
    session_appendtx_cstr(s, "> ");
    return 0;
}

# Send MOTD + the first name prompt; the session starts in PHASE_NAME.
# Called once at accept (replaces the M1-B placeholder banner).
fn session_begin_login(s): i64 {
    store64(s + SS_PHASE, PHASE_NAME);
    session_send_motd(s);
    session_send_name_prompt(s);
    return 0;
}

# Handle a line entered at the name prompt.
fn login_on_name(s, buf, len): i64 {
    if (login_name_ok(buf, len) == 0) {
        session_appendtx_cstr(s, "That name won't do — 2-16 letters/digits, no reserved handles.\r\n");
        session_send_name_prompt(s);
        return 0;
    }
    # Capture the name, then branch on whether a record exists (M6 auth):
    # a known name asks for its passphrase; a new name forges an identity.
    # player_exists / login_begin_* are forward refs → persist.cyr.
    memcpy(load64(s + SS_NAME_BUF), buf, len);
    store64(s + SS_NAME_LEN, len);
    session_appendtx_cstr(s, "\r\nWelcome, ");
    session_appendtx(s, buf, len);
    session_appendtx_cstr(s, ". The Under-Grid stirs.\r\n");
    if (player_exists(buf, len) == 1) {
        return login_begin_pass(s);
    }
    session_appendtx_cstr(s, "No record answers to that name — let us forge one.\r\n");
    return login_begin_newpass(s);
}

# === M2 command dispatch ===
#
# One shared parser for every session — parsing a line is synchronous and
# never spans calls, so the single-thread loop needs only one instance
# (lazily allocated on first command). The world the verbs act on lands
# at M3; until then the handlers acknowledge the *parse* (verb / objects /
# preposition recognized) rather than faking world state, which keeps the
# wiring honest and demonstrable.
var g_parser = 0;

# Append token `i` of the parser (its lowercased form) to the tx queue.
fn session_appendtx_tok(s, pa, i): i64 {
    if (i < 0) { return 0; }
    # F4 (1.6.11) — a parser token is PLAYER-TYPED, so it goes through the
    # sanitizing appender. M10-A's rule, stated above session_appendtx_prose, is
    # "use this for anything a player typed; session_appendtx for server literals
    # and authored zone prose" — and this was handing raw token bytes to the raw
    # appender.
    #
    # It matters because telnet_feed decodes `IAC IAC` into a literal 0xFF data
    # byte (correct RFC 854, and the suite asserts it), session_push_line_byte
    # drops only b < 32, so a 0xFF survives into the token. Every not-found reply
    # then echoed it bare: "I don't understand ...", "You see no ...", and the
    # same in kill / put / give — a lone IAC on the wire, which is exactly the
    # defect M10 exists to prevent.
    session_appendtx_prose(s, tok_ptr(pa, i), tok_len(pa, i));
    return 0;
}

# Index where the command line's remainder begins: past leading
# whitespace, past the first word, past the whitespace after it. Returns
# `len` when there is no remainder (a bare verb). Used by social verbs to
# echo the original (case-preserving) message text.
fn cmd_rest_start(buf, len): i64 {
    var i = 0;
    while (i < len) {
        var c = load8(buf + i) & 0xFF;
        if (c != 32) { if (c != 9) { break; } }
        i = i + 1;
    }
    while (i < len) {
        var c = load8(buf + i) & 0xFF;
        if (c == 32) { break; }
        if (c == 9)  { break; }
        i = i + 1;
    }
    while (i < len) {
        var c = load8(buf + i) & 0xFF;
        if (c != 32) { if (c != 9) { break; } }
        i = i + 1;
    }
    return i;
}

# say <message> — the speaker sees `You say, "X"`; everyone else in the
# room sees `<name> says, "X"`.
fn cmd_say(s, buf, len): i64 {
    var rs = cmd_rest_start(buf, len);
    if (rs >= len) { session_appendtx_cstr(s, "Say what?\r\n"); return 0; }
    session_appendtx_cstr(s, "You say, \"");
    session_appendtx_prose(s, buf + rs, len - rs);   # M10-B player-authored
    session_appendtx_cstr(s, "\"\r\n");
    room_say_broadcast(load64(s + SS_ROOM), s, s, " says, \"", buf + rs, len - rs, "\"\r\n");
    return 0;
}

# emote <action> — everyone in the room (the actor included) sees
# `<name> <action>`.
fn cmd_emote(s, buf, len): i64 {
    var rs = cmd_rest_start(buf, len);
    if (rs >= len) { session_appendtx_cstr(s, "Emote what?\r\n"); return 0; }
    session_appendtx_prose(s, load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN));   # M10-C name
    session_appendtx_cstr(s, " ");
    session_appendtx_prose(s, buf + rs, len - rs);   # M10-B player-authored
    session_appendtx_cstr(s, "\r\n");
    room_say_broadcast(load64(s + SS_ROOM), s, s, " ", buf + rs, len - rs, "\r\n");
    return 0;
}

# tell <player> <message> — a directed message to any connected player,
# regardless of room.
fn cmd_tell(s, pa, buf, len): i64 {
    if (load64(g_parser + PA_COUNT) < 2) {
        session_appendtx_cstr(s, "Tell whom what?\r\n");
        return 0;
    }
    # Message begins after the second word (verb, then target name).
    var rs1 = cmd_rest_start(buf, len);
    var rs2 = rs1 + cmd_rest_start(buf + rs1, len - rs1);
    if (rs2 >= len) { session_appendtx_cstr(s, "Tell them what?\r\n"); return 0; }

    var target = find_player_global(tok_ptr(pa, 1), tok_len(pa, 1));
    if (target == 0) {
        session_appendtx_cstr(s, "No one by that name is connected.\r\n");
        return 0;
    }
    if (target == s) {
        session_appendtx_cstr(s, "Talking to yourself already?\r\n");
        return 0;
    }
    # Recipient sees the incoming tell (flushed now — they may be idle).
    session_appendtx_cstr(target, "\r\n");
    session_appendtx_prose(target, load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN));   # M10-C name
    session_appendtx_cstr(target, " tells you, \"");
    session_appendtx_prose(target, buf + rs2, len - rs2);   # M10-B player-authored
    session_appendtx_cstr(target, "\"\r\n");
    deliver_to(target);
    # Sender's echo.
    session_appendtx_cstr(s, "You tell ");
    session_appendtx_prose(s, load64(target + SS_NAME_BUF), load64(target + SS_NAME_LEN));   # M10-C name
    session_appendtx_cstr(s, ", \"");
    session_appendtx_prose(s, buf + rs2, len - rs2);   # M10-B player-authored
    session_appendtx_cstr(s, "\"\r\n");
    return 0;
}

# The equipment verbs (wear / remove / wield).
#
# H12 (1.6.7) — these used to answer "the Under-Grid is empty — items arrive at
# M3", which stopped being true at M3 and read as a broken server for four
# releases afterwards. They are still unimplemented, but for an honest reason:
# there are no equipment slots to wear anything into. Objects carry no slot or
# wear-flag field, and adding one is a zone-format change the frozen 1.x
# surface (ADR 0007 §5) does not permit — the loadout system is M17 (2.1.0).
#
# So: resolve the noun for real, and say what is actually the case. A player who
# types `wear jacket` while carrying a jacket learns the verb is unfinished, not
# that their item vanished.
fn cmd_equip_stub(s, pa, verb): i64 {
    if (parsed_has_dobj(pa) == 0) {
        session_appendtx_cstr(s, verb_name(verb));
        session_appendtx_cstr(s, " what?\r\n");
        return 0;
    }
    var di = parsed_dobj(pa);
    var np[8]; var nl[8];
    var nth = qual_single(pa, di, &np, &nl);
    var o = ilist_find_kw_nth(load64(s + SS_INV), load64(&np), load64(&nl), nth);
    if (o == 0) {
        session_appendtx_cstr(s, "You aren't carrying that.\r\n");
        return 0;
    }
    if (verb == VERB_REMOVE) {
        session_appendtx_cstr(s, "You have nothing equipped — you are carrying ");
        append_item_name(s, o);
        session_appendtx_cstr(s, ", not wearing it.\r\n");
        return 0;
    }
    session_appendtx_cstr(s, "You turn ");
    append_item_name(s, o);
    session_appendtx_cstr(s, " over in your hands. Nothing in the Under-Grid has a rig to hold it yet.\r\n");
    return 0;
}

# Any remaining object verb with no implementation at all.
fn cmd_object(s, pa, verb): i64 {
    if (parsed_has_dobj(pa) == 0) {
        session_appendtx_cstr(s, verb_name(verb));
        session_appendtx_cstr(s, " what?\r\n");
        return 0;
    }
    session_appendtx_cstr(s, "You can't ");
    session_appendtx_cstr(s, verb_name(verb));
    session_appendtx_cstr(s, " that.\r\n");
    return 0;
}

# Brief in-game help: the verb classes the parser understands.
fn cmd_help_text(s): i64 {
    session_appendtx_cstr(s, "-- commands --\r\n");
    session_appendtx_cstr(s, "move    : n s e w u d (north ...)\r\n");
    session_appendtx_cstr(s, "look    : look(l) examine exits inventory(i) who\r\n");
    session_appendtx_cstr(s, "items   : get drop put give wear remove wield\r\n");
    # H12 (1.6.7) — the qualifier resolves for real now, so advertise it. It has
    # worked in the parser since M2-E and nothing has ever told a player it exists.
    session_appendtx_cstr(s, "nouns   : all  all.x  2.x (the 2nd x in view)\r\n");
    session_appendtx_cstr(s, "fight   : kill flee\r\n");
    session_appendtx_cstr(s, "social  : say tell emote\r\n");
    session_appendtx_cstr(s, "session : quit save passwd help\r\n");
    if (g_admin_enabled == 1) {   # 0.9.1 — only advertise admin when enabled
        session_appendtx_cstr(s, "admin   : @stats @who @reset\r\n");
    }
    class_append_abilities(s);   # forward ref → classes.cyr (M5)
    return 0;
}

# === ANSI SGR (M3-D) ===
#
# We emit raw SGR escapes inline into the wire stream rather than pull the
# external `darshana` styling lib: that lib is a client-side terminal
# renderer, the wrong layer for a server queuing ~4 escape codes into a tx
# buffer. Keeping these here preserves the zero-external-deps stance and
# the "Own the Stack" principle. `\x1b` is a one-byte ESC in Cyrius
# strings, so the codes embed directly in cstr literals.
fn ansi_reset(): i64 { return "\x1b[0m"; }      # clear all attributes
# Room titles. Pair with ansi_reset() — a raw SGR run bleeds until cleared.
fn ansi_title(): i64 { return "\x1b[1;33m"; }   # bold yellow — room title
# The exits line; session_append_exits wraps label and dir words in one span.
fn ansi_exits(): i64 { return "\x1b[36m"; }     # cyan — exits line
# Player names — one colour for anything human, in room lists and examine.
fn ansi_actor(): i64 { return "\x1b[1;32m"; }   # bold green — players
# Hostile mobs; deliberately not ansi_actor so a mob never reads as a player.
fn ansi_mob(): i64   { return "\x1b[31m"; }     # red — hostiles

# List the mobs present in room `room` (one per line, red). The mob.cyr
# instance list hangs off the Room struct's RM_MOB_HEAD.
fn session_append_mobs(s, room): i64 {
    var m = room_mob_head(room_at(room));
    while (m != 0) {
        session_appendtx_cstr(s, ansi_mob());
        session_appendtx(s, mi_name_ptr(m), mi_name_len(m));
        session_appendtx_cstr(s, " is here");
        # Show wounds (a fresh, unhurt mob reads cleaner without the tag).
        if (mi_hp(m) < mt_hp(mi_tpl(m))) {
            session_appendtx_cstr(s, " (");
            session_appendtx_cstr(s, mob_condition(m));
            session_appendtx_cstr(s, ")");
        }
        session_appendtx_cstr(s, ".");
        session_appendtx_cstr(s, ansi_reset());
        session_appendtx_cstr(s, "\r\n");
        m = mi_next(m);
    }
    return 0;
}

# Append the exits line for room `r` (cyan label, dir words). Shared by
# session_show_room and the `exits` verb.
fn session_append_exits(s, r): i64 {
    session_appendtx_cstr(s, ansi_exits());
    session_appendtx_cstr(s, "Exits:");
    var any = 0;
    var d = 0;
    while (d < NDIR) {
        if (room_exit(r, d) >= 0) {
            session_appendtx_cstr(s, " ");
            session_appendtx_cstr(s, dir_name(d));
            any = 1;
        }
        d = d + 1;
    }
    if (any == 0) { session_appendtx_cstr(s, " none"); }
    session_appendtx_cstr(s, ansi_reset());
    session_appendtx_cstr(s, "\r\n");
    return 0;
}

# === M3 room display + movement ===
#
# session_show_room renders the room at SS_ROOM into the session tx queue:
# bold-yellow title, default-weight prose, cyan exits, green present
# players. room_append_present (in server.cyr, which owns the session
# list) adds the other players here.
fn session_show_room(s): i64 {
    var room = load64(s + SS_ROOM);
    if (room < 0) { return 0; }
    if (world_room_count() == 0) { return 0; }
    var r = room_at(room);

    session_appendtx_cstr(s, "\r\n");
    session_appendtx_cstr(s, ansi_title());
    session_appendtx(s, room_title_ptr(r), room_title_len(r));
    session_appendtx_cstr(s, ansi_reset());
    session_appendtx_cstr(s, "\r\n");
    session_appendtx(s, room_prose_ptr(r), room_prose_len(r));
    session_appendtx_cstr(s, "\r\n");
    session_append_exits(s, r);
    session_append_objs(s, room);   # forward ref → item.cyr
    session_append_mobs(s, room);
    room_append_present(s, room);   # forward ref → server.cyr
    return 0;
}

# Place a freshly-logged-in session into the world (start room) and show
# it. No-op when no zone is loaded (the M2-era placeholder verbs still
# answer). Announces the arrival to anyone already in the start room.
fn session_enter_world(s): i64 {
    if (world_room_count() == 0) { return 0; }
    var start = world_start_room();
    store64(s + SS_ROOM, start);
    room_broadcast(start, s, s, " flickers into being here.", "", "\r\n");
    session_show_room(s);
    return 0;
}

# Place a *loaded* player back into their recorded room (M6-E). Unlike
# session_enter_world this honours SS_ROOM (already resolved by
# player_auth_load, with a start-room fallback baked in).
fn session_resume_world(s): i64 {
    if (world_room_count() == 0) { return 0; }
    var room = load64(s + SS_ROOM);
    if (room < 0) { room = world_start_room(); store64(s + SS_ROOM, room); }
    room_broadcast(room, s, s, " re-materializes from the grid.", "", "\r\n");
    session_show_room(s);
    return 0;
}

# Move a session one step in `dir`. Validates the exit, broadcasts the
# departure / arrival to onlookers, and auto-looks the mover.
fn cmd_move(s, dir): i64 {
    if (world_room_count() == 0) {
        session_appendtx_cstr(s, "The way ");
        session_appendtx_cstr(s, dir_name(dir));
        session_appendtx_cstr(s, " is sealed — no zone is loaded.\r\n");
        return 0;
    }
    var cur = load64(s + SS_ROOM);
    if (cur < 0) { cur = world_start_room(); store64(s + SS_ROOM, cur); }

    var dest = room_exit(room_at(cur), dir);
    if (dest < 0) {
        session_appendtx_cstr(s, "You can't go that way.\r\n");
        return 0;
    }

    # Departure notice to the room being left, arrival to the room entered.
    room_broadcast(cur, s, s, " heads ", dir_name(dir), ".\r\n");
    store64(s + SS_ROOM, dest);
    room_broadcast(dest, s, s, " arrives.", "", "\r\n");
    session_show_room(s);
    return 0;
}

# Case-insensitive prefix match: is np[0..nl) (already lowercased) a
# prefix of name_buf[0..name_len)? Used to match a typed noun against a
# present player's name.
fn name_prefix_match(name_buf, name_len, np, nl): i64 {
    if (nl <= 0)        { return 0; }
    if (nl > name_len)  { return 0; }
    var i = 0;
    while (i < nl) {
        if (ascii_lower(load8(name_buf + i) & 0xFF) != (load8(np + i) & 0xFF)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# examine <noun> — inspect self, or a player present in the room. Objects
# and mobs (which carry the `keywords` scope the M2 resolver matches) land
# at M4/M5; until then the live scope is the room's players.
fn cmd_examine(s, pa): i64 {
    if (parsed_has_dobj(pa) == 0) {
        session_appendtx_cstr(s, "Examine what?\r\n");
        return 0;
    }
    var di = parsed_dobj(pa);
    if (tok_eq(pa, di, "me") == 1) { return examine_self(s); }
    if (tok_eq(pa, di, "self") == 1) { return examine_self(s); }

    var other = room_find_player(s, load64(s + SS_ROOM), tok_ptr(pa, di), tok_len(pa, di));
    if (other != 0) {
        session_appendtx_cstr(s, ansi_actor());
        session_appendtx_prose(s, load64(other + SS_NAME_BUF), load64(other + SS_NAME_LEN));   # M10-C name
        session_appendtx_cstr(s, ansi_reset());
        session_appendtx_cstr(s, " stands here, taking in the Under-Grid.\r\n");
        return 0;
    }
    # A mob in the room?
    var xp[8]; var xl[8];
    var xnth = qual_single(pa, di, &xp, &xl);
    var m = mob_in_room_by_kw_nth(load64(s + SS_ROOM), load64(&xp), load64(&xl), xnth);
    if (m != 0) {
        var tpl = mi_tpl(m);
        session_appendtx_cstr(s, ansi_mob());
        session_appendtx(s, mi_name_ptr(m), mi_name_len(m));
        session_appendtx_cstr(s, ansi_reset());
        session_appendtx_cstr(s, "\r\n");
        if (mt_desc_len(tpl) > 0) {
            session_appendtx(s, mt_desc_ptr(tpl), mt_desc_len(tpl));
            session_appendtx_cstr(s, "\r\n");
        }
        session_appendtx_cstr(s, "It looks ");
        session_appendtx_cstr(s, mob_condition(m));
        session_appendtx_cstr(s, ".\r\n");
        return 0;
    }
    # An object lying in the room, or one the player is carrying. Examining an
    # object renders its description — which for readables (the work-notice,
    # postings) IS the act of reading it.
    # H18 (1.6.9) — this line was the crash. Unguarded, it reached
    # room_at(-1) on a zone-less server and killed the process; `look`, `get`,
    # `drop`, `kill` and `exits` all check first, and examine did not.
    # Guarding only the ROOM half deliberately: a carried object needs no room,
    # so inventory still answers.
    var o = 0;
    if (session_room_ok(s) == 1) {
        o = ilist_find_kw_nth(room_obj_head(room_at(load64(s + SS_ROOM))), load64(&xp), load64(&xl), xnth);
    }
    if (o == 0) { o = ilist_find_kw_nth(load64(s + SS_INV), load64(&xp), load64(&xl), xnth); }
    if (o != 0) {
        session_appendtx_cstr(s, ansi_item());
        session_appendtx(s, oi_name_ptr(o), oi_name_len(o));
        session_appendtx_cstr(s, ansi_reset());
        session_appendtx_cstr(s, "\r\n");
        if (oi_desc_len(o) > 0) {
            session_appendtx(s, oi_desc_ptr(o), oi_desc_len(o));
            session_appendtx_cstr(s, "\r\n");
        }
        return 0;
    }
    session_appendtx_cstr(s, "You see no ");
    session_appendtx_tok(s, pa, di);
    session_appendtx_cstr(s, " here.\r\n");
    return 0;
}

# `examine me` / `examine self` — identity, vitals, attributes. The AC printed
# here is the base score: brace / bypass are applied at roll time by combat.cyr's
# player_eff_ac, so an active guard moves the swing, not this number. (stim
# rides on hit / damage instead, so it never shows up in this block at all.)
fn examine_self(s): i64 {
    session_appendtx_cstr(s, "You are ");
    session_appendtx_cstr(s, ansi_actor());
    session_appendtx_prose(s, load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN));   # M10-C name
    session_appendtx_cstr(s, ansi_reset());
    var cls = load64(s + SS_CLASS);
    if (cls >= 0) {
        session_appendtx_cstr(s, ", ");
        session_appendtx(s, class_name_ptr(cls), class_name_len(cls));   # forward ref → classes.cyr
    }
    session_appendtx_cstr(s, ".\r\n");
    # Vitals + attributes.
    session_appendtx_cstr(s, "  HP ");
    session_appendtx_num(s, load64(s + SS_HP));
    session_appendtx_cstr(s, "/");
    session_appendtx_num(s, load64(s + SS_MAXHP));
    session_appendtx_cstr(s, "   Energy ");
    session_appendtx_num(s, load64(s + SS_ENERGY));
    session_appendtx_cstr(s, "/");
    session_appendtx_num(s, load64(s + SS_MAXENERGY));
    session_appendtx_cstr(s, "\r\n");
    session_appendtx_cstr(s, "  STR ");
    session_appendtx_num(s, load64(s + SS_STR));
    session_appendtx_cstr(s, "  DEX ");
    session_appendtx_num(s, load64(s + SS_DEX));
    session_appendtx_cstr(s, "  CON ");
    session_appendtx_num(s, load64(s + SS_CON));
    session_appendtx_cstr(s, "  TEC ");
    session_appendtx_num(s, load64(s + SS_TEC));
    session_appendtx_cstr(s, "   AC ");
    session_appendtx_num(s, load64(s + SS_AC));
    session_appendtx_cstr(s, "\r\n");
    return 0;
}

# Dispatch one parsed command. `buf`/`len` is the original line (for
# case-preserving social echo). Sets SS_QUIT on `quit`.
fn cmd_dispatch(s, pa, buf, len): i64 {
    var verb = parsed_verb(pa);

    if (verb == VERB_UNKNOWN) {
        if (parser_count(pa) == 0) { return 0; }   # blank line — just re-prompt
        session_appendtx_cstr(s, "I don't understand \"");
        session_appendtx_tok(s, pa, 0);
        session_appendtx_cstr(s, "\".  Try \"help\".\r\n");
        return 0;
    }

    if (verb_is_movement(verb) == 1) {
        return cmd_move(s, verb_to_dir(verb));
    }

    if (verb == VERB_QUIT) {
        session_appendtx_cstr(s, "The Under-Grid releases you. Farewell.\r\n");
        store64(s + SS_QUIT, 1);
        return 0;
    }
    if (verb == VERB_HELP) { return cmd_help_text(s); }
    if (verb == VERB_SAVE) {
        if (load64(s + SS_AUTHED) == 0) {
            session_appendtx_cstr(s, "You have no persistent record to save.\r\n");
            return 0;
        }
        # H6 (1.6.3) — rate-limit the verb. player_save is ~1.2 ms, almost all of
        # it ed25519_sign, plus a file write, a rename and an audit append. With
        # SS_AUTHED as the only gate, 4 KB of "save\r" in one read was 819 signed
        # writes back to back. H5's dispatch cap already meters the rate; this
        # caps the work itself, and costs a legitimate player nothing — nobody
        # types `save` twice inside a second on purpose.
        #
        # Gated on SS_LAST_SAVE_MS, which persist.cyr has always WRITTEN and
        # nothing ever read. Deliberately NOT on SS_SAVE_DIRTY: cmd_on_line
        # re-sets that flag after cmd_dispatch returns, so every line in a burst
        # sees dirty == 1 and a dirty-gate would be a no-op against this exact
        # pattern.
        if (save_rate_limited(s) == 1) {
            session_appendtx_cstr(s, "Your progress is etched into the grid.\r\n");
            return 0;
        }
        if (player_save(s) == 1) { session_appendtx_cstr(s, "Your progress is etched into the grid.\r\n"); }
        else { session_appendtx_cstr(s, "Save failed — the grid rejected the write.\r\n"); }
        return 0;
    }
    if (verb == VERB_PASSWD) { return passwd_begin(s); }   # 0.8.1 (persist.cyr)

    if (verb == VERB_LOOK) {
        if (world_room_count() == 0) { session_appendtx_cstr(s, "Darkness. No zone is loaded.\r\n"); return 0; }
        session_show_room(s);
        return 0;
    }
    if (verb == VERB_EXITS) {
        if (world_room_count() == 0) { session_appendtx_cstr(s, "No exits — no zone is loaded.\r\n"); return 0; }
        session_append_exits(s, room_at(load64(s + SS_ROOM)));
        return 0;
    }
    if (verb == VERB_EXAMINE)   { return cmd_examine(s, pa); }
    if (verb == VERB_INVENTORY) { return cmd_inventory(s); }
    if (verb == VERB_WHO)       { return cmd_who(s); }

    if (verb == VERB_GET)  { return cmd_get(s, pa); }
    if (verb == VERB_DROP) { return cmd_drop(s, pa); }
    if (verb == VERB_PUT)  { return cmd_put(s, pa); }
    if (verb == VERB_GIVE) { return cmd_give(s, pa); }
    if (verb == VERB_WEAR)   { return cmd_equip_stub(s, pa, verb); }
    if (verb == VERB_REMOVE) { return cmd_equip_stub(s, pa, verb); }
    if (verb == VERB_WIELD)  { return cmd_equip_stub(s, pa, verb); }

    if (verb == VERB_SAY)   { return cmd_say(s, buf, len); }
    if (verb == VERB_TELL)  { return cmd_tell(s, pa, buf, len); }
    if (verb == VERB_EMOTE) { return cmd_emote(s, buf, len); }

    if (verb == VERB_KILL)  { return cmd_kill(s, pa); }
    if (verb == VERB_FLEE)  { return cmd_flee(s); }
    if (verb_is_ability(verb) == 1) { return cmd_ability(s, pa, verb); }

    # Remaining item verbs all take a direct object.
    return cmd_object(s, pa, verb);
}

# Handle a line entered at the command prompt (PHASE_CMD). `@stats` stays
# an admin verb outside the world table (M1-H); everything else routes
# through the M2 verb-noun parser. render_stats lives in server.cyr,
# where the observability counters do (resolved as a forward reference).
fn cmd_on_line(s, buf, len): i64 {
    # @-admin namespace — only live when YD_ADMIN enabled it (0.9.1). When
    # off, these fall through to the parser and read as unknown commands.
    if (g_admin_enabled == 1) {
        if (name_eq_ci(buf, len, "@stats") == 1) {
            render_stats(s);
            session_send_cmd_prompt(s);
            return 0;
        }
        if (name_eq_ci(buf, len, "@who") == 1) {        # 0.8.3 (server.cyr)
            render_who(s);
            session_send_cmd_prompt(s);
            return 0;
        }
        if (name_eq_ci(buf, len, "@reset") == 1) {      # 0.8.3 (server.cyr)
            render_reset(s);
            session_send_cmd_prompt(s);
            return 0;
        }
    }
    if (g_parser == 0) { g_parser = parser_new(); }
    parser_parse(g_parser, buf, len);
    cmd_dispatch(s, g_parser, buf, len);
    # Any in-world command may mutate persistent state; flag for the
    # debounced save sweep (M6-D). Cheap; the sweep only writes if set.
    if (load64(s + SS_AUTHED) == 1) { store64(s + SS_SAVE_DIRTY, 1); }
    # Re-prompt only if still at the command prompt — a verb that switches
    # phase (e.g. `passwd` → PHASE_CHPASS_NEW, 0.8.1) sent its own prompt.
    if (load64(s + SS_QUIT) == 0) {
        if (load64(s + SS_PHASE) == PHASE_CMD) { session_send_cmd_prompt(s); }
    }
    return 0;
}

# === session_on_line — dispatch one complete decoded line by phase. ===
#
# `buf` / `len` is the line with its CR / LF terminator already stripped.
fn session_on_line(s, buf, len): i64 {
    var ph = load64(s + SS_PHASE);
    if (ph == PHASE_NAME)        { return login_on_name(s, buf, len); }
    if (ph == PHASE_PASS)        { return login_on_pass(s, buf, len); }       # M6 auth (persist.cyr)
    if (ph == PHASE_NEWPASS)     { return login_on_newpass(s, buf, len); }
    if (ph == PHASE_CONFIRMPASS) { return login_on_confirm(s, buf, len); }
    if (ph == PHASE_CHPASS_NEW)     { return chpass_on_new(s, buf, len); }      # 0.8.1 passwd (persist.cyr)
    if (ph == PHASE_CHPASS_CONFIRM) { return chpass_on_confirm(s, buf, len); }
    if (ph == PHASE_CLASS)       { return login_on_class(s, buf, len); }      # classes.cyr
    return cmd_on_line(s, buf, len);
}

# === session_push_line_byte — append one decoded data byte to the line. ===
# Returns 1 if this byte completed a line and dispatched it, else 0 — the
# signal session_consume_rx meters its per-event work by (H5, 1.6.2).
#
# CR is the canonical line terminator. CR LF collapses to one line: the
# CR dispatches, then the paired LF arrives with the line already empty
# and is dropped. A lone LF (Unix-style `nc` clients) terminates a
# non-empty line too. Over-long lines (no terminator within LINE_CAP)
# reset with a wire warning — M2 will reject these as a parse error.
fn session_push_line_byte(s, b): i64 {
    var ln = load64(s + SS_LINE_BUF);
    var len = load64(s + SS_LINE_LEN);
    # During passphrase entry the client is in server-echo (character) mode —
    # session_echo_off raised WILL ECHO — so the server draws the line: a '*'
    # mask per char, an erase on backspace, and the CR LF. For normal input the
    # client line-echoes, so the server stays silent (no double echo).
    var phase = load64(s + SS_PHASE);
    var is_pass = 0;
    if (phase == PHASE_PASS)           { is_pass = 1; }
    if (phase == PHASE_NEWPASS)        { is_pass = 1; }
    if (phase == PHASE_CONFIRMPASS)    { is_pass = 1; }
    if (phase == PHASE_CHPASS_NEW)     { is_pass = 1; }
    if (phase == PHASE_CHPASS_CONFIRM) { is_pass = 1; }

    if (b == 13) {
        # H5 (1.6.2) — an empty line is not a command. The LF branch below has
        # always had this guard; CR never did, so 4096 bare CRs in one write
        # dispatched 4096 empty lines, each paying a full login attempt. Costs
        # nothing legitimate: a player pressing Enter on a blank prompt gets the
        # same re-prompt either way.
        if (len == 0) { return 0; }
        if (is_pass == 1) { session_appendtx_cstr(s, "\r\n"); }
        session_on_line(s, ln, len);
        store64(s + SS_LINE_LEN, 0);
        return 1;
    }
    if (b == 10) {
        # len == 0 here is the LF half of a CR LF pair — absorb it.
        if (len == 0) { return 0; }
        if (is_pass == 1) { session_appendtx_cstr(s, "\r\n"); }
        session_on_line(s, ln, len);
        store64(s + SS_LINE_LEN, 0);
        return 1;
    }
    # Backspace (BS) / DEL: drop the last buffered byte; in masked mode erase it
    # on screen too (back-space-back).
    if (b == 8 || b == 127) {
        if (len > 0) {
            store64(s + SS_LINE_LEN, len - 1);
            if (is_pass == 1) { session_appendtx_cstr(s, "\b \b"); }
        }
        return 0;
    }
    # Ignore other control bytes (telnet IAC is already stripped upstream).
    if (b < 32) { return 0; }
    if (len >= LINE_CAP) {
        store64(s + SS_LINE_LEN, 0);
        session_appendtx_cstr(s, "(line too long — buffer reset)\r\n");
        return 0;
    }
    store8(ln + len, b);
    store64(s + SS_LINE_LEN, len + 1);
    if (is_pass == 1) {
        var star[1];
        store8(&star + 0, 42);   # '*'
        session_appendtx(s, &star, 1);
    }
    return 0;
}

# === session_consume_rx — Telnet-decode pending rx bytes. ===
#
# Feeds every raw byte read this round through the per-session Telnet
# parser. IAC sequences are consumed by the state machine; any reply it
# queues (option negotiation) is copied into our tx queue so it goes out
# in on-wire order ahead of application data. Decoded data bytes flow
# into the line accumulator, which dispatches complete lines to
# session_on_line. The raw rx buffer is scratch — fully consumed here,
# so SS_RX_LEN resets to 0 on return.
# E2 (1.6.10) — the same consumer, with the line cap supplied by the caller and
# the number of lines actually dispatched reported back through `out_fired`.
#
# `drain_pending_rx` needs both. It runs inside the tick over EVERY session, so
# it has to spend a budget shared across the whole walk rather than let each
# session take a fixed slice — and it can only spend that budget accurately if
# it learns how many lines a session really fired, not how many it was offered.
# Charging the full slice to a session that had one line queued would starve the
# rest of the list for no work done.
fn session_consume_rx_max(s, maxlines, out_fired): i64 {
    var rx = load64(s + SS_RX_BUF);
    var len = load64(s + SS_RX_LEN);
    var ts = load64(s + SS_TS);
    var i = 0;
    var fired = 0;
    while (i < len) {
        if (fired >= maxlines) { i = i; break; }
        # 1.7.0 — the charge window. Checked at the TOP of the loop, at the same
        # cut point the line cap already uses: byte `i` has not been fed yet, so
        # the retained tail still starts on a byte boundary and the split-IAC
        # hazard this function's tail comment describes is untouched.
        #
        # The bound is sampled from the CURRENT phase, before the line is
        # dispatched, because dispatching is what changes the phase.
        var bound = line_crypto_bound(load64(s + SS_PHASE));
        if (charge_stop(charge_spent(), g_charge_cap, bound) == 1) { i = i; break; }
        var ev = telnet_feed(ts, load8(rx + i));
        # Drain any negotiation reply into the tx queue before the data
        # byte, preserving RFC 854 on-wire ordering.
        var txl = telnet_tx_len(ts);
        if (txl > 0) {
            session_appendtx(s, telnet_tx_buf(ts), txl);
            telnet_tx_consume(ts);
        }
        if (ev == EV_DATA) {
            fired = fired + session_push_line_byte(s, telnet_data_byte(ts) & 0xFF);
        }
        # EV_SB / EV_NONE: nothing for the application at M1-C/M1-D.
        i = i + 1;
    }
    # Retain whatever the cap left unread. The resume point is a BYTE index, not
    # a line index: telnet_feed is a byte-at-a-time state machine and an IAC
    # sequence can straddle the cut, so stopping mid-sequence and resuming
    # anywhere else would resurrect exactly the split-IAC bug that machine exists
    # to handle. Shift the tail down (dst < src, so a forward copy is safe) and
    # record the new length; session_on_readable appends after it, and
    # drain_pending_rx (server.cyr) gives it another capped pass each tick — epoll
    # is level-triggered on socket data, so it will NOT re-fire for bytes already
    # sitting in this buffer.
    store64(out_fired, fired);
    if (i < len) {
        var rem = len - i;
        var k = 0;
        while (k < rem) { store8(rx + k, load8(rx + i + k)); k = k + 1; }
        store64(s + SS_RX_LEN, rem);
        return 1;
    }
    store64(s + SS_RX_LEN, 0);
    return 0;
}

# The event-path consumer: one session, the full RX_MAX_LINES slice. Unchanged
# behaviour — this is the H5 (1.6.2) dispatch cap, and every existing caller
# still gets exactly it.
fn session_consume_rx(s): i64 {
    var fired[8];
    return session_consume_rx_max(s, RX_MAX_LINES, &fired);
}

# === session_is_idle — has this session been silent past the limit? ===
#
# Pure predicate over SS_LAST_MS (updated on every inbound byte). The
# tick sweep (server.cyr) uses it to reap slowloris-style quiet clients.
# Returns 1 if (now - last) >= timeout_ms.
# G2 (1.6.13) — an unauthenticated session gets a much shorter deadline.
#
# 1.6.3 added MAX_SESSIONS, which was half of the original finding; the other
# half — a *separate, shorter* timeout for connections that have not logged in —
# was never implemented, and the finding was closed anyway. So a socket that
# connects and never authenticates held an fd and a session slot for the full
# five minutes, the same as a player mid-game.
#
# The two deadlines are not the same job. A logged-in player is idle because
# they walked away and should be given room; a connection that has not named
# itself in 30 seconds is either broken or probing, and neither deserves a slot.
# Hardcoded rather than a knob: ADR 0007 §6 freezes the YD_* set for 1.x.
enum PreAuthConst { PREAUTH_TIMEOUT_MS = 30000; }

# Has this session been silent past its deadline? Logged-in players get
# `timeout_ms`; a session that has not authenticated gets the shorter of that
# and PREAUTH_TIMEOUT_MS — never longer. See the block above for why they differ.
fn session_is_idle(s, now_ms, timeout_ms): i64 {
    var limit = timeout_ms;
    if (load64(s + SS_AUTHED) == 0) {
        if (PREAUTH_TIMEOUT_MS < limit) { limit = PREAUTH_TIMEOUT_MS; }
    }
    if (now_ms - load64(s + SS_LAST_MS) >= limit) { return 1; }
    return 0;
}

# === session_on_readable — pull bytes from the socket into rx. ===
#
# Returns 1 if the session should stay alive, 0 if it should be torn
# down (clean EOF or socket error).
# G1 (1.6.12) — the caller supplies the line budget and learns what was spent.
#
# `session_on_readable(s, now_ms)` remains, delegating with the full
# RX_MAX_LINES slice, so nothing that only handles one session changes. The
# event loops use this form because they walk MANY sessions per pass and have to
# spend a budget across the whole walk — see the EVENT_LINES_MAX block in
# server.cyr for why a per-session cap was never a bound on a loop.
fn session_on_readable_max(s, now_ms, maxlines, out_fired): i64 {
    var rx = load64(s + SS_RX_BUF);
    var len = load64(s + SS_RX_LEN);
    var fd = load64(s + SS_FD);
    var done = 0;
    var alive = 1;
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos: sys_read on a socket fd is the BLOCKING recv adapter, which would
    # park the single-threaded poll loop on an idle session. Use the NON-BLOCKING
    # sock_recv #49 directly (tagged fd → conn_id). Return sense is INVERTED from
    # Linux: >0 = bytes, 0 = WOULD_BLOCK (drained — keep alive), -1 = EOF/error.
    var conn = _agnos_fd_conn(fd);
    while (done == 0) {
        var room = RX_CAP - len;
        if (room <= 0) { done = 1; continue; }
        var n = sys_sock_recv(conn, rx + len, room);
        if (n == 0) { done = 1; continue; }             # WOULD_BLOCK — nothing more now
        if (n < 0) { alive = 0; done = 1; continue; }   # EOF / error — drop
        len = len + n;
    }
    #else
    while (done == 0) {
        var room = RX_CAP - len;
        if (room <= 0) { done = 1; continue; }
        var n = sys_read(fd, rx + len, room);
        if (n < 0) {
            # EAGAIN → the socket is drained. Anything else → real error.
            if (n != 0 - 11) { alive = 0; }
            done = 1;
            continue;
        }
        if (n == 0) {
            # Clean EOF.
            alive = 0;
            done = 1;
            continue;
        }
        len = len + n;
    }
    #endif
    store64(s + SS_RX_LEN, len);
    if (len > 0) { store64(s + SS_LAST_MS, now_ms); }
    session_consume_rx_max(s, maxlines, out_fired);
    return alive;
}

# One session, the full RX_MAX_LINES slice — the H5 (1.6.2) dispatch cap,
# unchanged for every caller that is not walking a list.
fn session_on_readable(s, now_ms): i64 {
    var fired[8];
    return session_on_readable_max(s, now_ms, RX_MAX_LINES, &fired);
}
