# item.cyr — M4-E/F objects: templates, instances, corpses, loot.
#
# Object templates load from a CYML `<zone>.objs.cyml` (ADR 0005,
# `kind = "obj"`). An instance is a live object that can sit in a room, in
# a container (a corpse), or in a player's inventory — all the same
# intrusive list (OI_NEXT), differing only in which head it hangs off.
#
# A corpse is a synthesized container instance (no template): killing a
# mob leaves "the corpse of <mob>" in the room, holding the mob's loot.
# `get all from corpse` (the M2 parser already produces the structure)
# moves a corpse's contents into the player's inventory.

# === Object template layout ===
enum OT {
    OT_ID       = 0;     # inline id (OT_ID_CAP)
    OT_ID_LEN   = 32;
    OT_NAME     = 40;    # inline display name (OT_NAME_CAP)
    OT_NAME_LEN = 104;
    OT_KW       = 112;   # inline keywords, NUL-terminated (OT_KW_CAP)
    OT_KW_LEN   = 176;
    OT_DESC_PTR = 184;
    OT_DESC_LEN = 192;
    OT_SIZE     = 200;
}
enum OtCap { OT_ID_CAP = 32; OT_NAME_CAP = 64; OT_KW_CAP = 64; }

# === Object instance layout ===
enum OI {
    OI_NEXT      = 0;    # intrusive list (room / inventory / corpse)
    OI_CONTENTS  = 8;    # head of contained items (containers / corpses)
    OI_IS_CORPSE = 16;   # 1 for a synthesized corpse
    OI_NAME      = 24;   # inline display name (OI_NAME_CAP)
    OI_NAME_LEN  = 88;
    OI_KW        = 96;   # inline keywords, NUL-terminated (OI_KW_CAP)
    OI_KW_LEN    = 160;
    OI_DESC_PTR  = 168;
    OI_DESC_LEN  = 176;
    OI_TPL_ID    = 184;  # inline originating template id (M6 inventory persist)
    OI_TPL_ID_LEN = 216;
    OI_AGE       = 224;  # ticks since a corpse was created (M12-A); unused on items
    OI_SIZE      = 232;
}
enum OiCap { OI_NAME_CAP = 64; OI_KW_CAP = 64; OI_TPL_ID_CAP = 32; }

var g_obj_tpls      = 0;
var g_obj_tpl_count = 0;

# === Template accessors ===
fn ot_at(i): i64        { return g_obj_tpls + i * OT_SIZE; }

# === Instance accessors ===
fn oi_next(o): i64       { return load64(o + OI_NEXT); }
# Head of the contained-item list — nonzero only for containers / corpses.
fn oi_contents(o): i64   { return load64(o + OI_CONTENTS); }
# 1 for a synthesized corpse. get/take consult this to refuse hauling bodies.
fn oi_is_corpse(o): i64  { return load64(o + OI_IS_CORPSE); }
# Display name, copied inline at mint — corpses have no template to borrow one.
fn oi_name_ptr(o): i64   { return o + OI_NAME; }
# Name length; capped to OI_NAME_CAP-1 on copy, so the inline tail stays NUL.
fn oi_name_len(o): i64   { return load64(o + OI_NAME_LEN); }
# Keyword blob fed to kw_matches — one item answers to several parser nouns.
fn oi_kw_ptr(o): i64     { return o + OI_KW; }       # NUL-terminated
# Borrowed pointer into the parsed CYML body; the instance does not own it.
fn oi_desc_ptr(o): i64   { return load64(o + OI_DESC_PTR); }
# Length of that borrowed body. 0 for corpses, which carry no authored prose.
fn oi_desc_len(o): i64   { return load64(o + OI_DESC_LEN); }

# === Intrusive list ops. `slot` is the ADDRESS of the head pointer
# (room+RM_OBJ_HEAD, session+SS_INV, or corpse+OI_CONTENTS). ===
# === M12-A/B — returning objects to the freelist. ===
#
# The free rule: **free only where an instance leaves the object graph
# entirely.** Not at ilist_remove — that is the *move* primitive (cmd_get does
# remove-then-push), and freeing there would destroy every `get`. Until corpse
# decay landed there was no exit at all: every object minted since boot was
# still reachable from some room, inventory or corpse, and nothing was ever
# reclaimed because alloc() has no free().
#
# obj_free takes the whole subtree — a corpse owns its loot through OI_CONTENTS,
# so decaying one must free what is inside it or the contents become
# unreachable *and* unfreed, which is the leak wearing a different hat.
fn obj_free(o): i64 {
    if (o == 0) { return 0; }
    var c = load64(o + OI_CONTENTS);
    while (c != 0) {
        var nxt = oi_next(c);
        obj_free(c);
        c = nxt;
    }
    g_obj_live = g_obj_live - 1;
    fl_free(o);
    return 0;
}

# === H2 — return a disconnecting player's inventory to the freelist. ===
#
# `session_free` frees the rx / tx / line / name buffers and the ident block, and
# has never touched SS_INV — so every object a player was carrying leaked at
# disconnect. Remotely driven and unbounded: connect, `get all`, `quit`, repeat.
# 1.4.0 gave objects a free path but only wired it to corpse decay; this is the
# other end of the same job.
#
# The items are genuinely leaving the object graph here — the save record stores
# inventory by TEMPLATE ID (persist.cyr's `inv` field), not by instance, so the
# player gets them back on next login from a fresh `item_new`. Nothing else can
# reach these instances once the session is gone, which is exactly the condition
# M12-B's free rule requires.
#
# Call this BEFORE session_free, and only from the disconnect path — dropping a
# live player's inventory anywhere else would destroy what they are carrying.
fn session_drop_inv(s): i64 {
    var o = load64(s + SS_INV);
    while (o != 0) {
        var nxt = oi_next(o);      # capture before the free
        obj_free(o);
        o = nxt;
    }
    store64(s + SS_INV, 0);
    return 0;
}

# Push `o` onto the front of the intrusive list at `slot`. O(1) and
# order-agnostic — nothing in the game depends on inventory or room-object
# ordering, so the cheapest insertion wins.
fn ilist_push(slot, o): i64 {
    store64(o + OI_NEXT, load64(slot));
    store64(slot, o);
    return 0;
}
# Unlink `o` from the list at `slot` and clear its OI_NEXT, so a single-item
# move (remove-then-push) leaves no stale link into the old list. Bulk moves
# that zero the whole head afterward — player_drop_all — skip this.
# A no-op if `o` isn't on that list — callers move items they just found.
fn ilist_remove(slot, o): i64 {
    var head = load64(slot);
    if (head == o) { store64(slot, oi_next(o)); store64(o + OI_NEXT, 0); return 0; }
    var prev = head;
    while (prev != 0) {
        if (oi_next(prev) == o) {
            store64(prev + OI_NEXT, oi_next(o));
            store64(o + OI_NEXT, 0);
            return 0;
        }
        prev = oi_next(prev);
    }
    return 0;
}
# The `nth` (1-based) item in the list whose keywords the noun prefixes, or 0
# if the list holds fewer than `nth` matches. Scan order is list order, which
# for ilist_push is most-recently-added first — the same order `look` and
# `inventory` print, so "2." means the second one the player can see.
fn ilist_find_kw_nth(head, np, nl, nth): i64 {
    if (nth < 1) { return 0; }
    var seen = 0;
    var o = head;
    while (o != 0) {
        if (kw_matches(np, nl, oi_kw_ptr(o)) == 1) {
            seen = seen + 1;
            if (seen == nth) { return o; }
        }
        o = oi_next(o);
    }
    return 0;
}
# First item in the list whose keywords the noun prefixes, or 0.
fn ilist_find_kw(head, np, nl): i64 { return ilist_find_kw_nth(head, np, nl, 1); }

# === world_load_objs — parse a `<zone>.objs.cyml` into templates. ===
fn world_load_objs(path): i64 {
    var r = cyml_parse_file_r(path);
    if (is_ok(r) == 0) { return WL_ERR_IO; }
    var doc = result_unwrap(r);
    var n = cyml_doc_entry_count(doc);
    if (n <= 0)          { return WL_ERR_EMPTY; }
    if (n > MAX_ENTRIES) { return WL_ERR_OVERCAP; }

    # H9 (1.6.5) — build into the global, but publish the COUNT only on the
    # success return below. Every `return WL_ERR_*` in the parse loop sits after
    # this point, so setting the count here meant a rejected file left a live,
    # partly-filled table behind: cmd_serve printed "no zone loaded" / "no mobs
    # loaded" and every `world_room_count() == 0` guard in session.cyr,
    # combat.cyr, item.cyr and server.cyr was defeated at the same moment. A
    # player could log in, walk into the prefix that did parse, and be stranded
    # in a room with no exits — with the operator told the load had failed.
    # Zeroing first is what makes cmd_serve's documented non-fatal behaviour
    # ("the server still runs, with the verbs answering their no-zone
    # placeholders") actually true.
    g_obj_tpls = alloc(n * OT_SIZE);
    memset(g_obj_tpls, 0, n * OT_SIZE);
    g_obj_tpl_count = 0;   # published on success only

    var i = 0;
    while (i < n) {
        var e = cyml_doc_entry(doc, i);
        var hs = str_new(cyml_entry_header(e), cyml_entry_header_len(e));
        var secs = toml_parse(hs);
        if (vec_len(secs) == 0) { return WL_ERR_NOID; }
        var pairs = toml_section_pairs(vec_get(secs, 0));

        var kind = toml_get(pairs, "kind");
        if (kind == 0) { return WL_ERR_KIND; }
        if (str_eq_cstr(kind, "obj") == 0) { return WL_ERR_KIND; }

        var t = ot_at(i);
        var id = toml_get(pairs, "id");
        if (id == 0) { return WL_ERR_NOID; }
        # H11 (1.6.6) — OT_ID_CAP - 1, not OT_ID_CAP. The template wrote up to
        # 32 bytes while item_new copies an instance's OI_TPL_ID at
        # OI_TPL_ID_CAP - 1 (31), so a 32-byte authored id was truncated on the
        # way into the instance and could never match its own template on
        # reload — the save record stores inventory BY that id. Capping both at
        # CAP - 1 keeps them NUL-terminated and round-trippable.
        store64(t + OT_ID_LEN, copy_str_capped(t + OT_ID, OT_ID_CAP - 1, id));
        var name = toml_get(pairs, "name");
        if (name != 0) { store64(t + OT_NAME_LEN, copy_str_capped(t + OT_NAME, OT_NAME_CAP - 1, name)); }
        var kw = toml_get(pairs, "keywords");
        if (kw != 0) { store64(t + OT_KW_LEN, copy_str_capped(t + OT_KW, OT_KW_CAP - 1, kw)); }
        store64(t + OT_DESC_PTR, cyml_entry_body(e));
        store64(t + OT_DESC_LEN, cyml_entry_body_len(e));
        i = i + 1;
    }
    g_obj_tpl_count = n;   # H9 — publish only now that every entry parsed
    return n;
}

# Template whose id is the `len` bytes at `buf`, or 0. `buf` is a slice of a
# space-separated id list (loot / room spawns), not a NUL-terminated string,
# so the length is compared first and the bytes never read past `len`.
fn obj_tpl_by_id(buf, len): i64 {
    var i = 0;
    while (i < g_obj_tpl_count) {
        var t = ot_at(i);
        if (load64(t + OT_ID_LEN) == len) {
            var a = t + OT_ID;
            var j = 0; var same = 1;
            while (j < len) {
                if ((load8(a + j) & 0xFF) != (load8(buf + j) & 0xFF)) { same = 0; j = len; }
                j = j + 1;
            }
            if (same == 1) { return t; }
        }
        i = i + 1;
    }
    return 0;
}

# === item_new — a fresh instance of object template `tpl`. ===
fn item_new(tpl): i64 {
    var o = fl_alloc(OI_SIZE);   # M12-B: freelist, not the bump allocator
    g_obj_live = g_obj_live + 1;   # M12-D
    memset(o, 0, OI_SIZE);
    store64(o + OI_NAME_LEN, copy_bytes_capped(o + OI_NAME, OI_NAME_CAP - 1, tpl + OT_NAME, load64(tpl + OT_NAME_LEN)));
    store64(o + OI_KW_LEN,   copy_bytes_capped(o + OI_KW,   OI_KW_CAP - 1,   tpl + OT_KW,   load64(tpl + OT_KW_LEN)));
    store64(o + OI_DESC_PTR, load64(tpl + OT_DESC_PTR));
    store64(o + OI_DESC_LEN, load64(tpl + OT_DESC_LEN));
    var idn = copy_bytes_capped(o + OI_TPL_ID, OI_TPL_ID_CAP - 1,
    tpl + OT_ID, load64(tpl + OT_ID_LEN));
    store64(o + OI_TPL_ID_LEN, idn);
    return o;
}

# Id of the template this instance was minted from; inline for M6 save/load.
fn oi_tpl_id_ptr(o): i64 { return o + OI_TPL_ID; }
# 0 for corpses / template-less items, which is what keeps them out of respawn.
fn oi_tpl_id_len(o): i64 { return load64(o + OI_TPL_ID_LEN); }

# Copy up to `cap` raw bytes; return bytes copied. (str-free variant of
# copy_str_capped, for inline-to-inline template copies.)
fn copy_bytes_capped(dst, cap, src, len): i64 {
    var n = len;
    if (n > cap) { n = cap; }
    var i = 0;
    while (i < n) { store8(dst + i, load8(src + i) & 0xFF); i = i + 1; }
    return n;
}

# === corpse_new — a container instance "the corpse of <name>". ===
fn corpse_new(name_ptr, name_len): i64 {
    var o = fl_alloc(OI_SIZE);   # M12-B: freelist, not the bump allocator
    g_obj_live = g_obj_live + 1;   # M12-D
    memset(o, 0, OI_SIZE);
    store64(o + OI_IS_CORPSE, 1);
    # name = "the corpse of " + mob name (bounded).
    var lead = "the corpse of ";
    var pos = 0;
    pos = pos + copy_bytes_capped(o + OI_NAME + pos, OI_NAME_CAP - 1 - pos, lead, strlen(lead));
    pos = pos + copy_bytes_capped(o + OI_NAME + pos, OI_NAME_CAP - 1 - pos, name_ptr, name_len);
    store64(o + OI_NAME_LEN, pos);
    # keywords: just "corpse" (NUL-terminated by memset tail).
    copy_bytes_capped(o + OI_KW, OI_KW_CAP - 1, "corpse", 6);
    store64(o + OI_KW_LEN, 6);
    return o;
}

# === corpse_of — fill the combat hook: drop a loot-bearing corpse. ===
# Called from mob_died (combat.cyr). Builds the corpse, spawns the mob's
# loot into it, and pushes it onto the room's object list.
fn corpse_of(m, room): i64 {
    var tpl = mi_tpl(m);
    var corpse = corpse_new(mt_name_ptr(tpl), mt_name_len(tpl));
    # Spawn loot from the template's `loot` id list into the corpse.
    var loot = mt_loot(tpl);
    if (loot != 0) {
        var p = str_data(loot);
        var len = str_len(loot);
        var i = 0;
        while (i < len) {
            if ((load8(p + i) & 0xFF) == 32) { i = i + 1; continue; }
            var start = i;
            while (i < len) { if ((load8(p + i) & 0xFF) == 32) { break; } i = i + 1; }
            var ot = obj_tpl_by_id(p + start, i - start);
            if (ot != 0) { ilist_push(corpse + OI_CONTENTS, item_new(ot)); }
        }
    }
    ilist_push(room_at(room) + RM_OBJ_HEAD, corpse);
    return 0;
}

# === player_drop_all — dump the player's inventory into the room. ===
# Called on player death (combat.cyr). Moves every inventory item to the
# room's object list.
fn player_drop_all(s, room): i64 {
    var o = load64(s + SS_INV);
    while (o != 0) {
        var nxt = oi_next(o);
        ilist_push(room_at(room) + RM_OBJ_HEAD, o);
        o = nxt;
    }
    store64(s + SS_INV, 0);
    return 0;
}

# === ANSI for items (handled here to keep item prose self-contained). ===
fn ansi_item(): i64 { return "\x1b[33m"; }   # yellow — objects / corpses

# List the objects in room `room`, one per line. Called from
# session_show_room (forward ref from session.cyr).
fn session_append_objs(s, room): i64 {
    var o = room_obj_head(room_at(room));
    while (o != 0) {
        session_appendtx_cstr(s, ansi_item());
        session_appendtx(s, oi_name_ptr(o), oi_name_len(o));
        session_appendtx_cstr(s, " lies here.");
        session_appendtx_cstr(s, ansi_reset());
        session_appendtx_cstr(s, "\r\n");
        o = oi_next(o);
    }
    return 0;
}

# Append one item's display name (yellow).
fn append_item_name(s, o): i64 {
    session_appendtx_cstr(s, ansi_item());
    session_appendtx(s, oi_name_ptr(o), oi_name_len(o));
    session_appendtx_cstr(s, ansi_reset());
    return 0;
}

# === get_from — move item(s) from `from_slot` to `to_slot`. ===
# qall=1 with noun_l==0 → everything (skipping corpses); qall=1 with a
# noun → every match; qall=0 → the first match. `where` names the source
# for the not-found message.
fn get_from(s, from_slot, to_slot, qall, np, nl, nth, where): i64 {
    if (qall == 1) {
        var moved = 0;
        var o = load64(from_slot);
        while (o != 0) {
            var nxt = oi_next(o);
            var take = 1;
            if (oi_is_corpse(o) == 1) { take = 0; }                 # never auto-take corpses
            if (nl > 0) { if (kw_matches(np, nl, oi_kw_ptr(o)) == 0) { take = 0; } }
            if (take == 1) {
                ilist_remove(from_slot, o);
                ilist_push(to_slot, o);
                session_appendtx_cstr(s, "You take ");
                append_item_name(s, o);
                session_appendtx_cstr(s, ".\r\n");
                moved = moved + 1;
            }
            o = nxt;
        }
        if (moved == 0) { session_appendtx_cstr(s, "There is nothing to take.\r\n"); }
        return 0;
    }
    var o = ilist_find_kw_nth(load64(from_slot), np, nl, nth);
    if (o == 0) {
        session_appendtx_cstr(s, "There is nothing like that ");
        session_appendtx_cstr(s, where);
        session_appendtx_cstr(s, ".\r\n");
        return 0;
    }
    if (oi_is_corpse(o) == 1) {
        session_appendtx_cstr(s, "You can't carry that.\r\n");
        return 0;
    }
    ilist_remove(from_slot, o);
    ilist_push(to_slot, o);
    session_appendtx_cstr(s, "You take ");
    append_item_name(s, o);
    session_appendtx_cstr(s, ".\r\n");
    return 0;
}

# === cmd_get — get <item> [from <container>], get all [from <corpse>]. ===
fn cmd_get(s, pa): i64 {
    if (world_room_count() == 0) { session_appendtx_cstr(s, "There is nothing here.\r\n"); return 0; }
    if (parsed_has_dobj(pa) == 0) { session_appendtx_cstr(s, "Get what?\r\n"); return 0; }
    var di = parsed_dobj(pa);
    var room = load64(s + SS_ROOM);
    var room_slot = room_at(room) + RM_OBJ_HEAD;
    var inv_slot = s + SS_INV;

    var kind[8]; var num[8]; var bp[8]; var bl[8];
    qual_parse(pa, di, &kind, &num, &bp, &bl);
    var qall = 0;
    if (load64(&kind) == QUAL_ALL) { qall = 1; }
    var np = load64(&bp);
    var nl = load64(&bl);
    var nth = 1;
    if (load64(&kind) == QUAL_NTH) { nth = load64(&num); }

    # get X from <container>
    if (parsed_prep(pa) == PREP_FROM) {
        if (parsed_has_iobj(pa) == 1) {
            var ii = parsed_iobj(pa);
            var cp[8]; var cl[8];
            var cnth = qual_single(pa, ii, &cp, &cl);
            var container = ilist_find_kw_nth(load64(room_slot), load64(&cp), load64(&cl), cnth);
            if (container == 0) {
                session_appendtx_cstr(s, "You see no ");
                session_appendtx_tok(s, pa, ii);
                session_appendtx_cstr(s, " here.\r\n");
                return 0;
            }
            return get_from(s, container + OI_CONTENTS, inv_slot, qall, np, nl, nth, "in there");
        }
    }
    # get X from the room
    return get_from(s, room_slot, inv_slot, qall, np, nl, nth, "here");
}

# === cmd_drop — drop <item> / drop all from inventory to the room. ===
fn cmd_drop(s, pa): i64 {
    if (world_room_count() == 0) { session_appendtx_cstr(s, "There is nowhere to drop it.\r\n"); return 0; }
    if (parsed_has_dobj(pa) == 0) { session_appendtx_cstr(s, "Drop what?\r\n"); return 0; }
    var di = parsed_dobj(pa);
    var inv_slot = s + SS_INV;
    var room_slot = room_at(load64(s + SS_ROOM)) + RM_OBJ_HEAD;

    var kind[8]; var num[8]; var bp[8]; var bl[8];
    qual_parse(pa, di, &kind, &num, &bp, &bl);
    var np = load64(&bp);
    var nl = load64(&bl);

    if (load64(&kind) == QUAL_ALL) {
        var moved = 0;
        var o = load64(inv_slot);
        while (o != 0) {
            var nxt = oi_next(o);
            var take = 1;
            if (nl > 0) { if (kw_matches(np, nl, oi_kw_ptr(o)) == 0) { take = 0; } }
            if (take == 1) {
                ilist_remove(inv_slot, o);
                ilist_push(room_slot, o);
                session_appendtx_cstr(s, "You drop ");
                append_item_name(s, o);
                session_appendtx_cstr(s, ".\r\n");
                moved = moved + 1;
            }
            o = nxt;
        }
        if (moved == 0) { session_appendtx_cstr(s, "You have nothing to drop.\r\n"); }
        return 0;
    }
    var nth = 1;
    if (load64(&kind) == QUAL_NTH) { nth = load64(&num); }
    var o = ilist_find_kw_nth(load64(inv_slot), np, nl, nth);
    if (o == 0) { session_appendtx_cstr(s, "You aren't carrying that.\r\n"); return 0; }
    ilist_remove(inv_slot, o);
    ilist_push(room_slot, o);
    session_appendtx_cstr(s, "You drop ");
    append_item_name(s, o);
    session_appendtx_cstr(s, ".\r\n");
    return 0;
}

# === cmd_put — put <item> [in <container>]. ===
#
# H12 (1.6.7) — `put` answered the M2-era placeholder ("the Under-Grid is empty
# — items arrive at M3") for four releases after M3 landed. It is the exact
# inverse of `get X from Y`, and like that verb it treats any object as able to
# hold things: 1.x objects carry no container flag, so the two halves agree
# rather than one of them inventing a rule the other does not enforce.
#
# Nesting is capped at one level — a container that already holds something
# cannot itself go into another. That is a real game rule ("empty it first"),
# but it is load-bearing: obj_free walks OI_CONTENTS recursively, so unbounded
# nesting is unbounded stack, and a cycle would not terminate at all. Depth 1
# makes both impossible by construction instead of by argument.
fn cmd_put(s, pa): i64 {
    if (parsed_has_dobj(pa) == 0) { session_appendtx_cstr(s, "Put what?\r\n"); return 0; }
    if (parsed_has_iobj(pa) == 0) {
        session_appendtx_cstr(s, "Put it in what?\r\n");
        return 0;
    }
    if (world_room_count() == 0) { session_appendtx_cstr(s, "There is nothing here.\r\n"); return 0; }

    var di = parsed_dobj(pa);
    var inv_slot = s + SS_INV;
    var room_slot = room_at(load64(s + SS_ROOM)) + RM_OBJ_HEAD;

    var np[8]; var nl[8];
    var nth = qual_single(pa, di, &np, &nl);
    var o = ilist_find_kw_nth(load64(inv_slot), load64(&np), load64(&nl), nth);
    if (o == 0) { session_appendtx_cstr(s, "You aren't carrying that.\r\n"); return 0; }

    # The container: something in the room, or something else being carried.
    var ii = parsed_iobj(pa);
    var cp[8]; var cl[8];
    var cnth = qual_single(pa, ii, &cp, &cl);
    var c = ilist_find_kw_nth(load64(room_slot), load64(&cp), load64(&cl), cnth);
    if (c == 0) { c = ilist_find_kw_nth(load64(inv_slot), load64(&cp), load64(&cl), cnth); }
    if (c == 0) {
        session_appendtx_cstr(s, "You see no ");
        session_appendtx_tok(s, pa, ii);
        session_appendtx_cstr(s, " here.\r\n");
        return 0;
    }
    if (c == o) {
        session_appendtx_cstr(s, "It won't hold itself.\r\n");
        return 0;
    }
    if (oi_contents(o) != 0) {
        session_appendtx_cstr(s, "It's full — empty it first.\r\n");
        return 0;
    }

    ilist_remove(inv_slot, o);
    ilist_push(c + OI_CONTENTS, o);
    session_appendtx_cstr(s, "You put ");
    append_item_name(s, o);
    session_appendtx_cstr(s, " in ");
    append_item_name(s, c);
    session_appendtx_cstr(s, ".\r\n");
    return 0;
}

# === cmd_give — give <item> [to <player>]. ===
#
# H12 (1.6.7) — the second half of the placeholder repair. Hands an object from
# one inventory to another; the recipient must be a logged-in player standing in
# the same room, which room_find_player already enforces (PHASE_CMD + same room,
# viewer excluded so `give x to <self>` never resolves).
#
# The recipient is flushed immediately, exactly as `tell` does — an item that
# arrives silently and only surfaces on the next command reads as a lost item.
fn cmd_give(s, pa): i64 {
    if (parsed_has_dobj(pa) == 0) { session_appendtx_cstr(s, "Give what?\r\n"); return 0; }
    if (parsed_has_iobj(pa) == 0) {
        session_appendtx_cstr(s, "Give it to whom?\r\n");
        return 0;
    }

    var di = parsed_dobj(pa);
    var inv_slot = s + SS_INV;
    var np[8]; var nl[8];
    var nth = qual_single(pa, di, &np, &nl);
    var o = ilist_find_kw_nth(load64(inv_slot), load64(&np), load64(&nl), nth);
    if (o == 0) { session_appendtx_cstr(s, "You aren't carrying that.\r\n"); return 0; }
    if (oi_is_corpse(o) == 1) { session_appendtx_cstr(s, "You can't hand that over.\r\n"); return 0; }

    var ii = parsed_iobj(pa);
    var target = room_find_player(s, load64(s + SS_ROOM), tok_ptr(pa, ii), tok_len(pa, ii));
    if (target == 0) {
        session_appendtx_cstr(s, "There is no ");
        session_appendtx_tok(s, pa, ii);
        session_appendtx_cstr(s, " here.\r\n");
        return 0;
    }

    ilist_remove(inv_slot, o);
    ilist_push(target + SS_INV, o);

    session_appendtx_cstr(s, "You give ");
    append_item_name(s, o);
    session_appendtx_cstr(s, " to ");
    session_appendtx_prose(s, load64(target + SS_NAME_BUF), load64(target + SS_NAME_LEN));   # M10-C name
    session_appendtx_cstr(s, ".\r\n");

    session_appendtx_cstr(target, "\r\n");
    session_appendtx_prose(target, load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN));        # M10-C name
    session_appendtx_cstr(target, " gives you ");
    append_item_name(target, o);
    session_appendtx_cstr(target, ".\r\n");
    deliver_to(target);
    return 0;
}

# === cmd_inventory — list what the player carries. ===
fn cmd_inventory(s): i64 {
    var o = load64(s + SS_INV);
    if (o == 0) { session_appendtx_cstr(s, "You carry nothing.\r\n"); return 0; }
    session_appendtx_cstr(s, "You are carrying:\r\n");
    while (o != 0) {
        session_appendtx_cstr(s, "  ");
        append_item_name(s, o);
        session_appendtx_cstr(s, "\r\n");
        o = oi_next(o);
    }
    return 0;
}

# === M7-D — object respawn (reapply authored room object spawns) ==========
# A room's `objects` spawn list is reapplied without duplicating objects
# already present: an authored id is (re)spawned only if no object instance
# in the room already carries that template id (OI_TPL_ID). Used both at
# boot (room empty → spawns all authored) and on zone reset. Corpses /
# dropped loot carry no template id, so they never block or get matched.

# Does this instance carry template id `idptr[0..idlen)`?
fn _oi_id_eq(o, idptr, idlen): i64 {
    if (oi_tpl_id_len(o) != idlen) { return 0; }
    var j = 0;
    while (j < idlen) {
        if ((load8(oi_tpl_id_ptr(o) + j) & 0xFF) != (load8(idptr + j) & 0xFF)) { return 0; }
        j = j + 1;
    }
    return 1;
}

# Count matching instances on one intrusive list, DESCENDING into containers.
fn _obj_id_count_list(head, idptr, idlen): i64 {
    var n = 0;
    var o = head;
    while (o != 0) {
        if (_oi_id_eq(o, idptr, idlen) == 1) { n = n + 1; }
        var inner = oi_contents(o);
        if (inner != 0) { n = n + _obj_id_count_list(inner, idptr, idlen); }
        o = oi_next(o);
    }
    return n;
}

# === E5 (1.6.10) — count an authored id across the WHOLE world. ===
#
# `_obj_id_present` used to scan the top-level object list of the single room
# being topped up. Two ways to defeat it, and the reset then minted a duplicate
# that nothing ever reclaims — `obj_free` is reached only from corpse decay and
# from a disconnecting player's inventory, so a duplicate is permanent:
#
#   1. Carry the object to another room and drop it. The home room reads as
#      "missing" forever. Pre-existing; named verbatim in server.cyr's H11
#      comment as "an unbounded fl_alloc growth path driven by ordinary play".
#   2. **Hide it in place, inside a container.** The scan walked `oi_next` and
#      never descended `OI_CONTENTS`. **This one is ours** — it did not exist
#      before 1.6.7 added `put`. Reproduced live in market.stalls: `get optic`
#      → `put optic in shard` → `@reset` → `objs +1`, a duplicate on the floor
#      with the original still in the shard, once per reset cycle, unbounded.
#
# So the question the reset asks is now the right one: not "is this id in this
# room" but "does the world already hold as many of this id as the zone authors".
# That is the classic max-exist count, and it fixes both drivers at once — a
# relocated object still lets its home room restock (the population is short by
# one), while a hidden or duplicated one does not (the population is already
# full). Player inventories count too, or logging in with an authored item in
# hand would restock the world for free.
fn _obj_id_world_count(idptr, idlen): i64 {
    var n = 0;
    var ri = 0;
    while (ri < g_room_count) {
        n = n + _obj_id_count_list(room_obj_head(room_at(ri)), idptr, idlen);
        ri = ri + 1;
    }
    var s = g_session_head;                      # forward ref → server.cyr
    while (s != 0) {
        n = n + _obj_id_count_list(load64(s + SS_INV), idptr, idlen);
        s = load64(s + SS_NEXT);
    }
    return n;
}

# How many times the zone authors this id, across every room's `objects` list.
# The reset's ceiling: the world may hold this many and no more.
fn _obj_id_authored_count(idptr, idlen): i64 {
    var n = 0;
    var ri = 0;
    while (ri < g_room_count) {
        var sp = room_objspawn(room_at(ri));
        if (sp != 0) {
            var p = str_data(sp);
            var len = str_len(sp);
            var i = 0;
            while (i < len) {
                if ((load8(p + i) & 0xFF) == 32) { i = i + 1; continue; }
                var start = i;
                while (i < len) { if ((load8(p + i) & 0xFF) == 32) { break; } i = i + 1; }
                if (i - start == idlen) {
                    var j = 0;
                    var same = 1;
                    while (j < idlen) {
                        if ((load8(p + start + j) & 0xFF) != (load8(idptr + j) & 0xFF)) { same = 0; j = idlen; }
                        else { j = j + 1; }
                    }
                    if (same == 1) { n = n + 1; }
                }
            }
        }
        ri = ri + 1;
    }
    return n;
}

# Should the reset skip this id for this room? Yes when the room already holds
# one (the original per-room rule, so a full room never double-stocks), or when
# the world is already at the authored ceiling for it.
fn _obj_id_present(ri, idptr, idlen): i64 {
    if (_obj_id_count_list(room_obj_head(room_at(ri)), idptr, idlen) > 0) { return 1; }
    if (_obj_id_world_count(idptr, idlen) >= _obj_id_authored_count(idptr, idlen)) { return 1; }
    return 0;
}

# Respawn one room's authored `objects` ids, skipping any already present, and
# return how many were spawned. Boot and reset share this path: an empty room
# spawns the full set, a picked-over one only refills the gaps.
# The space-separated id list is walked in place off the room's str — no split
# buffer — though every spawn still allocates one OI_SIZE instance.
fn zone_reset_room_objs(ri): i64 {
    var s = room_objspawn(room_at(ri));
    if (s == 0) { return 0; }
    var p = str_data(s);
    var len = str_len(s);
    var spawned = 0;
    var i = 0;
    while (i < len) {
        if ((load8(p + i) & 0xFF) == 32) { i = i + 1; continue; }
        var start = i;
        while (i < len) { if ((load8(p + i) & 0xFF) == 32) { break; } i = i + 1; }
        var idlen = i - start;
        if (_obj_id_present(ri, p + start, idlen) == 0) {
            var tpl = obj_tpl_by_id(p + start, idlen);
            if (tpl != 0) {
                ilist_push(room_at(ri) + RM_OBJ_HEAD, item_new(tpl));
                spawned = spawned + 1;
            }
        }
    }
    return spawned;
}

# Reapply object spawns across every room. Returns objects spawned. At boot
# the rooms are empty so this places the full authored set; on reset it only
# refills what's gone.
fn zone_reset_objs(): i64 {
    var spawned = 0;
    var ri = 0;
    while (ri < g_room_count) {
        spawned = spawned + zone_reset_room_objs(ri);
        ri = ri + 1;
    }
    return spawned;
}

# === M12-A — corpse decay. ===
#
# Corpses were never removed from a room. Every kill left one on the floor for
# the process lifetime: unbounded memory on a long-lived server, and rooms that
# silently fill with the dead. This is the first place an object genuinely
# leaves the graph, which makes it the first place obj_free is safe to call.
#
# CORPSE_TICKS is a hardcoded constant, deliberately NOT an env knob:
# [ADR 0007](../docs/adr/0007-frozen-1.0-surface.md) §6 freezes the YD_* knob
# names and semantics for all of 1.x, so adding YD_CORPSE_TICKS here would be a
# frozen-surface change and belongs to 2.0. 120 ticks is 5 minutes at the
# standard 2.5 s cadence — long enough to walk back and loot, well inside the
# 15-minute zone reset.
enum CorpseDecay { CORPSE_TICKS = 120; }

# Age every corpse in `ri` by one tick and free those past the limit, along
# with whatever loot is still inside them. Returns the number decayed.
fn corpse_decay_room(ri): i64 {
    var slot = room_at(ri) + RM_OBJ_HEAD;
    var o = load64(slot);
    var freed = 0;
    while (o != 0) {
        var nxt = oi_next(o);
        if (oi_is_corpse(o) == 1) {
            var age = load64(o + OI_AGE) + 1;
            store64(o + OI_AGE, age);
            if (age >= CORPSE_TICKS) {
                ilist_remove(slot, o);   # off the graph first, then free
                obj_free(o);
                freed = freed + 1;
            }
        }
        o = nxt;
    }
    return freed;
}

# Sweep every room. Driven once per tick from advance_tick; O(objects in the
# world), which at Hub scale is tens — the 50 ms p99 drift budget is untroubled,
# but re-measure with bench_combat if the world grows past a few hundred.
fn corpse_decay_sweep(): i64 {
    var freed = 0;
    var ri = 0;
    while (ri < g_room_count) {
        freed = freed + corpse_decay_room(ri);
        ri = ri + 1;
    }
    return freed;
}
