# server.cyr — M1-A/M1-B event loop + per-session lifecycle.
#
# Single-thread epoll loop per ADR 0003. Owns the listener fd, the
# signalfd (SIGINT / SIGTERM for clean shutdown), the 2.5 s combat-tick
# scheduler, and every connected Session.
#
# Each accepted client gets a heap-allocated Session (see session.cyr)
# whose pointer is the epoll user-data tag. The fd is registered for
# EPOLLIN immediately; EPOLLOUT is added on demand via session_set_out
# whenever a write would block, and removed when the tx queue drains.

# === Constants ===

enum ServerConst {
    DEFAULT_PORT     = 4000;   # classic DikuMUD-family port; 23 is privileged
    LISTEN_BACKLOG   = 32;
    TICK_MS          = 2500;   # ADR 0001 — 2.5 s combat tick
    MAX_EPOLL_EVENTS = 64;
    # H6 (1.6.3) — concurrent-session ceiling, and how many ticks the listener
    # stands down after a real accept error. 256 sessions is far above anything
    # this single-threaded loop serves comfortably and far below a default
    # 1024-fd limit, leaving headroom for the listener, signalfd, epoll fd, save
    # files and the audit store.
    MAX_SESSIONS       = 256;
    ACCEPT_BACKOFF_TICKS = 4;
    # H1 (1.6.14) — the epoll_event layout, PER ARCHITECTURE.
    #
    # This was a bare `12` with the data read at `+4`, which is the x86_64
    # *packed* layout only. aarch64 Linux leaves the struct unpacked: 16 bytes
    # with the u64 at offset 8. So on ARM the loop would have read a session
    # pointer out of the wrong bytes and dereferenced it.
    #
    # The stdlib already knows this — `epoll_event_new` has separate x86_64 and
    # aarch64 versions and the aarch64 one carries a comment explaining the
    # split. Descent used that helper to WRITE events and then hardcoded its own
    # constants to READ them back, so the write path was portable and the read
    # path was not. These two constants are the read path's half of the same
    # fact, and `_ev_scratch` below is what keeps the two in step.
    EPOLL_EVENT_SIZE = 12;
    EPOLL_DATA_OFF   = 4;
}

# aarch64 Linux: unpacked 16-byte epoll_event, data at +8. Overrides the
# x86_64 values above. Kept adjacent to them so the two cannot drift apart.
#ifdef CYRIUS_ARCH_AARCH64
enum EpollArch64 {
    EPOLL_EVENT_SIZE_A64 = 16;
    EPOLL_DATA_OFF_A64   = 8;
}
#endif

# Tags discriminating epoll user-data values. Listener + signalfd carry
# these literal tags; per-session events carry the Session pointer
# (heap addresses are always > both literals).
enum FdTag {
    TAG_LISTENER = 1;
    TAG_SIGNAL   = 2;
}

#ifdef CYRIUS_TARGET_AGNOS
# agnos's syscall peer defines no epoll event-mask constants (epoll there
# watches only signalfd/timerfd, and sys_epoll_ctl is 3-arg — no event struct).
# descent's agnos poll loop never epoll-watches sockets, but dispatch_session's
# shared `events & EPOLLIN` test still needs the bit defined to compile + read.
enum AgnosEpollCompat {
    EPOLLIN  = 1;
    EPOLLOUT = 4;
}
#endif

# === fcntl helper — set O_NONBLOCK on an fd ===
fn set_nonblock(fd): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos sockets are inherently non-blocking — sock_accept#57 / sock_recv#49
    # never park, and there is no fcntl in the frozen 0–59 syscall surface. No-op.
    return 0;
    #else
    var flags = syscall(SYS_FCNTL, fd, 3, 0);                # F_GETFL
    if (flags < 0) { return flags; }
    return syscall(SYS_FCNTL, fd, 4, flags | O_NONBLOCK);    # F_SETFL
    #endif
}

# === Block SIGINT / SIGTERM and return a signalfd watching them ===
fn install_signal_fd(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no sigset / signalfd in the frozen surface. The agnos serve loop
    # (cmd_serve) never installs one — shutdown is process-kill / in-band. The
    # Linux-only sigset_new/sigset_add/SIG_BLOCK/sys_signalfd symbols would be
    # undefined for CYRIUS_TARGET_AGNOS, so the body must be gated out entirely.
    return 0 - 1;
    #else
    var mask = sigset_new();
    sigset_add(mask, SIGINT);
    sigset_add(mask, SIGTERM);
    var pr = sys_sigprocmask(SIG_BLOCK, mask, 0);
    if (pr < 0) { return pr; }
    return sys_signalfd(0 - 1, mask, 0);
    #endif
}

# === Epoll registration helpers ===

# Register `fd` for EPOLLIN, tagging its events with `data_tag` — a literal
# FdTag for the listener / signalfd, or the Session pointer for a client.
# Read-arming only; EPOLLOUT is added later on demand by session_set_out.
# The epoll_event stride and data offset for THIS target. Both the reader (the
# dispatch loop) and the writer (ev_scratch) go through these, so a layout that
# is right for one is right for the other by construction — which is exactly what
# was not true before H1.
fn epoll_ev_size(): i64 {
    #ifdef CYRIUS_ARCH_AARCH64
    return EPOLL_EVENT_SIZE_A64;
    #endif
    return EPOLL_EVENT_SIZE;
}
# Byte offset of the u64 tag inside an epoll_event on this target.
fn epoll_data_off(): i64 {
    #ifdef CYRIUS_ARCH_AARCH64
    return EPOLL_DATA_OFF_A64;
    #endif
    return EPOLL_DATA_OFF;
}

# H2 (1.6.14) — ONE reusable event struct, not one per call.
#
# `epoll_event_new` allocates 16 bytes from the bump allocator, which has no
# free — so every accept and every EPOLLOUT arm/disarm leaked 16 bytes for the
# life of the process. Tiny, but unbounded and entirely avoidable: `epoll_ctl`
# copies the struct, so it is dead the moment the syscall returns and a single
# buffer serves every call. Single-threaded event loop (ADR 0003), so there is
# no aliasing hazard.
#
# Writing it here rather than calling the stdlib helper also puts the write and
# the read on the SAME layout constants — which is the actual fix for H1. The
# helper was correct; having two sources of truth was not.
var g_ev_scratch = 0;
# Fill the shared event struct and return it. Valid only until the next call —
# epoll_ctl copies it, so no caller needs it to outlive the syscall.
fn ev_scratch(events, data): i64 {
    if (g_ev_scratch == 0) { g_ev_scratch = alloc(16); }
    store32(g_ev_scratch, events);
    store64(g_ev_scratch + epoll_data_off(), data);
    return g_ev_scratch;
}

# Register `fd` for EPOLLIN, tagging its events with `data_tag` — a literal
# FdTag for the listener / signalfd, or the Session pointer for a client.
# Read-arming only; EPOLLOUT is added on demand by session_set_out.
fn epoll_add_in(epfd, fd, data_tag): i64 {
    #ifndef CYRIUS_TARGET_AGNOS
    var ev = ev_scratch(EPOLLIN, data_tag);
    return sys_epoll_ctl(epfd, EPOLL_CTL_ADD, fd, ev);
    #endif
    # agnos: never called (the poll loop sweeps g_session_head); epoll_event_new
    # + 4-arg sys_epoll_ctl are Linux-only. Stub so the file compiles --agnos.
    return 0;
}

# Toggle EPOLLOUT on a session's fd. `armed` = 1 adds it, 0 removes it.
# Updates the session's SS_OUT_ARMED slot; no-op if already in the
# requested state.
fn session_set_out(epfd, s, armed): i64 {
    if (load64(s + SS_OUT_ARMED) == armed) { return 0; }
    #ifndef CYRIUS_TARGET_AGNOS
    var ev_mask = EPOLLIN;
    if (armed == 1) { ev_mask = EPOLLIN | EPOLLOUT; }
    var ev = ev_scratch(ev_mask, s);
    sys_epoll_ctl(epfd, EPOLL_CTL_MOD, load64(s + SS_FD), ev);
    #endif
    # agnos: no epoll; the poll loop flushes every session each sweep, so tx
    # backpressure needs no EPOLLOUT arming — we just track the intended state.
    store64(s + SS_OUT_ARMED, armed);
    return 0;
}

# === Bring up a listener on INADDR_ANY:port ===
fn open_listener(port): i64 {
    var sr = tcp_socket();
    if (is_ok(sr) == 0) { return 0 - err_code_of(sr); }
    var sfd = result_unwrap(sr);
    sock_reuse(sfd);
    var br = sock_bind(sfd, INADDR_ANY(), port);
    if (is_ok(br) == 0) { sock_close(sfd); return 0 - err_code_of(br); }
    var lr = sock_listen(sfd, LISTEN_BACKLOG);
    if (is_ok(lr) == 0) { sock_close(sfd); return 0 - err_code_of(lr); }
    var nr = set_nonblock(sfd);
    if (nr < 0) { sock_close(sfd); return nr; }
    return sfd;
}

# === Tick advance — M1-A placeholder, M4-A fills in. ===

var g_tick_count = 0;
# Ticks between debounced save sweeps (M6-D). Computed at serve start from
# g_tick_ms so a real run saves every ~5 min; 0 disables (no zone / tests).
var g_save_interval_ticks = 0;

# Persist every authed session that has changed since its last save. Walks
# the active list defensively (player_save never unlinks, but mirror the
# idle-sweep pattern). Queued by the tick — never inline in a command path.
# === H16 (1.6.8) — meter the autosave, don't fire it all at once. ===
#
# This used to run once every 300 s and save EVERY dirty session in one pass,
# inline in the tick. Measured: 42.4 ms at 32 dirty sessions (85% of the ADR
# 0001 50 ms budget) and 340.9 ms at MAX_SESSIONS=256 — 682% of budget, and 13.6%
# of the whole 2.5 s interval, in a single tick.
#
# It ran unnoticed because the schedule is absolute: a sub-interval overrun is
# absorbed by the next epoll_wait timeout and `@stats` reports 0 ms drift
# straight through it. The tick was not late; it was simply gone for a third of
# a second, and nothing in the server could see that.
#
# The cost is 89% ed25519_sign (1.178 ms of 1.322 ms per save) and only ~5% file
# I/O, so batching writes is not the lever — doing fewer SIGNS per tick is the
# only lever. Hence: run every tick, save at most SAVE_BATCH_MAX sessions, and
# move the cadence from the sweep to the session (save_sweep_due). Per-session
# behaviour is unchanged at 5 minutes; the burst is gone.
#
# Deliberately NOT a cross-tick cursor, which is what the finding proposed. The
# full 256-session scan with the complete predicate measures 950 ns — 1/1400th
# of one save — so a cursor optimises something already free, and buys a
# session pointer held across ticks in exchange. SS_SIZE lands in a freelist
# class that fl_free does not zero and the next accept re-issues, so a cursor
# would be the exact shape of use-after-free that H1 and M12-C already exist to
# prevent. Not worth it for 950 ns.
#
# Throughput check, because "a cap" is only safe if the queue drains: sessions
# become eligible at most MAX_SESSIONS per SAVE_SWEEP_MIN_MS = 2.13 per tick
# against a drain rate of 4, so ~53% utilisation and the backlog is stable. Head
# bias cannot starve the tail either — a session that loses a batch is strictly
# more overdue on the next tick. The only slow case is a synchronised cohort:
# all 256 eligible on one tick puts the last one 64 ticks (160 s) late.
enum SaveSweepConst {
    SAVE_BATCH_MAX = 4;   # 4 x 1.32 ms = 5.3 ms worst case, 10.6% of the budget
}
# Autosave whichever sessions are due, up to SAVE_BATCH_MAX of them. Returns how
# many were written. Called every tick; the cadence lives on the session, in
# save_sweep_due. See the block above for the throughput argument.
fn save_sweep(): i64 {
    var now = clock_now_ms();
    var budget = SAVE_BATCH_MAX;
    var saved = 0;
    var s = g_session_head;
    while (s != 0) {
        if (budget == 0) { return saved; }
        var nxt = load64(s + SS_NEXT);
        if (load64(s + SS_AUTHED) == 1) {
            if (save_sweep_due(s, now) == 1) {
                # H10 (1.6.5) — a discarded failure here is silent data loss on
                # a five-minute cadence. The player is still connected and has no
                # idea; the audit chain is the only durable record.
                if (player_save(s) != 1) {
                    audit_keyed(AK_SAVE_FAIL_SWEEP, SEV_WARNING, "save.fail.sweep",
                    load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), clock_now_ms());
                }
                budget = budget - 1;
                saved = saved + 1;
            }
        }
        s = nxt;
    }
    return saved;
}

# === M7 — zone resets ====================================================
# Reset interval override (seconds) for testing/ops; 0 = use the authored
# g_zone_reset_secs. Read from YD_RESET_SECS at serve start.
var g_reset_secs_override = 0;

# === M12-C — drop every session reference to a mob instance. ===
#
# Called from mob_died before the instance leaves the room list. Until 1.4.0
# `mob_died` cleared only the *killing* session's SS_TARGET, so a second player
# who had also typed `kill drone` kept a pointer to the dead mob across ticks.
#
# That was inert only because nothing was ever reclaimed: combat_round's
# `mi_hp(m) <= 0` guard read the corpse's memory, saw a dead mob, and
# disengaged. The moment M12-B started freeing instances, that same read became
# a use-after-free — and worse, fl_free returns the block to a size class that
# the very next mob_spawn re-issues, so the stale pointer would resolve to a
# *live, different* mob rather than obviously-dead memory.
#
# Deferring the free to end-of-tick does not help; the reference outlives the
# tick. The reference has to go, not the timing. Forward-referenced from
# combat.cyr, which is included ahead of this file (same shape as
# room_combat_line).
fn sessions_forget_mob(m): i64 {
    var s = g_session_head;
    while (s != 0) {
        if (load64(s + SS_TARGET) == m) { store64(s + SS_TARGET, 0); }
        s = load64(s + SS_NEXT);
    }
    return 0;
}

# === H1 — drop every mob's reference to a session. ===
#
# The mirror of sessions_forget_mob, and the same hazard pointing the other way.
# `drop_session` frees a Session on quit / idle-reap / socket close, but nothing
# walked the mob lists, so a mob that the player had engaged (`cmd_kill` does
# `mi_set_target(m, s)`) kept MI_TARGET pointing at freed memory.
#
# That was inert until 1.5.0 — before the actor tick, MI_TARGET was only ever
# COMPARED (`combat_disengage`'s `if (mi_target(m) == s)`), never followed. M13's
# `_mob_assist` reads it and then dereferences: `var s = mi_target(other);
# ... load64(s + SS_ROOM)`. So the actor tick turned a dormant dangling pointer
# into a live use-after-free, and `fl_free` hands the block to the size class the
# next `session_new` draws from — meaning the read can land on a *live, different*
# player and hand that session to a second mob as its target.
#
# Exactly the shape M12-C fixed for sessions→mobs. Clearing the reference is the
# fix; deferring the free is not, because the reference outlives any tick.
fn mobs_forget_session(s): i64 {
    var ri = 0;
    while (ri < g_room_count) {
        var m = room_mob_head(room_at(ri));
        while (m != 0) {
            if (mi_target(m) == s) { mi_set_target(m, 0); }
            m = mi_next(m);
        }
        ri = ri + 1;
    }
    return 0;
}

# === H5 (1.6.2) — give sessions with retained rx bytes another capped pass. ===
#
# session_consume_rx now stops after RX_MAX_LINES dispatches and keeps the rest
# of the buffer. epoll is level-triggered on SOCKET data (nothing in this tree
# sets EPOLLET), so once those bytes are off the socket and into rx it will not
# fire again for them — without this sweep a capped remainder would sit
# unprocessed until the client happened to send more.
#
# Metering per tick rather than per event is the whole point: a burst that used
# to be paid in one 65-second stall is now spread across ticks at RX_MAX_LINES
# each, and the loop stays responsive to everyone else throughout.
# === E1 + E2 (1.6.10) — the tick honours SS_QUIT, and the drain has a budget. ===
#
# Two defects, one walk, so one edit.
#
# **E1 — SS_QUIT was advisory on this path.** Exactly one place acted on it:
# `dispatch_session`, which runs only when an epoll event arrives for that fd.
# A session whose rx buffer still held queued lines therefore kept being fed 8
# lines per tick *after the server had decided to close it*, and on the
# returning-player path every one of those lines is a full `player_auth_load`
# (read + parse + 3 hex decodes + ed25519_verify, measured 7.66 ms).
#
# So `MAX_LOGIN_FAILS` did not bound anything. The sweep observed SS_FAILS
# climbing 7, 15, 23, 31, 39, 47 across six consecutive ticks with SS_QUIT
# already 1 and the session still on `g_session_head` — a cap believed enforced
# since 1.6.2 and enforced nowhere. Measured ~64 ms per such session per tick,
# linear in session count: ~4.1 s per tick at 64 sessions.
#
# **E2 — the drain had no aggregate budget.** `RX_MAX_LINES` is a PER-SESSION
# cap and this walks every session, so the real bound was 8 x session count x
# whatever the most expensive line costs. Measured 2.2 s in a single tick at
# MAX_SESSIONS — 88% of the whole 2.5 s interval, from ~1 MB of attacker input.
# This is the identical shape H16 fixed for `save_sweep` in 1.6.8; the argument
# in that comment block applies here verbatim and simply was not carried over.
#
# The budget is in LINES and shared across the whole walk, not sessions, so a
# session with one queued line costs one line rather than a whole slice. No
# cross-tick cursor, for the reason H16 gives: SS_SIZE lands in a freelist class
# `fl_free` does not zero and the next accept re-issues, so a retained session
# pointer is the H1 / M12-C use-after-free shape. Head bias is acceptable here
# in a way it would not be for saves — a serviced session's remainder shrinks
# every pass, so the head drains and moves on rather than staying eligible.
# G1 (1.6.12) — lines dispatched across ONE event-loop pass, all sessions
# together. Sized like DRAIN_LINES_MAX below: 16 x the costliest line an
# attacker can queue (~8.1 ms for a wrong-passphrase verify) is the worst case,
# and unlike the drain this budget is spent BEFORE the tick check, so it is the
# one that decides whether a tick can be swallowed whole.
enum EventBudget { EVENT_LINES_MAX = 16; }
enum DrainConst {
    # 1.7.0 — THIS COMMENT USED TO DO THE ARITHMETIC, AND IT WAS WRONG.
    #
    # It read: "16 x ~1.08 ms (the costliest unauthenticated line, a keypair
    # derivation) = ~17 ms, about a third of the ADR 0001 50 ms p99 drift
    # budget." Every clause of that was false or unfounded:
    #
    #   - A keypair derivation was NOT the costliest unauthenticated line. A
    #     wrong passphrase against a name that exists was, at ~8.2 ms — seven
    #     times more — because it paid a full ed25519_verify. The correct figure
    #     was already written down twice within thirty lines of here (the E1
    #     block above says "measured 7.66 ms"; the EVENT_LINES_MAX block says
    #     "~8.1 ms for a wrong-passphrase verify"). This comment used neither.
    #   - So the real worst case was 16 x 8.2 = 131 ms, not 17 ms.
    #   - ADR 0001 contains no 50 ms figure at all. It says tick drift under load
    #     is load-bearing and points at the M4 gate. The number lives in the
    #     roadmap and the benches, which is why three gates could disagree about
    #     it without anything failing.
    #
    # Both halves are now fixed. The reorder in player_auth_load makes a wrong
    # passphrase cost ~1.07 ms, so the 1.08 ms premise is finally TRUE; and the
    # bound no longer rests on a premise at all, because PASS_CHARGE_MAX meters
    # what the line actually consumed. This count stays at 16 as a BACKSTOP for
    # cost the meter cannot see (a `look` in a room full of dropped items), and
    # keeping the value buys a property worth having: 1.7.0 can only ever admit
    # FEWER lines than 1.6.15 did, never more. It is a strict refinement.
    DRAIN_LINES_MAX = 16;
}

# === PASS_CHARGE_MAX — the real bound (1.7.0). ===
#
# ONE constant for BOTH dispatch sites, on purpose: ADR 0003 has two loops, and
# three of the last four findings in this file were one loop capped and the other
# not. A single name cannot be updated in one place and forgotten in the other.
#
# Four constraints fix it at 20 units (= 5000 us of charged work per window):
#   1. A sustained pass stays inside a fifth of the drift allowance:
#      2 windows x 20 x 250 us = 10 000 us <= 50 000 / 5.          OK
#   2. It admits the dearest UNAUTHENTICATED line from the cap rather than by
#      luck of the progress clause: CHG_DERIVE + CHG_SIGN = 17 <= 20.  OK
#   3. It does not admit two of them: 17 + 17 = 34 > 20.            OK
#   4. It is below the dearest line overall, so the worst a window can overrun
#      is max(cap, dearest) and not cap + dearest: 20 < 54.         OK
#
# Worst realised window, by what the peer sends: one successful login (13.5 ms,
# via the progress clause), or two wrong passphrases (3.4 ms), or one 4 kB `say`
# to a full room (6.5 ms), or sixteen `look`s (1.2 ms, count-bound).
# === g_rx_backlog — the re-arm (1.7.0). ===
#
# A metered pass is only safe if the work it REFUSES gets picked up promptly.
# Before 1.7.0 it would not have been, and the comment in the epoll loop saying
# otherwise — "an unserviced socket re-fires immediately" — is true of the
# LISTENER and false of a session that has already been drained:
#
#   session_on_readable_max reads the socket to EAGAIN unconditionally, BEFORE
#   session_consume_rx_max ever looks at the line budget. epoll_add_in registers
#   EPOLLIN with no EPOLLET, but level-triggered means "readable", and a drained
#   socket is not readable — the refused bytes are in SS_RX_BUF, not in the
#   kernel. So nothing re-fires, and drain_pending_rx was reached from exactly
#   one place: advance_tick, once per tick.
#
# Refused lines therefore waited up to a full tick interval (2500 ms), ground out
# at a few lines per second. That is why "just lower the count" was never the fix
# it looked like, and why this counter has to exist alongside the meter.
#
# Set by drain_pending_rx to the number of sessions still holding retained bytes
# (or still condemned) after its walk; read by both loops, which decline to sleep
# while it is non-zero. Not a busy spin: each such pass does up to PASS_CHARGE_MAX
# of real charged work, and it terminates because SS_RX_LEN is bounded by RX_CAP
# and the progress clause guarantees at least one line per window.
var g_rx_backlog = 0;

enum ChargeBudget {
    PASS_CHARGE_MAX = 20;
    # The drift allowance, named so tests assert against a constant instead of a
    # number retyped in prose. NOT from ADR 0001 — see the DrainConst note. The
    # ADR is amended in this release to state it.
    ADR1_DRIFT_US = 50000;
}

# Reference-host measurements the charge table is derived FROM. Read only by
# tests and benches, and they exist so the derivation is CI-asserted rather than
# living in a comment — which is the root cause this whole release is about. A
# comment cannot fail CI.
enum ChargeMeasured {
    MEAS_DERIVE_US      =  1723;   # ident_derive
    MEAS_SIGN_LINE_US   =  2270;   # dearest sign-bearing line (PHASE_CLASS)
    MEAS_VERIFY_US      = 11371;   # ed25519_verify
    MEAS_DEAREST_US     = 13458;   # successful login — needs a real credential
    MEAS_DEAR_UNAUTH_US =  3938;   # dearest without the victim's passphrase
    MEAS_WRONGPASS_US   =  1706;   # wrong passphrase, AFTER the reorder
}
# Give sessions with retained rx bytes another metered pass, drop any the server
# has already condemned, and return how many sessions were serviced. Called once
# per tick from advance_tick. See the block above for both bounds.
fn drain_pending_rx(): i64 {
    var budget = DRAIN_LINES_MAX;
    charge_window_open(PASS_CHARGE_MAX);   # 1.7.0 — the real bound
    var s = g_session_head;
    var drained = 0;
    g_rx_backlog = 0;
    while (s != 0) {
        var nxt = load64(s + SS_NEXT);
        if (load64(s + SS_QUIT) == 1) {
            # E1 — already condemned. Drain what it has been told and tear it
            # down here rather than waiting for an epoll event that may never
            # come: the attacker's socket is deliberately silent, and this walk
            # is the only thing still touching the session. Same mid-walk drop
            # sweep_idle has always done, and `nxt` is already captured.
            #
            # 1.7.0 — THIS ARM WAS THE UNBUDGETED ONE. It never consulted
            # `budget`, and `drop_session`'s first act is an unconditional
            # `player_save`, i.e. an ed25519_sign. So N condemned AUTHENTICATED
            # sessions cost N signs in one walk with nothing bounding N —
            # measured 81 ms at 64 and ~325 ms projected at MAX_SESSIONS, inside
            # the very function E2 added a budget to. The line budget above and
            # the charge window both looked like they covered this walk. Neither
            # did, because the expensive work here is not a line.
            #
            # It is CHARGED rather than deferred: a condemned session must still
            # be torn down promptly (that is E1, and the fd is a real resource),
            # and deferring the save would need a queue holding a pointer
            # `fl_free` is about to reissue — the H1 / M12-C use-after-free
            # shape. So the save happens, the meter sees it, and the charge
            # stops this pass from also dispatching lines. Bounding the reap
            # count itself is a separate item (tracked in the roadmap).
            #
            # 1.7.9 — a sweep flagged the ordering here as "checks the budget
            # AFTER the mutation". That is true and it is the point: the check
            # cannot precede work that must happen anyway. Worth stating the
            # cost plainly rather than leaving a reader to rediscover it — the
            # overshoot is exactly ONE signature per pass, because the charge is
            # consulted immediately after the first teardown and stops the rest.
            # It is a bounded, deliberate overshoot, not an unmetered path.
            session_drain(s);
            drop_session(g_epfd, s);
            if (charge_stop(charge_spent(), g_charge_cap, 0) == 1) {
                # Out of budget: leave the rest of the condemned for the next
                # pass. They are still on the list and still condemned, and the
                # backlog flag below keeps the loop from sleeping on them.
                g_rx_backlog = g_rx_backlog + 1;
                s = 0;
                continue;
            }
        } else {
            if (load64(s + SS_RX_LEN) > 0) {
                if (budget > 0) {
                    var take = budget;
                    if (take > RX_MAX_LINES) { take = RX_MAX_LINES; }
                    var fired[8];
                    session_consume_rx_max(s, take, &fired);
                    budget = budget - load64(&fired);
                    flush_session(g_epfd, s);
                    drained = drained + 1;
                }
                # 1.7.0 — anything still retained after this walk is work the
                # loop must come BACK for, and epoll will not tell it to: the
                # socket was already drained to EAGAIN, so it is no longer
                # readable and nothing re-fires. Count it so the loop declines
                # to sleep. (See the g_rx_backlog block below.)
                if (load64(s + SS_RX_LEN) > 0) { g_rx_backlog = g_rx_backlog + 1; }
            }
        }
        s = nxt;
    }
    charge_window_close();
    return drained;
}

# H6 (1.6.3) — take the listener off / put it back on the epoll interest list.
# Disarming is what actually stops the busy spin; suppressing the accept alone
# leaves epoll_wait returning immediately on a level-triggered readable fd.
fn listener_disarm(): i64 {
    if (g_listener_armed == 0) { return 0; }
    #ifndef CYRIUS_TARGET_AGNOS
    var ev = ev_scratch(0, TAG_LISTENER);
    sys_epoll_ctl(g_epfd, EPOLL_CTL_MOD, g_listener_fd, ev);
    #endif
    g_listener_armed = 0;
    return 0;
}

# Put the listener's EPOLLIN interest back once the backoff window has passed.
# Called unconditionally from the tick, so it must be idempotent — if fd
# pressure has not eased the next real accept error simply disarms it again.
fn listener_rearm(): i64 {
    if (g_listener_armed == 1) { return 0; }
    #ifndef CYRIUS_TARGET_AGNOS
    var ev = ev_scratch(EPOLLIN, TAG_LISTENER);
    sys_epoll_ctl(g_epfd, EPOLL_CTL_MOD, g_listener_fd, ev);
    #endif
    g_listener_armed = 1;
    return 0;
}

# === H11 (1.6.6) — is this character already logged in on another session? ===
#
# `login_on_name` only ever asked `player_exists`; nothing looked at who was
# already connected. Two sessions on the same character each ran `_restore_inv`
# and each minted a full copy of every saved item — reproduced: one authored
# `notice` became two on disk, signed and persisted, doubling per cycle. And
# `zone_reset_room_objs` only refills MISSING ids, never removes extras, so the
# duplicates parked in rooms were never reclaimed: an unbounded fl_alloc growth
# path driven by ordinary play.
#
# The second half is worse than duplication. Both sessions write the same
# `data/players/<name>.cyml` with no compare-and-swap, so whichever disconnects
# last wins — the stale session's `drop_session` → `player_save` silently reverts
# the live session's room, drops, HP and class.
#
# Refusing the newcomer is the conservative answer. Takeover ("boot the old
# session and adopt the character") is friendlier but needs semantics for
# in-flight combat and an in-progress `passwd`, which is a 2.0 conversation.
# Name comparison is byte-exact: `login_name_ok` constrains names to alnum, and
# `_path_for` lowercases only for the FILENAME, so two differently-cased spellings
# of one character share a record — compare case-insensitively to match.
fn session_already_online(name, len, except_s): i64 {
    var t = g_session_head;
    while (t != 0) {
        if (t != except_s) {
            if (load64(t + SS_AUTHED) == 1) {
                if (load64(t + SS_NAME_LEN) == len) {
                    var nb = load64(t + SS_NAME_BUF);
                    var i = 0;
                    var same = 1;
                    while (i < len) {
                        if (ascii_lower(load8(nb + i) & 0xFF) != ascii_lower(load8(name + i) & 0xFF)) {
                            same = 0;
                            i = len;
                        } else { i = i + 1; }
                    }
                    if (same == 1) { return 1; }
                }
            }
        }
        t = load64(t + SS_NEXT);
    }
    return 0;
}

# M7-B presence gate — is any in-world session standing in this zone? A
# session with SS_ROOM in [0, room_count) is placed in the world (login
# leaves it at -1). Single-writer (ADR 0003), so this snapshot can't race.
fn zone_has_player(): i64 {
    var s = g_session_head;
    while (s != 0) {
        var room = load64(s + SS_ROOM);
        if (room >= 0) {
            if (room < world_room_count()) { return 1; }
        }
        s = load64(s + SS_NEXT);
    }
    return 0;
}

# M7-E reset event log — one line per reset, for an operator to read. (The
# consumer was specced as "Joshua at M8"; Joshua is now backlog and the operator
# channel is M18. The log line stands on its own either way.)
fn zone_reset_log(mobs, objs): i64 {
    print("[", 1);
    print_num(get_epoch_secs());
    print("] zone=", 7);
    if (g_zone_id != 0) { print(str_data(g_zone_id), str_len(g_zone_id)); }
    print(" reset (rooms=", 14);
    print_num(world_room_count());
    print(", mobs=", 7);
    print_num(mobs);
    print(", objs=", 7);
    print_num(objs);
    println(")");
    return 0;
}

# Reset the zone if its interval has elapsed AND no player is present.
# Deferred (player present) resets do NOT advance g_zone_last_reset_ms, so
# the reset fires on the first empty tick after the window passes.
fn maybe_zone_reset(): i64 {
    if (world_room_count() == 0) { return 0; }
    # H13 — both operands are clamped at their source (clamp_reset_secs), so the
    # * 1000 cannot overflow and the interval cannot be <= 0. Re-clamped here
    # rather than trusted: this is the only line where the multiply happens, and
    # a future third writer of either global would otherwise reintroduce it
    # silently.
    var interval_ms = clamp_reset_secs(g_zone_reset_secs) * 1000;
    if (g_reset_secs_override > 0) {
        interval_ms = clamp_reset_secs(g_reset_secs_override) * 1000;
    }
    var now = clock_now_ms();
    if (now - g_zone_last_reset_ms < interval_ms) { return 0; }   # window not elapsed
    if (zone_has_player() == 1) { return 0; }                     # M7-B defer
    var mobs = zone_reset_mobs();   # M7-C
    var objs = zone_reset_objs();   # M7-D
    g_zone_last_reset_ms = now;
    zone_reset_log(mobs, objs);     # M7-E
    return 1;
}

# One server tick (ADR 0001's 2.5 s, or g_tick_ms): a combat round for every
# engaged session, the debounced save sweep on its interval, then the zone
# reset check. Both loops (epoll + the agnos poll loop) drive it, and both
# call it at most once per pass — drift is absorbed by next_tick, not here.
fn advance_tick(): i64 {
    g_tick_count = g_tick_count + 1;
    combat_tick_all();   # resolve a combat round for every engaged session
    # H16 — every tick now; save_sweep meters itself and save_sweep_due carries
    # the 5-minute per-session cadence. The enable flag stays exactly as it was,
    # so "0 disables it" (no zone loaded, tests) is unchanged.
    if (g_save_interval_ticks > 0) { save_sweep(); }
    # H6 — put the listener back once the backoff window has passed. If the fd
    # pressure has not eased, the next real error simply disarms it again; the
    # cost is one wasted accept per window instead of a pinned core.
    if (g_tick_count >= g_accept_backoff_until) { listener_rearm(); }
    # 1.7.0 — drain_pending_rx used to be called HERE, once per tick. It now runs
    # once per event-loop PASS, in both loop bodies, because from here it could
    # only ever give a refused line tick-interval latency (up to 2500 ms) — epoll
    # will not re-fire for bytes already in SS_RX_BUF. See the g_rx_backlog block.
    #
    # Moving it also moves it from the tick BODY into the pre-tick-check window,
    # which is the quantity the drift allowance actually constrains. That is a
    # tightening, not a loosening: it was never invisible-and-free, it was
    # invisible-and-charged-to-the-wrong-budget.
    # 1.7.1 — roll up any audit window whose 60 s has elapsed. Without this a
    # flood that STOPS leaves its tail counted but unwritten until its key happens
    # to fire again, which for an attack that ended is never. One walk of a
    # 16-entry table per tick; no allocation unless something is actually pending.
    # 1.7.4 — one clock sample for both audit rules. The rollup flush lands the
    # tail of a flood that stopped; ADR 0009's size probe is metered by
    # audit_rotate_check_due, so it costs nothing on 23 ticks out of 24 and ~2.6 us
    # (zero arena) on the 24th — against ADR 0001's 50 ms.
    var audit_now = clock_now_ms();
    audit_flush_due(audit_now);
    if (audit_rotate_check_due(g_tick_count) == 1) { audit_rotate_maybe(audit_now); }
    mob_tick_all(g_tick_count);   # M13 — every living mob takes a turn
    corpse_decay_sweep();   # M12-A — age out corpses and reclaim them
    maybe_zone_reset();  # M7 — respawn mobs/loot when the zone empties out
    flush_dirty_sessions();   # H15 — one write per session, not one per line
    return 0;
}

# === H15 (1.6.8) — coalesce the tick's writes. ===
#
# Every room broadcast used to walk the session list and issue a write(2) per
# recipient per LINE. For E engaged players co-located in one room that is
# 2E^2 - E writes in a single tick — measured at 20.1 ms for E=128 and 78.2 ms
# for E=256, the latter being 156% of the whole ADR 0001 50 ms drift budget,
# flushing to /dev/null (the cheapest sink there is) and not even counting
# mob_tick_all, drain_pending_rx or save_sweep.
#
# The append is untouched; only the WRITE moves. That distinction is the reason
# this is legal on a frozen wire surface: per-client byte order is decided
# entirely by append order, and a stream socket has no segment semantics, so
# deferring the syscall cannot reorder anything. What does change is
# packetization — a client that used to receive its prompt in its own write now
# receives it batched with the rest of the tick. No conformant Telnet client
# cares, but it is the one observable difference.
#
# Deferring the APPEND would be a different and much worse idea: mob_died
# broadcasts and then frees the instance into a freelist class the next spawn
# re-issues, so anything holding mi_name_ptr(m) past the call (a pointer queue,
# an iovec list) would resolve to a live *different* mob. session_appendtx
# memcpy's the bytes, which is what makes deferring the write safe.
fn session_mark_dirty(s): i64 {
    store64(s + SS_TX_DIRTY, 1);
    return 0;
}

# Write out every session the tick touched, once each. Called as the LAST
# statement of advance_tick — deliberately inside it rather than after it in
# tick_step, because sweep_idle runs next and drop_session frees the tx buffer
# without draining: an idle-reaped session would otherwise lose a whole tick of
# prose rather than at most a line.
fn flush_dirty_sessions(): i64 {
    var s = g_session_head;
    var flushed = 0;
    while (s != 0) {
        var nxt = load64(s + SS_NEXT);   # flush_session is non-dropping, but keep the walk uniform
        if (load64(s + SS_TX_DIRTY) == 1) {
            store64(s + SS_TX_DIRTY, 0);
            flush_session(g_epfd, s);
            flushed = flushed + 1;
        }
        s = nxt;
    }
    return flushed;
}

# Sessions-currently-connected counter (M1-H observability hook).
var g_session_count = 0;

# === H6 (1.6.3) — accept-path limits. ===
#
# MAX_SESSIONS bounds concurrent sessions so the process never reaches its fd
# limit through ordinary connections. g_session_count was incremented,
# decremented and printed by @stats, but never COMPARED to anything — there was
# no cap at all.
#
# g_accept_backoff_until is the listener's re-arm tick. handle_accept used to
# treat every non-Ok sock_accept as "backlog drained", so EMFILE/ENFILE were
# indistinguishable from EAGAIN. The listener is level-triggered (nothing here
# sets EPOLLET), so a pending-but-unacceptable connection made epoll_wait return
# instantly, forever — and unlike the EAGAIN path, which hands back a shared
# singleton, a real error boxes a FRESH Err from the bump allocator on every
# pass. Measured at an rlimit of 48 with 60 idle sockets: 99.9% of one core and
# +33.9 MB RSS in 15 s, climbing until alloc() returns 0 and the store faults.
# On a real error we now stop accepting until a later tick, turning an unbounded
# spin into one wasted accept per backoff window.
var g_accept_backoff_until = 0;
# The listener fd + whether it is currently armed in epoll. Backing off from
# ACCEPTING is not enough on its own: the listener is level-triggered, so a
# still-pending connection makes epoll_wait return instantly whether or not we
# try to accept it — measured, the core stayed pinned at 99.9% with the accept
# suppressed. The interest itself has to come off epoll, and go back on when the
# backoff expires.
var g_listener_fd = 0;
var g_listener_armed = 1;

# Intrusive head of the active-session list. Threaded through each
# Session's SS_NEXT / SS_PREV so the tick sweep (M1-F) can walk every
# live connection without a separate container.
var g_session_head = 0;

# g_epfd (the published epoll fd, used by broadcast/flush) is declared in
# session.cyr so combat.cyr — included before server.cyr — can reference
# it. cmd_serve assigns it at startup.

# Idle-disconnect threshold (ms). Default 5 minutes; overridable at
# startup via the YD_IDLE_MS env var (testing / ops tuning).
var g_idle_timeout_ms = 300000;

# Combat-tick interval (ms). ADR 0001's 2.5 s by default; overridable via
# YD_TICK_MS for testing / ops (a fast tick makes combat verification
# quick). Read once at serve start.
var g_tick_ms = 2500;

# Prepend a session to the active list.
fn session_list_push(s): i64 {
    store64(s + SS_PREV, 0);
    store64(s + SS_NEXT, g_session_head);
    if (g_session_head != 0) { store64(g_session_head + SS_PREV, s); }
    g_session_head = s;
    return 0;
}

# Unlink a session from the active list.
fn session_list_remove(s): i64 {
    var p = load64(s + SS_PREV);
    var n = load64(s + SS_NEXT);
    if (p != 0) { store64(p + SS_NEXT, n); } else { g_session_head = n; }
    if (n != 0) { store64(n + SS_PREV, p); }
    store64(s + SS_NEXT, 0);
    store64(s + SS_PREV, 0);
    return 0;
}

# === Session disconnect — unlink, remove from epoll, free. ===
fn drop_session(epfd, s): i64 {
    # M6-D: flush state on the way out — covers `quit`, idle reap, and
    # client-side disconnects alike. A no-op for unauthenticated sessions.
    # 1.7.11 (AD) — `session_persistable`, not a bare SS_AUTHED test. SS_AUTHED
    # is set in login_on_confirm BEFORE the class menu, so this arm used to write
    # `class = -1` for anyone who closed the window at the menu — permanently,
    # because nothing ever returned a player to that menu. See session_persistable.
    if (session_persistable(s) == 1) {
        # H10 — the last save a character gets. Queueing a line would be dead
        # code (the socket is going away), so record it where an operator can
        # find it afterwards.
        if (player_save(s) != 1) {
            audit_keyed(AK_SAVE_FAIL_DISC, SEV_WARNING, "save.fail.disconnect",
            load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), clock_now_ms());
        }
    }
    #ifndef CYRIUS_TARGET_AGNOS
    sys_epoll_ctl(epfd, EPOLL_CTL_DEL, load64(s + SS_FD), 0);
    #endif
    # H1/B — nothing may still point at this session, and nothing it owns may
    # outlive it. Both BEFORE session_free: mobs_forget_session clears the
    # MI_TARGET the actor tick would otherwise dereference, and session_drop_inv
    # returns the carried inventory that session_free never touched. Order
    # matters only in that both must precede the free.
    mobs_forget_session(s);
    session_drop_inv(s);
    session_list_remove(s);
    session_free(s);
    g_session_count = g_session_count - 1;
    return 0;
}

# === sweep_idle — reap sessions silent past g_idle_timeout_ms. ===
#
# Called once per tick. Captures SS_NEXT before dropping, since
# drop_session unlinks the node mid-walk. A best-effort goodbye line is
# flushed before teardown (slowloris defense, ADR 0002 wire model).
# F7 (1.6.11) — meter the idle reap, because every reap is a signature.
#
# drop_session's first act is an unconditional player_save for any authed
# session, and H16 measured that at 1.30 ms with 89% of it in ed25519_sign. H16
# then capped save_sweep at SAVE_BATCH_MAX = 4 per tick precisely because 256 of
# them in one pass was 332 ms — 664% of the ADR 0001 budget.
#
# sweep_idle could do exactly that number of saves in exactly that one pass and
# nothing bounded it. It runs from tick_step immediately after advance_tick, so
# it is inside the same tick spending the same budget: a second, unmetered
# signing site that the H16 work did not look at. No attacker needed — a server
# restart puts everyone on the same idle deadline, so they time out together.
#
# Same budget shape and the same non-starvation argument H16 wrote down: a
# session that misses a reap is strictly more overdue next tick, and its
# deadline has already passed, so a few seconds of extra grace costs nothing.
enum IdleReapConst { IDLE_REAP_MAX = 4; }
# === 1.7.11 — a clean shutdown must save the people who are still playing. ===
#
# THE DEFECT. `cmd_serve`'s exit was `println` -> `audit_flush_all` ->
# `sock_close` -> `return`. It never walked `g_session_head`, and `handle_signal`
# only sets `stop = 1`. Every `player_save` call site in the tree is on some other
# path — character creation, the `save` verb, `save_sweep`, `drop_session`, chpass
# — so **SIGINT/SIGTERM saved nobody**, and every connected player lost up to
# `SAVE_SWEEP_MIN_MS` (five minutes) of progress on every restart.
#
# It was invisible because nothing exercises it: the suite never runs `cmd_serve`,
# no bench reaches the exit path, and a manual smoke test that connects and then
# stops the server looks fine because the LAST autosave is usually recent.
#
# The docs promised the opposite. `docs/guides/running.md` said *"Shut down
# cleanly with SIGINT/SIGTERM; a `kill -9` is safe too"*, which reads as "clean
# shutdown is at least as safe" — and ADR 0006's save-trigger list does not
# include a signalled shutdown at all. Both are corrected alongside this.
#
# DELIBERATELY NOT `drop_session`. The process is exiting: closing fds and freeing
# session memory buys nothing, and `drop_session` unlinks mid-walk, which is a
# footgun for no gain here. Saving is the whole job.
#
# UNBUDGETED, ALSO DELIBERATELY. Every other save path in this tree is metered
# because it competes with the tick; this one does not — there is no next tick. At
# MAX_SESSIONS the walk is ~256 signatures, and an operator waiting a moment
# longer for a clean stop is the trade every one of those signatures is buying.
fn shutdown_save_all(): i64 {
    var saved = 0;
    var failed = 0;
    var s = g_session_head;
    while (s != 0) {
        var nxt = load64(s + SS_NEXT);
        if (load64(s + SS_AUTHED) == 1) {
            # 1.7.11 (AD) — the same class gate the disconnect path uses. A
            # session that never chose a class must not have `class = -1` written
            # over a good record on the way out.
            if (session_persistable(s) == 1) {
                if (player_save(s) == 1) {
                    saved = saved + 1;
                } else {
                    failed = failed + 1;
                    audit_keyed(AK_SAVE_FAIL_DISC, SEV_WARNING, "save.fail.shutdown",
                    load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), clock_now_ms());
                }
            }
        }
        s = nxt;
    }
    print("server: saved ", 14); print_num(saved); print(" session(s) on shutdown", 23);
    if (failed > 0) { print(" (", 2); print_num(failed); print(" FAILED)", 8); }
    println("");
    return saved;
}

# Disconnect up to IDLE_REAP_MAX sessions that have been silent past the timeout,
# and return how many were reaped. Called once per tick from tick_step. See the
# block above for why the cap is not optional.
fn sweep_idle(epfd, now_ms): i64 {
    var budget = IDLE_REAP_MAX;
    var reaped = 0;
    var s = g_session_head;
    while (s != 0) {
        if (budget == 0) { return reaped; }
        var nxt = load64(s + SS_NEXT);
        if (session_is_idle(s, now_ms, g_idle_timeout_ms) == 1) {
            # 1.7.14 (AI) — spend the budget only on reaps that actually COST one.
            #
            # `IDLE_REAP_MAX`'s whole derivation above is "every reap is a
            # signature", and that has never been true for the unauthenticated
            # ones — the very reaps `PREAUTH_TIMEOUT_MS` (1.6.13) was added to
            # serve. `drop_session` saves only what `session_persistable` admits,
            # so an unauthed reap is a `close` and an unlink from a list: no
            # `player_save`, no `ed25519_sign`, none of the 1.30 ms this cap exists
            # to ration. Charging it one anyway meant a burst of slowloris
            # connections could exhaust the tick's reap budget and DELAY the
            # eviction of the very sessions the timeout is for.
            #
            # Sampled BEFORE the teardown, because `drop_session` frees the
            # session and the predicate would then be reading freed memory — the
            # H1 / M12-C shape this tree has a standing lesson about.
            var costly = session_persistable(s);
            session_appendtx_cstr(s, "\r\nIdle timeout — disconnecting.\r\n");
            session_drain(s);
            drop_session(epfd, s);
            if (costly == 1) { budget = budget - 1; }
            reaped = reaped + 1;
        }
        s = nxt;
    }
    return reaped;
}

# === H14 (1.6.8) — the tick schedule reads a clock from before the tick. ===
#
# The snap-forward exists for exactly one situation: the tick body ran long, we
# blew past a boundary, and we must NOT then fire a burst of catch-up ticks. It
# read a clock sampled *before* the tick body — so in the one case it was written
# for, it under-snaps by one interval and fires the doubled tick it exists to
# prevent. Self-limiting (the next pass samples correctly and recovers), so it is
# one extra tick per overrun, not a pile-up.
#
# Note carefully what is NOT wrong here. The drift metric is correct as written:
# `record_tick_drift(now - next_tick)` on a PRE-work sample is scheduling
# lateness, which is what the ADR 0001 budget is about and what `@stats` prints.
# Folding the tick's own execution time into it would make the metric worse and
# change a frozen `@stats` field (ADR 0007 §41).
# So: a second sample, used only for the reschedule. The first one stays.
#
# F8 (1.6.11) — this used to add "and it would double-count, because a tick that
# overruns already surfaces as the *next* tick's lateness". **That is false**,
# and it contradicted the H16 block 500 lines above in this same file, which
# says the opposite and is right: the schedule is absolute, so a sub-interval
# overrun is absorbed by the next epoll_wait timeout and `@stats` reports 0 ms
# drift straight through it. Any overrun shorter than one full interval is
# invisible to the drift metric *by construction* — which is exactly how
# save_sweep spent 332 ms in a tick for eight releases without being seen.
#
# The conclusion survives — do not move this sample; scheduling lateness is the
# right definition and the field is frozen — but the reasoning did not, and a
# false justification is worse than none. Measuring tick-BODY cost needs its own
# counter, which is a new `@stats` field and therefore 2.0 (M14).
#
# Split out of the loops rather than patched in place because the loop body sits
# behind a socket and a signalfd and is unreachable from any test harness — and
# because there are TWO loops (epoll and the agnos poll loop), which is how they
# would drift apart. One implementation, both callers.

# Advance `next_tick` by whole intervals until it is strictly after `now_after`.
# Pure, and total: a deadline that has NOT passed is returned unchanged, so the
# caller cannot skip a beat by asking twice. (An unconditional +1 interval before
# the loop would do exactly that, and is redundant besides — the loop alone
# already lands on the first future boundary in every case a caller can reach.)
fn tick_reschedule(next_tick, now_after, tick_ms): i64 {
    if (tick_ms <= 0) { return next_tick; }   # no cadence to advance
    while (next_tick <= now_after) { next_tick = next_tick + tick_ms; }
    return next_tick;
}

# Fire one tick and return the next deadline. `now` is the pre-work sample the
# caller already took to decide the deadline had passed; the post-work sample is
# taken HERE, which is the whole point — a caller cannot pass a stale one.
fn tick_step(epfd, next_tick, now, tick_ms): i64 {
    record_tick_drift(now - next_tick);   # lateness, measured before the work
    advance_tick();
    # Deliberately still the pre-work sample: shifting the idle-reap boundary by
    # the tick's duration would reap a marginal session a pass early, and the
    # timeout is five minutes. Gratuitous churn in a patch release.
    sweep_idle(epfd, now);
    return tick_reschedule(next_tick, clock_now_ms(), tick_ms);
}

# === Observability (M1-H). =================================================
#
# A small set of counters the `@stats` admin verb surfaces: live connections,
# sessions logged in, ticks since boot, and the p99 of recent tick-scheduling
# drift. (An operator consumer for these is M18; the old "Joshua at M8" framing
# is backlog — see the roadmap.)

enum ObsConst { DRIFT_RING_CAP = 512; }

var g_tick_drift_ring  = 0;   # ring of recent drift samples (ms)
var g_tick_drift_tmp   = 0;   # scratch buffer for the p99 sort
var g_tick_drift_count = 0;   # samples recorded (saturates at CAP)
var g_tick_drift_idx   = 0;   # next ring write slot

# Allocate the drift buffers. Called once at serve start.
fn obs_init(): i64 {
    g_tick_drift_ring = alloc(DRIFT_RING_CAP * 8);
    g_tick_drift_tmp  = alloc(DRIFT_RING_CAP * 8);
    return 0;
}

# Record one tick's scheduling drift (how late the tick fired vs its
# absolute deadline). Negative is clamped to 0 (early is never late).
fn record_tick_drift(drift_ms): i64 {
    # H14 (1.6.8) — the ring is allocated by obs_init, which only cmd_serve
    # calls. Anything else that drives a tick (a bench, a test) reached a null
    # store here and faulted. One comparison per tick buys the whole tick path a
    # harness; it is not reachable in the server, where obs_init runs at boot.
    if (g_tick_drift_ring == 0) { return 0; }
    if (drift_ms < 0) { drift_ms = 0; }
    store64(g_tick_drift_ring + g_tick_drift_idx * 8, drift_ms);
    g_tick_drift_idx = (g_tick_drift_idx + 1) % DRIFT_RING_CAP;
    if (g_tick_drift_count < DRIFT_RING_CAP) {
        g_tick_drift_count = g_tick_drift_count + 1;
    }
    return 0;
}

# p99 of the recent drift window (ms). Insertion-sorts a copy of the
# ring (bounded at DRIFT_RING_CAP); computed only when @stats is invoked.
fn tick_drift_p99(): i64 {
    var cnt = g_tick_drift_count;
    if (cnt == 0) { return 0; }
    var i = 0;
    while (i < cnt) {
        store64(g_tick_drift_tmp + i * 8, load64(g_tick_drift_ring + i * 8));
        i = i + 1;
    }
    var a = 1;
    while (a < cnt) {
        var key = load64(g_tick_drift_tmp + a * 8);
        var b = a - 1;
        while (b >= 0) {
            if (load64(g_tick_drift_tmp + b * 8) <= key) { break; }
            store64(g_tick_drift_tmp + (b + 1) * 8, load64(g_tick_drift_tmp + b * 8));
            b = b - 1;
        }
        store64(g_tick_drift_tmp + (b + 1) * 8, key);
        a = a + 1;
    }
    var idx = (cnt * 99) / 100;
    if (idx >= cnt) { idx = cnt - 1; }
    return load64(g_tick_drift_tmp + idx * 8);
}

# Count sessions past the login gate (PHASE_CMD) by walking the list.
fn count_logged_in(): i64 {
    var c = 0;
    var s = g_session_head;
    while (s != 0) {
        if (load64(s + SS_PHASE) == PHASE_CMD) { c = c + 1; }
        s = load64(s + SS_NEXT);
    }
    return c;
}

# Render the status block into a session's tx queue (the `@stats` verb).
fn render_stats(s): i64 {
    session_appendtx_cstr(s, "-- yeoman's descent :: status --\r\n");
    session_appendtx_cstr(s, "connections : ");
    session_appendtx_num(s, g_session_count);
    session_appendtx_cstr(s, "\r\n");
    session_appendtx_cstr(s, "logged in   : ");
    session_appendtx_num(s, count_logged_in());
    session_appendtx_cstr(s, "\r\n");
    session_appendtx_cstr(s, "ticks       : ");
    session_appendtx_num(s, g_tick_count);
    session_appendtx_cstr(s, "\r\n");
    session_appendtx_cstr(s, "drift p99ms : ");
    session_appendtx_num(s, tick_drift_p99());
    session_appendtx_cstr(s, "\r\n");
    session_appendtx_cstr(s, "idle to ms  : ");
    session_appendtx_num(s, g_idle_timeout_ms);
    session_appendtx_cstr(s, "\r\n");
    return 0;
}

# === 0.8.3 — operator read-only verbs (@who, @reset). ====================
# Groundwork for the operator interface. Since 0.9.1 the whole @-namespace
# (@stats/@who/@reset) is gated behind the YD_ADMIN env knob, default off —
# see `apply_idle_env` below and session.cyr's `g_admin_enabled`. Replacing
# that env gate with real operator authentication is tracked as
# [roadmap M18](../docs/development/roadmap.md#m17m23--the-2x-tail), which is
# deliberately independent of Joshua (now backlog). This used to link to an M8
# anchor that no longer exists.

# @who — every in-world session (name + the room it's standing in).
fn render_who(s): i64 {
    session_appendtx_cstr(s, "-- connected --\r\n");
    var n = 0;
    var more = 0;
    var p = g_session_head;
    while (p != 0) {
        # F1 (1.6.11) — bound the index at BOTH ends before room_at.
        #
        # This tested only `room >= 0` and then dereferenced. `room_at` is
        # documented "no bounds check — callers hold valid indices", so the
        # guard has to be the caller's, and half a guard is not one. cmd_who
        # three hundred lines below has always checked both ends; this is the
        # `@who` admin verb and never did.
        #
        # Safe today only by accident of an invariant held elsewhere (SS_ROOM is
        # -1 or valid, never stale-and-positive). That is exactly the kind of
        # accident session_room_ok was introduced for in 1.6.9, and exactly what
        # made `examine` a remote crash when the accident stopped holding.
        var room = load64(p + SS_ROOM);
        if (room >= 0) {
            if (room < world_room_count()) {
                # 1.7.7 — whole lines only; see RoomList in session.cyr. Same
                # shape as `cmd_who` above and fixed in the same pass on purpose:
                # this one is DORMANT (the @-namespace is off unless YD_ADMIN=1),
                # and leaving the dormant twin of a defect in place is how three of
                # the four findings that reopened the 1.x gate came to exist.
                var r = room_at(room);
                var need = 2 + load64(p + SS_NAME_LEN) * 2                 # prose IAC-doubles
                + 5 + room_title_len(r) + 2;                               # " — " is 5 bytes, CRLF 2
                if (room_line_fits(s, need) == 0) {
                    more = more + 1;
                } else {
                    session_appendtx_cstr(s, "  ");
                    session_appendtx_prose(s, load64(p + SS_NAME_BUF), load64(p + SS_NAME_LEN));   # M10-C name
                    session_appendtx_cstr(s, " — ");
                    session_appendtx(s, room_title_ptr(r), room_title_len(r));
                    session_appendtx_cstr(s, "\r\n");
                }
                n = n + 1;
            }
        }
        p = load64(p + SS_NEXT);
    }
    list_append_more(s, more, "in-world", " not shown.\r\n");
    if (n == 0) { session_appendtx_cstr(s, "  (no one in-world)\r\n"); }
    session_appendtx_cstr(s, "in-world: ");
    session_appendtx_num(s, n);
    session_appendtx_cstr(s, "\r\n");
    return 0;
}

# @reset — force an immediate zone reset, bypassing the presence gate. The
# top-up is idempotent (only dead mobs / missing objects respawn), so a
# forced reset with players present just refills what's gone. Also re-arms
# the timer and writes the standard reset log line.
fn render_reset(s): i64 {
    if (world_room_count() == 0) { session_appendtx_cstr(s, "No zone loaded.\r\n"); return 0; }
    var mobs = zone_reset_mobs();
    var objs = zone_reset_objs();
    g_zone_last_reset_ms = clock_now_ms();
    zone_reset_log(mobs, objs);
    session_appendtx_cstr(s, "zone reset forced — mobs +");
    session_appendtx_num(s, mobs);
    session_appendtx_cstr(s, ", objs +");
    session_appendtx_num(s, objs);
    session_appendtx_cstr(s, "\r\n");
    return 0;
}

# === Drain a session's tx queue, arming / unarming EPOLLOUT to match. ===
#
# Returns 1 if the session is still alive, 0 if it should be dropped.
fn flush_session(epfd, s): i64 {
    var rc = session_drain(s);
    if (rc < 0) { return 0; }
    if (rc == 2) { session_set_out(epfd, s, 0); return 1; }
    if (rc == 1) { session_set_out(epfd, s, 1); return 1; }
    return 1;
}

# === Room presence + broadcast (M3-C). ===
#
# These walk the active-session list (this file owns it) on behalf of the
# session layer's room display + movement, which forward-reference them.

# Append "Also here: a, b" to `viewer`'s tx for every other logged-in
# session sharing `room_idx`. Nothing appended when the room is otherwise
# empty.
fn room_append_present(viewer, room_idx): i64 {
    var first = 1;
    var more = 0;
    var t = g_session_head;
    while (t != 0) {
        if (t != viewer) {
            if (load64(t + SS_PHASE) == PHASE_CMD) {
                if (load64(t + SS_ROOM) == room_idx) {
                    # 1.7.6 — whole names only; see RoomList in session.cyr. This
                    # section runs LAST, so it is the most likely to be cut, and
                    # MAX_SESSIONS co-located players would overflow it on their
                    # own even with an empty floor.
                    #
                    # The fit check comes BEFORE the separator, deliberately.
                    # Writing ", " and then discovering the name does not fit
                    # leaves a dangling separator with nothing after it — a
                    # different malformed line than the one this release exists to
                    # remove. The name is costed at 2x because session_appendtx_prose
                    # IAC-doubles, so a name of 0xFF bytes emits twice its length.
                    var need = strlen(ansi_actor()) + load64(t + SS_NAME_LEN) * 2
                    + strlen(ansi_reset()) + 2;
                    if (first == 1) { need = need + 11; }
                    if (room_line_fits(viewer, need) == 0) {
                        more = more + 1;
                    } else {
                        if (first == 1) {
                            session_appendtx_cstr(viewer, "Also here: ");
                            first = 0;
                        } else {
                            session_appendtx_cstr(viewer, ", ");
                        }
                        session_appendtx_cstr(viewer, ansi_actor());
                        session_appendtx_prose(viewer, load64(t + SS_NAME_BUF), load64(t + SS_NAME_LEN));   # M10-C name
                        session_appendtx_cstr(viewer, ansi_reset());
                    }
                }
            }
        }
        t = load64(t + SS_NEXT);
    }
    if (first == 0) { session_appendtx_cstr(viewer, "\r\n"); }
    room_append_more(viewer, more, "people are");
    return 0;
}

# Broadcast a third-person combat line to onlookers in `room_idx` (not the
# combatant `except_s`): a leading CRLF, then subject + mid + object (if
# obj_len > 0) + tail. Subject/object are (ptr, len) so either a player
# name or a mob name fits — "<alice> strikes <drone>." or "<drone> hits
# <alice>!". Non-dropping (combat tick safety). (0.6.1)
#
# Since H15 (1.6.8) this MARKS its recipients rather than flushing them: it is
# the tick-driven broadcaster, and the tick is where the write count was
# quadratic. flush_dirty_sessions writes each session once, last thing in
# advance_tick.
fn room_combat_line(room_idx, except_s, subj_p, subj_l, mid, obj_p, obj_l, tail): i64 {
    var t = g_session_head;
    while (t != 0) {
        var nxt = load64(t + SS_NEXT);
        if (t != except_s) {
            if (load64(t + SS_PHASE) == PHASE_CMD) {
                if (load64(t + SS_ROOM) == room_idx) {
                    session_tx_reserve(t, subj_l + obj_l + 256);   # H15 valve
                    session_appendtx_cstr(t, "\r\n");
                    session_appendtx(t, subj_p, subj_l);
                    session_appendtx_cstr(t, mid);
                    if (obj_l > 0) { session_appendtx(t, obj_p, obj_l); }
                    session_appendtx_cstr(t, tail);
                    session_mark_dirty(t);   # H15 — written once, at end of tick
                }
            }
        }
        t = nxt;
    }
    return 0;
}

# Find a logged-in player in `room_idx` whose name the typed noun
# np[0..nl) prefixes (case-insensitive), excluding `viewer`. Returns the
# session ptr or 0. First match wins.
fn room_find_player(viewer, room_idx, np, nl): i64 {
    if (room_idx < 0) { return 0; }
    var t = g_session_head;
    while (t != 0) {
        if (t != viewer) {
            if (load64(t + SS_PHASE) == PHASE_CMD) {
                if (load64(t + SS_ROOM) == room_idx) {
                    if (name_prefix_match(load64(t + SS_NAME_BUF), load64(t + SS_NAME_LEN), np, nl) == 1) {
                        return t;
                    }
                }
            }
        }
        t = load64(t + SS_NEXT);
    }
    return 0;
}

# Broadcast a movement line to everyone in `room_idx` except `except_s`:
# a leading CRLF, the mover's name, then the cstr parts a/b/c (any may be "").
#
# E7 (1.6.10) — this used to claim "each recipient is flushed immediately ... a
# recipient that errors on flush is dropped". Neither half has been true since
# H15 (1.6.8): recipients are MARKED (session_mark_dirty) and written once, by
# flush_dirty_sessions at the end of advance_tick for tick-driven prose or at
# the end of dispatch_session for command-driven prose (H19, 1.6.9). And
# nothing here drops anyone — flush_session is non-dropping by design, because
# this runs while the session list is being walked.
#
# The leading CRLF is load-bearing and outlives all of that: a line arriving
# after a prompt has to start on a fresh row.
fn room_broadcast(room_idx, except_s, mover_s, a, b, c): i64 {
    var name_buf = load64(mover_s + SS_NAME_BUF);
    var name_len = load64(mover_s + SS_NAME_LEN);
    var t = g_session_head;
    while (t != 0) {
        var nxt = load64(t + SS_NEXT);
        if (t != except_s) {
            if (load64(t + SS_PHASE) == PHASE_CMD) {
                if (load64(t + SS_ROOM) == room_idx) {
                    session_tx_reserve(t, name_len + 256);   # H15 valve
                    session_appendtx_cstr(t, "\r\n");
                    session_appendtx_prose(t, name_buf, name_len);   # M10-C name
                    session_appendtx_cstr(t, a);
                    session_appendtx_cstr(t, b);
                    session_appendtx_cstr(t, c);
                    session_mark_dirty(t);   # H15 — written once, at end of tick
                }
            }
        }
        t = nxt;
    }
    return 0;
}

# Flush one session immediately — a directed `tell` or `give` recipient.
# Non-dropping: a broken socket is reaped on its next epoll HUP in
# dispatch_session, never freed here, so this is safe to call while walking the
# session list.
#
# E7 (1.6.10) — the parenthetical used to say "or a combatant mid-tick", which
# stopped being true at H15 (1.6.8): combat prose is marked dirty and written
# once by flush_dirty_sessions at the end of advance_tick, and the room
# broadcasters mark rather than flush. This is now only the directed-message
# path, which runs on the epoll side and is O(1).
fn deliver_to(t): i64 {
    flush_session(g_epfd, t);
    return 0;
}

# Resolve one combat round for every engaged, logged-in session. Called
# from advance_tick. The tick never frees a session, so the walk is safe
# even though combat prose flushes mid-loop.
fn combat_tick_all(): i64 {
    var s = g_session_head;
    while (s != 0) {
        var nxt = load64(s + SS_NEXT);
        if (load64(s + SS_PHASE) == PHASE_CMD) {
            if (load64(s + SS_TARGET) != 0) { combat_round(s); }
            classes_upkeep(s);   # energy regen + cooldown / buff decay (M5)
        }
        s = nxt;
    }
    return 0;
}

# Broadcast a speech/emote line to everyone in `room_idx` except
# `except_s`: a leading CRLF, the speaker's name, a `lead` cstr, the
# message body bytes, then a `tail` cstr.
#
# E7 (1.6.10) — "each recipient is flushed; a flush error drops that recipient"
# has been wrong since H15 (1.6.8): recipients are marked and written once.
# This one is reached from the COMMAND path, so H19 (1.6.9) drains the dirty
# set at the end of dispatch_session — which is what keeps `say` at 0 ms
# instead of the 2099 ms it cost between those two releases.
fn room_say_broadcast(room_idx, except_s, speaker_s, lead, body, body_len, tail): i64 {
    var name_buf = load64(speaker_s + SS_NAME_BUF);
    var name_len = load64(speaker_s + SS_NAME_LEN);
    var t = g_session_head;
    while (t != 0) {
        var nxt = load64(t + SS_NEXT);
        if (t != except_s) {
            if (load64(t + SS_PHASE) == PHASE_CMD) {
                if (load64(t + SS_ROOM) == room_idx) {
                    # M10-B/C escape to at most 4 bytes per input byte.
                    session_tx_reserve(t, name_len * 4 + body_len * 4 + 256);   # H15 valve
                    session_appendtx_cstr(t, "\r\n");
                    session_appendtx_prose(t, name_buf, name_len);   # M10-C name
                    session_appendtx_cstr(t, lead);
                    session_appendtx_prose(t, body, body_len);   # M10-B
                    session_appendtx_cstr(t, tail);
                    session_mark_dirty(t);   # H15 — written once, at end of tick
                }
            }
        }
        t = nxt;
    }
    return 0;
}

# Find any logged-in player (anywhere) whose name the typed noun np[0..nl)
# prefixes, for directed `tell`. Returns the session ptr or 0.
fn find_player_global(np, nl): i64 {
    var t = g_session_head;
    while (t != 0) {
        if (load64(t + SS_PHASE) == PHASE_CMD) {
            if (name_prefix_match(load64(t + SS_NAME_BUF), load64(t + SS_NAME_LEN), np, nl) == 1) {
                return t;
            }
        }
        t = load64(t + SS_NEXT);
    }
    return 0;
}

# `who` — list every logged-in player and the room they are in.
# 1.7.7 — whole lines only; see RoomList in session.cyr. `who` is the one listing
# in this set whose length no cap in the game bounds: it is one line per LOGGED-IN
# SESSION, so it overruns at roughly 90 players online — well inside MAX_SESSIONS —
# and it does so for every player who types it, at once.
#
# `n` counts every session in-world whether or not its line was rendered, because
# "(N online)" answers a different question than the list does. The omitted count
# is reported separately.
fn cmd_who(s): i64 {
    session_appendtx_cstr(s, "-- wanderers of the Under-Grid --\r\n");
    var n = 0;
    var more = 0;
    var t = g_session_head;
    while (t != 0) {
        if (load64(t + SS_PHASE) == PHASE_CMD) {
            if (more > 0) {
                more = more + 1;                 # past the cut: count, do not render
            } else {
                var rm = load64(t + SS_ROOM);
                var titled = 0;
                if (rm >= 0) {
                    if (rm < world_room_count()) { titled = 1; }
                }
                # The name is costed at 2x because session_appendtx_prose
                # IAC-doubles, so a name of 0xFF bytes emits twice its length.
                var need = 2 + strlen(ansi_actor()) + load64(t + SS_NAME_LEN) * 2
                + strlen(ansi_reset()) + 2;
                if (titled == 1) { need = need + 5 + room_title_len(room_at(rm)); }   # " — " is 5 bytes
                if (room_line_fits(s, need) == 0) {
                    more = 1;
                } else {
                    session_appendtx_cstr(s, "  ");
                    session_appendtx_cstr(s, ansi_actor());
                    session_appendtx_prose(s, load64(t + SS_NAME_BUF), load64(t + SS_NAME_LEN));   # M10-C name
                    session_appendtx_cstr(s, ansi_reset());
                    if (titled == 1) {
                        session_appendtx_cstr(s, " — ");
                        var r = room_at(rm);
                        session_appendtx(s, room_title_ptr(r), room_title_len(r));
                    }
                    session_appendtx_cstr(s, "\r\n");
                }
            }
            n = n + 1;
        }
        t = load64(t + SS_NEXT);
    }
    list_append_more(s, more, "online", " not shown.\r\n");
    session_appendtx_cstr(s, "(");
    session_appendtx_num(s, n);
    session_appendtx_cstr(s, " online)\r\n");
    return 0;
}

# === Accept handler — drain every pending accept; alloc + register. ===
fn handle_accept(epfd, listener_fd, now_ms): i64 {
    # H6 — stood down after a real accept error; the tick re-arms us.
    if (g_tick_count < g_accept_backoff_until) { return 0; }
    var done = 0;
    while (done == 0) {
        var ar = sock_accept(listener_fd);
        if (is_ok(ar) == 0) {
            # EAGAIN is the steady state — the backlog is genuinely drained, and
            # lib/net hands back a shared singleton for it. Anything else is a
            # real error (EMFILE / ENFILE are the ones that matter) and boxes a
            # fresh Err; spinning on it is what burned a core and 2.3 MB/s.
            if (err_code_of(ar) != _NET_EAGAIN) {
                g_accept_backoff_until = g_tick_count + ACCEPT_BACKOFF_TICKS;
                listener_disarm();
            }
            done = 1;
            continue;
        }
        var cfd = result_unwrap(ar);
        # H6 — at capacity, take the connection off the backlog and drop it
        # rather than leaving it pending. Leaving it would re-arm the
        # level-triggered listener immediately and reproduce the same spin.
        if (g_session_count >= MAX_SESSIONS) {
            sock_close(cfd);
            continue;
        }
        var nb = set_nonblock(cfd);
        if (nb < 0) { sock_close(cfd); continue; }
        var s = session_new(cfd, now_ms);
        #ifndef CYRIUS_TARGET_AGNOS
        epoll_add_in(epfd, cfd, s);
        #endif
        # agnos: sockets can't be epoll-watched; session_list_push alone enrolls
        # the conn — the poll loop's per-session recv sweep services it.
        session_list_push(s);
        g_session_count = g_session_count + 1;
        # Opening Telnet salvo (IAC WILL ECHO / WILL SGA) ahead of any
        # application bytes, per RFC 1143 — see session_telnet_announce.
        session_telnet_announce(s);
        # MOTD + name prompt; the session opens in PHASE_NAME (M1-E).
        session_begin_login(s);
        flush_session(epfd, s);
    }
    return 0;
}

# === Signal handler — drain signalfd, ask the loop to stop. ===
fn handle_signal(signal_fd): i64 {
    var sinfo[128];
    sys_read(signal_fd, &sinfo, 128);
    return 1;
}

# === Per-session event dispatcher. ===
#
# Returns 1 to keep the session, 0 to drop it.
# G1 (1.6.12) — the budgeted form. `dispatch_session` keeps its old signature
# and spends a full slice; the event loops use this one and share a budget
# across the whole batch.
fn dispatch_session_max(epfd, s, events, now_ms, maxlines, out_fired): i64 {
    # EPOLLHUP (0x10) + EPOLLERR (0x8) both warrant a drop, but only
    # after we drain any in-flight read so the rx-side echo path runs
    # at least once. EPOLLIN still fires alongside HUP on most kernels.
    var alive = 1;
    store64(out_fired, 0);
    if ((events & EPOLLIN) != 0) {
        alive = session_on_readable_max(s, now_ms, maxlines, out_fired);
    }
    # H19 (1.6.9) — deliver to everyone this command touched, NOW.
    #
    # H15 turned every room broadcast into a dirty flag drained at the end of
    # advance_tick. That is right for the TICK, where E combatants each
    # broadcast to E-1 others and the write count is quadratic. It is wrong for
    # commands, which arrive on this path: `say`, `emote`, arrivals, departures
    # and `kill`'s lunge all mark their listeners and then waited for the next
    # tick boundary — up to the full 2.5 s (ADR 0001) before anyone heard you
    # speak. Immediate before 1.6.8; a regression introduced by the coalescing.
    #
    # No syscall cost is given back: one command marks at most the room's
    # population, which is exactly how many writes it always issued. Only the
    # tick's own burst is coalesced, which is where the 2E^2 - E came from.
    #
    # Placed before the drop checks below so a departing player's goodbye still
    # reaches onlookers even when this session is about to be torn down.
    flush_dirty_sessions();
    if (alive == 0) { return 0; }
    var ok = flush_session(epfd, s);
    if (ok == 0) { return 0; }
    # The `quit` verb (M2) queued its goodbye above; flush_session just
    # drained it, so now we can tear the session down.
    if (load64(s + SS_QUIT) == 1) { return 0; }
    if ((events & 0x18) != 0) { return 0; }   # HUP | ERR
    return 1;
}

# Service ONE session out of an event batch, charging a budget shared by the
# whole pass. Returns the budget that remains; writes the keep/drop decision to
# `out_keep`.
#
# G1 (1.6.12) — extracted so the two loops cannot disagree. ADR 0003 has an
# epoll loop and an agnos poll loop, and the finding that produced this fix
# noted they had already diverged: the epoll side at least had MAX_EPOLL_EVENTS
# bounding the number of events, while the agnos side swept EVERY session on
# every ~20 ms pass with no analog at all (~16.5 s per pass at MAX_SESSIONS).
# One implementation, two callers, and it is reachable from a test — the loops
# themselves sit behind a socket and a signalfd and are not.
fn event_batch_step(epfd, s, events, now_ms, budget, out_keep): i64 {
    var take = budget;
    if (take > RX_MAX_LINES) { take = RX_MAX_LINES; }
    if (take < 0) { take = 0; }
    var fired[8];
    store64(out_keep, dispatch_session_max(epfd, s, events, now_ms, take, &fired));
    return budget - load64(&fired);
}

# Open the batch window and hand back the line backstop, so a loop body reads
# `var budget = event_pass_begin();`.
#
# Returning the count rather than exposing two calls is deliberate: forgetting
# the window is then a COMPILE error (an undefined `budget`) instead of a silent
# reversion to unmetered. That closes the omission hazard at this site. The
# matching hazard inside drain_pending_rx is not compile-checked — it is covered
# by the suite instead, and named as a residual risk in state.md.
fn event_pass_begin(): i64 {
    charge_window_open(PASS_CHARGE_MAX);
    return EVENT_LINES_MAX;
}

# Close it, and report whether the loop should decline to sleep. Both loops call
# this at the end of a pass.
fn event_pass_end(): i64 {
    charge_window_close();
    if (g_rx_backlog > 0) { return 1; }
    return 0;
}

# The unbudgeted form: one session, a full slice. Kept for callers that are not
# walking a list.
fn dispatch_session(epfd, s, events, now_ms): i64 {
    var fired[8];
    return dispatch_session_max(epfd, s, events, now_ms, RX_MAX_LINES, &fired);
}

# Apply the YD_IDLE_MS env override to g_idle_timeout_ms, if set to a
# positive integer. Invalid / absent → keep the 5-minute default.
fn apply_idle_env(): i64 {
    var v = getenv("YD_IDLE_MS");
    if (v != 0) {
        var ms = atoi(v);
        if (ms > 0) { g_idle_timeout_ms = ms; }
    }
    var tv = getenv("YD_TICK_MS");
    if (tv != 0) {
        var tms = atoi(tv);
        if (tms > 0) { g_tick_ms = tms; }
    }
    var rv = getenv("YD_RESET_SECS");   # M7 — fast zone resets for testing
    if (rv != 0) {
        # H13 (1.6.8) — the `rs > 0` test already stopped 0 and negatives, but
        # nothing bounded the top end, and this value is multiplied by 1000 too.
        var rs = atoi(rv);
        if (rs > 0) { g_reset_secs_override = clamp_reset_secs(rs); }
    }
    var ad = getenv("YD_ADMIN");        # 0.9.1 — enable the @-admin namespace
    if (ad != 0) {
        if (atoi(ad) > 0) { g_admin_enabled = 1; }
    }
    return 0;
}

# === cmd_serve — open listener, run the loop until SIGINT/SIGTERM. ===
fn cmd_serve(port): i64 {
    # HARDENING — ignore SIGPIPE before anything can touch a client socket.
    # session_drain writes with a raw flagsless `sys_write`, and the DEFAULT
    # SIGPIPE disposition is *terminate the process*: a write landing on a peer
    # that already sent RST would kill the whole server and drop every other
    # player with it. dispatch_session calls flush_session BEFORE its
    # EPOLLHUP/EPOLLERR check, so that write genuinely can precede the teardown.
    #
    # Honesty note: this window was NOT reproducible at 1.2.0 — 200 abrupt
    # RST disconnects, and 60 stalled peers RST while holding unsent tx, both
    # left the server serving. The epoll HUP path appears to reap sessions
    # first in practice. So this is defence in depth against a latent hazard,
    # not a fix for a demonstrated DoS.
    #
    # With SIG_IGN the write returns -EPIPE instead, which session_drain
    # already routes down its existing "real error → disconnect" path, so
    # single-session teardown is unchanged. `signal_ignore` is portable
    # (rt_sigaction on Linux, BSD sigaction on macOS, no-op on agnos/Windows),
    # so this needs no target gate.
    signal_ignore(SIGPIPE);
    apply_idle_env();
    obs_init();
    # Load the starter zone. A failure is non-fatal — the server still
    # runs, with the verbs answering their no-zone placeholders.
    var wl = world_load_rooms(DP_ROOMS);
    if (wl == WL_OK) {
        println("world: loaded zone");
        print_num(world_room_count());
        println(" rooms");
        # Object + mob templates, then spawn mobs into rooms (M4).
        var oc = world_load_objs(DP_OBJS);
        if (oc >= 0) { print_num(oc); println(" object templates"); }
        else {
            # H9 (1.6.5) — a rejected objs file used to produce NO diagnostic at
            # all: there was no else arm, and zone_reset_objs below was gated on
            # the MOB result, not this one. A malformed hub.objs.cyml therefore
            # gave a completely clean-looking boot.
            println("world: no objects loaded (code below)");
            print_num(oc);
            println("");
        }
        var mc = world_load_mobs(DP_MOBS);
        if (mc >= 0) {
            var sp = world_spawn_all();
            # H9 — gated on the OBJECT result; it was reading mc.
            var so = 0;
            if (oc >= 0) { so = zone_reset_objs(); }   # M7-D: place authored room objects
            print_num(mc); print(" mob templates, ", 16);
            print_num(sp); print(" mobs, ", 7);
            print_num(so); println(" objs spawned");
        } else {
            println("world: no mobs loaded (code below)");
            print_num(mc); println("");
        }
    } else {
        println("world: no zone loaded (code below) — running roomless");
        print_num(wl);
        println("");
    }
    # Player classes (M5).
    var cc = world_load_classes(DP_CLASSES);
    if (cc >= 0) { print_num(cc); println(" player classes"); }
    else { println("world: no classes loaded"); }
    # 1.7.11 (AD) — FATAL. This used to print "players spawn classless" and carry
    # on, which is the worse half of the classless-record defect: with the table
    # empty, `player_auth_load`'s `cls >= g_class_count` clamp demotes EVERY
    # character to -1, and the next disconnect writes that demotion to disk. One
    # typo in data/classes.cyml plus a restart was playerbase-wide, irreversible
    # loss — irreversible because the operator cannot re-sign a player's record.
    #
    # A server with no classes cannot run the game anyway (no character can be
    # created), so the affordance was buying nothing and costing everything. The
    # loader already unpublishes the table on ANY failure (F6), so `g_class_count`
    # is a sound test for "the file did not load".
    if (g_class_count == 0) {
        println("world: FATAL — no player classes. Refusing to start:");
        println("  a running server with an empty class table demotes every");
        println("  character to classless on load, and the next disconnect");
        println("  writes that to disk. Fix data/classes.cyml and restart.");
        return 1;
    }
    combat_seed(clock_now_ms());   # seed the hidden-roll RNG (M4)
    # M6: persistence engine — buffers, data/ dirs, libro audit chain — and
    # the debounced save cadence (~5 min of ticks, never below one).
    persist_init();
    g_save_interval_ticks = 300000 / g_tick_ms;
    if (g_save_interval_ticks < 1) { g_save_interval_ticks = 1; }
    println("persist: player saves + audit chain ready");
    # M7: start the zone-reset clock from boot (resets are measured since
    # last reset, not server start — but boot IS the first "reset").
    g_zone_last_reset_ms = clock_now_ms();
    println("world: zone-reset timer armed");
    println("yeoman's descent — starting event-loop listener");
    println("server: listening on port");
    print_num(port);
    println("");
    var lfd = open_listener(port);
    g_listener_fd = lfd;   # H6 — listener_disarm/rearm need it from the tick
    if (lfd < 0) {
        println("server: failed to bind listener (errno below)");
        efmt_int(0 - lfd);
        println("");
        return 1;
    }
    #ifndef CYRIUS_TARGET_AGNOS
    var sigfd = install_signal_fd();
    if (sigfd < 0) {
        println("server: failed to install signalfd (errno below)");
        efmt_int(0 - sigfd);
        println("");
        sock_close(lfd);
        return 1;
    }
    var epfd = sys_epoll_create();
    if (epfd < 0) {
        println("server: failed to create epoll fd (errno below)");
        efmt_int(0 - epfd);
        println("");
        sock_close(lfd);
        sys_close(sigfd);
        return 1;
    }
    g_epfd = epfd;   # publish for room broadcasts (M3-C)
    epoll_add_in(epfd, lfd, TAG_LISTENER);
    epoll_add_in(epfd, sigfd, TAG_SIGNAL);
    var events_buf = alloc(MAX_EPOLL_EVENTS * 16);   # H1 — 16 covers both layouts
    var next_tick = clock_now_ms() + g_tick_ms;
    var stop = 0;
    while (stop == 0) {
        var now = clock_now_ms();
        var timeout_ms = next_tick - now;
        if (timeout_ms < 0) { timeout_ms = 0; }
        # 1.7.0 — do not park in epoll_wait while refused lines are sitting in
        # SS_RX_BUF. epoll cannot see them (the socket is drained, so it is not
        # readable), so without this clamp a metered pass would hand its
        # leftovers a full tick interval of latency. Bounded, not a spin: each
        # repeat does up to PASS_CHARGE_MAX units of real work, SS_RX_LEN only
        # shrinks, and the progress clause guarantees at least one line per pass.
        if (g_rx_backlog > 0) { timeout_ms = 0; }
        var n = sys_epoll_wait(epfd, events_buf, MAX_EPOLL_EVENTS, timeout_ms);
        if (n < 0) { continue; }   # EINTR-benign
        # G1 (1.6.12) — ONE budget for the whole batch.
        #
        # This loop drains up to MAX_EPOLL_EVENTS = 64 session events, each of
        # which was allowed RX_MAX_LINES = 8 dispatches. RX_MAX_LINES is a
        # PER-SESSION cap and this walks 64 sessions, so the batch had no bound
        # at all — which is verbatim the defect E2 (1.6.10) diagnosed and fixed
        # for drain_pending_rx, in words that could be pasted here unchanged.
        #
        # Measured on this tree: one event of 8 wrong-passphrase lines is 64 ms
        # of CPU for 104 bytes of input, and a full batch of 64 such events is
        # **4.12 s with no tick-deadline check in between** — 8240% of the ADR
        # 0001 budget and 164% of the entire tick interval, so a whole combat
        # tick is skipped. The unauthenticated creation variant needs no account
        # and costs 609 ms per batch.
        #
        # Three passes looked straight at this and each capped a neighbour: H5
        # (1.6.2) capped ONE session per event, E1/E2 (1.6.10) capped the
        # tick-side drain, F7 (1.6.11) capped the idle reap. Nothing capped the
        # batch — the path that runs first and most often.
        #
        # 1.7.0 — the claim that used to close this block was WRONG, and it is
        # the reason "just lower the count" was not the fix it appeared to be.
        # It read: "Nothing is dropped by stopping early: epoll is
        # level-triggered, so an unserviced socket re-fires immediately, and
        # drain_pending_rx already exists to grind retained remainders down at
        # its own metered rate."
        #
        # Level-triggered means READABLE, and a session whose socket has already
        # been drained to EAGAIN is not readable — the refused bytes are sitting
        # in SS_RX_BUF, not in the kernel. So nothing re-fired, and the drain ran
        # once per TICK, meaning a refused line waited up to 2500 ms. True of the
        # listener; false of a drained session. See the g_rx_backlog block.
        #
        # Fixed by making the drain part of this pass and by refusing to sleep
        # while a backlog exists, so a refused line waits one pass, not one tick.
        var budget = event_pass_begin();
        var i = 0;
        while (i < n) {
            var ev_off = i * epoll_ev_size();          # H1 — per-arch stride
            var ev_mask = load32(events_buf + ev_off);
            var data = load64(events_buf + ev_off + epoll_data_off());
            if (data == TAG_LISTENER) {
                handle_accept(epfd, lfd, clock_now_ms());
            }
            if (data == TAG_SIGNAL) {
                stop = handle_signal(sigfd);
            }
            if (data > TAG_SIGNAL) {
                var keep[8];
                budget = event_batch_step(epfd, data, ev_mask, clock_now_ms(), budget, &keep);
                if (load64(&keep) == 0) {
                    drop_session(epfd, data);
                    # === 1.7.12 (AF) — charge the teardown. ===
                    #
                    # `drop_session`'s first act is an unconditional `player_save`,
                    # i.e. one `ed25519_sign` — CHG_SIGN = 10 against a
                    # PASS_CHARGE_MAX of 20. This arm consulted no budget at all,
                    # so a batch of MAX_EPOLL_EVENTS = 64 condemned sessions spent
                    # 640 charge units inside a 20-unit window while every OTHER
                    # path in the pass believed it was metered.
                    #
                    # This is VERBATIM the 1.7.0 finding — fixed there for
                    # `drain_pending_rx`, never carried to the two batch loops, in
                    # the release whose own comment reads "ONE constant for BOTH
                    # dispatch sites, on purpose". Same shape as that fix: the
                    # teardown happens (it cannot be deferred — the fd is a real
                    # resource and deferring the save would hold a pointer
                    # `fl_free` is about to reissue), the meter sees it, and the
                    # rest of the batch waits. epoll is LEVEL-TRIGGERED, so every
                    # event we do not read here is reported again next pass.
                    if (charge_stop(charge_spent(), g_charge_cap, 0) == 1) {
                        g_rx_backlog = g_rx_backlog + 1;
                        i = n;
                        continue;
                    }
                }
            }
            i = i + 1;
        }
        # 1.7.0 — the drain runs HERE, per pass, not once per tick from
        # advance_tick. It has its own window (see drain_pending_rx), so this is
        # two bounded windows per pass and not one unbounded one; the addition is
        # done out loud in the PASS_CHARGE_MAX block. Moving it is what makes a
        # refused line wait one pass instead of one tick interval.
        drain_pending_rx();
        event_pass_end();
        # Tick check — absolute scheduling per ADR 0003. If we drifted
        # past one tick, snap next_tick straight to the next future
        # boundary so we don't fire a burst of catch-up ticks.
        now = clock_now_ms();
        if (now >= next_tick) {
            next_tick = tick_step(epfd, next_tick, now, g_tick_ms);   # H14
        }
    }
    sys_close(epfd);
    sys_close(sigfd);
    #endif
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos: epoll watches only signalfd/timerfd (never sockets) and epoll_wait
    # is 3-arg (no timeout) — so the epoll socket-multiplexer can't be used.
    # Instead, a sleep_ms-paced poll loop: each pass drains pending accepts
    # (sock_accept#57 is non-blocking), sweeps every session for readable bytes
    # (sock_recv#49 non-blocking — see session_on_readable's agnos branch), then
    # runs the combat tick on its absolute 2.5 s schedule. No signalfd —
    # shutdown is process-kill / in-band. ~20 ms cadence ≈ 50 sweeps/s.
    g_epfd = 0;   # room broadcasts call flush_session(g_epfd, …); epfd is unused on agnos
    var next_tick = clock_now_ms() + g_tick_ms;
    var stop = 0;
    while (stop == 0) {
        handle_accept(0, lfd, clock_now_ms());
        # Non-blocking recv sweep over the active-session list. drop_session
        # unlinks the current node, so capture SS_NEXT before dispatch.
        # G1 (1.6.12) — the agnos sweep gets the same budget, and needed it more:
        # it walks EVERY session on every ~20 ms pass with no MAX_EPOLL_EVENTS
        # analog at all, so at MAX_SESSIONS it was 256 x 64 ms = ~16.5 s per
        # pass. ADR 0003's two loops had diverged here; this is the divergence.
        var budget = event_pass_begin();   # 1.7.0 — same window as the epoll side
        var s = g_session_head;
        while (s != 0) {
            var nxt = load64(s + SS_NEXT);
            var keep[8];
            budget = event_batch_step(0, s, EPOLLIN, clock_now_ms(), budget, &keep);
            if (load64(&keep) == 0) {
                drop_session(0, s);
                # 1.7.12 (AF) — the agnos twin, and it needed this MORE than the
                # epoll side: that loop is bounded by MAX_EPOLL_EVENTS = 64, this
                # one walks EVERY session on every ~20 ms pass with no analog. The
                # remainder is picked up next pass; g_rx_backlog also skips the
                # pacing sleep so it is the very next one.
                if (charge_stop(charge_spent(), g_charge_cap, 0) == 1) {
                    g_rx_backlog = g_rx_backlog + 1;
                    s = 0;
                    continue;
                }
            }
            s = nxt;
        }
        drain_pending_rx();
        event_pass_end();
        var now = clock_now_ms();
        if (now >= next_tick) {
            next_tick = tick_step(0, next_tick, now, g_tick_ms);   # H14
        }
        # 1.7.0 — skip the pacing sleep while refused lines are retained, for the
        # same reason the epoll side clamps its timeout to 0. Without this the
        # agnos backlog would drain at 50 lines/s. The sleep is the ONLY thing
        # pacing this loop, so it is restored the moment the backlog clears.
        if (g_rx_backlog == 0) { sys_sleep_ms(20); }
    }
    #endif
    println("server: shutdown signal received; closing listener.");
    shutdown_save_all();            # 1.7.11 — see below. BEFORE the audit flush.
    # 1.7.1 — a tally that never reaches the log is a flood nobody can see.
    audit_flush_all();
    sock_close(lfd);
    return 0;
}
