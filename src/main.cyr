# cyrius-yeomans-descent — main entry point.
#
# argv dispatch. The `serve` verb opens the M1 event-loop listener
# (per ADR 0003); `version` / `help` are stubs that don't touch the
# wire. Stdlib auto-included via cyrius.cyml; sibling src/* files
# need explicit `include` per first-party convention.

# M6 persistence chain (opt-in, never auto-resolved — see cyrius.cyml).
# Order: thread/thread_local → sakshi → libro. thread/thread_local MUST be
# included explicitly: sigil's crypto banks the SHA message-schedule per-thread
# via `cbank()` → `thread_local_get`, and the [deps]-stdlib auto-prepend does
# NOT pull them (unlike ct/keccak/random) — leaving thread_local_* as
# `ud2`/SIGILL trap stubs that crash `sha256` the instant ident derivation runs
# (regression surfaced 1.1.x). ct/keccak/random still auto-prepend ahead of sigil.
#
# sigil is NOT included here. libro 2.8.0 thinned its sigil surface to capability
# sub-bundles, so [deps.libro] now resolves sigil-mldsa (ed25519) + sigil_sha256
# + sigil_sha_ni + sigil_hex into lib/ and cyrius auto-includes them. Adding the
# MONOLITHIC lib/sigil.cyr on top defined every one of those symbols twice
# ("last definition wins") and dragged the unused x509/RSA bignum tables in —
# ~13 MB of .bss for a server that only calls ed25519_{keypair,sign,verify},
# sha256 and hex_{encode,decode_into}. All six live in the thin bundles.
include "lib/thread.cyr"
include "lib/thread_local.cyr"
include "lib/sakshi.cyr"
include "lib/libro.cyr"

include "src/telnet.cyr"
include "src/parser.cyr"
include "src/world.cyr"
include "src/mob.cyr"
include "src/session.cyr"
include "src/item.cyr"
include "src/combat.cyr"
include "src/classes.cyr"
include "src/persist.cyr"   # uses sigil/libro + session/item/world/classes enums
include "src/server.cyr"

# Keep in lockstep with the VERSION file — `cyrius.cyml` interpolates that file
# via ${file:VERSION}, but Cyrius has no source-level equivalent, so this literal
# is a hand-synced copy. It silently drifted to 1.1.3 across the 1.1.4 and 1.1.5
# releases (the `version` verb reported a build two releases old); the release
# checklist in CLAUDE.md now names this line explicitly.
var VERSION_STRING = "1.6.14";

# Identity line for the CLI, stdout only. What a connecting player sees is
# session_send_motd's banner instead — operator-facing and wire-facing stay apart.
fn print_banner(): i64 {
    println("yeoman's descent — a cyrius-native text MUD");
    return 0;
}

# Usage text, also the fallback for a bare invocation. The EXIT CODES block is
# contract, not decoration: a supervisor must be able to tell bad usage (2) from
# a command that ran and failed (1), so keep it in step with the returns below.
fn print_help(): i64 {
    print_banner();
    println("");
    println("USAGE: cyrius-yeomans-descent <command> [args]");
    println("");
    println("COMMANDS:");
    println("  serve [port]   start the M1 event-loop listener (default 4000)");
    println("  version        print version string");
    println("  help           show this message");
    println("");
    println("EXIT CODES:");
    println("  0  success");
    println("  1  command-specific failure");
    println("  2  bad usage (unknown command / arg)");
    return 0;
}

# Bare version line — no banner, nothing else on stdout, so release tooling can
# capture it whole. Prints VERSION_STRING, which is the hand-synced copy above.
fn cmd_version(): i64 {
    println(VERSION_STRING);
    return 0;
}

# Parse argv(2) as a port number; fall back to DEFAULT_PORT if absent
# or unparseable. Ports outside [1, 65535] reject with usage exit 2.
fn parse_port(): i64 {
    if (argc() < 3) { return DEFAULT_PORT; }
    var raw = argv(2);
    var p = atoi(raw);
    if (p < 1) { return 0 - 1; }
    if (p > 65535) { return 0 - 1; }
    return p;
}

# argv dispatch; the return value is the process exit code (see print_help).
# alloc_init + args_init run before any verb is read: argv()/argc() return 0
# until args_init slurps /proc/self/cmdline, and args_init allocates that
# buffer itself, so alloc_init must come first.
# Unrecognized verb, missing verb and a rejected port all exit 2, not 1: they
# never reached a command, so nothing ran that could have failed.
fn main(): i64 {
    alloc_init();
    args_init();
    if (argc() < 2) { print_help(); return 2; }
    var verb = argv(1);
    if (streq(verb, "help")    == 1) { return print_help(); }
    if (streq(verb, "version") == 1) { return cmd_version(); }
    if (streq(verb, "serve")   == 1) {
        var p = parse_port();
        if (p < 0) {
            println("serve: port must be an integer in [1, 65535]");
            return 2;
        }
        return cmd_serve(p);
    }
    println("unknown command — try `help`");
    return 2;
}

var r = main();
syscall(SYS_EXIT, r);
