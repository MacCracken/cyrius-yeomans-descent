# classes.cyr — M5 classes & abilities.
#
# The four callings (Pikeman / Splicer / Courier / Chaplain) load from
# `data/classes.cyml` (CYML, kind="class"): starting attributes
# (STR/DEX/CON/TEC) plus the derived combat profile (HP/AC/hit/damage) and
# an energy pool. Class selection (M5-A) is a login sub-phase; apply_class
# (M5-B) stamps the chosen class onto the session, replacing the flat
# PlayerStat defaults. Abilities + cooldowns (M5-C..G) live in the second
# half of this file.
#
# Included after combat.cyr so ability handlers can use the combat
# primitives (roll, combat_try_hit, mob hp); the login hooks
# (class_send_prompt / login_on_class) are forward-referenced from
# session.cyr.

# === Class data layout ===
enum CL {
    CL_ID       = 0;     # inline id (CL_ID_CAP)
    CL_ID_LEN   = 32;
    CL_NAME     = 40;    # inline display name (CL_NAME_CAP)
    CL_NAME_LEN = 72;
    CL_ROLE     = 80;    # inline role tag (CL_ROLE_CAP)
    CL_ROLE_LEN = 112;
    CL_STR      = 120;
    CL_DEX      = 128;
    CL_CON      = 136;
    CL_TEC      = 144;
    CL_HP       = 152;
    CL_AC       = 160;
    CL_HIT      = 168;
    CL_NDICE    = 176;
    CL_DSIZE    = 184;
    CL_DMOD     = 192;
    CL_ENERGY   = 200;
    CL_DESC_PTR = 208;
    CL_DESC_LEN = 216;
    CL_SIZE     = 224;
}
enum ClCap { CL_ID_CAP = 32; CL_NAME_CAP = 32; CL_ROLE_CAP = 32; }

var g_classes     = 0;
var g_class_count = 0;

# Base address of class record `i` in the flat table — unchecked; callers gate idx.
fn cl_at(i): i64        { return g_classes + i * CL_SIZE; }
# Name bytes sit inline in the record, so this is an offset, not a stored pointer.
fn cl_name_ptr(c): i64  { return c + CL_NAME; }
# Name length as written by copy_str_capped on load — never exceeds CL_NAME_CAP - 1.
fn cl_name_len(c): i64  { return load64(c + CL_NAME_LEN); }
# Role tag ("Tank / Melee") — inline like the name; shown beside it in the M5-A menu.
fn cl_role_ptr(c): i64  { return c + CL_ROLE; }
# Role tag length, likewise capped at CL_ROLE_CAP - 1 by the loader.
fn cl_role_len(c): i64  { return load64(c + CL_ROLE_LEN); }
# Starting HP; apply_class stamps it into both SS_MAXHP and SS_HP at selection.
fn cl_hp(c): i64        { return load64(c + CL_HP); }
# Armour class — lower is harder to hit, per the hidden roll in combat.cyr.
fn cl_ac(c): i64        { return load64(c + CL_AC); }
# Flat to-hit bonus folded into that roll.
fn cl_hit(c): i64       { return load64(c + CL_HIT); }
# Max energy pool — the cap classes_upkeep regenerates toward, ENERGY_REGEN a tick.
fn cl_energy(c): i64    { return load64(c + CL_ENERGY); }
# Starting STR — display/persist only today; damage comes from the dice profile.
fn cl_str(c): i64       { return load64(c + CL_STR); }
# Starting DEX — scales Courier backstab; the to-hit math does not read it.
fn cl_dex(c): i64       { return load64(c + CL_DEX); }
# Starting CON — the one attribute in the tick loop: out-of-combat regen, CON/5.
fn cl_con(c): i64       { return load64(c + CL_CON); }
# Starting TEC — ability power for Splicer damage and Chaplain heals.
fn cl_tec(c): i64       { return load64(c + CL_TEC); }

# H5 (1.6.14) — `session_class` deleted. It was never called, and its comment
# claimed a use ("for who / stats") that does not exist: both read SS_CLASS
# directly. A comment asserting a caller that is not there is worse than the
# dead code, because it makes the next reader look for one.
# Same bytes as cl_name_ptr, keyed by class index — for callers holding SS_CLASS.
fn class_name_ptr(idx): i64 { return cl_at(idx) + CL_NAME; }
# Length half of that pair; both feed session_appendtx, which takes ptr + len.
fn class_name_len(idx): i64 { return load64(cl_at(idx) + CL_NAME_LEN); }

# === world_load_classes — parse data/classes.cyml into the class table. ===
fn world_load_classes(path): i64 {
    # F6 (1.6.11) — unpublish FIRST, before anything can fail.
    #
    # H9 (1.6.5) moved the zeroing below the allocation so an in-loop rejection
    # could not leave a live half-table. It did not cover the three returns
    # ABOVE it — WL_ERR_IO, WL_ERR_EMPTY, WL_ERR_OVERCAP — so a missing or
    # empty file left the PREVIOUS table published while the caller was told the
    # load failed. Measured: after loading a nonexistent objs file the count was
    # still 10, mobs still 4, classes still 4. Only world_load_rooms was safe,
    # because it routes all eight of its returns through _wl_rooms_fail.
    #
    # Hoisting it here is the same guarantee with less machinery: there is no
    # error return before this line, so every one of them now unpublishes.
    g_class_count = 0;

    var r = cyml_parse_file_r(path);
    if (is_ok(r) == 0) { return WL_ERR_IO; }
    var doc = result_unwrap(r);
    var n = cyml_doc_entry_count(doc);
    if (n <= 0)          { return WL_ERR_EMPTY; }
    if (n > MAX_ENTRIES) { return WL_ERR_OVERCAP; }

    # H9 (1.6.5) — build into the global, but publish the COUNT only on the
    # success return below. Every `return WL_ERR_*` in the parse loop sits after
    # this point, so setting the count here meant a rejected file left a live,
    # partly-filled table behind: cmd_serve printed "no zone loaded" / "no mobs
    # loaded" and every `world_room_count() == 0` guard in session.cyr,
    # combat.cyr, item.cyr and server.cyr was defeated at the same moment. A
    # player could log in, walk into the prefix that did parse, and be stranded
    # in a room with no exits — with the operator told the load had failed.
    # Zeroing first is what makes cmd_serve's documented non-fatal behaviour
    # ("the server still runs, with the verbs answering their no-zone
    # placeholders") actually true.
    g_classes = alloc(n * CL_SIZE);
    memset(g_classes, 0, n * CL_SIZE);
    g_class_count = 0;   # (already zeroed at entry — F6; kept for clarity)

    var i = 0;
    while (i < n) {
        var e = cyml_doc_entry(doc, i);
        var hs = str_new(cyml_entry_header(e), cyml_entry_header_len(e));
        var secs = toml_parse(hs);
        if (vec_len(secs) == 0) { return WL_ERR_NOID; }
        var pairs = toml_section_pairs(vec_get(secs, 0));

        var kind = toml_get(pairs, "kind");
        if (kind == 0) { return WL_ERR_KIND; }
        if (str_eq_cstr(kind, "class") == 0) { return WL_ERR_KIND; }

        var c = cl_at(i);
        var id = toml_get(pairs, "id");
        if (id == 0) { return WL_ERR_NOID; }
        # H3 (1.6.14) — CAP - 1, matching the two fields beside it.
        #
        # This copied all 32 bytes of a 32-byte slot, leaving no terminator,
        # while the adjacent name and role copies use CAP - 1 for exactly that
        # reason. Safe today only because every reader goes through CL_ID_LEN
        # and nothing treats the id as a cstr — a trap for the first caller that
        # does, and the same shape as the OT_ID / OI_TPL_ID mismatch that 1.6.6
        # fixed for objects and did not sweep for classes.
        store64(c + CL_ID_LEN, copy_str_capped(c + CL_ID, CL_ID_CAP - 1, id));
        var name = toml_get(pairs, "name");
        if (name != 0) { store64(c + CL_NAME_LEN, copy_str_capped(c + CL_NAME, CL_NAME_CAP - 1, name)); }
        var role = toml_get(pairs, "role");
        if (role != 0) { store64(c + CL_ROLE_LEN, copy_str_capped(c + CL_ROLE, CL_ROLE_CAP - 1, role)); }

        store64(c + CL_STR, toml_int(pairs, "str", 10));
        store64(c + CL_DEX, toml_int(pairs, "dex", 10));
        store64(c + CL_CON, toml_int(pairs, "con", 10));
        store64(c + CL_TEC, toml_int(pairs, "tec", 10));
        store64(c + CL_HP,  toml_int(pairs, "hp", 30));
        store64(c + CL_AC,  toml_int(pairs, "ac", 8));
        store64(c + CL_HIT, toml_int(pairs, "hit", 1));
        store64(c + CL_ENERGY, toml_int(pairs, "energy", 20));

        var nd[8]; var dd[8]; var dm[8];
        parse_dice(toml_get(pairs, "damage"), &nd, &dd, &dm);
        store64(c + CL_NDICE, load64(&nd));
        store64(c + CL_DSIZE, load64(&dd));
        store64(c + CL_DMOD,  load64(&dm));

        store64(c + CL_DESC_PTR, cyml_entry_body(e));
        store64(c + CL_DESC_LEN, cyml_entry_body_len(e));
        i = i + 1;
    }
    g_class_count = n;   # H9 — publish only now that every entry parsed
    return n;
}

# === apply_class — stamp class `idx`'s profile onto a session (M5-B). ===
fn apply_class(s, idx): i64 {
    var c = cl_at(idx);
    store64(s + SS_CLASS, idx);
    # H4 (1.6.14) — the rest of the 1.6.7 sign sweep, finally finished.
    #
    # H12 (1.6.7) taught the config reader to accept negatives; H13 clamped
    # reset_secs and F9 (1.6.11) clamped hp and energy. These four were missed
    # both times. player_auth_load clamps all four to [1, 1000] when a saved
    # character is READ, so the invariant was asserted on the load path and
    # absent on the creation path — the same split F9 fixed for hp.
    store64(s + SS_STR, _clamp(cl_str(c), 1, 1000));
    store64(s + SS_DEX, _clamp(cl_dex(c), 1, 1000));
    store64(s + SS_CON, _clamp(cl_con(c), 1, 1000));
    store64(s + SS_TEC, _clamp(cl_tec(c), 1, 1000));
    # F9 (1.6.11) — clamp on the CREATION path, matching the load path exactly.
    #
    # H12 (1.6.7) taught toml_int to read a leading '-', and H13 clamped the one
    # caller it audited (reset_secs). These were not swept. `hp` and `energy`
    # flow from data/classes.cyml straight into SS_MAXHP / SS_MAXENERGY here,
    # while player_auth_load clamps those same two fields to [1, 1000000] and
    # [0, 1000000] — the invariant was asserted where a record is READ and
    # absent where a character is MADE. An authored `hp = -5` produced a player
    # who was dead on arrival.
    #
    # Clamped rather than rejected: ADR 0007 §5 freezes the class file format
    # for 1.x, so refusing a file that loads today is the compatibility break
    # that section exists to prevent. `ac` and `hit` are deliberately left
    # unclamped — a negative AC is meaningful in THAC0 and is precisely what H12
    # existed to enable.
    var chp = _clamp(cl_hp(c), 1, 1000000);       # forward ref → persist.cyr
    store64(s + SS_MAXHP, chp);
    store64(s + SS_HP, chp);
    store64(s + SS_AC, cl_ac(c));
    store64(s + SS_HIT, cl_hit(c));
    # H4 — the damage profile feeds roll()'s loop, so ndice is a trip count an
    # authored file should not be able to set to a million. Same bounds the load
    # path uses.
    store64(s + SS_NDICE, _clamp(load64(c + CL_NDICE), 1, 100));
    store64(s + SS_DSIZE, _clamp(load64(c + CL_DSIZE), 1, 1000));
    store64(s + SS_DMOD,  _clamp(load64(c + CL_DMOD), 0 - 1000, 10000));
    var cen = _clamp(cl_energy(c), 0, 1000000);   # F9 — same bound as the load path
    store64(s + SS_MAXENERGY, cen);
    store64(s + SS_ENERGY, cen);
    store64(s + SS_CD0, 0);
    store64(s + SS_CD1, 0);
    store64(s + SS_CD2, 0);
    store64(s + SS_GUARD, 0);
    store64(s + SS_STIM, 0);
    store64(s + SS_STEALTH, 0);
    return 0;
}

# === class_send_prompt — the M5-A selection menu. ===
fn class_send_prompt(s): i64 {
    session_appendtx_cstr(s, "\r\nChoose your calling in the Under-Grid:\r\n");
    var i = 0;
    var more = 0;
    while (i < g_class_count) {
        var c = cl_at(i);
        if (more > 0) {
            more = more + 1;
        } else {
            # 1.7.9 — whole lines only; see RoomList in session.cyr. One menu fits
            # comfortably at the four shipped classes, so this is dormant today —
            # but nothing flushes between the lines of a single read, and up to
            # RX_MAX_LINES bad choices can stack menus into one queue. At
            # MAX_ENTRIES = 32 authored classes two stacked menus pass TX_CAP.
            # Fixed with its siblings rather than left as the one loop in this
            # class that still truncates, which is how 1.7.7's findings happened.
            var need = 2 + 4 + 2 + cl_name_len(c) + 5 + cl_role_len(c) + 2;
            if (room_line_fits(s, need) == 0) {
                more = 1;
            } else {
                session_appendtx_cstr(s, "  ");
                session_appendtx_num(s, i + 1);
                session_appendtx_cstr(s, ") ");
                session_appendtx(s, cl_name_ptr(c), cl_name_len(c));
                session_appendtx_cstr(s, " — ");
                session_appendtx(s, cl_role_ptr(c), cl_role_len(c));
                session_appendtx_cstr(s, "\r\n");
            }
        }
        i = i + 1;
    }
    list_append_more(s, more, "callings", " not shown.\r\n");
    session_appendtx_cstr(s, "Enter a number or name: ");
    return 0;
}

# Is buf[0..tl) a case-insensitive prefix of class `c`'s id?
fn class_id_prefix(c, buf, tl): i64 {
    var idlen = load64(c + CL_ID_LEN);
    if (tl <= 0)      { return 0; }
    if (tl > idlen)   { return 0; }
    var a = c + CL_ID;
    var i = 0;
    while (i < tl) {
        if (ascii_lower(load8(a + i) & 0xFF) != ascii_lower(load8(buf + i) & 0xFF)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Resolve a class-selection line to a class index, or -1.
fn class_by_input(buf, len): i64 {
    var st = 0;
    while (st < len) {
        var c = load8(buf + st) & 0xFF;
        if (c != 32) { if (c != 9) { break; } }
        st = st + 1;
    }
    if (st >= len) { return 0 - 1; }
    var en = len;
    while (en > st) {
        var c = load8(buf + en - 1) & 0xFF;
        if (c != 32) { if (c != 9) { break; } }
        en = en - 1;
    }
    var p = buf + st;
    var tl = en - st;
    if (tl <= 0) { return 0 - 1; }

    if (tl == 1) {
        var d = load8(p) & 0xFF;
        if (d >= 49) { if (d <= 48 + g_class_count) { return d - 49; } }   # '1'..'N'
    }
    var i = 0;
    while (i < g_class_count) {
        if (class_id_prefix(cl_at(i), p, tl) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# === login_on_class — handle the class-selection prompt (M5-A). ===
fn login_on_class(s, buf, len): i64 {
    if (g_class_count == 0) {
        # No classes loaded (roomless / misconfigured) — skip into the world.
        store64(s + SS_PHASE, PHASE_CMD);
        session_enter_world(s);
        session_send_cmd_prompt(s);
        return 0;
    }
    var idx = class_by_input(buf, len);
    if (idx < 0) {
        session_appendtx_cstr(s, "No such calling. ");
        class_send_prompt(s);
        return 0;
    }
    apply_class(s, idx);
    store64(s + SS_PHASE, PHASE_CMD);
    session_appendtx_cstr(s, "\r\nYou take up the mantle of the ");
    session_appendtx(s, class_name_ptr(idx), class_name_len(idx));
    session_appendtx_cstr(s, ".\r\n");
    session_appendtx_cstr(s, "Type \"help\" for commands.\r\n");
    # === 1.7.15 (AO) — RESUME a character that already has a room. ===
    #
    # This called `session_enter_world` unconditionally, which OVERWRITES SS_ROOM
    # with the start room. For a brand-new character that is right. For one that
    # reached this menu through 1.7.11's classless-record heal it is silent,
    # permanent relocation: `player_auth_load` had already restored their real
    # room, and choosing a class threw it away. Reproduced by gate re-run #3 —
    # `hub.flagon` became `hub.gate` and the next save made it permanent.
    #
    # A defect inside this line's own fix, which is the shape this project keeps
    # finding: 1.7.11 correctly sent the player back to the menu and did not ask
    # what the menu's exit path would then do to the state it had just restored.
    #
    # `SS_ROOM` is the discriminator and needs no new field: `session_new` sets it
    # to -1 and only a successful load makes it >= 0. The two paths keep their own
    # arrival prose — "flickers into being" for a new character, "re-materializes
    # from the grid" for one coming back — though note that prose reaches only
    # ONLOOKERS: `room_broadcast` excludes the arriving session, so a test must
    # watch a second session in the room to see it.
    if (load64(s + SS_ROOM) < 0) { session_enter_world(s); }
    else { session_resume_world(s); }
    # H10 (1.6.5) — the character's FIRST record. Failing silently here means a
    # player finishes creation, plays, and finds nothing to log back in to.
    if (player_save(s) != 1) {
        audit_keyed(AK_SAVE_FAIL_CREATE, SEV_WARNING, "save.fail.create",
        load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), clock_now_ms());
        session_appendtx_cstr(s, "\r\nWARNING: your character could not be written to disk.\r\n");
    }
    session_send_cmd_prompt(s);
    return 0;
}

# ──────────────────────────────────────
# M5-G — Ability framework: energy, tick-counted cooldowns, status.
#
# Abilities resolve the instant they're typed (between ticks), composing
# with the 2.5 s auto-attack rather than replacing it — see
# [ADR 0001](../docs/adr/0001-tick-based-combat-over-cooldowns.md).
# Each costs energy and locks its cooldown slot for N ticks; classes_upkeep
# (run every tick from combat_tick_all) regenerates energy and decays
# cooldowns + buffs.

enum AbilityConst { ENERGY_REGEN = 3; }

# Does the session's class have id `cstr`?
fn cl_id_eq(idx, cstr): i64 {
    if (idx < 0) { return 0; }
    var c = cl_at(idx);
    var len = load64(c + CL_ID_LEN);
    var a = c + CL_ID;
    var i = 0;
    while (i < len) {
        var ch = load8(cstr + i) & 0xFF;
        if (ch == 0) { return 0; }
        if ((load8(a + i) & 0xFF) != ch) { return 0; }
        i = i + 1;
    }
    if ((load8(cstr + i) & 0xFF) != 0) { return 0; }
    return 1;
}

# Per-tick upkeep for one session: energy regen, cooldown + buff decay,
# and out-of-combat HP recovery (0.6.1).
fn classes_upkeep(s): i64 {
    var e = load64(s + SS_ENERGY) + ENERGY_REGEN;
    if (e > load64(s + SS_MAXENERGY)) { e = load64(s + SS_MAXENERGY); }
    store64(s + SS_ENERGY, e);
    if (load64(s + SS_CD0) > 0) { store64(s + SS_CD0, load64(s + SS_CD0) - 1); }
    if (load64(s + SS_CD1) > 0) { store64(s + SS_CD1, load64(s + SS_CD1) - 1); }
    if (load64(s + SS_CD2) > 0) { store64(s + SS_CD2, load64(s + SS_CD2) - 1); }
    if (load64(s + SS_GUARD) > 0) { store64(s + SS_GUARD, load64(s + SS_GUARD) - 1); }
    if (load64(s + SS_STIM) > 0)  { store64(s + SS_STIM, load64(s + SS_STIM) - 1); }

    # Recover HP while out of combat — CON-scaled, so tankier classes mend
    # faster. In combat (SS_TARGET set) you heal only via abilities.
    if (load64(s + SS_TARGET) == 0) {
        var hp = load64(s + SS_HP);
        var max = load64(s + SS_MAXHP);
        if (hp < max) {
            hp = hp + 1 + load64(s + SS_CON) / 5;
            if (hp > max) { hp = max; }
            store64(s + SS_HP, hp);
        }
    }
    return 0;
}

# Common class / cooldown / energy gate for a self-targeted ability.
# Spends on success (returns 1); on a block, sends the reason + returns 0.
fn self_prep(s, owner, slot, cost, cd, vname): i64 {
    if (cl_id_eq(load64(s + SS_CLASS), owner) == 0) {
        session_appendtx_cstr(s, "You don't know how to ");
        session_appendtx_cstr(s, vname);
        session_appendtx_cstr(s, ".\r\n");
        return 0;
    }
    var cda = s + SS_CD0 + slot * 8;
    if (load64(cda) > 0) {
        session_appendtx_cstr(s, vname);
        session_appendtx_cstr(s, " isn't ready — ");
        session_appendtx_num(s, load64(cda));
        session_appendtx_cstr(s, " more tick(s).\r\n");
        return 0;
    }
    if (load64(s + SS_ENERGY) < cost) {
        session_appendtx_cstr(s, "Not enough energy.\r\n");
        return 0;
    }
    store64(s + SS_ENERGY, load64(s + SS_ENERGY) - cost);
    store64(cda, cd);
    return 1;
}

# Same gate for an offensive ability; also requires an engaged, present,
# living target. Returns the target mob on success, else 0 (reason sent).
fn off_prep(s, owner, slot, cost, cd, vname): i64 {
    if (cl_id_eq(load64(s + SS_CLASS), owner) == 0) {
        session_appendtx_cstr(s, "You don't know how to ");
        session_appendtx_cstr(s, vname);
        session_appendtx_cstr(s, ".\r\n");
        return 0;
    }
    var m = load64(s + SS_TARGET);
    if (m == 0) { session_appendtx_cstr(s, "You aren't fighting anything.\r\n"); return 0; }
    if (mi_hp(m) <= 0) {
        store64(s + SS_TARGET, 0);
        session_appendtx_cstr(s, "Your target is already down.\r\n");
        return 0;
    }
    if (mi_room(m) != load64(s + SS_ROOM)) { session_appendtx_cstr(s, "Your target isn't here.\r\n"); return 0; }
    var cda = s + SS_CD0 + slot * 8;
    if (load64(cda) > 0) {
        session_appendtx_cstr(s, vname);
        session_appendtx_cstr(s, " isn't ready — ");
        session_appendtx_num(s, load64(cda));
        session_appendtx_cstr(s, " more tick(s).\r\n");
        return 0;
    }
    if (load64(s + SS_ENERGY) < cost) {
        session_appendtx_cstr(s, "Not enough energy.\r\n");
        return 0;
    }
    store64(s + SS_ENERGY, load64(s + SS_ENERGY) - cost);
    store64(cda, cd);
    return m;
}

# Deal `dmg` to mob `m` with a lead-in line; handles the kill.
fn ability_strike(s, m, dmg, lead): i64 {
    mi_set_hp(m, mi_hp(m) - dmg);
    session_appendtx_cstr(s, ansi_hit());
    session_appendtx_cstr(s, lead);
    session_appendtx_cstr(s, mi_name_ptr(m));
    session_appendtx_cstr(s, " for ");
    session_appendtx_num(s, dmg);
    session_appendtx_cstr(s, " damage!");
    session_appendtx_cstr(s, ansi_reset());
    session_appendtx_cstr(s, "\r\n");
    cb_player_act(s, m, " hammers ", "!\r\n");   # onlookers see the ability land
    # H12 (1.6.7) — report the kill so callers can drop their follow-up line.
    # `bash` and `emp` printed "It reels, stunned." after the mob had already
    # collapsed. Not a use-after-free — every ability sets the stun BEFORE the
    # strike and none touches `m` afterwards — but it described a corpse.
    if (mi_hp(m) <= 0) { mob_died(s, m); return 1; }
    return 0;
}

# Heal the player by `amt` (capped at max HP).
fn ability_heal(s, amt): i64 {
    var hp = load64(s + SS_HP) + amt;
    if (hp > load64(s + SS_MAXHP)) { hp = load64(s + SS_MAXHP); }
    store64(s + SS_HP, hp);
    session_appendtx_cstr(s, "Wounds close — +");
    session_appendtx_num(s, amt);
    session_appendtx_cstr(s, " hp.\r\n");
    return 0;
}

# Common tail: status line, prompt, flush.
fn ability_tail(s): i64 {
    session_append_condition(s);
    session_send_cmd_prompt(s);
    combat_flush(s);
    return 0;
}

# Append the player's class abilities to the help text (M5).
fn class_append_abilities(s): i64 {
    var cls = load64(s + SS_CLASS);
    if (cls < 0) { return 0; }
    session_appendtx_cstr(s, "abilities (");
    session_appendtx(s, class_name_ptr(cls), class_name_len(cls));
    session_appendtx_cstr(s, "): ");
    if (cl_id_eq(cls, "pikeman")  == 1) { session_appendtx_cstr(s, "bash brace cleave"); }
    if (cl_id_eq(cls, "splicer")  == 1) { session_appendtx_cstr(s, "hack overload emp"); }
    if (cl_id_eq(cls, "courier")  == 1) { session_appendtx_cstr(s, "sneak backstab bypass"); }
    if (cl_id_eq(cls, "chaplain") == 1) { session_appendtx_cstr(s, "patch stim rally"); }
    session_appendtx_cstr(s, "\r\n");
    return 0;
}

# === cmd_ability — dispatch the 12 class abilities (M5-C..F). ===
fn cmd_ability(s, pa, verb): i64 {
    var tec = load64(s + SS_TEC);
    var dex = load64(s + SS_DEX);

    # --- Pikeman (STR/CON melee) ---
    if (verb == VERB_BASH) {
        var m = off_prep(s, "pikeman", 0, 6, 2, "bash");
        if (m != 0) {
            mi_set_stun(m, 1);
            var dmg = roll(load64(s + SS_NDICE), load64(s + SS_DSIZE),
            load64(s + SS_DMOD)) + 2;
            if (ability_strike(s, m, dmg, "You smash your shock-pike into ") == 0) {
                session_appendtx_cstr(s, "It reels, stunned.\r\n");
            }
        }
        return ability_tail(s);
    }
    if (verb == VERB_BRACE) {
        if (self_prep(s, "pikeman", 1, 5, 3, "brace") == 1) {
            store64(s + SS_GUARD, 3);
            session_appendtx_cstr(s, "You set your feet and raise your guard.\r\n");
        }
        return ability_tail(s);
    }
    if (verb == VERB_CLEAVE) {
        var m = off_prep(s, "pikeman", 2, 8, 3, "cleave");
        if (m != 0) {
            var d = roll(load64(s + SS_NDICE), load64(s + SS_DSIZE), load64(s + SS_DMOD));
            d = d + roll(load64(s + SS_NDICE), load64(s + SS_DSIZE), load64(s + SS_DMOD));
            ability_strike(s, m, d, "You cleave a brutal arc through ");
        }
        return ability_tail(s);
    }

    # --- Splicer (TEC caster) ---
    if (verb == VERB_HACK) {
        var m = off_prep(s, "splicer", 0, 6, 1, "hack");
        if (m != 0) { ability_strike(s, m, roll(1, 6, 0) + tec / 2, "Your intrusion spikes through "); }
        return ability_tail(s);
    }
    if (verb == VERB_OVERLOAD) {
        var m = off_prep(s, "splicer", 1, 12, 4, "overload");
        if (m != 0) { ability_strike(s, m, roll(3, 6, 0) + tec, "You overvolt every circuit in "); }
        return ability_tail(s);
    }
    if (verb == VERB_EMP) {
        var m = off_prep(s, "splicer", 2, 8, 4, "emp");
        if (m != 0) {
            mi_set_stun(m, 2);
            if (ability_strike(s, m, roll(1, 4, 0), "An EMP burst seizes the systems of ") == 0) {
                session_appendtx_cstr(s, "Its servos lock up.\r\n");
            }
        }
        return ability_tail(s);
    }

    # --- Courier (DEX rogue) ---
    if (verb == VERB_SNEAK) {
        if (self_prep(s, "courier", 0, 4, 2, "sneak") == 1) {
            store64(s + SS_STEALTH, 1);
            session_appendtx_cstr(s, "You melt into the shadows, blade ready.\r\n");
        }
        return ability_tail(s);
    }
    if (verb == VERB_BACKSTAB) {
        var m = off_prep(s, "courier", 1, 6, 2, "backstab");
        if (m != 0) {
            var base = roll(load64(s + SS_NDICE), load64(s + SS_DSIZE), load64(s + SS_DMOD));
            var d = base + dex / 2;
            if (load64(s + SS_STEALTH) > 0) {
                d = base * 3 + dex;
                store64(s + SS_STEALTH, 0);
                ability_strike(s, m, d, "From the dark you drive your monoblade into ");
            } else {
                ability_strike(s, m, d, "You slip past the guard of ");
            }
        }
        return ability_tail(s);
    }
    if (verb == VERB_BYPASS) {
        if (self_prep(s, "courier", 2, 5, 3, "bypass") == 1) {
            store64(s + SS_GUARD, 2);
            session_appendtx_cstr(s, "You shift onto the balls of your feet, ready to slip every blow.\r\n");
        }
        return ability_tail(s);
    }

    # --- Chaplain (TEC/CON support) ---
    if (verb == VERB_PATCH) {
        if (self_prep(s, "chaplain", 0, 6, 1, "patch") == 1) { ability_heal(s, roll(2, 6, 0) + tec / 2); }
        return ability_tail(s);
    }
    if (verb == VERB_STIM) {
        if (self_prep(s, "chaplain", 1, 6, 3, "stim") == 1) {
            store64(s + SS_STIM, 3);
            session_appendtx_cstr(s, "A combat stimulant floods your system — you feel fast and strong.\r\n");
        }
        return ability_tail(s);
    }
    if (verb == VERB_RALLY) {
        if (self_prep(s, "chaplain", 2, 12, 5, "rally") == 1) {
            ability_heal(s, roll(3, 6, 0) + tec);
            store64(s + SS_STIM, 3);
            session_appendtx_cstr(s, "You rally — blood up, faith harder than the steel around you.\r\n");
        }
        return ability_tail(s);
    }

    session_appendtx_cstr(s, "You can't do that.\r\n");
    return ability_tail(s);
}
