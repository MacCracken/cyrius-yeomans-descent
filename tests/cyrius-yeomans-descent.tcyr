# cyrius-yeomans-descent test suite
# Stdlib auto-included via cyrius.cyml; project modules included explicitly.

# M6 persistence chain — opt-in libs before the modules that use them.
# sigil is NOT included: [deps.libro] resolves the thin capability sub-bundles
# (sigil-mldsa / sigil_sha256 / sigil_sha_ni / sigil_hex) and cyrius auto-includes
# them. Adding the monolithic lib/sigil.cyr redefined all of it — see src/main.cyr.
include "lib/thread.cyr"        # sigil cbank() → thread_local_get; MUST be
include "lib/thread_local.cyr"  # explicit or sha256 SIGILLs (see src/main.cyr)
include "lib/sakshi.cyr"
include "lib/libro.cyr"

include "src/telnet.cyr"
include "src/parser.cyr"
include "src/world.cyr"
include "src/mob.cyr"
include "src/session.cyr"
include "src/item.cyr"
include "src/combat.cyr"
include "src/classes.cyr"
include "src/persist.cyr"
# session.cyr forward-references 12 server.cyr symbols (flush_session,
# room_broadcast, render_*, …). They were unreachable from the suite so it
# built anyway, but every run printed 12 "undefined function" warnings —
# noise that would hide a real one.
include "src/server.cyr"

# Feed a byte and assert the returned TelEvent.
fn feed_is(ts, b, want_ev, name): i64 {
    return assert_eq(telnet_feed(ts, b), want_ev, name);
}

# === M1-C — Telnet IAC parser ===
fn test_telnet(): i64 {
    test_group("telnet");

    # T1: a plain data byte passes through as EV_DATA, value preserved.
    var ts = telnet_state_new();
    feed_is(ts, 0x41, EV_DATA, "plain byte → EV_DATA");
    assert_eq(telnet_data_byte(ts) & 0xFF, 0x41, "data byte is 'A'");

    # T2: IAC IAC is an escaped literal 0xFF in the data stream.
    feed_is(ts, IAC, EV_NONE, "IAC → EV_NONE (enter IAC state)");
    feed_is(ts, IAC, EV_DATA, "IAC IAC → EV_DATA");
    assert_eq(telnet_data_byte(ts) & 0xFF, 0xFF, "escaped byte is 0xFF");

    # T3: naive-refuse — peer WILL ECHO draws IAC DONT ECHO.
    var t3 = telnet_state_new();
    telnet_feed(t3, IAC);
    telnet_feed(t3, WILL);
    telnet_feed(t3, OPT_ECHO);
    assert_eq(telnet_tx_len(t3), 3, "WILL draws a 3-byte reply");
    var b3 = telnet_tx_buf(t3);
    assert_eq(load8(b3 + 0) & 0xFF, IAC,  "reply[0] = IAC");
    assert_eq(load8(b3 + 1) & 0xFF, DONT, "reply[1] = DONT");
    assert_eq(load8(b3 + 2) & 0xFF, OPT_ECHO, "reply[2] = ECHO");

    # T4: naive-refuse — peer DO on an untracked option draws IAC WONT.
    # (SGA is a preferred option under M1-D; STATUS stays untracked.)
    var t4 = telnet_state_new();
    telnet_feed(t4, IAC);
    telnet_feed(t4, DO);
    telnet_feed(t4, OPT_STATUS);
    var b4 = telnet_tx_buf(t4);
    assert_eq(load8(b4 + 1) & 0xFF, WONT, "DO untracked draws WONT");

    # T5: a single-byte command (NOP) is consumed with no reply.
    var t5 = telnet_state_new();
    telnet_feed(t5, IAC);
    feed_is(t5, NOP, EV_NONE, "IAC NOP → EV_NONE");
    assert_eq(telnet_tx_len(t5), 0, "NOP draws no reply");

    # T6: subnegotiation collects its payload and ends with EV_SB.
    var t6 = telnet_state_new();
    telnet_feed(t6, IAC);
    telnet_feed(t6, SB);
    telnet_feed(t6, OPT_NAWS);
    telnet_feed(t6, 0x00);
    telnet_feed(t6, 0x50);   # cols = 80
    telnet_feed(t6, 0x00);
    telnet_feed(t6, 0x18);   # rows = 24
    telnet_feed(t6, IAC);
    feed_is(t6, SE, EV_SB, "IAC SE → EV_SB");
    assert_eq(telnet_sb_len(t6), 5, "subneg payload is 5 bytes (opt+4)");
    assert_eq(load8(telnet_sb_buf(t6)) & 0xFF, OPT_NAWS, "payload[0] = NAWS");

    # T7: an escaped IAC inside SB lands as a literal 0xFF in the payload.
    var t7 = telnet_state_new();
    telnet_feed(t7, IAC);
    telnet_feed(t7, SB);
    telnet_feed(t7, OPT_STATUS);
    telnet_feed(t7, 0x42);   # 'B'
    telnet_feed(t7, IAC);
    telnet_feed(t7, IAC);    # escaped → 0xFF
    telnet_feed(t7, 0x43);   # 'C'
    telnet_feed(t7, IAC);
    feed_is(t7, SE, EV_SB, "escaped-SB → EV_SB");
    assert_eq(telnet_sb_len(t7), 4, "payload is 4 bytes");
    assert_eq(load8(telnet_sb_buf(t7) + 2) & 0xFF, 0xFF, "payload[2] = 0xFF");

    # T8: malformed SB (IAC then a non-SE/non-IAC byte) recovers to DATA;
    # the next plain byte flows as data, proving no lock-up.
    var t8 = telnet_state_new();
    telnet_feed(t8, IAC);
    telnet_feed(t8, SB);
    telnet_feed(t8, OPT_STATUS);
    telnet_feed(t8, 0x42);
    telnet_feed(t8, IAC);
    telnet_feed(t8, NOP);    # malformed inside SB
    feed_is(t8, 0x5A, EV_DATA, "recovers to DATA after malformed SB");
    assert_eq(telnet_data_byte(t8) & 0xFF, 0x5A, "data byte is 'Z'");

    # T9: data still flows around a negotiation salvo (mixed stream).
    var t9 = telnet_state_new();
    feed_is(t9, 0x58, EV_DATA, "pre-negotiation 'X' is data");
    telnet_feed(t9, IAC);
    telnet_feed(t9, DO);
    telnet_feed(t9, OPT_ECHO);
    feed_is(t9, 0x59, EV_DATA, "post-negotiation 'Y' is data");
    assert_eq(telnet_tx_len(t9), 3, "the DO ECHO drew exactly one reply");

    return 0;
}

# === M1-D — RFC 1143 Q-method negotiation ===
fn test_negotiation(): i64 {
    test_group("negotiation");

    # N1: the announce is silent — the client keeps cooked line mode (it
    # local-echoes + edits the line itself). We never volunteer ECHO/SGA, so
    # us-ECHO stays NO. (Masking is raised by hand at the passphrase — see N2b.)
    var ts = telnet_state_new();
    telnet_announce(ts);
    assert_eq(telnet_tx_len(ts), 0, "announce queues nothing (line mode)");
    assert_eq(opt_us(ts, OPT_ECHO), Q_NO, "us-ECHO stays NO after announce");

    # N2: an unsolicited DO ECHO is REFUSED (WONT ECHO) — the server never echoes
    # normal input, the client keeps local-echoing. us-ECHO stays NO.
    var t2 = telnet_state_new();
    telnet_announce(t2);
    telnet_tx_consume(t2);
    telnet_feed(t2, IAC);
    telnet_feed(t2, DO);
    telnet_feed(t2, OPT_ECHO);
    assert_eq(telnet_tx_len(t2), 3, "unsolicited DO ECHO draws a refusal");
    assert_eq(load8(telnet_tx_buf(t2) + 1) & 0xFF, WONT, "DO ECHO → WONT ECHO");
    assert_eq(opt_us(t2, OPT_ECHO), Q_NO, "us-ECHO stays NO (we won't echo normal input)");

    # N2b: but a hand-raised WILL ECHO (passphrase masking, session_echo_off sets
    # us=WANTYES) IS honoured — the peer's DO ECHO confirms it, us=YES, no reply.
    var t2b = telnet_state_new();
    opt_set_us(t2b, OPT_ECHO, Q_WANTYES);
    telnet_feed(t2b, IAC);
    telnet_feed(t2b, DO);
    telnet_feed(t2b, OPT_ECHO);
    assert_eq(telnet_tx_len(t2b), 0, "DO ECHO confirms our WANTYES — no reply");
    assert_eq(opt_us(t2b, OPT_ECHO), Q_YES, "passphrase WILL ECHO settles at YES");

    # N3: peer DONT ECHO after announce — accept silently, us=NO.
    var t3 = telnet_state_new();
    telnet_announce(t3);
    telnet_tx_consume(t3);
    telnet_feed(t3, IAC);
    telnet_feed(t3, DONT);
    telnet_feed(t3, OPT_ECHO);
    assert_eq(opt_us(t3, OPT_ECHO), Q_NO, "us-ECHO drops to NO on DONT");

    # N4: an untracked option (STATUS) still routes to naive-refuse.
    var t4 = telnet_state_new();
    telnet_feed(t4, IAC);
    telnet_feed(t4, WILL);
    telnet_feed(t4, OPT_STATUS);
    assert_eq(telnet_tx_len(t4), 3, "untracked WILL draws a refusal");
    assert_eq(load8(telnet_tx_buf(t4) + 1) & 0xFF, DONT, "untracked WILL → DONT");

    # N5: peer asks us to do SGA (DO SGA) cold — we prefer it, so WILL SGA.
    var t5 = telnet_state_new();
    telnet_feed(t5, IAC);
    telnet_feed(t5, DO);
    telnet_feed(t5, OPT_SUPPRESS_GO_AHEAD);
    assert_eq(load8(telnet_tx_buf(t5) + 1) & 0xFF, WILL, "DO SGA → WILL SGA");
    assert_eq(opt_us(t5, OPT_SUPPRESS_GO_AHEAD), Q_YES, "us-SGA at YES");

    return 0;
}

# === M1-E — login name validation ===
fn name_ok_cstr(lit): i64 { return login_name_ok(lit, strlen(lit)); }

fn test_login(): i64 {
    test_group("login");
    assert_eq(name_ok_cstr("kiran"),  1, "kiran ok");
    assert_eq(name_ok_cstr("ab"),     1, "2 chars ok (min)");
    assert_eq(name_ok_cstr("Kiran7"), 1, "alnum mixed-case ok");
    assert_eq(name_ok_cstr("admins"), 1, "admins is not reserved");
    assert_eq(name_ok_cstr("a"),      0, "1 char too short");
    assert_eq(name_ok_cstr("verylongnamebeyond"), 0, "18 chars too long");
    assert_eq(name_ok_cstr("_hidden"), 0, "leading underscore rejected");
    assert_eq(name_ok_cstr("123go"),  0, "leading digit rejected");
    assert_eq(name_ok_cstr("kir an"), 0, "embedded space rejected");
    assert_eq(name_ok_cstr("admin"),  0, "reserved admin rejected");
    assert_eq(name_ok_cstr("ADMIN"),  0, "reserved admin (caps) rejected");
    assert_eq(name_ok_cstr("system"), 0, "reserved system rejected");
    return 0;
}

# === M2-A — tokenizer ===
# Tokenize a NUL-terminated literal; return the token count.
fn tok_cstr(pa, lit): i64 { return parser_tokenize(pa, lit, strlen(lit)); }

fn test_tokenize(): i64 {
    test_group("tokenize");
    var pa = parser_new();

    # K1: plain two-token split.
    assert_eq(tok_cstr(pa, "get sword"), 2, "two tokens");
    assert_eq(tok_eq(pa, 0, "get"),   1, "tok0 = get");
    assert_eq(tok_eq(pa, 1, "sword"), 1, "tok1 = sword");

    # K2: lowercase normalization.
    tok_cstr(pa, "GET Sword");
    assert_eq(tok_eq(pa, 0, "get"),   1, "GET → get");
    assert_eq(tok_eq(pa, 1, "sword"), 1, "Sword → sword");

    # K3: runs of spaces + leading/trailing whitespace collapse.
    assert_eq(tok_cstr(pa, "  look   north  "), 2, "collapsed whitespace → 2");
    assert_eq(tok_eq(pa, 0, "look"),  1, "tok0 = look");
    assert_eq(tok_eq(pa, 1, "north"), 1, "tok1 = north");

    # K4: tab is a delimiter too.
    assert_eq(tok_cstr(pa, "say\thi"), 2, "tab splits");

    # K5: a double-quoted run is one multi-word token (quotes stripped).
    assert_eq(tok_cstr(pa, "get \"rusted drone\""), 2, "quoted phrase = 1 tok");
    assert_eq(tok_eq(pa, 0, "get"), 1, "tok0 = get");
    assert_eq(tok_eq(pa, 1, "rusted drone"), 1, "tok1 = 'rusted drone'");

    # K6: empty quotes emit no token.
    assert_eq(tok_cstr(pa, "say \"\""), 1, "empty quotes drop");
    assert_eq(tok_eq(pa, 0, "say"), 1, "only token is say");

    # K7: an unterminated quote runs to end of line.
    assert_eq(tok_cstr(pa, "get \"rusted"), 2, "unterminated quote → 2 toks");
    assert_eq(tok_eq(pa, 1, "rusted"), 1, "tok1 = rusted");

    # K8: an empty line yields zero tokens.
    assert_eq(tok_cstr(pa, ""), 0, "empty line → 0 tokens");
    assert_eq(tok_cstr(pa, "      "), 0, "all-whitespace → 0 tokens");

    # K9: tok_eq guards out-of-range indices.
    tok_cstr(pa, "look");
    assert_eq(tok_eq(pa, 5, "look"), 0, "oob index → no match");
    assert_eq(tok_eq(pa, 0, "looking"), 0, "literal longer than token");
    assert_eq(tok_eq(pa, 0, "lo"), 0, "literal shorter than token");

    parser_free(pa);
    return 0;
}

# === M2-B — verb table + aliases ===
# Tokenize a one-word literal and return the Verb id of token 0.
fn verb_of(pa, lit): i64 { tok_cstr(pa, lit); return verb_lookup(pa, 0); }

fn test_verbs(): i64 {
    test_group("verbs");
    var pa = parser_new();

    # canonical words resolve.
    assert_eq(verb_of(pa, "look"),      VERB_LOOK,      "look");
    assert_eq(verb_of(pa, "get"),       VERB_GET,       "get");
    assert_eq(verb_of(pa, "kill"),      VERB_KILL,      "kill");
    assert_eq(verb_of(pa, "inventory"), VERB_INVENTORY, "inventory");
    assert_eq(verb_of(pa, "quit"),      VERB_QUIT,      "quit");

    # aliases fold into their canonical verb.
    assert_eq(verb_of(pa, "l"),   VERB_LOOK,      "l → look");
    assert_eq(verb_of(pa, "i"),   VERB_INVENTORY, "i → inventory");
    assert_eq(verb_of(pa, "inv"), VERB_INVENTORY, "inv → inventory");

    # every cardinal direction, word + single-letter.
    assert_eq(verb_of(pa, "north"), VERB_NORTH, "north");
    assert_eq(verb_of(pa, "n"),     VERB_NORTH, "n → north");
    assert_eq(verb_of(pa, "s"),     VERB_SOUTH, "s → south");
    assert_eq(verb_of(pa, "e"),     VERB_EAST,  "e → east");
    assert_eq(verb_of(pa, "w"),     VERB_WEST,  "w → west");
    assert_eq(verb_of(pa, "u"),     VERB_UP,    "u → up");
    assert_eq(verb_of(pa, "d"),     VERB_DOWN,  "d → down");

    # case-insensitivity rides on tokenizer lowercasing.
    assert_eq(verb_of(pa, "LOOK"), VERB_LOOK, "LOOK → look");

    # unknown words + empty.
    assert_eq(verb_of(pa, "xyzzy"), VERB_UNKNOWN, "xyzzy unknown");
    assert_eq(verb_of(pa, ""),      VERB_UNKNOWN, "empty → unknown");

    # taxonomy + name round-trip.
    assert_eq(verb_is_movement(VERB_NORTH), 1, "north is movement");
    assert_eq(verb_is_movement(VERB_LOOK),  0, "look is not movement");
    assert_eq(streq(verb_name(VERB_GET), "get"), 1, "verb_name(GET) = get");

    parser_free(pa);
    return 0;
}

# === M2-C — direct-object resolution ===
# Resolve a one-token noun literal against a scope (names/n).
fn resolve_lit(pa, lit, names, n): i64 {
    tok_cstr(pa, lit);
    return resolve_tok(pa, 0, names, n);
}

fn test_resolve(): i64 {
    test_group("resolve");
    var pa = parser_new();

    # Synthetic scope: 3 entities, each a space-separated keyword string.
    # (M3 builds this array from live room / inventory contents.)
    var names[24];                       # 3 pointers × 8 bytes
    store64(&names + 0,  "rusted security drone");
    store64(&names + 8,  "shock pike");
    store64(&names + 16, "battered drone");
    var n = 3;

    # unique keyword prefix → that entity's index.
    assert_eq(resolve_lit(pa, "pike",  &names, n), 1, "pike → e1");
    assert_eq(resolve_lit(pa, "shock", &names, n), 1, "shock → e1");
    assert_eq(resolve_lit(pa, "sec",   &names, n), 0, "sec (prefix) → e0");
    assert_eq(resolve_lit(pa, "rust",  &names, n), 0, "rust (prefix) → e0");
    assert_eq(resolve_lit(pa, "p",     &names, n), 1, "single-char prefix p → e1");

    # a keyword shared by two entities is ambiguous.
    assert_eq(resolve_lit(pa, "drone", &names, n), RES_AMBIGUOUS, "drone ambiguous");

    # no match.
    assert_eq(resolve_lit(pa, "xyzzy", &names, n), RES_NOTFOUND, "xyzzy not found");

    # case-insensitive (token lowercased; keyword lowercased on the fly).
    assert_eq(resolve_lit(pa, "PIKE", &names, n), 1, "PIKE → e1");

    # primitive-level checks.
    assert_eq(kw_matches("dro",  3, "battered drone"), 1, "dro prefixes drone");
    assert_eq(kw_matches("ron",  3, "battered drone"), 0, "mid-word no match");
    assert_eq(kw_matches("drone7", 6, "battered drone"), 0, "noun longer than kw");
    assert_eq(resolve_count("drone", 5, &names, n), 2, "two drones in scope");
    assert_eq(resolve_count("nope",  4, &names, n), 0, "no matches counted");

    parser_free(pa);
    return 0;
}

# === M2-D — preposition / indirect-object split ===
fn parse_lit(pa, lit): i64 { return parser_parse(pa, lit, strlen(lit)); }

fn test_prep(): i64 {
    test_group("prep");
    var pa = parser_new();

    # "put rations in pack" — verb/dobj/prep/iobj all present.
    parse_lit(pa, "put rations in pack");
    assert_eq(parsed_verb(pa), VERB_PUT,  "verb = put");
    assert_eq(parsed_prep(pa), PREP_IN,   "prep = in");
    assert_eq(tok_eq(pa, parsed_dobj(pa), "rations"), 1, "dobj = rations");
    assert_eq(tok_eq(pa, parsed_iobj(pa), "pack"),    1, "iobj = pack");

    # "give monoblade to kiran".
    parse_lit(pa, "give monoblade to kiran");
    assert_eq(parsed_verb(pa), VERB_GIVE, "verb = give");
    assert_eq(parsed_prep(pa), PREP_TO,   "prep = to");
    assert_eq(tok_eq(pa, parsed_dobj(pa), "monoblade"), 1, "dobj = monoblade");
    assert_eq(tok_eq(pa, parsed_iobj(pa), "kiran"),     1, "iobj = kiran");

    # "get all from corpse" — qualifier word stays a dobj token (M2-E reads it).
    parse_lit(pa, "get all from corpse");
    assert_eq(parsed_verb(pa), VERB_GET,  "verb = get");
    assert_eq(parsed_prep(pa), PREP_FROM, "prep = from");
    assert_eq(tok_eq(pa, parsed_dobj(pa), "all"),    1, "dobj = all");
    assert_eq(tok_eq(pa, parsed_iobj(pa), "corpse"), 1, "iobj = corpse");

    # "look at drone" — empty dobj phrase, iobj only.
    parse_lit(pa, "look at drone");
    assert_eq(parsed_verb(pa), VERB_LOOK, "verb = look");
    assert_eq(parsed_prep(pa), PREP_AT,   "prep = at");
    assert_eq(parsed_has_dobj(pa), 0,     "no dobj before 'at'");
    assert_eq(tok_eq(pa, parsed_iobj(pa), "drone"), 1, "iobj = drone");

    # "get sword" — dobj, no preposition.
    parse_lit(pa, "get sword");
    assert_eq(parsed_prep(pa), PREP_NONE, "no prep");
    assert_eq(tok_eq(pa, parsed_dobj(pa), "sword"), 1, "dobj = sword");
    assert_eq(parsed_has_iobj(pa), 0, "no iobj");

    # head-noun rule: unquoted multi-word dobj resolves on its last token.
    parse_lit(pa, "examine rusted drone");
    assert_eq(parsed_verb(pa), VERB_EXAMINE, "verb = examine");
    assert_eq(tok_eq(pa, parsed_dobj(pa), "drone"), 1, "head noun = drone");

    # bare verb — no objects.
    parse_lit(pa, "look");
    assert_eq(parsed_verb(pa), VERB_LOOK, "verb = look");
    assert_eq(parsed_has_dobj(pa), 0, "bare verb: no dobj");
    assert_eq(parsed_has_iobj(pa), 0, "bare verb: no iobj");

    # empty line.
    assert_eq(parse_lit(pa, ""), VERB_UNKNOWN, "empty → unknown verb");

    parser_free(pa);
    return 0;
}

# === M2-E — qualifiers (all.X / X.N) ===
fn test_qual(): i64 {
    test_group("qual");
    var pa = parser_new();

    var kind[8]; var num[8]; var bp[8]; var bl[8];

    # "all.rations" → QUAL_ALL, base "rations".
    parse_lit(pa, "get all.rations");
    qual_parse(pa, parsed_dobj(pa), &kind, &num, &bp, &bl);
    assert_eq(load64(&kind), QUAL_ALL, "all.rations → ALL");
    assert_eq(load64(&bl), 7, "base len = len('rations')");

    # bare "all" → QUAL_ALL, zero-length base (everything).
    parse_lit(pa, "get all from corpse");
    qual_parse(pa, parsed_dobj(pa), &kind, &num, &bp, &bl);
    assert_eq(load64(&kind), QUAL_ALL, "bare all → ALL");
    assert_eq(load64(&bl), 0, "bare all → empty base");

    # "2.drone" → QUAL_NTH n=2, base "drone".
    parse_lit(pa, "kill 2.drone");
    qual_parse(pa, parsed_dobj(pa), &kind, &num, &bp, &bl);
    assert_eq(load64(&kind), QUAL_NTH, "2.drone → NTH");
    assert_eq(load64(&num), 2, "n = 2");

    # plain noun → QUAL_NONE, whole token is the base.
    parse_lit(pa, "kill drone");
    qual_parse(pa, parsed_dobj(pa), &kind, &num, &bp, &bl);
    assert_eq(load64(&kind), QUAL_NONE, "drone → NONE");
    assert_eq(load64(&bl), 5, "base len = len('drone')");

    # parse_uint / is_word_all primitives.
    assert_eq(parse_uint("12", 2), 12, "parse_uint 12");
    assert_eq(parse_uint("3x", 2), 0 - 1, "parse_uint non-digit → -1");
    assert_eq(is_word_all("all", 3), 1, "is_word_all yes");
    assert_eq(is_word_all("ale", 3), 0, "is_word_all no");

    # Resolution against a synthetic scope with three drones + a pike.
    var names[32];
    store64(&names + 0,  "alpha drone");
    store64(&names + 8,  "beta drone");
    store64(&names + 16, "gamma drone");
    store64(&names + 24, "shock pike");
    var n = 4;

    # resolve_nth picks the Nth in scan order.
    assert_eq(resolve_nth("drone", 5, &names, n, 1), 0, "1st drone → e0");
    assert_eq(resolve_nth("drone", 5, &names, n, 2), 1, "2nd drone → e1");
    assert_eq(resolve_nth("drone", 5, &names, n, 3), 2, "3rd drone → e2");
    assert_eq(resolve_nth("drone", 5, &names, n, 4), RES_NOTFOUND, "no 4th drone");
    assert_eq(resolve_nth("drone", 5, &names, n, 0), RES_NOTFOUND, "0th → notfound");

    # resolve_all collects every match in scan order.
    var out[64];
    assert_eq(resolve_all("drone", 5, &names, n, &out, 8), 3, "all drones → 3");
    assert_eq(load64(&out + 0), 0, "out[0] = e0");
    assert_eq(load64(&out + 16), 2, "out[2] = e2");

    # bare all (zero-length noun) matches everything.
    assert_eq(resolve_all("", 0, &names, n, &out, 8), 4, "bare all → 4");

    # the max cap bounds how many are collected.
    assert_eq(resolve_all("drone", 5, &names, n, &out, 2), 2, "cap at 2");

    parser_free(pa);
    return 0;
}

# === M3-B — zone loader + world tree ===
fn test_world(): i64 {
    test_group("world");

    # Happy path: a 3-room test loop.
    assert_eq(world_load_rooms("tests/fixtures/loop.rooms.cyml"), WL_OK, "loop fixture loads");
    assert_eq(world_room_count(), 3, "3 rooms loaded");

    # Ids interned + looked up by id.
    assert_eq(room_index_by_id("tfix.a", 6), 0, "tfix.a at index 0");
    assert_eq(room_index_by_id("tfix.c", 6), 2, "tfix.c at index 2");
    assert_eq(room_index_by_id("tfix.zzz", 8), 0 - 1, "unknown id → -1");

    # `start` header field resolved (tfix.b is the start, index 1).
    assert_eq(world_start_room(), 1, "start = tfix.b (idx 1)");

    # Exits resolved to indices, both directions.
    var a = room_at(0);
    assert_eq(room_exit(a, DIR_N), 1, "A north → B(1)");
    assert_eq(room_exit(a, DIR_S), 0 - 1, "A has no south");
    var b = room_at(1);
    assert_eq(room_exit(b, DIR_S), 0, "B south → A(0)");
    assert_eq(room_exit(b, DIR_E), 2, "B east → C(2)");
    assert_eq(room_exit(room_at(2), DIR_W), 1, "C west → B(1)");

    # Title + prose captured.
    assert_eq(room_title_len(a), 6, "title 'Room A' is 6 bytes");
    assert(room_prose_len(a) > 0, "prose non-empty");

    # verb_to_dir + dir_name.
    assert_eq(verb_to_dir(VERB_NORTH), DIR_N, "VERB_NORTH → DIR_N");
    assert_eq(verb_to_dir(VERB_DOWN),  DIR_D, "VERB_DOWN → DIR_D");
    assert_eq(verb_to_dir(VERB_LOOK),  0 - 1, "non-movement verb → -1");
    assert_eq(streq(dir_name(DIR_E), "east"), 1, "dir_name(E) = east");

    # Validation failures.
    assert_eq(world_load_rooms("tests/fixtures/dangling.rooms.cyml"),  WL_ERR_DANGLE, "dangling exit rejected");
    assert_eq(world_load_rooms("tests/fixtures/wrongkind.rooms.cyml"), WL_ERR_KIND,   "non-room kind rejected");
    assert_eq(world_load_rooms("tests/fixtures/nonesuch.cyml"),        WL_ERR_IO,     "missing file → IO err");

    return 0;
}

# === M4 — combat: dice, mobs, items, corpses ===
fn test_combat(): i64 {
    test_group("combat");

    # parse_dice
    var nd[8]; var dd[8]; var dm[8];
    parse_dice(str_from("2d6+1"), &nd, &dd, &dm);
    assert_eq(load64(&nd), 2, "2d6+1 → 2 dice");
    assert_eq(load64(&dd), 6, "2d6+1 → d6");
    assert_eq(load64(&dm), 1, "2d6+1 → +1");
    parse_dice(str_from("1d4"), &nd, &dd, &dm);
    assert_eq(load64(&dd), 4, "1d4 → d4");
    assert_eq(load64(&dm), 0, "1d4 → +0");
    parse_dice(str_from("junk"), &nd, &dd, &dm);
    assert_eq(load64(&dd), 4, "malformed → 1d4 default");

    # die / roll bounds (seeded)
    combat_seed(99);
    var lo = 99; var hi = 0; var k = 0;
    while (k < 300) { var x = die(6); if (x < lo) { lo = x; } if (x > hi) { hi = x; } k = k + 1; }
    assert_eq(lo, 1, "die(6) min is 1");
    assert_eq(hi, 6, "die(6) max is 6");
    k = 0; lo = 999; hi = 0;
    while (k < 300) { var x = roll(2, 6, 1); if (x < lo) { lo = x; } if (x > hi) { hi = x; } k = k + 1; }
    assert(lo >= 3, "2d6+1 floor is 3");
    assert(hi <= 13, "2d6+1 ceiling is 13");

    # combat_try_hit produces both outcomes on a coin-flip case.
    var hits = 0; var misses = 0; k = 0;
    while (k < 300) {
        if (combat_try_hit(0, 8) == 1) { hits = hits + 1; } else { misses = misses + 1; }
        k = k + 1;
    }
    assert(hits > 0, "some attacks hit");
    assert(misses > 0, "some attacks miss");

    # Mob templates from the Hub bestiary.
    assert(world_load_mobs("data/zones/hub.mobs.cyml") >= 4, "hub mobs load");
    var rd = mob_tpl_by_id("rustdrone", 9);
    assert(rd != 0, "rustdrone template found");
    assert_eq(mt_hp(rd), 18, "rustdrone hp 18");
    assert_eq(mt_ac(rd), 7, "rustdrone ac 7");
    assert_eq(mt_ndice(rd), 1, "rustdrone 1 die");
    assert_eq(mt_dsize(rd), 6, "rustdrone d6");

    # Object templates.
    assert(world_load_objs("data/zones/hub.objs.cyml") >= 4, "hub objs load");
    assert(obj_tpl_by_id("scrip", 5) != 0, "scrip template found");

    # Spawn into a fixture room, find by keyword, remove.
    world_load_rooms("tests/fixtures/loop.rooms.cyml");
    var m = mob_spawn(rd, 0);
    assert_eq(room_mob_head(room_at(0)), m, "spawned mob on room list");
    assert(mob_in_room_by_kw(0, "rust", 4) == m, "found by keyword prefix");
    assert(mob_in_room_by_kw(0, "zzz", 3) == 0, "no keyword match → 0");
    mob_remove(m);
    assert_eq(room_mob_head(room_at(0)), 0, "removed from room list");

    # mob_condition by HP fraction (rustdrone has 18 max HP) — 0.6.1.
    var mc = mob_spawn(rd, 0);
    assert_eq(streq(mob_condition(mc), "unhurt"),          1, "full HP → unhurt");
    mi_set_hp(mc, 14); assert_eq(streq(mob_condition(mc), "lightly wounded"), 1, "77% → lightly wounded");
    mi_set_hp(mc, 9);  assert_eq(streq(mob_condition(mc), "wounded"),         1, "50% → wounded");
    mi_set_hp(mc, 5);  assert_eq(streq(mob_condition(mc), "badly wounded"),   1, "27% → badly wounded");
    mi_set_hp(mc, 2);  assert_eq(streq(mob_condition(mc), "near death"),      1, "11% → near death");
    mob_remove(mc);

    # Corpse + loot.
    var c = corpse_new("a test mob", 10);
    assert_eq(oi_is_corpse(c), 1, "corpse_new flags corpse");
    assert_eq(kw_matches("corpse", 6, oi_kw_ptr(c)), 1, "corpse matches 'corpse'");
    store64(rd + MT_LOOT, str_from("scrip cell"));
    corpse_of(mob_spawn(rd, 0), 0);
    var corpse = room_obj_head(room_at(0));
    assert(corpse != 0, "corpse left in room");
    assert_eq(oi_is_corpse(corpse), 1, "room object is a corpse");
    var cnt = 0; var o = oi_contents(corpse);
    while (o != 0) { cnt = cnt + 1; o = oi_next(o); }
    assert_eq(cnt, 2, "corpse holds 2 loot items");

    return 0;
}

# === M5 — classes, selection, abilities ===
fn test_classes(): i64 {
    test_group("classes");

    assert_eq(world_load_classes("data/classes.cyml"), 4, "4 classes load");
    var pk = cl_at(0);
    assert_eq(cl_str(pk), 16, "pikeman STR 16");
    assert_eq(cl_hp(pk),  40, "pikeman HP 40");
    assert_eq(cl_ac(pk),  5,  "pikeman AC 5");
    assert_eq(cl_id_eq(0, "pikeman"),  1, "class 0 is pikeman");
    assert_eq(cl_id_eq(1, "splicer"),  1, "class 1 is splicer");
    assert_eq(cl_id_eq(0, "splicer"),  0, "class 0 is not splicer");
    assert_eq(cl_id_eq(0 - 1, "pikeman"), 0, "no class → no match");

    # class_by_input: number, prefix, trimmed, invalid, out-of-range.
    assert_eq(class_by_input("1", 1),          0,     "'1' → pikeman");
    assert_eq(class_by_input("4", 1),          3,     "'4' → chaplain");
    assert_eq(class_by_input("spli", 4),       1,     "'spli' → splicer");
    assert_eq(class_by_input("  courier ", 10), 2,    "trimmed → courier");
    assert_eq(class_by_input("wizard", 6),     0 - 1, "unknown → -1");
    assert_eq(class_by_input("5", 1),          0 - 1, "digit out of range → -1");

    # apply_class onto a fabricated session slab.
    var s = fl_alloc(SS_SIZE);
    memset(s, 0, SS_SIZE);
    apply_class(s, 0);
    assert_eq(load64(s + SS_CLASS),     0,  "class index set");
    assert_eq(load64(s + SS_HP),        40, "hp from class");
    assert_eq(load64(s + SS_MAXHP),     40, "maxhp from class");
    assert_eq(load64(s + SS_STR),       16, "str from class");
    assert_eq(load64(s + SS_ENERGY),    20, "energy from class");

    # classes_upkeep: energy regen caps, cooldown + buff decay floor at 0.
    store64(s + SS_ENERGY, 19);
    store64(s + SS_CD0, 2);
    store64(s + SS_GUARD, 2);
    store64(s + SS_STIM, 1);
    classes_upkeep(s);
    assert_eq(load64(s + SS_ENERGY), 20, "energy regen caps at max");
    assert_eq(load64(s + SS_CD0),    1,  "cooldown -1");
    assert_eq(load64(s + SS_GUARD),  1,  "guard -1");
    assert_eq(load64(s + SS_STIM),   0,  "stim expired");
    classes_upkeep(s);
    classes_upkeep(s);
    assert_eq(load64(s + SS_CD0), 0, "cooldown floors at 0");

    # Out-of-combat recovery (0.6.1): CON-scaled HP regen, only when not
    # engaged. Pikeman CON 16 → +1 + 16/5 = +4 per tick.
    store64(s + SS_TARGET, 0);
    store64(s + SS_HP, 10);
    classes_upkeep(s);
    assert_eq(load64(s + SS_HP), 14, "out-of-combat regen +4 (CON 16)");
    store64(s + SS_TARGET, 1);
    store64(s + SS_HP, 14);
    classes_upkeep(s);
    assert_eq(load64(s + SS_HP), 14, "no regen while engaged");
    store64(s + SS_TARGET, 0);
    store64(s + SS_HP, 39);
    classes_upkeep(s);
    assert_eq(load64(s + SS_HP), 40, "regen caps at max HP");
    fl_free(s);

    # Effective-stat helpers (combat.cyr buffs).
    var s2 = fl_alloc(SS_SIZE);
    memset(s2, 0, SS_SIZE);
    store64(s2 + SS_AC, 8);
    store64(s2 + SS_HIT, 1);
    assert_eq(player_eff_ac(s2),  8, "no guard → base AC");
    assert_eq(player_eff_hit(s2), 1, "no stim → base hit");
    store64(s2 + SS_GUARD, 2);
    assert_eq(player_eff_ac(s2),  5, "guard lowers AC by 3");
    store64(s2 + SS_STIM, 2);
    assert_eq(player_eff_hit(s2),    3, "stim +2 hit");
    assert_eq(player_dmg_bonus(s2),  2, "stim +2 damage");
    fl_free(s2);

    return 0;
}

# === M1-F — idle predicate ===
fn test_idle(): i64 {
    test_group("idle");
    # Fabricate a minimal session-shaped slab: only SS_LAST_MS matters.
    var s = fl_alloc(SS_SIZE);
    memset(s, 0, SS_SIZE);
    store64(s + SS_LAST_MS, 1000);

    # A LOGGED-IN player gets the full 5 minutes. SS_AUTHED must be set — this
    # assertion used to run on a zeroed slab and so was silently testing the
    # unauthenticated path against the authenticated rule.
    store64(s + SS_AUTHED, 1);
    assert_eq(session_is_idle(s, 1000 + 299999, 300000), 0, "authed, just under 5m: live");
    assert_eq(session_is_idle(s, 1000 + 300000, 300000), 1, "authed, exactly 5m: idle");
    assert_eq(session_is_idle(s, 1000 + 600000, 300000), 1, "authed, well past: idle");

    # G2 (1.6.13) — an UNAUTHENTICATED connection gets a much shorter deadline.
    # 1.6.3 capped the session COUNT and the original finding's other half — a
    # separate pre-auth timeout — was never implemented.
    store64(s + SS_AUTHED, 0);
    assert_eq(session_is_idle(s, 1000 + PREAUTH_TIMEOUT_MS - 1, 300000), 0,
              "unauthed, just under the pre-auth deadline: live");
    assert_eq(session_is_idle(s, 1000 + PREAUTH_TIMEOUT_MS, 300000), 1,
              "unauthed, at the pre-auth deadline: reaped long before 5m");
    assert(PREAUTH_TIMEOUT_MS < 300000, "and the pre-auth deadline is genuinely shorter");

    # The shorter deadline must never LENGTHEN anyone's grace: if the operator
    # sets an idle timeout below it, the smaller of the two still wins.
    store64(s + SS_AUTHED, 0);
    assert_eq(session_is_idle(s, 1000 + 5000, 4000), 1,
              "a tighter operator timeout still applies to unauthed sessions");
    fl_free(s);
    return 0;
}

# === M6 — persistence: identity, save/load round-trip, auth, tamper ===
fn test_persist(): i64 {
    test_group("persist");
    persist_init();

    # Identity derivation is deterministic and passphrase-sensitive.
    var sk1 = alloc(SK_LEN); var pk1 = alloc(PK_LEN);
    var sk2 = alloc(SK_LEN); var pk2 = alloc(PK_LEN);
    var salt = alloc(SALT_LEN); memset(salt, 0xAB, SALT_LEN);
    ident_derive(salt, "hunter2", 7, sk1, pk1);
    ident_derive(salt, "hunter2", 7, sk2, pk2);
    assert_eq(_bytes_eq(pk1, pk2, PK_LEN), 1, "same salt+pass → same pubkey");
    ident_derive(salt, "wrongpw", 7, sk2, pk2);
    assert_eq(_bytes_eq(pk1, pk2, PK_LEN), 0, "different pass → different pubkey");

    # Build a session with an identity + non-default stats, then save.
    var s = fl_alloc(SS_SIZE); memset(s, 0, SS_SIZE);
    var nmb = fl_alloc(NAME_CAP); store64(s + SS_NAME_BUF, nmb);
    memcpy(nmb, "TestPlayer", 10); store64(s + SS_NAME_LEN, 10);
    var blk = sess_ident(s);
    memcpy(blk, salt, SALT_LEN);
    ident_derive(salt, "hunter2", 7, blk + IDENT_SK, blk + IDENT_PK);
    store64(blk + IDENT_CREATED, 1234567);
    store64(s + SS_ROOM, 0 - 1);
    store64(s + SS_CLASS, 2);
    store64(s + SS_HP, 27); store64(s + SS_MAXHP, 33); store64(s + SS_AC, 5);
    store64(s + SS_HIT, 3); store64(s + SS_NDICE, 2); store64(s + SS_DSIZE, 6); store64(s + SS_DMOD, 1);
    store64(s + SS_STR, 14); store64(s + SS_DEX, 12); store64(s + SS_CON, 13); store64(s + SS_TEC, 11);
    store64(s + SS_ENERGY, 18); store64(s + SS_MAXENERGY, 20);
    store64(s + SS_INV, 0);
    store64(s + SS_AUTHED, 1);
    assert_eq(player_save(s), 1, "save returns ok");
    assert_eq(player_exists("TestPlayer", 10), 1, "record exists after save");
    assert_eq(player_exists("Nobody", 6), 0, "absent for unknown name");

    # Fresh session + correct passphrase restores every field.
    var s2 = fl_alloc(SS_SIZE); memset(s2, 0, SS_SIZE);
    var nmb2 = fl_alloc(NAME_CAP); store64(s2 + SS_NAME_BUF, nmb2);
    memcpy(nmb2, "TestPlayer", 10); store64(s2 + SS_NAME_LEN, 10);
    assert_eq(player_auth_load(s2, "hunter2", 7), 1, "right pass → loaded");
    assert_eq(load64(s2 + SS_HP), 27, "hp restored");
    assert_eq(load64(s2 + SS_MAXHP), 33, "maxhp restored");
    assert_eq(load64(s2 + SS_AC), 5, "ac restored");
    assert_eq(load64(s2 + SS_CLASS), 2, "class restored");
    assert_eq(load64(s2 + SS_STR), 14, "str restored");
    assert_eq(load64(s2 + SS_TEC), 11, "tec restored");
    assert_eq(load64(s2 + SS_ENERGY), 18, "energy restored");
    assert_eq(load64(s2 + SS_AUTHED), 1, "authed after load");

    # Wrong passphrase is rejected (pubkey mismatch).
    var s3 = fl_alloc(SS_SIZE); memset(s3, 0, SS_SIZE);
    var nmb3 = fl_alloc(NAME_CAP); store64(s3 + SS_NAME_BUF, nmb3);
    memcpy(nmb3, "TestPlayer", 10); store64(s3 + SS_NAME_LEN, 10);
    assert_eq(player_auth_load(s3, "guessguess", 10), 0, "wrong pass → rejected");

    # Tamper: flip a bit in the signed region → the Ed25519 record signature
    # rejects it (returns -2 even with the right passphrase).
    _path_for("TestPlayer", 10, g_persist_path);
    var tn = file_read_all(g_persist_path, g_persist_slurp, SLURP_CAP - 1);
    store8(g_persist_slurp + 20, load8(g_persist_slurp + 20) ^ 0x01);
    _write_record_raw("TestPlayer", 10, g_persist_slurp, tn);
    var s4 = fl_alloc(SS_SIZE); memset(s4, 0, SS_SIZE);
    var nmb4 = fl_alloc(NAME_CAP); store64(s4 + SS_NAME_BUF, nmb4);
    memcpy(nmb4, "TestPlayer", 10); store64(s4 + SS_NAME_LEN, 10);
    assert_eq(player_auth_load(s4, "hunter2", 7), 0 - 2, "tampered record → rejected");

    return 0;
}

# === M7 — zone resets: mob top-up + object no-double-up ===
fn _count_all_mobs(): i64 {
    var total = 0;
    var ri = 0;
    while (ri < world_room_count()) {
        var m = room_mob_head(room_at(ri));
        while (m != 0) { total = total + 1; m = mi_next(m); }
        ri = ri + 1;
    }
    return total;
}

fn test_reset(): i64 {
    test_group("reset");

    # Load the real Hub (rooms + mob/obj templates) and spawn it.
    assert_eq(world_load_rooms("data/zones/hub.rooms.cyml"), WL_OK, "hub rooms load");
    assert(world_load_objs("data/zones/hub.objs.cyml") >= 0, "hub obj templates load");
    assert(world_load_mobs("data/zones/hub.mobs.cyml") >= 0, "hub mob templates load");
    assert(g_zone_reset_secs > 0, "reset_secs read from zone header");

    var n0 = world_spawn_all();
    assert(n0 > 0, "boot spawns mobs");
    assert_eq(_count_all_mobs(), n0, "all spawned mobs alive");

    # Reset with a full zone is a no-op (no deficit, no duplicates).
    assert_eq(zone_reset_mobs(), 0, "full zone → reset spawns nothing");
    assert_eq(_count_all_mobs(), n0, "mob count unchanged");

    # Clear the whole zone, then reset → full authored repopulation.
    var ri = 0;
    while (ri < world_room_count()) {
        var m = room_mob_head(room_at(ri));
        while (m != 0) { var nx = mi_next(m); mob_remove(m); m = nx; }
        ri = ri + 1;
    }
    assert_eq(_count_all_mobs(), 0, "zone cleared");
    assert_eq(zone_reset_mobs(), n0, "reset respawns the full authored population");
    assert_eq(_count_all_mobs(), n0, "zone repopulated to authored count");

    # Partial: remove one mob, reset tops up exactly one (multiset-correct,
    # so a 'scavver scavver' room refills only the missing one).
    var first = 0;
    ri = 0;
    while (ri < world_room_count()) {
        var h = room_mob_head(room_at(ri));
        if (h != 0) { first = h; ri = world_room_count(); }
        else { ri = ri + 1; }
    }
    mob_remove(first);
    assert_eq(_count_all_mobs(), n0 - 1, "one mob removed");
    assert_eq(zone_reset_mobs(), 1, "reset spawns exactly the missing one");
    assert_eq(_count_all_mobs(), n0, "back to full population");

    # M7-D object respawn: synthesize an objspawn on room 0 and reapply.
    store64(room_at(0) + RM_OBJSPAWN, str_from("scrip"));
    assert_eq(zone_reset_room_objs(0), 1, "objspawn places the authored object");
    assert_eq(zone_reset_room_objs(0), 0, "no double-up — object already present");

    return 0;
}

# === 0.8.1 — login/identity polish: relative-time + passwd re-key ===
fn _tx_reset(s): i64 { store64(s + SS_TX_LEN, 0); return 0; }
fn _tx_is(s, cstr): i64 {
    var len = load64(s + SS_TX_LEN);
    var buf = load64(s + SS_TX_BUF);
    if (len != strlen(cstr)) { return 0; }
    var i = 0;
    while (i < len) {
        if ((load8(buf + i) & 0xFF) != (load8(cstr + i) & 0xFF)) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn _mk_sess(name, nl): i64 {
    var s = fl_alloc(SS_SIZE); memset(s, 0, SS_SIZE);
    store64(s + SS_TX_BUF, fl_alloc(TX_CAP));
    var nm = fl_alloc(NAME_CAP); memcpy(nm, name, nl);
    store64(s + SS_NAME_BUF, nm); store64(s + SS_NAME_LEN, nl);
    return s;
}

fn test_login_polish(): i64 {
    test_group("login-polish");
    persist_init();

    var s = _mk_sess("RekeyHero", 9);

    # Relative-time greeting formatter.
    _tx_reset(s); session_append_ago(s, 30);     assert_eq(_tx_is(s, "moments ago"), 1, "30s → moments ago");
    _tx_reset(s); session_append_ago(s, 90);     assert_eq(_tx_is(s, "1 minute ago"), 1, "90s → 1 minute ago");
    _tx_reset(s); session_append_ago(s, 300);    assert_eq(_tx_is(s, "5 minutes ago"), 1, "300s → 5 minutes ago");
    _tx_reset(s); session_append_ago(s, 7200);   assert_eq(_tx_is(s, "2 hours ago"), 1, "7200s → 2 hours ago");
    _tx_reset(s); session_append_ago(s, 172800); assert_eq(_tx_is(s, "2 days ago"), 1, "2d → 2 days ago");

    # passwd re-key: build an identity from "oldpass", save, then change it.
    var blk = sess_ident(s);
    random_bytes(blk, SALT_LEN);
    ident_derive(blk, "oldpass", 7, blk + IDENT_SK, blk + IDENT_PK);
    store64(blk + IDENT_CREATED, 100);
    store64(s + SS_ROOM, 0 - 1); store64(s + SS_AUTHED, 1);
    store64(s + SS_HP, 20); store64(s + SS_MAXHP, 20); store64(s + SS_CLASS, 0);
    assert_eq(player_save(s), 1, "initial save");

    chpass_on_new(s, "newpass", 7);
    assert_eq(load64(s + SS_PHASE), PHASE_CHPASS_CONFIRM, "passwd: new → confirm phase");
    chpass_on_confirm(s, "newpass", 7);
    assert_eq(load64(s + SS_PHASE), PHASE_CMD, "passwd: confirm → command phase");

    # The new passphrase authenticates; the old one no longer does.
    var s2 = _mk_sess("RekeyHero", 9);
    assert_eq(player_auth_load(s2, "newpass", 7), 1, "new passphrase authenticates");
    var s3 = _mk_sess("RekeyHero", 9);
    assert_eq(player_auth_load(s3, "oldpass", 7), 0, "old passphrase rejected after re-key");

    # A mismatch leaves us at the new-pass prompt and commits nothing.
    chpass_on_new(s, "aaaa", 4);
    chpass_on_confirm(s, "bbbb", 4);
    assert_eq(load64(s + SS_PHASE), PHASE_CHPASS_NEW, "passwd mismatch → re-prompt, no commit");
    var s4 = _mk_sess("RekeyHero", 9);
    assert_eq(player_auth_load(s4, "newpass", 7), 1, "still the newpass after a failed change");

    return 0;
}

# === 0.9.0 — security sweep regressions ===
fn _str_into(buf, off, cstr): i64 {
    var i = 0;
    while ((load8(cstr + i) & 0xFF) != 0) { store8(buf + off + i, load8(cstr + i)); i = i + 1; }
    return off + i;
}

# N bytes of 'a', for over-length passphrase probes.
fn _rep_a(n): i64 {
    var b = alloc(n + 1);
    var i = 0;
    while (i < n) { store8(b + i, 97); i = i + 1; }
    store8(b + n, 0);
    return b;
}

fn test_security(): i64 {
    test_group("security");
    persist_init();

    # Build a real signed record, but with out-of-range class + ndice (a
    # player owns their key, so they can sign any field values).
    var s = _mk_sess("SecHero", 7);
    var blk = sess_ident(s);
    random_bytes(blk, SALT_LEN);
    ident_derive(blk, "rightpass", 9, blk + IDENT_SK, blk + IDENT_PK);
    store64(blk + IDENT_CREATED, 1);
    store64(s + SS_ROOM, 0 - 1); store64(s + SS_AUTHED, 1);
    store64(s + SS_HP, 20); store64(s + SS_MAXHP, 20);
    store64(s + SS_CLASS, 99999999);     # would index g_classes + cls*CL_SIZE → OOB read
    store64(s + SS_NDICE, 2000000000);   # would spin the roll() loop → DoS
    assert_eq(player_save(s), 1, "save with extreme fields");

    # On load, the signature verifies (we own the key) but fields are clamped.
    var s2 = _mk_sess("SecHero", 7);
    assert_eq(player_auth_load(s2, "rightpass", 9), 1, "loads with right pass");
    assert_eq(load64(s2 + SS_CLASS), 0 - 1, "out-of-range class → classless (no OOB read)");
    assert(load64(s2 + SS_NDICE) <= 100, "huge ndice clamped (no DoS loop)");

    # Over-long passphrase is rejected as wrong — must not overflow ident_derive.
    var bigpass = alloc(5000);
    memset(bigpass, 65, 5000);   # 5000 'A's, far past PASS_MAX
    var s3 = _mk_sess("SecHero", 7);
    assert_eq(player_auth_load(s3, bigpass, 5000), 0, "over-long passphrase rejected, no crash");

    # Over-long hex field in a planted record is rejected BEFORE decode — the
    # critical pre-verify heap overflow. Forge a record with a 5000-char salt.
    var fbuf = alloc(8000);
    var o = _str_into(fbuf, 0, "[player]\nsalt = \"");
    var k = 0;
    while (k < 5000) { store8(fbuf + o, 97); o = o + 1; k = k + 1; }   # 'a' x5000
    o = _str_into(fbuf, o, "\"\npubkey = \"");
    k = 0; while (k < 64) { store8(fbuf + o, 48); o = o + 1; k = k + 1; }
    o = _str_into(fbuf, o, "\"\nsig = \"");
    k = 0; while (k < 128) { store8(fbuf + o, 48); o = o + 1; k = k + 1; }
    o = _str_into(fbuf, o, "\"\n");
    _write_record_raw("Forged", 6, fbuf, o);
    var s4 = _mk_sess("Forged", 6);
    # H5 (1.6.2) moved the passlen bounds ABOVE the record read, so this must use
    # an in-range passphrase to still reach the salt-length check — "x" (len 1)
    # is below PASS_MIN and would now short-circuit before the record is touched,
    # silently retiring the 0.9.0 overflow coverage this assertion exists for.
    assert_eq(player_auth_load(s4, "xxxx", 4), 0 - 2, "over-long salt hex rejected before decode (no overflow)");
    # And the new short-circuit itself: an out-of-range passphrase is a plain
    # wrong-passphrase reject, and costs nothing — no record read, no verify.
    assert_eq(player_auth_load(_mk_sess("Forged", 6), "x", 1), 0,
              "an under-length passphrase is rejected before the record is read");
    assert_eq(player_auth_load(_mk_sess("Forged", 6), _rep_a(200), 200), 0,
              "an over-length passphrase is rejected before the record is read");

    # _clamp sanity.
    assert_eq(_clamp(5, 1, 10), 5, "clamp in-range");
    assert_eq(_clamp(0 - 9, 1, 10), 1, "clamp below");
    assert_eq(_clamp(99, 1, 10), 10, "clamp above");

    return 0;
}

# === 0.9.1 — surface freeze: save schema stamp + admin gate ===
fn _contains(buf, n, needle): i64 {
    var nl = strlen(needle);
    var i = 0;
    while (i + nl <= n) {
        var j = 0;
        var same = 1;
        while (j < nl) {
            if ((load8(buf + i + j) & 0xFF) != (load8(needle + j) & 0xFF)) { same = 0; j = nl; }
            else { j = j + 1; }
        }
        if (same == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Build a bare session with a tx buffer, for driving the emit path directly.
fn _tx_sess(): i64 {
    var s = fl_alloc(SS_SIZE);
    memset(s, 0, SS_SIZE);
    store64(s + SS_TX_BUF, fl_alloc(TX_CAP));
    store64(s + SS_TX_LEN, 0);
    return s;
}

# Count lone (unpaired) 0xFF bytes in a buffer — the defect M10 exists to
# prevent. A doubled IAC consumes both bytes and is not lone; an odd-length run
# leaves exactly one.
fn _lone_iac_count(buf, n): i64 {
    var i = 0;
    var lone = 0;
    while (i < n) {
        if ((load8(buf + i) & 0xFF) == 255) {
            if (i + 1 < n) {
                if ((load8(buf + i + 1) & 0xFF) == 255) { i = i + 2; continue; }
            }
            lone = lone + 1;
        }
        i = i + 1;
    }
    return lone;
}

# === M10 — wire hygiene: player-authored bytes never break the Telnet stream ===
fn test_wire_hygiene(): i64 {
    test_group("wire-hygiene");

    # --- The core defect. telnet_feed decodes `IAC IAC` to a literal 0xFF data
    # byte (asserted by telnet T2), session_push_line_byte keeps it (it drops
    # only b < 32), and before M10 cmd_say handed it straight to every listener.
    # RFC 854 requires re-sending it as `IAC IAC`.
    var s = _tx_sess();
    var one[1];
    store8(&one, 255);
    session_appendtx_prose(s, &one, 1);
    var tx = load64(s + SS_TX_BUF);
    assert_eq(load64(s + SS_TX_LEN), 2, "a lone IAC is escaped to two bytes");
    assert_eq(load8(tx) & 0xFF, 255, "escaped[0] = IAC");
    assert_eq(load8(tx + 1) & 0xFF, 255, "escaped[1] = IAC");
    assert_eq(_lone_iac_count(tx, 2), 0, "no lone IAC survives");

    # Plain text is untouched.
    var s2 = _tx_sess();
    session_appendtx_prose(s2, "hello", 5);
    assert_eq(load64(s2 + SS_TX_LEN), 5, "plain text passes through unchanged");

    # --- C0 and DEL are dropped. ESC matters most: without it, player text could
    # forge the SGR runs ansi_title()/ansi_actor() emit and repaint another
    # player's screen. ESC cannot reach here through `say` today (the input
    # filter drops < 32), but M21's persisted title is a hand-editable,
    # validly-re-signed field, so the sanitizer must own the rule.
    var s3 = _tx_sess();
    var esc[4];
    store8(&esc + 0, 65); store8(&esc + 1, 27); store8(&esc + 2, 127); store8(&esc + 3, 66);
    session_appendtx_prose(s3, &esc, 4);
    assert_eq(load64(s3 + SS_TX_LEN), 2, "ESC and DEL are dropped");
    assert_eq(load8(load64(s3 + SS_TX_BUF)) & 0xFF, 65, "surrounding text survives");

    # --- C1 (0x80-0x9F) is deliberately KEPT. As raw bytes those are UTF-8
    # continuation bytes and the tokenizer passes UTF-8 through; dropping them
    # would corrupt every non-ASCII name to fix nothing a Telnet client cares about.
    var s4 = _tx_sess();
    var utf[2];
    store8(&utf + 0, 0xC3); store8(&utf + 1, 0xA9);   # "é"
    session_appendtx_prose(s4, &utf, 2);
    assert_eq(load64(s4 + SS_TX_LEN), 2, "UTF-8 continuation bytes are preserved");

    # --- The boundary case, which is the subtle half of M10-A. LINE_CAP and
    # TX_CAP are both 4096, so a full line of 0xFF escapes to 8192. A truncation
    # landing BETWEEN the two bytes of a pair would emit the very lone IAC this
    # function prevents. Fill the queue to an odd gap and require the pair to be
    # dropped whole rather than split.
    var s5 = _tx_sess();
    store64(s5 + SS_TX_LEN, TX_CAP - 1);        # exactly one byte of room
    var before = load64(s5 + SS_TX_LEN);
    session_appendtx_prose(s5, &one, 1);        # one IAC needs two bytes
    assert_eq(load64(s5 + SS_TX_LEN), before, "an escape pair is never split at the cap");

    # And a full buffer of IACs truncates cleanly, with no lone IAC anywhere.
    var s6 = _tx_sess();
    var many = alloc(LINE_CAP);
    var i = 0;
    while (i < LINE_CAP) { store8(many + i, 255); i = i + 1; }
    session_appendtx_prose(s6, many, LINE_CAP);
    var n6 = load64(s6 + SS_TX_LEN);
    assert(n6 <= TX_CAP, "prose append respects TX_CAP");
    assert_eq(_lone_iac_count(load64(s6 + SS_TX_BUF), n6), 0,
              "a full line of IAC truncates without splitting a pair");

    # --- Fuzz: every byte value at every position in a short window. No lone
    # IAC may survive, nothing below 32 may appear, and the write must stay in
    # bounds. This is the invariant, swept rather than spot-checked.
    var bad_lone = 0;
    var bad_ctrl = 0;
    var bad_len  = 0;
    var b = 0;
    while (b < 256) {
        var sf = _tx_sess();
        var probe[3];
        store8(&probe + 0, 88);        # 'X'
        store8(&probe + 1, b);
        store8(&probe + 2, 89);        # 'Y'
        session_appendtx_prose(sf, &probe, 3);
        var nf = load64(sf + SS_TX_LEN);
        var bf = load64(sf + SS_TX_BUF);
        if (nf > 4) { bad_len = bad_len + 1; }
        if (_lone_iac_count(bf, nf) != 0) { bad_lone = bad_lone + 1; }
        var j = 0;
        while (j < nf) {
            var o = load8(bf + j) & 0xFF;
            if (o < 32) { bad_ctrl = bad_ctrl + 1; }
            if (o == 127) { bad_ctrl = bad_ctrl + 1; }
            j = j + 1;
        }
        b = b + 1;
    }
    assert_eq(bad_lone, 0, "fuzz: no byte value produces a lone IAC");
    assert_eq(bad_ctrl, 0, "fuzz: no control byte reaches the wire");
    assert_eq(bad_len, 0, "fuzz: output never exceeds 2x input");

    return 0;
}

# === M12 — instance lifecycle: nothing the world creates may leak ===
fn test_lifecycle(): i64 {
    test_group("lifecycle");

    # The world must be loaded for room lists to exist.
    if (g_room_count == 0) {
        assert(0, "lifecycle: no world loaded (fixture ordering)");
        return 0;
    }

    # --- Mobs are reclaimed on death. Before M12 mob_remove only unlinked, and
    # the instance came from alloc(), which has no free() at all — so every kill
    # leaked for the process lifetime.
    var tpl = mt_at(0);
    var mobs0 = g_mob_live;
    var m = mob_spawn(tpl, 0);
    assert_eq(g_mob_live, mobs0 + 1, "spawning a mob raises the live count");
    mob_remove(m);
    assert_eq(g_mob_live, mobs0, "removing a mob returns it to the freelist");

    # --- A corpse owns its loot: freeing it must take the contents too, or the
    # contents become unreachable AND unfreed — the same leak wearing a hat.
    var objs0 = g_obj_live;
    var corpse = corpse_new("test-thing", 10);
    ilist_push(corpse + OI_CONTENTS, item_new(ot_at(0)));
    ilist_push(corpse + OI_CONTENTS, item_new(ot_at(0)));
    assert_eq(g_obj_live, objs0 + 3, "corpse plus two items = three live objects");
    obj_free(corpse);
    assert_eq(g_obj_live, objs0, "freeing a corpse frees its contents too");

    # --- get/drop must NOT free. ilist_remove is the MOVE primitive (cmd_get is
    # remove-then-push); freeing there would destroy every `get`. This is the
    # regression that guards the rule.
    var objs1 = g_obj_live;
    var it = item_new(ot_at(0));
    var slot_a = room_at(0) + RM_OBJ_HEAD;
    ilist_push(slot_a, it);
    ilist_remove(slot_a, it);
    assert_eq(g_obj_live, objs1 + 1, "ilist_remove is a move, not a free");
    obj_free(it);
    assert_eq(g_obj_live, objs1, "explicit free reclaims it");

    # --- M12-C: every session pointing at a dying mob must let go, not just the
    # killer. Two attackers, one kill. Before M12-C the second kept a pointer to
    # a freed instance — and fl_free returns the block to a size class the next
    # mob_spawn re-issues, so it would resolve to a live, DIFFERENT mob.
    var m2 = mob_spawn(tpl, 0);
    var a = _mk_sess("AttackerA", 9);
    var b = _mk_sess("AttackerB", 9);
    store64(a + SS_ROOM, 0); store64(b + SS_ROOM, 0);
    store64(a + SS_PHASE, PHASE_CMD); store64(b + SS_PHASE, PHASE_CMD);
    store64(a + SS_TARGET, m2); store64(b + SS_TARGET, m2);
    # Put both on the active list sessions_forget_mob walks.
    store64(a + SS_NEXT, b); store64(b + SS_NEXT, 0);
    var saved_head = g_session_head;
    g_session_head = a;
    sessions_forget_mob(m2);
    assert_eq(load64(a + SS_TARGET), 0, "first attacker's target cleared");
    assert_eq(load64(b + SS_TARGET), 0, "SECOND attacker's target cleared too");
    g_session_head = saved_head;
    mob_remove(m2);

    # --- Corpse decay ages out and reclaims. CORPSE_TICKS ticks of sweeping
    # must leave the count where it started.
    var mobs1 = g_mob_live;
    var objs2 = g_obj_live;
    var c2 = corpse_new("decay-me", 8);
    ilist_push(room_at(0) + RM_OBJ_HEAD, c2);
    assert_eq(g_obj_live, objs2 + 1, "corpse placed in the room");
    var t = 0;
    while (t < CORPSE_TICKS - 1) { corpse_decay_sweep(); t = t + 1; }
    assert_eq(g_obj_live, objs2 + 1, "corpse survives until its age is reached");
    corpse_decay_sweep();
    assert_eq(g_obj_live, objs2, "corpse is reclaimed once it ages out");

    # --- The soak. Spawn, kill, decay, repeat — the counts must return to a
    # bounded steady state rather than climbing. This is the M12 gate.
    var mobs_base = g_mob_live;
    var objs_base = g_obj_live;
    var round = 0;
    while (round < 25) {
        var mm = mob_spawn(tpl, 0);
        mi_set_hp(mm, 0);
        corpse_of(mm, 0);          # the death path: corpse + loot
        sessions_forget_mob(mm);
        mob_remove(mm);
        var k = 0;
        while (k < CORPSE_TICKS) { corpse_decay_sweep(); k = k + 1; }
        round = round + 1;
    }
    assert_eq(g_mob_live, mobs_base, "soak: mob count returns to baseline");
    assert_eq(g_obj_live, objs_base, "soak: object count returns to baseline");

    return 0;
}

# Count mobs currently standing in room `ri`.
fn _mobs_in(ri): i64 {
    var m = room_mob_head(room_at(ri));
    var n = 0;
    while (m != 0) { n = n + 1; m = mi_next(m); }
    return n;
}

# Is `m` on room `ri`'s occupant list?
fn _mob_on_list(ri, m): i64 {
    var o = room_mob_head(room_at(ri));
    while (o != 0) { if (o == m) { return 1; } o = mi_next(o); }
    return 0;
}

# === M13 — the actor tick ===
fn test_actor_tick(): i64 {
    test_group("actor-tick");

    if (g_room_count < 2) {
        assert(0, "actor-tick: need a multi-room world (fixture ordering)");
        return 0;
    }
    var tpl = mt_at(0);

    # --- MI_HOME is the authored room and survives a move. The zone reset counts
    # by it, so if a wander overwrote it every reset would spawn a replacement
    # for the mob that walked away — population climbing by one, forever.
    var m = mob_spawn(tpl, 0);
    assert_eq(load64(m + MI_HOME), 0, "spawn records its home room");
    var dest = 0 - 1;
    var d = 0;
    while (d < NDIR) {
        if (room_exit(room_at(0), d) >= 0) { dest = room_exit(room_at(0), d); d = NDIR; }
        else { d = d + 1; }
    }
    assert(dest >= 0, "start room has an exit to move through");
    mob_move_to(m, dest, 0);
    assert_eq(mi_room(m), dest, "the mob is now in the destination room");
    assert_eq(load64(m + MI_HOME), 0, "MI_HOME is unchanged by a move");
    assert_eq(_mob_on_list(0, m), 0, "it left the origin room's list");
    assert_eq(_mob_on_list(dest, m), 1, "it joined the destination room's list");

    # --- The reset must NOT duplicate a wandered mob. This is the interaction
    # that makes MI_HOME load-bearing: count by home, not by who is standing here.
    assert_eq(_mob_alive_count(0, tpl), 1, "a wandered mob still counts against its home");
    mob_remove(m);

    # --- mob_unlink must not free. It is the move primitive; mob_remove is the
    # retire primitive. Conflating them would double-free every wander.
    var live0 = g_mob_live;
    var m2 = mob_spawn(tpl, 0);
    mob_unlink(m2);
    assert_eq(g_mob_live, live0 + 1, "mob_unlink is a move, not a free");
    assert_eq(mi_next(m2), 0, "unlink clears the stale forward link");
    _mob_free(m2);
    assert_eq(g_mob_live, live0, "explicit free reclaims it");

    # --- The re-entry guard. A mob that wanders FORWARD into a room the sweep
    # has not visited yet would take a second turn in the same tick without
    # MI_ACTED. Drive two sweeps at the same tick number and require the second
    # to be a no-op for an already-stamped mob.
    var m3 = mob_spawn(tpl, 0);
    var turns = mob_tick_all(4242);
    assert(turns > 0, "a fresh tick gives every mob a turn");
    assert_eq(mob_tick_all(4242), 0, "sweeping the SAME tick again gives nobody a turn");
    assert_eq(mob_tick_all(4243), turns, "the next tick gives them all a turn again");
    mob_remove(m3);

    # --- Stunned and dead mobs forfeit their turn.
    var m4 = mob_spawn(tpl, 0);
    mi_set_stun(m4, 3);
    assert_eq(_mob_can_act(m4), 0, "a stunned mob cannot act");
    mi_set_stun(m4, 0);
    mi_set_hp(m4, 0);
    assert_eq(_mob_can_act(m4), 0, "a dead mob cannot act");
    mi_set_hp(m4, mt_hp(tpl));
    assert_eq(_mob_can_act(m4), 1, "an intact idle mob can act");
    mob_remove(m4);

    # --- Flee: below MORALE_FLEE_PCT a mob drops its target and moves. Above it,
    # it holds. Driven directly so the test does not depend on the 1-in-N roll.
    var sess = _mk_sess("FleeBait", 8);
    store64(sess + SS_ROOM, 0);
    store64(sess + SS_PHASE, PHASE_CMD);
    var m5 = mob_spawn(tpl, 0);
    mi_set_target(m5, sess);
    mi_set_hp(m5, mt_hp(tpl));                       # full health
    assert_eq(_mob_flee(m5), 0, "a healthy mob holds its ground");
    assert_eq(mi_target(m5), sess, "and keeps its target");
    mi_set_hp(m5, 1);                                # 1 hp of a much larger pool
    assert_eq(_mob_flee(m5), 1, "a badly hurt mob breaks off");
    assert_eq(mi_target(m5), 0, "fleeing drops its target");
    assert(mi_room(m5) != 0, "fleeing moves it out of the room");
    mob_remove(m5);

    # --- A cornered mob fights on. Find a room with no exits, or skip honestly.
    var walled = 0 - 1;
    var ri = 0;
    while (ri < g_room_count) {
        var any = 0;
        var dd = 0;
        while (dd < NDIR) { if (room_exit(room_at(ri), dd) >= 0) { any = 1; } dd = dd + 1; }
        if (any == 0) { walled = ri; ri = g_room_count; } else { ri = ri + 1; }
    }
    if (walled >= 0) {
        var m6 = mob_spawn(tpl, walled);
        mi_set_target(m6, sess);
        mi_set_hp(m6, 1);
        assert_eq(_mob_flee(m6), 0, "a cornered mob cannot flee and fights on");
        assert_eq(mi_target(m6), sess, "and keeps its target");
        mob_remove(m6);
    }

    # --- Assist: an idle mob joins a room-mate's fight against a player who is
    # actually present. A target who has left is stale and must not be joined.
    var engaged = mob_spawn(tpl, 0);
    var idle = mob_spawn(tpl, 0);
    mi_set_target(engaged, sess);
    store64(sess + SS_ROOM, 0);
    var joined = 0;
    var attempt = 0;
    while (attempt < 200) {                 # ASSIST_CHANCE is 1-in-N; drive it
        if (mi_target(idle) == 0) { _mob_assist(idle); } else { joined = 1; attempt = 200; }
        attempt = attempt + 1;
    }
    assert_eq(joined, 1, "an idle mob eventually joins a room-mate's fight");
    assert_eq(mi_target(idle), sess, "and targets the player being fought");

    # The player walks out: a fresh idle mob must not assist against an absent target.
    store64(sess + SS_ROOM, dest);
    var idle2 = mob_spawn(tpl, 0);
    var tries = 0;
    while (tries < 200) { _mob_assist(idle2); tries = tries + 1; }
    assert_eq(mi_target(idle2), 0, "no assist against a target who has left the room");

    mob_remove(engaged); mob_remove(idle); mob_remove(idle2);

    # --- The leash. Unbounded wander is a content bug: the first live run of
    # M13 had the Foundry Sentinel walk from `foundry.overseer` the length of the
    # zone into `hub.gate`, the newbie start room. A roaming population diffuses
    # evenly across the map and erases the authored difficulty curve.
    #
    # Soak the real spawn set for many ticks and require every mob to stay
    # within one room of where it was authored.
    var spawned = zone_reset_mobs();
    var tick = 9000;
    var sweeps = 0;
    while (sweeps < 400) { mob_tick_all(tick + sweeps); sweeps = sweeps + 1; }
    var strayed = 0;
    var checked = 0;
    var rr = 0;
    while (rr < g_room_count) {
        var mm = room_mob_head(room_at(rr));
        while (mm != 0) {
            checked = checked + 1;
            if (_room_adjacent(load64(mm + MI_HOME), mi_room(mm)) == 0) { strayed = strayed + 1; }
            mm = mi_next(mm);
        }
        rr = rr + 1;
    }
    assert(checked > 0, "the soak actually had mobs to move");
    assert_eq(strayed, 0, "after 400 ticks every mob is still within one room of home");

    # And the leash must not have frozen them solid — some movement did happen.
    var moved = 0;
    rr = 0;
    while (rr < g_room_count) {
        var m7 = room_mob_head(room_at(rr));
        while (m7 != 0) {
            if (mi_room(m7) != load64(m7 + MI_HOME)) { moved = moved + 1; }
            m7 = mi_next(m7);
        }
        rr = rr + 1;
    }
    assert(moved > 0, "the leash still permits movement (mobs are not frozen)");

    return 0;
}

# === M14 — 1.6.0 hardening: disconnect-path lifetime + relational save validation ===
fn test_hardening(): i64 {
    test_group("hardening");
    persist_init();
    if (g_room_count == 0) { assert(0, "hardening: no world loaded"); return 0; }

    # --- H1: a mob must not keep a pointer to a disconnected session.
    #
    # Before 1.5.0 this was inert — MI_TARGET was only ever COMPARED. M13's
    # _mob_assist dereferences it (`load64(s + SS_ROOM)`), so the actor tick
    # turned a dormant dangling pointer into a live use-after-free. fl_free
    # returns the block to the size class the next session_new draws from, so the
    # read can land on a live, DIFFERENT player.
    var tpl = mt_at(0);
    var m = mob_spawn(tpl, 0);
    var s = _mk_sess("Quitter", 7);
    store64(s + SS_ROOM, 0);
    mi_set_target(m, s);
    assert_eq(mi_target(m), s, "the mob is holding the session");
    mobs_forget_session(s);
    assert_eq(mi_target(m), 0, "disconnect clears the mob's target pointer");

    # A second mob in another room must be cleared too — the sweep is world-wide,
    # not room-local, because a player can engage and then walk away.
    var m2 = mob_spawn(tpl, 0);
    mob_move_to(m2, room_exit(room_at(0), 0), 0);
    mi_set_target(m2, s);
    mobs_forget_session(s);
    assert_eq(mi_target(m2), 0, "a mob in another room is cleared as well");
    mob_remove(m); mob_remove(m2);

    # --- H2: a disconnecting player's inventory must be reclaimed.
    # session_free frees rx/tx/line/name/ident and never touched SS_INV, so every
    # carried object leaked on `quit`. Remotely driven: connect, get, quit, repeat.
    var objs0 = g_obj_live;
    var s2 = _mk_sess("Hoarder", 7);
    var k = 0;
    while (k < 5) { ilist_push(s2 + SS_INV, item_new(ot_at(0))); k = k + 1; }
    assert_eq(g_obj_live, objs0 + 5, "five carried objects are live");
    session_drop_inv(s2);
    assert_eq(g_obj_live, objs0, "disconnect reclaims the carried inventory");
    assert_eq(load64(s2 + SS_INV), 0, "the inventory head is cleared");

    # Idempotent — drop_session must be safe if the path is ever reached twice.
    session_drop_inv(s2);
    assert_eq(g_obj_live, objs0, "dropping an already-empty inventory is a no-op");

    # --- H3: hp must be clamped against maxhp, not just to an absolute range.
    # A player owns their signing key, so a re-signed record can carry any
    # values; nothing downstream ever pulls an over-max hp back down.
    var s3 = _mk_sess("Inflated", 8);
    var blk = sess_ident(s3);
    random_bytes(blk, SALT_LEN);
    ident_derive(blk, "inflate99", 9, blk + IDENT_SK, blk + IDENT_PK);
    store64(blk + IDENT_CREATED, 1);
    _plant_record(blk, "schema = 1\nname = \"FreezeHero\"\nroom = \"\"\ninv = \"\"\nhp = 1000000\nmaxhp = 30\nclass = 0\n");
    var s4 = _mk_sess("FreezeHero", 10);
    assert_eq(player_auth_load(s4, "inflate99", 9), 1, "the inflated record loads");
    assert_eq(load64(s4 + SS_MAXHP), 30, "maxhp is as recorded");
    assert_eq(load64(s4 + SS_HP), 30, "hp is clamped down to maxhp on load");

    # The ordinary case is untouched: hp below max stays where it is.
    _plant_record(blk, "schema = 1\nname = \"FreezeHero\"\nroom = \"\"\ninv = \"\"\nhp = 12\nmaxhp = 30\nclass = 0\n");
    var s5 = _mk_sess("FreezeHero", 10);
    assert_eq(player_auth_load(s5, "inflate99", 9), 1, "a normal record loads");
    assert_eq(load64(s5 + SS_HP), 12, "hp below maxhp is preserved");

    # --- H4 (1.6.1): the audit chain must not accumulate.
    #
    # descent is a write-through consumer — audit_event hands each entry to the
    # FileStore and never reads the chain back — so libro 2.8.4's streaming mode
    # keeps only the head hash. Before it, every login/save/security event was
    # retained for the process lifetime with no way to bound it.
    #
    # This asserts the term that actually changed. RSS does NOT move: the Strs
    # each entry carries come from the bump allocator, which has no free, and
    # freelist memory is never returned to the OS — so a soak reads the same
    # drift before and after. chain_len is the honest instrument.
    assert_eq(chain_streaming(g_audit_chain), 1, "the audit chain is in streaming mode");
    var before = chain_len(g_audit_chain);
    var a = 0;
    while (a < 50) { audit_event(SEV_INFO, "soak.probe", "Prober", 6); a = a + 1; }
    assert_eq(chain_len(g_audit_chain), before, "50 audit events retain nothing");
    assert_eq(chain_len(g_audit_chain), 0, "the streaming chain stays empty");

    return 0;
}

# === H5 (1.6.2) — pre-auth work is metered ===
fn test_preauth_meter(): i64 {
    test_group("preauth-meter");

    # --- The dispatch cap. One readable event may complete at most RX_MAX_LINES
    # lines; the rest of the buffer is RETAINED, not dropped. Unmetered, a 4 KB
    # read held ~800 login attempts and froze the single-threaded loop for
    # seconds (measured: 5.2 s wrong-passphrase, 27.1 s bare-CR).
    var s = _tx_sess();
    store64(s + SS_LINE_BUF, fl_alloc(LINE_CAP));
    store64(s + SS_NAME_BUF, fl_alloc(NAME_CAP));
    store64(s + SS_TS, telnet_state_new());
    store64(s + SS_PHASE, PHASE_NAME);
    var rx = fl_alloc(RX_CAP);
    store64(s + SS_RX_BUF, rx);
    # 40 short lines: "ab\r" x 40 = 120 bytes.
    var n = 0;
    var w = 0;
    while (n < 40) {
        store8(rx + w, 97); store8(rx + w + 1, 98); store8(rx + w + 2, 13);
        w = w + 3; n = n + 1;
    }
    store64(s + SS_RX_LEN, w);
    var more = session_consume_rx(s);
    assert_eq(more, 1, "the cap reports there is more to do");
    assert(load64(s + SS_RX_LEN) > 0, "the unconsumed tail is retained, not dropped");
    assert(load64(s + SS_RX_LEN) < w, "and some of it was consumed");

    # Draining repeatedly must finish — the retained tail is not a stall.
    var guard = 0;
    while (load64(s + SS_RX_LEN) > 0) {
        session_consume_rx(s);
        guard = guard + 1;
        if (guard > 100) { store64(s + SS_RX_LEN, 0); }
    }
    assert(guard <= 100, "repeated passes drain the buffer to empty");
    assert(guard >= 4, "40 lines took several capped passes, not one");

    # --- A bare CR must not dispatch an empty line. The LF branch always had
    # this guard; CR did not, so 4096 CRs cost 4096 login attempts.
    var s2 = _tx_sess();
    store64(s2 + SS_LINE_BUF, fl_alloc(LINE_CAP));
    store64(s2 + SS_LINE_LEN, 0);
    store64(s2 + SS_PHASE, PHASE_NAME);
    assert_eq(session_push_line_byte(s2, 13), 0, "a bare CR on an empty line dispatches nothing");
    store8(load64(s2 + SS_LINE_BUF), 120);
    store64(s2 + SS_LINE_LEN, 1);
    assert_eq(session_push_line_byte(s2, 13), 1, "a CR after real bytes does dispatch");

    # --- The passphrase bounds are checked before the record is touched, so an
    # out-of-range attempt costs nothing. "Nonesuch" has no save file at all:
    # before the hoist this returned -1 (no record); now the length gate fires
    # first and it is a plain wrong-passphrase 0.
    assert_eq(player_auth_load(_mk_sess("Nonesuch", 8), "x", 1), 0,
              "under-length passphrase short-circuits before the record read");
    assert_eq(player_auth_load(_mk_sess("Nonesuch", 8), _rep_a(200), 200), 0,
              "over-length passphrase short-circuits before the record read");

    return 0;
}

# === H6 (1.6.3) — accept-path limits + save rate limit ===
fn test_accept_limits(): i64 {
    test_group("accept-limits");

    # --- The session cap. g_session_count was incremented, decremented and
    # printed by @stats, but never COMPARED — there was no ceiling at all, so
    # ordinary connections could walk the process into its fd limit.
    assert(MAX_SESSIONS > 0, "a session ceiling exists");
    assert(MAX_SESSIONS < 1024, "and sits below a default fd limit, leaving headroom");

    # --- Listener arm/disarm. Disarming is what actually stops the busy spin:
    # the listener is level-triggered, so suppressing the accept alone left
    # epoll_wait returning instantly (measured: 99.9% of a core with the accept
    # already suppressed). Idempotent in both directions — the tick calls
    # listener_rearm unconditionally once the window passes.
    var armed0 = g_listener_armed;
    listener_disarm();
    assert_eq(g_listener_armed, 0, "disarm clears the armed flag");
    listener_disarm();
    assert_eq(g_listener_armed, 0, "disarming twice is a no-op");
    listener_rearm();
    assert_eq(g_listener_armed, 1, "re-arm sets it back");
    listener_rearm();
    assert_eq(g_listener_armed, 1, "re-arming twice is a no-op");
    g_listener_armed = armed0;

    # --- The save rate limit. player_save is ~1.2 ms of ed25519_sign plus a
    # write, a rename and an audit append; 4 KB of "save\r" was 819 of them.
    var s = _mk_sess("Saver", 5);
    var blk = sess_ident(s);
    random_bytes(blk, SALT_LEN);
    ident_derive(blk, "saverpass1", 10, blk + IDENT_SK, blk + IDENT_PK);
    store64(blk + IDENT_CREATED, 1);
    store64(s + SS_AUTHED, 1); store64(s + SS_ROOM, 0 - 1);
    store64(s + SS_HP, 20); store64(s + SS_MAXHP, 20); store64(s + SS_CLASS, 0);
    assert_eq(player_save(s), 1, "the first save lands");
    var stamp = load64(s + SS_LAST_SAVE_MS);
    assert(stamp > 0, "and records when it happened");

    # The gate itself, tested directly rather than by driving cmd_dispatch —
    # that needs a full session + parser + world and segfaults on a bare test
    # session, which proves nothing about the rule.
    assert_eq(save_rate_limited(s), 1, "a save moments after the last is rate-limited");
    # 1 rather than clock_now_ms() - interval - 1: clock_now_ms() is monotonic
    # (ms since boot), so on a host up for under a second that arithmetic goes
    # NEGATIVE and this stops testing what it says it tests. 1 is a valid,
    # long-past timestamp on every host and is not the never-saved sentinel.
    store64(s + SS_LAST_SAVE_MS, 1);
    assert_eq(save_rate_limited(s), 0, "once the window passes it is allowed again");
    # A session that has never saved must never be blocked.
    var fresh = _mk_sess("Fresh", 5);
    assert_eq(save_rate_limited(fresh), 0, "a session that never saved is not rate-limited");

    return 0;
}

# === H7 (1.6.4) — the assist actually works ===
fn test_assist_real(): i64 {
    test_group("assist-real");
    if (g_room_count < 2) { assert(0, "assist-real: need a multi-room world"); return 0; }
    var tpl = mt_at(0);

    # --- H7-a: a latch whose target has left the room must be reaped.
    # Before this, the engaged arm offered only _mob_flee, which returns above
    # MORALE_FLEE_PCT — and an assisting mob is never attacked, so its HP never
    # falls. It kept the stale target forever and never wandered again.
    var m = mob_spawn(tpl, 0);
    var s = _mk_sess("Leaver", 6);
    store64(s + SS_ROOM, 0);
    store64(s + SS_PHASE, PHASE_CMD);
    mi_set_target(m, s);
    store64(s + SS_ROOM, 1);              # the player walks out
    mob_tick_all(7100);
    assert_eq(mi_target(m), 0, "a target who left the room is reaped");

    # And the mob is free to move again — the freeze is gone.
    var moved = 0;
    var k = 0;
    while (k < 300) {
        mob_tick_all(7200 + k);
        if (mi_room(m) != load64(m + MI_HOME)) { moved = 1; k = 300; }
        k = k + 1;
    }
    assert_eq(moved, 1, "a reaped mob wanders again");
    mob_remove(m);

    # --- H7-b: an assisting mob actually swings. M13 set MI_TARGET and printed
    # "joins the fight!", but the only line that subtracts player HP lives in
    # combat_round, driven by the PLAYER's target — so the assist was prose.
    var s2 = _mk_sess("Punchbag", 8);
    store64(s2 + SS_ROOM, 0);
    store64(s2 + SS_PHASE, PHASE_CMD);
    store64(s2 + SS_MAXHP, 200); store64(s2 + SS_HP, 200);
    store64(s2 + SS_AC, 30);              # easy to hit, so the test is not flaky
    store64(s2 + SS_TARGET, 0);           # NOT fighting this mob
    var m2 = mob_spawn(tpl, 0);
    mi_set_target(m2, s2);
    var hp0 = load64(s2 + SS_HP);
    var n = 0;
    while (n < 40) { mob_tick_all(7600 + n); n = n + 1; }
    assert(load64(s2 + SS_HP) < hp0, "a mob that latched onto you actually hits you");
    mob_remove(m2);

    # --- The double-swing guard: if the player is already fighting THIS mob,
    # combat_round handles it and mob_tick_all must not swing it again.
    var s3 = _mk_sess("Duellist", 8);
    store64(s3 + SS_ROOM, 0);
    store64(s3 + SS_PHASE, PHASE_CMD);
    store64(s3 + SS_MAXHP, 500); store64(s3 + SS_HP, 500);
    store64(s3 + SS_AC, 30);
    var m3 = mob_spawn(tpl, 0);
    mi_set_target(m3, s3);
    store64(s3 + SS_TARGET, m3);          # mutual engagement
    var before3 = load64(s3 + SS_HP);
    mob_tick_all(7900);
    assert_eq(load64(s3 + SS_HP), before3,
              "the player's own target is left to combat_round, not swung twice");
    mob_remove(m3);

    return 0;
}

# === H8 (1.6.4) — the `passwd` candidate survives interleaved persistence ===
fn test_chpass_isolation(): i64 {
    test_group("chpass-isolation");
    persist_init();

    # A player mid-`passwd` has typed the new passphrase and is at the confirm
    # prompt — a full network round trip away. The candidate used to sit in the
    # global g_persist_dec, byte-for-byte where player_auth_load decodes
    # salt|pubkey|sig and where _build_record writes its signature. Anything that
    # persisted or authenticated in between destroyed it.
    #
    # The pre-existing test called the two halves back to back, which is the one
    # ordering that cannot fail. These interleave.

    # (a) An interleaved SAVE by another session must not disturb the candidate.
    var s = _mk_sess("Rekeyer", 7);
    var blk = sess_ident(s);
    random_bytes(blk, SALT_LEN);
    ident_derive(blk, "oldpass123", 10, blk + IDENT_SK, blk + IDENT_PK);
    store64(blk + IDENT_CREATED, 1);
    store64(s + SS_AUTHED, 1); store64(s + SS_ROOM, 0 - 1); store64(s + SS_CLASS, 0);
    store64(s + SS_PHASE, PHASE_CHPASS_NEW);
    chpass_on_new(s, "brandnewpass", 12);
    assert_eq(load64(s + SS_PHASE), PHASE_CHPASS_CONFIRM, "candidate staged");

    var other = _mk_sess("Bystander", 9);
    var ob = sess_ident(other);
    random_bytes(ob, SALT_LEN);
    ident_derive(ob, "bypass1234", 10, ob + IDENT_SK, ob + IDENT_PK);
    store64(ob + IDENT_CREATED, 1);
    store64(other + SS_AUTHED, 1); store64(other + SS_ROOM, 0 - 1); store64(other + SS_CLASS, 0);
    player_save(other);                       # <-- the interleave

    chpass_on_confirm(s, "brandnewpass", 12);
    assert_eq(load64(s + SS_PHASE), PHASE_CMD, "confirm survives an interleaved save");

    # (b) An interleaved FAILED login must not disturb it either. hex_decode_into
    # writes into the decode scratch BEFORE the signature verify, so even a wrong
    # passphrase probe against any account used to clobber the candidate.
    var s2 = _mk_sess("Rekeyer2", 8);
    var b2 = sess_ident(s2);
    random_bytes(b2, SALT_LEN);
    ident_derive(b2, "oldpass456", 10, b2 + IDENT_SK, b2 + IDENT_PK);
    store64(b2 + IDENT_CREATED, 1);
    store64(s2 + SS_AUTHED, 1); store64(s2 + SS_ROOM, 0 - 1); store64(s2 + SS_CLASS, 0);
    store64(s2 + SS_PHASE, PHASE_CHPASS_NEW);
    chpass_on_new(s2, "secondnewpass", 13);
    player_auth_load(_mk_sess("Bystander", 9), "wrongpass", 9);   # <-- the interleave
    chpass_on_confirm(s2, "secondnewpass", 13);
    assert_eq(load64(s2 + SS_PHASE), PHASE_CMD, "confirm survives a failed login probe");

    # (c) Two sessions mid-`passwd` at once each commit their OWN candidate — a
    # single shared global, even a dedicated one, cannot do this.
    var a = _mk_sess("PairA", 5);
    var ba = sess_ident(a);
    random_bytes(ba, SALT_LEN);
    ident_derive(ba, "apass12345", 10, ba + IDENT_SK, ba + IDENT_PK);
    store64(ba + IDENT_CREATED, 1);
    store64(a + SS_AUTHED, 1); store64(a + SS_ROOM, 0 - 1); store64(a + SS_CLASS, 0);
    var b = _mk_sess("PairB", 5);
    var bb = sess_ident(b);
    random_bytes(bb, SALT_LEN);
    ident_derive(bb, "bpass12345", 10, bb + IDENT_SK, bb + IDENT_PK);
    store64(bb + IDENT_CREATED, 1);
    store64(b + SS_AUTHED, 1); store64(b + SS_ROOM, 0 - 1); store64(b + SS_CLASS, 0);
    chpass_on_new(a, "aaanewpass", 10);
    chpass_on_new(b, "bbbnewpass", 10);       # interleaved staging
    chpass_on_confirm(a, "aaanewpass", 10);
    chpass_on_confirm(b, "bbbnewpass", 10);
    assert_eq(load64(a + SS_PHASE), PHASE_CMD, "session A committed its own candidate");
    assert_eq(load64(b + SS_PHASE), PHASE_CMD, "session B committed its own candidate");

    # The candidate block is released once committed — a derived secret key must
    # not linger in a reusable freelist block.
    assert_eq(load64(a + SS_IDENT_CAND), 0, "the candidate block is freed on commit");

    return 0;
}

# === H9/H10 (1.6.5) — failed loads publish nothing; failed saves are not silent ===
fn test_load_and_save_failure(): i64 {
    test_group("failure-paths");
    persist_init();

    # --- H9: a rejected content file must leave NO live table. Publishing the
    # count before the parse loop meant a rejected file left a partly-filled
    # world behind — cmd_serve printed "no zone loaded" while every
    # `world_room_count() == 0` guard downstream was simultaneously defeated, so
    # a player could log in and be stranded in the prefix that happened to parse.
    var saved_rooms = g_room_count;
    var saved_start = g_start_room;
    assert_eq(world_load_rooms("tests/fixtures/wrongkind.rooms.cyml"), WL_ERR_KIND,
              "a wrong-kind rooms file is rejected");
    assert_eq(g_room_count, 0, "and leaves no live room table");
    assert_eq(world_load_rooms("tests/fixtures/dangling.rooms.cyml"), WL_ERR_DANGLE,
              "a dangling-exit rooms file is rejected");
    assert_eq(g_room_count, 0, "and likewise leaves nothing live");
    assert_eq(world_load_rooms("tests/fixtures/nosuchfile.cyml"), WL_ERR_IO,
              "a missing file is rejected");
    assert_eq(g_room_count, 0, "and leaves nothing live");
    # Restore the real world for the groups that follow.
    assert_eq(world_load_rooms(DP_ROOMS), WL_OK, "the real zone reloads");
    assert(g_room_count > 0, "and publishes its count on success");

    # --- H10: the `passwd` commit must not claim success when the save failed.
    # It used to discard player_save's return, write a SEV_INFO "passwd.change"
    # entry and tell the player their record was re-keyed — while the on-disk
    # record still held the OLD pubkey, so the next login rejected the new
    # passphrase and the retired one still worked.
    #
    # Force the failure with an UNWRITABLE PATH, not an oversized inventory.
    #
    # This test used to overfill the inventory, because that made _build_record
    # return -1. G1 (1.6.13) deliberately removed that failure mode — an
    # over-long inventory now truncates and saves rather than refusing the whole
    # record forever — so the old trigger is gone by design. `_path_for` copies
    # the name straight into the path, so a name containing '/' points at a
    # directory that does not exist and `file_write_all` fails. That is a
    # truer test anyway: H10 exists for ENOSPC / EIO / a failed rename, which
    # are I/O failures, and this injects one.
    var s = _mk_sess("no/such/dir/Rekeyfail", 20);
    var blk = sess_ident(s);
    random_bytes(blk, SALT_LEN);
    ident_derive(blk, "origpass12", 10, blk + IDENT_SK, blk + IDENT_PK);
    store64(blk + IDENT_CREATED, 1);
    store64(s + SS_AUTHED, 1); store64(s + SS_ROOM, 0 - 1); store64(s + SS_CLASS, 0);
    assert_eq(player_save(s), 0 - 1, "the save genuinely fails (unwritable path)");

    # Capture the live pubkey, then attempt the re-key.
    var before = alloc(PK_LEN);
    memcpy(before, blk + IDENT_PK, PK_LEN);
    store64(s + SS_PHASE, PHASE_CHPASS_NEW);
    chpass_on_new(s, "replacement", 11);
    chpass_on_confirm(s, "replacement", 11);
    assert_eq(_bytes_eq(blk + IDENT_PK, before, PK_LEN), 1,
              "a failed re-key leaves the live identity UNCHANGED");
    assert_eq(load64(s + SS_IDENT_CAND), 0, "and still releases the candidate block");

    return 0;
}

# === H11 (1.6.6) — Batch A: state integrity ===
fn test_state_integrity(): i64 {
    test_group("state-integrity");
    persist_init();

    # --- A1: one character, one session. Two sessions on the same character each
    # ran _restore_inv and each minted a full copy of the saved inventory — and
    # zone_reset_room_objs only refills MISSING ids, never removes extras, so the
    # duplicates were never reclaimed. Both also wrote the same record with no
    # compare-and-swap, so the stale session's drop_session reverted the live
    # one's room, drops, HP and class.
    var a = _mk_sess("Twin", 4);
    store64(a + SS_AUTHED, 1);
    var saved_head = g_session_head;
    store64(a + SS_NEXT, 0);
    g_session_head = a;
    assert_eq(session_already_online("Twin", 4, 0), 1, "an authed session is found by name");
    assert_eq(session_already_online("Twin", 4, a), 0, "and excludes itself");
    assert_eq(session_already_online("Other", 5, 0), 0, "a different name does not match");
    # Case-insensitive: _path_for lowercases only the FILENAME, so two spellings
    # share one record and must be treated as the same character.
    assert_eq(session_already_online("TWIN", 4, 0), 1, "matching is case-insensitive");
    # An unauthenticated session with the same name is not yet that character.
    store64(a + SS_AUTHED, 0);
    assert_eq(session_already_online("Twin", 4, 0), 0, "an unauthed session does not hold the name");
    g_session_head = saved_head;

    # --- A2: a template id must survive the round trip into an instance. The
    # template wrote up to OT_ID_CAP (32) while item_new copies at
    # OI_TPL_ID_CAP - 1 (31), so a 32-byte id was truncated and could never match
    # its own template on reload — and the save record stores inventory BY id.
    # A real Hub id is ~6 bytes, so it round-trips either way and proves nothing:
    # the truncation is only observable at exactly OT_ID_CAP. Drive the REAL
    # loader over a fixture whose id is 32 bytes — writing the copy by hand here
    # would bypass the very line under test.
    assert(world_load_objs("tests/fixtures/longid.objs.cyml") > 0, "the maximal-id fixture loads");
    var probe = ot_at(0);
    assert_eq(load64(probe + OT_ID_LEN), OT_ID_CAP - 1,
              "a 32-byte id is stored at CAP-1, leaving room for the NUL");
    var sit = item_new(probe);
    assert_eq(oi_tpl_id_len(sit), load64(probe + OT_ID_LEN),
              "and round-trips into the instance intact");
    obj_free(sit);
    # Restore the real object table for the groups that follow.
    assert(world_load_objs(DP_OBJS) > 0, "the real object table reloads");

    var tpl = ot_at(0);
    var it = item_new(tpl);
    assert_eq(oi_tpl_id_len(it), load64(tpl + OT_ID_LEN),
              "the instance carries the template id at full length");
    var k = 0;
    var same = 1;
    while (k < load64(tpl + OT_ID_LEN)) {
        if ((load8(oi_tpl_id_ptr(it) + k) & 0xFF) != (load8(tpl + OT_ID + k) & 0xFF)) { same = 0; }
        k = k + 1;
    }
    assert_eq(same, 1, "and byte-for-byte the same id");
    assert(load64(tpl + OT_ID_LEN) < OT_ID_CAP, "template ids leave room for a NUL");
    obj_free(it);

    # --- A3: the audit chain resumes from the durable head. filestore_open told
    # the in-memory chain nothing, so every restart began at genesis and a
    # verifier walking data/audit.libro saw a broken link at each restart
    # boundary — indistinguishable from someone removing entries.
    #
    # The end-to-end proof is three real server processes (0 breaks with the fix,
    # 2 without). Here, assert the tail parser those runs depend on.
    var line = "{\"id\":\"x\",\"prev_hash\":\"aa\",\"hash\":\"beefcafe\"}\n";
    var h = _audit_last_hash(line, strlen(line));
    assert(h != 0, "a complete record yields a hash");
    assert_eq(str_eq_cstr(h, "beefcafe"), 1, "and it is the record's own hash");

    # The LAST record wins — the read window may begin mid-file.
    var two = "{\"hash\":\"first000\"}\n{\"hash\":\"second11\"}\n";
    assert_eq(str_eq_cstr(_audit_last_hash(two, strlen(two)), "second11"), 1,
              "the last complete record wins");

    # A torn final write (no trailing newline) is skipped, not half-read.
    var torn = "{\"hash\":\"good0000\"}\n{\"hash\":\"trunc";
    assert_eq(str_eq_cstr(_audit_last_hash(torn, strlen(torn)), "good0000"), 1,
              "a torn trailing record is ignored");
    assert_eq(_audit_last_hash("no newline here", 15), 0, "no complete record yields nothing");

    return 0;
}

# Pop every object off the list at `slot`, freeing each — leaves the room or
# inventory exactly as empty as the group found it.
fn _drain_ilist(slot): i64 {
    var o = load64(slot);
    while (o != 0) {
        var nxt = oi_next(o);
        store64(slot, nxt);
        obj_free(o);
        o = nxt;
    }
    return 0;
}
# First space-delimited word of an object's keyword blob, copied into `dst` and
# NUL-terminated. The blob is multi-word ("scrip fistful credits money"); feeding
# all of it to the parser would make the extra words look like more tokens, so
# every command these tests build uses just the first.
fn _kw1(src, dst): i64 {
    var i = 0;
    var done = 0;
    while (done == 0) {
        var c = load8(src + i) & 0xFF;
        if (c == 0)  { done = 1; continue; }
        if (c == 32) { done = 1; continue; }
        store8(dst + i, c);
        i = i + 1;
    }
    store8(dst + i, 0);
    return dst;
}
# Is `o` on the intrusive list headed at `slot`?
fn _on_ilist(slot, o): i64 {
    var c = load64(slot);
    while (c != 0) {
        if (c == o) { return 1; }
        c = oi_next(c);
    }
    return 0;
}

# === H12 (1.6.7) — Batch B: the qualifier, the placeholder verbs, zone ints. ===
fn test_item_verbs(): i64 {
    test_group("item-verbs");
    assert(world_room_count() > 0, "item-verbs: needs a loaded world (fixture ordering)");
    assert(g_obj_tpl_count >= 2, "item-verbs: needs at least two object templates");

    var room_slot = room_at(0) + RM_OBJ_HEAD;
    _drain_ilist(room_slot);

    # --- B1: the N.X ordinal. qual_parse has returned QUAL_NTH since M2-E and
    # nothing read it, so `get 2.scrip` searched for a keyword literally spelled
    # "2.scrip" and answered "There is nothing like that here" with the second
    # one in plain sight.
    var pa = parser_new();
    var qp[8]; var ql[8];
    var kwbuf = alloc(64);
    var kwbuf2 = alloc(64);

    parse_lit(pa, "get 2.scrip");
    assert_eq(qual_single(pa, parsed_dobj(pa), &qp, &ql), 2, "2.scrip → ordinal 2");
    assert_eq(load64(&ql), 5, "and the base noun drops the ordinal");

    parse_lit(pa, "get scrip");
    assert_eq(qual_single(pa, parsed_dobj(pa), &qp, &ql), 1, "an unqualified noun → ordinal 1");
    assert_eq(load64(&ql), 5, "whole token is the base");

    # A singular verb has no plural form, so all.X takes the first match.
    parse_lit(pa, "get all.scrip");
    assert_eq(qual_single(pa, parsed_dobj(pa), &qp, &ql), 1, "all.scrip → first match");
    assert_eq(load64(&ql), 5, "with the base after the dot");

    # Three identical items on one list: the ordinal must pick them apart in
    # list order — the order look / inventory print, which for ilist_push is
    # most-recently-pushed first.
    var tpl = ot_at(0);
    var head[8]; store64(&head, 0);
    var o1 = item_new(tpl); ilist_push(&head, o1);
    var o2 = item_new(tpl); ilist_push(&head, o2);
    var o3 = item_new(tpl); ilist_push(&head, o3);
    var kw = _kw1(oi_kw_ptr(o1), kwbuf);
    var kwl = strlen(kw);
    assert_eq(ilist_find_kw_nth(load64(&head), kw, kwl, 1), o3, "1. is the list head");
    assert_eq(ilist_find_kw_nth(load64(&head), kw, kwl, 2), o2, "2. is the second match");
    assert_eq(ilist_find_kw_nth(load64(&head), kw, kwl, 3), o1, "3. is the third match");
    assert_eq(ilist_find_kw_nth(load64(&head), kw, kwl, 4), 0, "past the end → nothing");
    assert_eq(ilist_find_kw_nth(load64(&head), kw, kwl, 0), 0, "a zero ordinal → nothing");
    assert_eq(ilist_find_kw(load64(&head), kw, kwl), o3,
              "the unqualified lookup is still first-match");

    # End to end through a real command: drop 2.<kw> must move the SECOND one
    # and leave the other two carried.
    var s = _mk_sess("Ordinal", 7);
    store64(s + SS_ROOM, 0);
    store64(s + SS_PHASE, PHASE_CMD);
    store64(s + SS_FD, 0 - 1);
    store64(s + SS_INV, load64(&head));

    var cmd = alloc(256);
    var co = _str_into(cmd, 0, "drop 2.");
    co = _str_into(cmd, co, kw);
    _tx_reset(s);
    parser_parse(pa, cmd, co);
    cmd_drop(s, pa);
    assert_eq(_on_ilist(room_slot, o2), 1, "drop 2.<kw> dropped the second one");
    assert_eq(_on_ilist(s + SS_INV, o2), 0, "and it left the inventory");
    assert_eq(_on_ilist(s + SS_INV, o3), 1, "the first is still carried");
    assert_eq(_on_ilist(s + SS_INV, o1), 1, "and so is the third");

    # An ordinal past the end must not silently fall back to the first.
    _tx_reset(s);
    co = _str_into(cmd, 0, "drop 9.");
    co = _str_into(cmd, co, kw);
    parser_parse(pa, cmd, co);
    cmd_drop(s, pa);
    assert_eq(_on_ilist(s + SS_INV, o3), 1, "9.<kw> with two carried drops nothing");
    assert_eq(_tx_is(s, "You aren't carrying that.\r\n"), 1, "and says so");

    _drain_ilist(room_slot);
    _drain_ilist(s + SS_INV);

    # --- B2: put. Four releases after M3 landed, `put` still answered "the
    # Under-Grid is empty — items arrive at M3".
    var box = item_new(ot_at(1));
    ilist_push(room_slot, box);
    var coin = item_new(ot_at(0));
    ilist_push(s + SS_INV, coin);
    var bkw = _kw1(oi_kw_ptr(box), kwbuf);
    var ckw = _kw1(oi_kw_ptr(coin), kwbuf2);

    co = _str_into(cmd, 0, "put ");
    co = _str_into(cmd, co, ckw);
    co = _str_into(cmd, co, " in ");
    co = _str_into(cmd, co, bkw);
    _tx_reset(s);
    parser_parse(pa, cmd, co);
    cmd_put(s, pa);
    assert_eq(_on_ilist(box + OI_CONTENTS, coin), 1, "put moved the item into the container");
    assert_eq(_on_ilist(s + SS_INV, coin), 0, "and out of the inventory");
    # ... and `get X from Y` takes it back — the two halves must agree.
    co = _str_into(cmd, 0, "get ");
    co = _str_into(cmd, co, ckw);
    co = _str_into(cmd, co, " from ");
    co = _str_into(cmd, co, bkw);
    _tx_reset(s);
    parser_parse(pa, cmd, co);
    cmd_get(s, pa);
    assert_eq(_on_ilist(s + SS_INV, coin), 1, "get ... from takes it back out");
    assert_eq(_on_ilist(box + OI_CONTENTS, coin), 0, "leaving the container empty");

    # Nothing may hold itself: that is a cycle, and obj_free walks OI_CONTENTS
    # recursively — it would never terminate.
    co = _str_into(cmd, 0, "put ");
    co = _str_into(cmd, co, ckw);
    co = _str_into(cmd, co, " in ");
    co = _str_into(cmd, co, ckw);
    _tx_reset(s);
    parser_parse(pa, cmd, co);
    cmd_put(s, pa);
    assert_eq(_tx_is(s, "It won't hold itself.\r\n"), 1, "a container cannot hold itself");
    assert_eq(oi_contents(coin), 0, "and nothing went in");

    # Nesting is capped at one level, so the recursion depth is bounded.
    var sack = item_new(ot_at(1));
    ilist_push(s + SS_INV, sack);
    ilist_push(sack + OI_CONTENTS, item_new(ot_at(0)));   # sack is now non-empty
    co = _str_into(cmd, 0, "put ");
    co = _str_into(cmd, co, _kw1(oi_kw_ptr(sack), alloc(64)));
    co = _str_into(cmd, co, " in ");
    co = _str_into(cmd, co, bkw);
    _tx_reset(s);
    parser_parse(pa, cmd, co);
    cmd_put(s, pa);
    assert_eq(_tx_is(s, "It's full — empty it first.\r\n"), 1, "a full container will not nest");
    assert_eq(_on_ilist(s + SS_INV, sack), 1, "and it stays where it was");

    _tx_reset(s);
    parse_lit(pa, "put scrip");
    cmd_put(s, pa);
    assert_eq(_tx_is(s, "Put it in what?\r\n"), 1, "put with no container asks for one");

    _drain_ilist(s + SS_INV);
    _drain_ilist(room_slot);

    # --- B2: give. Hands an object to a player standing in the same room.
    var giver = _mk_sess("Giver", 5);
    store64(giver + SS_ROOM, 0); store64(giver + SS_PHASE, PHASE_CMD);
    store64(giver + SS_FD, 0 - 1);
    var taker = _mk_sess("Taker", 5);
    store64(taker + SS_ROOM, 0); store64(taker + SS_PHASE, PHASE_CMD);
    store64(taker + SS_FD, 0 - 1);   # deliver_to writes to a bad fd, never a real one
    var saved_head = g_session_head;
    store64(giver + SS_NEXT, taker); store64(taker + SS_NEXT, 0);
    g_session_head = giver;

    var gift = item_new(ot_at(0));
    ilist_push(giver + SS_INV, gift);
    co = _str_into(cmd, 0, "give ");
    co = _str_into(cmd, co, _kw1(oi_kw_ptr(gift), kwbuf));
    co = _str_into(cmd, co, " to Taker");
    _tx_reset(giver); _tx_reset(taker);
    parser_parse(pa, cmd, co);
    cmd_give(giver, pa);
    assert_eq(_on_ilist(taker + SS_INV, gift), 1, "give moved the item to the recipient");
    assert_eq(_on_ilist(giver + SS_INV, gift), 0, "and out of the giver's hands");
    assert_eq(_contains(load64(taker + SS_TX_BUF), load64(taker + SS_TX_LEN), "gives you"), 1,
              "the recipient is told, in the same tick");

    # No such player in the room: the item must not evaporate.
    var keep = item_new(ot_at(0));
    ilist_push(giver + SS_INV, keep);
    _tx_reset(giver);
    co = _str_into(cmd, 0, "give ");
    co = _str_into(cmd, co, _kw1(oi_kw_ptr(keep), kwbuf));
    co = _str_into(cmd, co, " to Nobody");
    parser_parse(pa, cmd, co);
    cmd_give(giver, pa);
    assert_eq(_on_ilist(giver + SS_INV, keep), 1, "an unresolvable recipient keeps the item put");

    _tx_reset(giver);
    parse_lit(pa, "give scrip");
    cmd_give(giver, pa);
    assert_eq(_tx_is(giver, "Give it to whom?\r\n"), 1, "give with no recipient asks for one");

    g_session_head = saved_head;
    _drain_ilist(giver + SS_INV);
    _drain_ilist(taker + SS_INV);

    # --- B2: wear / remove / wield. Still unimplemented — equipment slots are
    # M17 — but they must say THAT, not "items arrive at M3", which stopped
    # being true the moment M3 shipped.
    var jacket = item_new(ot_at(0));
    ilist_push(s + SS_INV, jacket);
    co = _str_into(cmd, 0, "wear ");
    co = _str_into(cmd, co, _kw1(oi_kw_ptr(jacket), kwbuf));
    _tx_reset(s);
    parser_parse(pa, cmd, co);
    cmd_dispatch(s, pa, cmd, co);
    assert_eq(_contains(load64(s + SS_TX_BUF), load64(s + SS_TX_LEN), "arrive at M3"), 0,
              "wear no longer claims the world is empty");
    assert_eq(_contains(load64(s + SS_TX_BUF), load64(s + SS_TX_LEN), "rig to hold it"), 1,
              "it says why it cannot, instead");
    _tx_reset(s);
    parse_lit(pa, "wield sporkgun");
    cmd_dispatch(s, pa, "wield sporkgun", 14);
    assert_eq(_tx_is(s, "You aren't carrying that.\r\n"), 1,
              "and it resolves the noun for real before answering");
    _drain_ilist(s + SS_INV);

    # --- B1, the other half: mobs. `kill 2.drone` went through a separate scan
    # (mob_in_room_by_kw) that never saw a qualifier either, so a room holding
    # three of the same template could only ever be fought one way — whichever
    # one happened to head the occupant list.
    if (g_mob_tpl_count > 0) {
        var kt = mt_at(0);
        var mkw = _kw1(mt_kw_ptr(kt), kwbuf);
        var mkwl = strlen(mkw);
        var k1 = mob_spawn(kt, 0);
        var k2 = mob_spawn(kt, 0);
        var k3 = mob_spawn(kt, 0);
        assert_eq(mob_in_room_by_kw_nth(0, mkw, mkwl, 1), k3, "1. is the room's list head");
        assert_eq(mob_in_room_by_kw_nth(0, mkw, mkwl, 2), k2, "2. is the second mob");
        assert_eq(mob_in_room_by_kw_nth(0, mkw, mkwl, 3), k1, "3. is the third");
        assert_eq(mob_in_room_by_kw_nth(0, mkw, mkwl, 4), 0, "past the end → nothing");
        assert_eq(mob_in_room_by_kw(0, mkw, mkwl), k3, "the unqualified scan is still first-match");

        co = _str_into(cmd, 0, "kill 2.");
        co = _str_into(cmd, co, mkw);
        _tx_reset(s);
        store64(s + SS_TARGET, 0);
        parser_parse(pa, cmd, co);
        cmd_kill(s, pa);
        assert_eq(load64(s + SS_TARGET), k2, "kill 2.<kw> engages the second one");

        co = _str_into(cmd, 0, "examine 3.");
        co = _str_into(cmd, co, mkw);
        _tx_reset(s);
        parser_parse(pa, cmd, co);
        cmd_examine(s, pa);
        assert_eq(_contains(load64(s + SS_TX_BUF), load64(s + SS_TX_LEN), "You see no"), 0,
                  "examine 3.<kw> resolves rather than failing to find it");

        store64(s + SS_TARGET, 0);
        mob_remove(k1); mob_remove(k2); mob_remove(k3);
    }

    # --- B4: a killing blow ends the prose. bash / emp printed their status
    # line ("It reels, stunned.") after the mob had already collapsed.
    if (g_mob_tpl_count > 0) {
        var mt = mt_at(0);
        var m = mob_spawn(mt, 0);
        mi_set_hp(m, 50);
        _tx_reset(s);
        assert_eq(ability_strike(s, m, 1, "You tap "), 0, "a survivable hit reports no kill");
        mi_set_hp(m, 1);
        _tx_reset(s);
        assert_eq(ability_strike(s, m, 99, "You flatten "), 1, "a killing hit reports the kill");
        _drain_ilist(room_slot);   # the corpse it left
    }

    # --- B3: signed ints in authored content. toml_int routed every value
    # through parse_uint, which has no concept of a sign and returns -1 for
    # anything it cannot read — so an authored `ac = -3` silently became the
    # default and no zone file could ever express a negative.
    assert_eq(toml_int(_pairs_of("ac = \"-3\"\n"), "ac", 8), 0 - 3, "a negative value parses");
    assert_eq(toml_int(_pairs_of("ac = \"7\"\n"), "ac", 8), 7, "a positive value still parses");
    assert_eq(toml_int(_pairs_of("ac = \"0\"\n"), "ac", 8), 0, "and zero is not the default");
    assert_eq(toml_int(_pairs_of("ac = \"-\"\n"), "ac", 8), 8, "a bare sign falls back");
    assert_eq(toml_int(_pairs_of("ac = \"-x\"\n"), "ac", 8), 8, "a signed non-number falls back");
    assert_eq(toml_int(_pairs_of("hp = \"3\"\n"), "ac", 8), 8, "an absent key falls back");

    # G3 (1.6.13) — whitespace is trimmed before parsing. A trailing CR is what
    # any editor on Windows leaves, and before this an unparseable value silently
    # took the DEFAULT — so saving a zone file on the wrong platform could rewrite
    # a setting to a number the author never typed, with no error anywhere.
    assert_eq(toml_int(_pairs_of("ac = \"7\r\"\n"), "ac", 8), 7, "a trailing CR does not become the default");
    assert_eq(toml_int(_pairs_of("ac = \" 7\"\n"), "ac", 8), 7, "nor a leading space");
    assert_eq(toml_int(_pairs_of("ac = \"7 \"\n"), "ac", 8), 7, "nor a trailing space");
    assert_eq(toml_int(_pairs_of("ac = \"\t-3 \"\n"), "ac", 8), 0 - 3, "and a padded negative still parses");
    # Whitespace-only is not a number; it is still the default.
    assert_eq(toml_int(_pairs_of("ac = \"   \"\n"), "ac", 8), 8, "whitespace alone falls back");
    # Trimming is NOT strictness: genuine garbage still takes the default, which
    # is the half deliberately deferred to M14-D.
    assert_eq(toml_int(_pairs_of("ac = \"7x\"\n"), "ac", 8), 8, "real garbage still falls back (M14-D)");

    return 0;
}

# === H13 (1.6.8) — the zone reset cadence is bounded. ===
fn test_reset_bounds(): i64 {
    test_group("reset-bounds");

    # The clamp itself. RESET_SECS_MIN exists because a reset cannot usefully be
    # cheaper than the tick it rides on; RESET_SECS_MAX exists so the * 1000 in
    # maybe_zone_reset provably cannot overflow.
    assert_eq(clamp_reset_secs(900), 900, "an ordinary cadence passes through");
    assert_eq(clamp_reset_secs(RESET_SECS_MIN), RESET_SECS_MIN, "the floor itself passes");
    assert_eq(clamp_reset_secs(RESET_SECS_MAX), RESET_SECS_MAX, "the ceiling itself passes");
    assert_eq(clamp_reset_secs(0), RESET_SECS_MIN, "zero is not 'disabled' — it is clamped");
    assert_eq(clamp_reset_secs(0 - 1), RESET_SECS_MIN, "a negative is clamped");
    assert_eq(clamp_reset_secs(RESET_SECS_MAX + 1), RESET_SECS_MAX, "past the ceiling is clamped");
    # The bounds must not touch a cadence anyone would actually author. A clamp
    # that rewrote a weekly reset would be exactly the ADR 0007 §5 break the
    # clamp is trying to avoid causing.
    assert_eq(clamp_reset_secs(600), 600, "a ten-minute cadence is untouched");
    assert_eq(clamp_reset_secs(604800), 604800, "and so is a weekly one");

    # The point of the ceiling: the interval multiply stays positive. An
    # unclamped wrapped value went NEGATIVE here, and a negative interval makes
    # `now - last < interval` false forever — a reset on every tick.
    assert(clamp_reset_secs(RESET_SECS_MAX) * 1000 > 0, "the ms conversion cannot overflow");
    assert(clamp_reset_secs(0 - 999999999999) * 1000 > 0, "nor can a wrapped negative");

    # End to end through the real loader: an authored -1 must not reach the
    # interval. Drive the actual zone parser, not a hand-built value — the whole
    # bug was that the loader published what the file said.
    var saved_secs = g_zone_reset_secs;
    var saved_rooms = g_room_count;

    assert_eq(world_load_rooms("tests/fixtures/badreset.rooms.cyml"), WL_OK,
              "the negative-cadence fixture still loads (ADR 0007 §5 — no new rejections)");
    assert_eq(g_zone_reset_secs, RESET_SECS_MIN,
              "an authored reset_secs = -1 is clamped to the floor");

    assert_eq(world_load_rooms("tests/fixtures/zeroreset.rooms.cyml"), WL_OK,
              "the zero-cadence fixture still loads");
    assert_eq(g_zone_reset_secs, RESET_SECS_MIN,
              "an authored reset_secs = 0 is clamped to the floor");

    # And an ordinary zone is untouched — the clamp must be invisible to every
    # file that was already correct.
    assert_eq(world_load_rooms(DP_ROOMS), WL_OK, "the real zone reloads");
    assert_eq(g_zone_reset_secs, 900, "and its authored 900 survives unchanged");

    # The second clamp site: maybe_zone_reset re-clamps rather than trusting the
    # globals, because that is the only line where the multiply happens. Drive it
    # with a poisoned global that bypasses the loader entirely — which is exactly
    # what a future third writer of g_zone_reset_secs would do by accident.
    var saved_head = g_session_head;
    g_session_head = 0;                       # zone_has_player must not defer for us
    var saved_last = g_zone_last_reset_ms;
    g_zone_reset_secs = 0 - 1;                # the poisoned value
    g_zone_last_reset_ms = clock_now_ms();
    assert_eq(maybe_zone_reset(), 0,
              "a negative cadence does not fire a reset on the very next tick");
    g_zone_reset_secs = 0;
    g_zone_last_reset_ms = clock_now_ms();
    assert_eq(maybe_zone_reset(), 0, "and neither does a zero cadence");
    g_zone_last_reset_ms = saved_last;
    g_session_head = saved_head;

    g_zone_reset_secs = saved_secs;
    assert(g_room_count > 0, "the world is left loaded for the groups that follow");
    return 0;
}

# === H14 (1.6.8) — the tick schedule advances off a POST-work clock. ===
fn test_tick_schedule(): i64 {
    test_group("tick-schedule");

    # --- The arithmetic. tick_reschedule returns the first boundary strictly
    # after now_after — "strictly" matters: an exactly-hit boundary is a deadline
    # that has already arrived, not one to wait for.
    assert_eq(tick_reschedule(2500, 2501, 2500), 5000, "an on-time tick advances one interval");
    assert_eq(tick_reschedule(2500, 5000, 2500), 7500, "an exactly-hit boundary is not a future deadline");
    assert_eq(tick_reschedule(2500, 5200, 2500), 7500, "a one-interval overrun skips the missed boundary");
    assert_eq(tick_reschedule(0, 7500, 2500), 10000, "three missed boundaries collapse to one deadline");
    assert_eq(tick_reschedule(50, 173, 50), 200, "and it holds in a fast-tick regime");
    # Total, not just correct-on-the-happy-path: a deadline that has not passed is
    # left alone. An unconditional +1 interval before the loop would skip a beat.
    assert_eq(tick_reschedule(2500, 2400, 2500), 2500, "a deadline still in the future is untouched");
    assert_eq(tick_reschedule(2500, 0, 2500), 2500, "and asking twice does not advance it");
    # A zero or negative cadence would loop forever; there is no boundary to find.
    assert_eq(tick_reschedule(2500, 9999, 0), 2500, "a zero cadence cannot advance");

    # --- The call site. This is the assertion the bug actually fails.
    #
    # tick_step takes its POST-work sample itself, so no caller can hand it a
    # stale one. Drive it with a pre-work `now` of 0 while the real clock is at
    # its true value: that is a tick which "took" the entire uptime of the
    # process, without needing a genuinely slow tick to manufacture it. The old
    # code rescheduled off `now` and would answer one bare interval (2500);
    # rescheduling off a fresh sample must land past the real clock.
    #
    # A 1 ms cadence, deliberately, not the real 2500: with a 2500 ms interval
    # this only discriminates once the HOST has been up 2.5 s, which is the same
    # uptime assumption that made save-meter pass here and fail on CI. At 1 ms
    # the boundary is crossed on any machine that has been running at all.
    obs_init();                        # the drift ring; only cmd_serve calls this
    var saved_tick = g_tick_count;
    var saved_head = g_session_head;
    g_session_head = 0;                # sweep_idle / advance_tick walk this
    var before = clock_now_ms();
    var nt = tick_step(0, 0, 0, 1);
    assert(nt > before, "the new deadline is in the future, not one interval past a stale sample");
    assert_eq(tick_reschedule(0, 0, 1), 1, "the stale-sample answer would have been 1 ms");
    assert(nt > 1, "and the real one is not that");
    # It is the FIRST such boundary, not an arbitrary jump — the snap must not
    # overshoot either, or the cadence stretches.
    assert(nt - clock_now_ms() <= 1, "and it is the first boundary past it, not a skipped-ahead one");
    g_session_head = saved_head;
    assert_eq(g_tick_count, saved_tick + 1, "tick_step fired exactly one tick");

    # --- The metric must NOT absorb the tick's execution cost. This is the guard
    # against the plausible-but-wrong fix: moving the single sample to after the
    # work would turn `drift p99ms` in @stats from scheduling lateness into
    # lateness-plus-tick-cost, changing a frozen field (ADR 0007 §41) and
    # double-counting, since an overrun already shows up as the next tick's
    # lateness. tick_step recorded `now - next_tick` = 0 - 0 = 0 above.
    assert_eq(load64(g_tick_drift_ring + ((g_tick_drift_idx + DRIFT_RING_CAP - 1) % DRIFT_RING_CAP) * 8), 0,
              "drift is the pre-work lateness (0 here), not the tick's duration");

    return 0;
}

# Byte offset of the first occurrence of a cstr needle in buf[0..n), or -1.
# Same scan as _count_occurrences below, stopping at the first hit — used to
# corrupt a specific FIELD of a save record rather than a fixed offset, so the
# test keeps testing what it means when the record layout shifts.
fn _find_cstr(buf, n, needle): i64 {
    var nl = strlen(needle);
    if (nl <= 0) { return 0 - 1; }
    var i = 0;
    while (i + nl <= n) {
        var k = 0;
        var same = 1;
        while (k < nl) {
            if ((load8(buf + i + k) & 0xFF) != (load8(needle + k) & 0xFF)) { same = 0; k = nl; }
            else { k = k + 1; }
        }
        if (same == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Count non-overlapping occurrences of a cstr needle in buf[0..n).
fn _count_occurrences(buf, n, needle): i64 {
    var nl = strlen(needle);
    if (nl <= 0) { return 0; }
    var hits = 0;
    var i = 0;
    while (i + nl <= n) {
        var k = 0;
        var same = 1;
        while (k < nl) {
            if ((load8(buf + i + k) & 0xFF) != (load8(needle + k) & 0xFF)) { same = 0; k = nl; }
            else { k = k + 1; }
        }
        if (same == 1) { hits = hits + 1; i = i + nl; }
        else { i = i + 1; }
    }
    return hits;
}

# === H15 (1.6.8) — the tick's writes are coalesced, and nothing is lost. ===
fn test_tick_coalescing(): i64 {
    test_group("tick-coalescing");
    if (g_room_count == 0)      { assert(0, "coalescing: needs a loaded world"); return 0; }
    if (g_mob_tpl_count == 0)   { assert(0, "coalescing: needs a mob template"); return 0; }

    # A real file as the sink, so the test can read back exactly what reached the
    # socket. /dev/null would prove the writes happened but not what was in them,
    # and the whole hazard here is bytes going missing.
    var path = "/tmp/yd-coalesce-probe.txt";
    var fd = syscall(2, path, 577, 420);   # open(O_WRONLY|O_CREAT|O_TRUNC, 0644)
    assert(fd >= 0, "the probe sink opens");

    var E = 64;                 # well past the 36-player overflow onset
    var tpl = mt_at(0);
    var saved_head = g_session_head;
    var saved_epfd = g_epfd;
    g_session_head = 0;
    g_epfd = 0;

    var sess = alloc(E * 8);
    var mobs = alloc(E * 8);
    var i = 0;
    while (i < E) {
        var m = mob_spawn(tpl, 0);
        store64(mobs + i * 8, m);
        var s = session_new(fd, 0);
        store64(s + SS_PHASE, PHASE_CMD);
        store64(s + SS_ROOM, 0);
        store64(s + SS_NAME_LEN, 7);
        memcpy(load64(s + SS_NAME_BUF), "loadbot", 7);
        store64(s + SS_TARGET, m);
        mi_set_target(m, s);
        session_list_push(s);
        store64(sess + i * 8, s);
        i = i + 1;
    }

    # One tick, then the single end-of-tick write pass.
    combat_tick_all();

    # Before the flush: every session must still be UNDER the cap. This is the
    # assertion the naive "just defer the flush" fix fails — at 64 co-located
    # combatants each session accumulates ~2*(E-1) third-person lines, roughly
    # 9 kB against a 4096-byte TX_CAP, and session_appendtx truncates silently
    # (it reports the short write only through a return value nobody reads).
    var pinned = 0;
    i = 0;
    while (i < E) {
        if (load64(load64(sess + i * 8) + SS_TX_LEN) >= TX_CAP) { pinned = pinned + 1; }
        i = i + 1;
    }
    assert_eq(pinned, 0, "no session is pinned at TX_CAP — the valve drained them in time");

    var flushed = flush_dirty_sessions();
    assert_eq(flushed, E, "every engaged session was written exactly once");
    assert_eq(flush_dirty_sessions(), 0, "and the dirty flags are cleared, so a second pass is free");

    # Now read back what actually reached the sink. Each engaged session emits
    # exactly one condition line per round; if any were truncated away, the count
    # comes up short. This is the user-visible property, asserted end to end.
    i = 0;
    while (i < E) {
        var s = load64(sess + i * 8);
        store64(s + SS_TARGET, 0);
        mob_remove(load64(mobs + i * 8));
        i = i + 1;
    }
    g_session_head = saved_head;
    g_epfd = saved_epfd;
    sys_close(fd);

    var cap = 1048576;
    var buf = alloc(cap);
    var n = file_read_all(path, buf, cap);
    assert(n > 0, "the sink captured the tick's output");
    assert_eq(_count_occurrences(buf, n, "[ hp "), E,
              "every session's own condition line survived the tick");

    # --- The SOLO combatant, driven through the real advance_tick.
    #
    # Two things only this case can catch. First, a lone player in a room gets
    # no broadcasts — nobody else is there to mark them dirty — so combat_flush's
    # own mark is the only thing that ever writes their round out. With 64
    # players every session is marked by somebody else's broadcast and the bug
    # hides completely. Second, this drives advance_tick rather than calling
    # combat_tick_all and the flush pass by hand, so it is the only assertion
    # that proves the flush is actually WIRED INTO the tick.
    var solo_path = "/tmp/yd-coalesce-solo.txt";
    var sfd = syscall(2, solo_path, 577, 420);
    assert(sfd >= 0, "the solo sink opens");
    saved_head = g_session_head;
    saved_epfd = g_epfd;
    g_session_head = 0;
    g_epfd = 0;

    var lone_m = mob_spawn(tpl, 0);
    var lone = session_new(sfd, 0);
    store64(lone + SS_PHASE, PHASE_CMD);
    store64(lone + SS_ROOM, 0);
    store64(lone + SS_NAME_LEN, 4);
    memcpy(load64(lone + SS_NAME_BUF), "Solo", 4);
    store64(lone + SS_TARGET, lone_m);
    mi_set_target(lone_m, lone);
    session_list_push(lone);

    advance_tick();

    store64(lone + SS_TARGET, 0);
    g_session_head = saved_head;
    g_epfd = saved_epfd;
    sys_close(sfd);

    var sn = file_read_all(solo_path, buf, cap);
    assert(sn > 0, "a solo combatant's round reaches the socket inside advance_tick");
    assert_eq(_count_occurrences(buf, sn, "[ hp "), 1,
              "with nobody else in the room to mark them dirty");
    return 0;
}

# === H15 — a partial drain compacts, so the buffer does not silently shrink. ===
fn test_tx_compaction(): i64 {
    test_group("tx-compaction");

    # Note on the setup: this constructs the post-partial-write state directly
    # rather than provoking one, because on this box it CANNOT be provoked. A
    # write of <= PIPE_BUF (4096) is atomic on both pipes and unix stream
    # sockets, and TX_CAP is exactly 4096 — so session_drain's single write
    # either completes or returns EAGAIN, and tx_off is never strictly between
    # 0 and tx_len. Only a real TCP socket does short writes at this size, which
    # is exactly what a slow player's client is. So: set the offset a TCP
    # partial write would have left, then drive the real session_drain into
    # EAGAIN against a full pipe and check what it does with that offset.
    var fds[16];
    if (syscall(293, &fds, 2048) != 0) { assert(0, "pipe2 for the backpressure probe"); return 0; }
    var rfd = load32(&fds);
    var wfd = load32(&fds + 4);

    var junk = alloc(4096);
    memset(junk, 65, 4096);
    var filled = 0;
    var guard = 0;
    while (filled == 0) {
        if (sys_write(wfd, junk, 4096) < 0) { filled = 1; }
        guard = guard + 1;
        if (guard > 4096) { filled = 1; }
    }
    assert(sys_write(wfd, junk, 16) < 0, "the pipe is full — every further write is EAGAIN");

    var s = _mk_sess("Backpressure", 12);
    store64(s + SS_FD, wfd);
    var want = 2000;
    var sent = 800;                # what a TCP short write would already have taken
    var pat = alloc(want);
    var i = 0;
    while (i < want) { store8(pat + i, 97 + (i % 26)); i = i + 1; }
    session_appendtx(s, pat, want);
    assert_eq(load64(s + SS_TX_LEN), want, "the queue starts full");
    store64(s + SS_TX_OFF, sent);

    assert_eq(session_drain(s), 1, "the drain comes back short (EAGAIN), not complete");

    var left = want - sent;
    assert_eq(load64(s + SS_TX_LEN), left, "the queue is now just the unsent remainder");
    assert_eq(load64(s + SS_TX_OFF), 0,
              "a partial drain compacts to offset 0 instead of parking dead space at the front");
    # Content, not just offsets: memcpy in the wrong direction would leave these
    # lengths looking right and the bytes garbled.
    var buf = load64(s + SS_TX_BUF);
    assert_eq(load8(buf) & 0xFF, 97 + (sent % 26), "the remainder starts exactly where the write stopped");
    assert_eq(load8(buf + left - 1) & 0xFF, 97 + ((want - 1) % 26), "and ends at the end of the queue");
    var j = 0;
    var intact = 1;
    while (j < left) {
        if ((load8(buf + j) & 0xFF) != (load8(pat + sent + j) & 0xFF)) { intact = 0; j = left; }
        else { j = j + 1; }
    }
    assert_eq(intact, 1, "and every byte between is the tail of the original queue, in order");

    # This is what the compaction buys. Without it the usable capacity is
    # TX_CAP minus the dead prefix, and it shrinks monotonically while a slow
    # client stays behind — which is precisely when the server is producing the
    # most prose.
    assert_eq(TX_CAP - load64(s + SS_TX_LEN), TX_CAP - left, "the full remaining capacity is usable again");
    assert_eq(session_appendtx(s, "tail", 4), 4, "and there is room to append after it");

    sys_close(wfd);
    sys_close(rfd);
    return 0;
}

# === H16 (1.6.8) — the autosave is metered, not fired all at once. ===
fn test_save_meter(): i64 {
    test_group("save-meter");

    # Every clock value here is SYNTHETIC. The first version of this group used
    # clock_now_ms() as `now`, which passed on a long-running desktop and failed
    # on CI — because clock_now_ms() is CLOCK_MONOTONIC, milliseconds since
    # BOOT, and a fresh runner has been up for less than the five-minute
    # interval. The test was measuring the host's uptime. Synthetic values pin
    # the rule instead, and they cover the small-uptime case on purpose.
    var uptime = 1000;                 # a host that booted one second ago
    var settled = 4000000;             # and one that has been up for over an hour

    var s = _mk_sess("Meter", 5);
    store64(s + SS_SAVE_DIRTY, 0);
    store64(s + SS_LAST_SAVE_MS, 0);
    assert_eq(save_sweep_due(s, settled), 0, "a clean session is never due");
    assert_eq(save_sweep_due(s, uptime), 0, "not even on a freshly-booted host");

    store64(s + SS_SAVE_DIRTY, 1);
    assert_eq(save_sweep_due(s, settled), 1,
              "a dirty session that has never saved is due immediately");
    # THE regression. SS_LAST_SAVE_MS == 0 is a sentinel, not a timestamp to do
    # arithmetic on: `now - 0 >= SAVE_SWEEP_MIN_MS` is a statement about how long
    # the MACHINE has been up. Relying on it meant every character created in the
    # first five minutes of uptime silently skipped the autosave.
    assert_eq(save_sweep_due(s, uptime), 1,
              "and still due when the host booted a second ago");
    assert_eq(save_sweep_due(s, 0), 1, "the never-saved sentinel does not depend on the clock at all");

    store64(s + SS_LAST_SAVE_MS, settled);
    assert_eq(save_sweep_due(s, settled), 0, "one that just saved is not due again");
    assert_eq(save_sweep_due(s, settled + SAVE_SWEEP_MIN_MS - 1), 0, "nor one millisecond early");
    assert_eq(save_sweep_due(s, settled + SAVE_SWEEP_MIN_MS), 1, "and it is due on the interval");

    # The two intervals must stay distinct: SAVE_MIN_INTERVAL_MS is the anti-burst
    # gate on the `save` verb, SAVE_SWEEP_MIN_MS is the autosave cadence.
    assert(SAVE_SWEEP_MIN_MS > SAVE_MIN_INTERVAL_MS,
           "the sweep cadence is not the verb's rate limit");
    store64(s + SS_LAST_SAVE_MS, settled);
    assert_eq(save_sweep_due(s, settled + SAVE_MIN_INTERVAL_MS + 1), 0,
              "the verb's interval is far too short to make the sweep fire");

    # --- The batch cap. This is the whole point: an unmetered sweep signed every
    # dirty session in one tick — measured at 332 ms with 256 of them, 664% of
    # the ADR 0001 budget, in a single tick that @stats reported as 0 ms drift.
    #
    # Stand up more eligible sessions than the cap and count how many the sweep
    # actually takes. SS_AUTHED is left 0 so player_save returns without touching
    # the filesystem — the cap is what is under test, not the writer.
    var saved_head = g_session_head;
    g_session_head = 0;
    var n = SAVE_BATCH_MAX + 3;
    var i = 0;
    while (i < n) {
        var t2 = _mk_sess("Batch", 5);
        store64(t2 + SS_SAVE_DIRTY, 1);
        store64(t2 + SS_LAST_SAVE_MS, 0);   # never saved → eligible on any host
        store64(t2 + SS_AUTHED, 1);
        store64(t2 + SS_NEXT, g_session_head);
        g_session_head = t2;
        i = i + 1;
    }
    assert_eq(save_sweep(), SAVE_BATCH_MAX,
              "the sweep stops at the batch cap even with more sessions due");

    # And it is a cap per tick, not a cap forever — the sessions it skipped are
    # still due, so the backlog drains on following ticks rather than starving.
    var still_due = 0;
    var w = g_session_head;
    while (w != 0) {
        if (save_sweep_due(w, settled) == 1) { still_due = still_due + 1; }
        w = load64(w + SS_NEXT);
    }
    assert_eq(still_due, n - SAVE_BATCH_MAX, "the sessions it skipped are still due next tick");

    # --- The budget counts SAVES, not sessions VISITED. Walking past an
    # ineligible session costs nothing (the whole 256-session scan measures
    # 950 ns), so a session that is not due must not consume a slot — otherwise
    # a handful of idle players at the head of the list would throttle the
    # autosave for everyone behind them, which is precisely the starvation the
    # cap is supposed to avoid.
    g_session_head = 0;
    i = 0;
    while (i < SAVE_BATCH_MAX) {              # pushed first → these end up at the TAIL
        var d = _mk_sess("Due", 3);
        store64(d + SS_SAVE_DIRTY, 1);
        store64(d + SS_LAST_SAVE_MS, 0);
        store64(d + SS_AUTHED, 1);
        store64(d + SS_NEXT, g_session_head);
        g_session_head = d;
        i = i + 1;
    }
    i = 0;
    while (i < 3) {                            # pushed last → these sit at the HEAD
        var c = _mk_sess("Idle", 4);
        store64(c + SS_SAVE_DIRTY, 0);         # not due: nothing to write
        store64(c + SS_AUTHED, 1);
        store64(c + SS_NEXT, g_session_head);
        g_session_head = c;
        i = i + 1;
    }
    assert_eq(save_sweep(), SAVE_BATCH_MAX,
              "sessions that are not due are walked past without spending budget");

    g_session_head = saved_head;
    return 0;
}

# === H17 (1.6.8) — the record encoder allocates nothing, and encodes the ===
# === same bytes lib/sigil_hex.cyr does.                                  ===
fn test_hex_identity(): i64 {
    test_group("hex-identity");
    persist_init();

    # BYTE-IDENTITY FIRST. _hex_at writes into the SIGNED PREFIX of every save
    # record. A single character of divergence from hex_encode — uppercase, a
    # different digit base, an off-by-one — makes every record already on disk
    # fail its own Ed25519 check at the owner's next login: they are told the
    # record was tampered with, a false SEV_SECURITY entry is written, and the
    # character is gone. So this is asserted directly against the library
    # encoder rather than by rereading the constants.
    var probe = alloc(256);
    var i = 0;
    while (i < 256) { store8(probe + i, i); i = i + 1; }     # every byte value

    var lens = alloc(6 * 8);
    store64(lens + 0,  1); store64(lens + 8,  2);  store64(lens + 16, 15);
    store64(lens + 24, SALT_LEN); store64(lens + 32, PK_LEN); store64(lens + 40, SIG_LEN);
    # Every length is encoded from SEVERAL start offsets. This is not padding:
    # the real save lengths are all <= 64, so slicing only from offset 0 encodes
    # bytes 0x00-0x3F and never produces a HIGH nibble >= 10 — the `a`-`f`
    # branch for the high nibble is then never executed, and an encoder that
    # emitted uppercase there would pass a test that claims to cover "every byte
    # value". (It did. That is why these offsets are here.)
    var offs = alloc(4 * 8);
    store64(offs + 0, 0); store64(offs + 8, 100); store64(offs + 16, 160); store64(offs + 24, 192);
    var li = 0;
    var mismatches = 0;
    var saw_high_nibble = 0;
    while (li < 6) {
        var n = load64(lens + li * 8);
        var oi = 0;
        while (oi < 4) {
            var base = load64(offs + oi * 8);
            if (base + n > 256) { base = 256 - n; }
            var src = probe + base;
            var j = 0;
            while (j < n) {
                if (((load8(src + j) & 0xFF) >> 4) >= 10) { saw_high_nibble = 1; }
                j = j + 1;
            }
            var want = hex_encode(src, n);            # the library encoder
            var end = _hex_at(0, src, n);             # ours, into g_persist_save
            if (end != n * 2) { mismatches = mismatches + 1; }
            var k = 0;
            while (k < n * 2) {
                if ((load8(g_persist_save + k) & 0xFF) != (load8(want + k) & 0xFF)) {
                    mismatches = mismatches + 1;
                    k = n * 2;
                } else { k = k + 1; }
            }
            oi = oi + 1;
        }
        li = li + 1;
    }
    assert_eq(saw_high_nibble, 1, "the probe actually reaches bytes with a high nibble >= 10");
    assert_eq(mismatches, 0, "_hex_at agrees with hex_encode byte-for-byte, over every byte value");

    # Offset-preserving: it must return exactly where it stopped writing, or the
    # signed prefix length is wrong even when the bytes are right.
    assert_eq(_hex_at(7, probe, 4), 7 + 8, "it advances the offset by two per byte");
    # And it inherits the M11-D overflow discipline rather than writing past the cap.
    assert_eq(_sv_bad(_hex_at(SAVE_CAP - 3, probe, 32)), 1, "an overflowing encode poisons the offset");
    assert_eq(_sv_bad(_hex_at(SAVE_ERR, probe, 4)), 1, "and an already-poisoned offset stays poisoned");

    # THE LEAK ITSELF. _build_record used to hand out 248 bytes of bump arena
    # per call — alloc() has no free, so that is permanent. A hard zero is the
    # right assertion here: it is immune to libro or str.cyr drifting by a few
    # bytes, which a "under N bytes" ceiling would not be.
    var s = _mk_sess("HexHero", 7);
    var hsalt = alloc(SALT_LEN);
    var q = 0;
    while (q < SALT_LEN) { store8(hsalt + q, 200 + q); q = q + 1; }
    var hblk = sess_ident(s);
    memcpy(hblk, hsalt, SALT_LEN);
    ident_derive(hsalt, "hexpassphrase", 13, hblk + IDENT_SK, hblk + IDENT_PK);
    store64(hblk + IDENT_CREATED, 999);
    store64(s + SS_ROOM, 0 - 1);
    store64(s + SS_HP, 20); store64(s + SS_MAXHP, 20);
    store64(s + SS_AUTHED, 1);

    var before = alloc_used();
    var r = 0;
    while (r < 20) { _build_record(s); r = r + 1; }
    assert_eq(alloc_used() - before, 0, "_build_record allocates nothing at all");

    # And the record it builds still verifies under its own signature — the
    # assertion that says out loud that the bytes did not move. A wrong hex case
    # passes the leak check above and fails this one; that is the point of
    # having both.
    assert_eq(player_save(s), 1, "the character saves");
    var s2 = _mk_sess("HexHero", 7);
    assert_eq(player_auth_load(s2, "hexpassphrase", 13), 1,
              "and the record still verifies under its own signature");
    # --- F7: the idle reap is metered. drop_session's first act is a full
    # player_save (1.30 ms, 89% ed25519_sign), and H16 capped save_sweep at 4
    # per tick for exactly that reason — sweep_idle could do 256 of them in one
    # pass, in the same tick, and nothing bounded it. A restart puts everyone on
    # the same deadline, so no attacker is needed.
    var rh = g_session_head;
    g_session_head = 0;
    var n = IDLE_REAP_MAX + 3;
    var j = 0;
    while (j < n) {
        var idl = _freeable_sess();
        store64(idl + SS_LAST_MS, 0);          # long past the idle deadline
        store64(idl + SS_NEXT, g_session_head);
        g_session_head = idl;
        j = j + 1;
    }
    assert_eq(_sess_list_len(), n, "all of them are on the list");
    assert_eq(sweep_idle(0, g_idle_timeout_ms + 1000000), IDLE_REAP_MAX,
              "one tick reaps at most IDLE_REAP_MAX sessions");
    assert_eq(_sess_list_len(), n - IDLE_REAP_MAX, "and the rest are still connected");
    # Not a stall — successive ticks drain the backlog.
    var guard = 0;
    while (_sess_list_len() > 0) {
        sweep_idle(0, g_idle_timeout_ms + 1000000);
        guard = guard + 1;
        if (guard > 100) { g_session_head = 0; }
    }
    assert(guard <= 100, "successive ticks reap the whole backlog");
    g_session_head = rh;

    # --- F5: secret-key material is WIPED before it goes back to the freelist.
    # lib/freelist.cyr hands a freed block to the next fl_alloc of that size
    # class without zeroing it, and SS_IDENT holds the live Ed25519 secret key
    # for the whole session. Reading the block after the free is exactly the
    # exposure under test: it is freed-but-mapped, which is precisely what the
    # next allocation would receive.
    # _freeable_sess, not _tx_sess: session_free closes SS_FD (0 from a memset
    # is stdin) and telnet_state_frees SS_TS (0 dereferences null). Both bit.
    var ks2 = _freeable_sess();
    var kblk = sess_ident(ks2);
    var kcand = sess_cand(ks2);          # the mid-`passwd` candidate, also secret
    var b = 0;
    while (b < IDENT_LEN) { store8(kblk + b, 0xAA); b = b + 1; }   # "secret" bytes
    b = 0;
    while (b < CAND_LEN) { store8(kcand + b, 0xBB); b = b + 1; }
    session_free(ks2);
    var residue = 0;
    b = 0;
    while (b < IDENT_LEN) {
        if ((load8(kblk + b) & 0xFF) != 0) { residue = residue + 1; }
        b = b + 1;
    }
    assert_eq(residue, 0, "the live ident block is zeroed before it returns to the freelist");
    # The 1.6.4 entry claimed the candidate was "wiped and freed on commit, on
    # both rewinds, and in session_free". Three of those four were true.
    var cres = 0;
    b = 0;
    while (b < CAND_LEN) {
        if ((load8(kcand + b) & 0xFF) != 0) { cres = cres + 1; }
        b = b + 1;
    }
    assert_eq(cres, 0, "and so is the passwd candidate, as 1.6.4 always claimed");

    return 0;
}

# === H18 (1.6.9) — `examine` on a zone-less server was a remote crash. ===
fn test_roomless_safety(): i64 {
    test_group("roomless-safety");

    # The predicate first: it checks the INDEX, not just the count. The count
    # alone does not tell you the session's own room is in range.
    var s = _mk_sess("Roomless", 8);
    store64(s + SS_ROOM, 0 - 1);
    assert_eq(session_room_ok(s), 0, "an unplaced session (-1) is not in a valid room");
    store64(s + SS_ROOM, 0);
    assert_eq(session_room_ok(s), 1, "room 0 of a loaded zone is valid");
    store64(s + SS_ROOM, g_room_count);
    assert_eq(session_room_ok(s), 0, "one past the last room is not");
    store64(s + SS_ROOM, g_room_count + 1000);
    assert_eq(session_room_ok(s), 0, "and neither is far past it");

    # The crash itself. On a server whose zone failed to load, g_rooms is 0 and
    # every logged-in session sits at SS_ROOM = -1 — so `room_at(-1)` computes
    # g_rooms + (-1 * RM_SIZE) = -240 and dereferencing it killed the process.
    # Reproduced live before the fix: `look`, `get`, `kill` and `exits` all
    # answered politely and `examine thing` took the server down.
    #
    # This test SEGFAULTS the whole binary if the guard is removed, which is
    # exactly the right failure mode for a crash regression.
    var saved_count = g_room_count;
    var saved_rooms = g_rooms;
    g_room_count = 0;
    g_rooms = 0;
    store64(s + SS_ROOM, 0 - 1);
    store64(s + SS_PHASE, PHASE_CMD);

    var pa = parser_new();
    _tx_reset(s);
    parse_lit(pa, "examine thing");
    cmd_examine(s, pa);
    assert_eq(_contains(load64(s + SS_TX_BUF), load64(s + SS_TX_LEN), "You see no"), 1,
              "examine answers instead of dereferencing a room that does not exist");

    # `examine me` must still work with no zone — it needs no room at all.
    _tx_reset(s);
    parse_lit(pa, "examine me");
    cmd_examine(s, pa);
    assert_eq(_contains(load64(s + SS_TX_BUF), load64(s + SS_TX_LEN), "You are"), 1,
              "and the character sheet still renders without a world");

    # A CARRIED object is still examinable without a room: the guard covers the
    # room lookup only, not the whole command.
    g_room_count = saved_count;
    g_rooms = saved_rooms;
    var carried = item_new(ot_at(0));
    g_room_count = 0;
    g_rooms = 0;
    store64(s + SS_INV, carried);
    var ckw = _kw1(oi_kw_ptr(carried), alloc(64));
    var cmd = alloc(128);
    var co = _str_into(cmd, 0, "examine ");
    co = _str_into(cmd, co, ckw);
    _tx_reset(s);
    parser_parse(pa, cmd, co);
    cmd_examine(s, pa);
    assert_eq(_contains(load64(s + SS_TX_BUF), load64(s + SS_TX_LEN), "You see no"), 0,
              "an item in hand is examinable with no zone loaded");

    g_room_count = saved_count;
    g_rooms = saved_rooms;
    store64(s + SS_INV, 0);
    obj_free(carried);
    assert(g_room_count > 0, "the world is restored for the groups that follow");
    return 0;
}

# Build an unauthenticated session with `nlines` queued in its rx buffer. This
# is the shape of the E2 pre-auth flood: bytes already off the socket, epoll
# quiet, only the tick still touching it.
#
# The queued lines are INVALID NAMES parked in PHASE_NAME, deliberately. An
# invalid name re-prompts and never sets SS_QUIT (session.cyr's login_on_name),
# so the session survives every pass and the budget is what is under test. The
# first draft used mismatched passphrases — which now trips the E3 creation cap,
# whereupon E1 frees the session mid-walk and this harness reads a freed pointer
# out of its own array. That is E1 and E3 working exactly as intended; it is not
# what this test is measuring.
fn _armed_rx_sess(nlines): i64 {
    var s = _tx_sess();
    store64(s + SS_LINE_BUF, fl_alloc(LINE_CAP));
    store64(s + SS_NAME_BUF, fl_alloc(NAME_CAP));
    store64(s + SS_TS, telnet_state_new());
    store64(s + SS_FD, 0 - 1);
    store64(s + SS_PHASE, PHASE_NAME);
    var rx = fl_alloc(RX_CAP);
    store64(s + SS_RX_BUF, rx);
    var o = 0;
    var line = 0;
    while (line < nlines) {
        if (o > RX_CAP - 8) { line = nlines; continue; }
        store8(rx + o, 33); o = o + 1;      # '!' — never a valid name
        store8(rx + o, 33); o = o + 1;
        store8(rx + o, 13); o = o + 1;      # CR
        line = line + 1;
    }
    store64(s + SS_RX_LEN, o);
    return s;
}

# Like _armed_rx_sess, but parked in PHASE_PASS against a name that HAS a record,
# with `nlines` wrong-passphrase lines queued. That is the costliest line an
# unauthenticated peer can queue, and the one 1.7.0's charge window is sized
# against. Each queued line is >= PASS_MIN so it survives the H5 (1.6.2) length
# pre-check and actually reaches the identity comparison — a line rejected on
# length costs nothing and would make the test vacuous.
#
# Unlike the passphrase-MISMATCH creation path, a wrong passphrase on the
# RETURNING path is capped by MAX_LOGIN_FAILS rather than freeing the session
# mid-walk, so nlines must stay at or below that cap for the session to survive
# the walk being measured. See _armed_rx_sess's note for the freed-pointer
# hazard this avoids.
fn _armed_pass_sess(name, nl, nlines): i64 {
    var s = _tx_sess();
    store64(s + SS_LINE_BUF, fl_alloc(LINE_CAP));
    var nmb = fl_alloc(NAME_CAP);
    memcpy(nmb, name, nl);
    store64(s + SS_NAME_BUF, nmb);
    store64(s + SS_NAME_LEN, nl);
    store64(s + SS_TS, telnet_state_new());
    store64(s + SS_FD, 0 - 1);
    store64(s + SS_ROOM, 0 - 1);
    store64(s + SS_PHASE, PHASE_PASS);
    var rx = fl_alloc(RX_CAP);
    store64(s + SS_RX_BUF, rx);
    var o = 0;
    var line = 0;
    while (line < nlines) {
        if (o > RX_CAP - 16) { line = nlines; continue; }
        var k = 0;
        while (k < 11) { store8(rx + o, 119 + (line % 2)); o = o + 1; k = k + 1; }
        store8(rx + o, 13); o = o + 1;      # CR
        line = line + 1;
    }
    store64(s + SS_RX_LEN, o);
    return s;
}

# A session with every buffer session_free will try to release. Anything that
# reaches drop_session MUST be built this way: session_free calls
# telnet_state_free(SS_TS) unconditionally, and a 0 there dereferences null —
# and sock_close(SS_FD) on the 0 a memset leaves would close fd 0.
fn _freeable_sess(): i64 {
    var s = _tx_sess();
    store64(s + SS_FD, 0 - 1);
    store64(s + SS_TS, telnet_state_new());
    store64(s + SS_RX_BUF, fl_alloc(RX_CAP));
    store64(s + SS_LINE_BUF, fl_alloc(LINE_CAP));
    store64(s + SS_NAME_BUF, fl_alloc(NAME_CAP));
    return s;
}

# Length of the active-session list.
fn _sess_list_len(): i64 {
    var n = 0;
    var s = g_session_head;
    while (s != 0) { n = n + 1; s = load64(s + SS_NEXT); }
    return n;
}

# === E1 + E2 (1.6.10) — the tick honours SS_QUIT and the drain has a budget. ===
fn test_preauth_scale(): i64 {
    test_group("preauth-scale");

    # --- E2: drain_pending_rx spends a budget SHARED across the whole session
    # list, not RX_MAX_LINES per session. Stand up more sessions than the budget
    # can service in one tick and count how many lines actually got dispatched.
    var saved_head = g_session_head;
    var saved_epfd = g_epfd;
    g_session_head = 0;
    g_epfd = 0;

    var NS = 40;                 # far more sessions than DRAIN_LINES_MAX
    var i = 0;
    # alloc, not `var sessions[NS * 8]` — a `var buf[N]` declaration is N BYTES,
    # and getting that wrong here smashed the stack (it is the first line of
    # CLAUDE.md's Key Principles for a reason).
    var sessions = alloc(NS * 8);
    while (i < NS) {
        var s = _armed_rx_sess(20);
        store64(sessions + i * 8, s);
        store64(s + SS_NEXT, g_session_head);
        g_session_head = s;
        i = i + 1;
    }

    # One tick's worth of draining. The aggregate lines consumed must not exceed
    # the budget — the whole finding was that it was sessions x RX_MAX_LINES.
    var before_total = 0;
    i = 0;
    while (i < NS) { before_total = before_total + load64(load64(sessions + i * 8) + SS_RX_LEN); i = i + 1; }
    drain_pending_rx();
    var after_total = 0;
    i = 0;
    while (i < NS) { after_total = after_total + load64(load64(sessions + i * 8) + SS_RX_LEN); i = i + 1; }

    # Each dispatched line is 3 rx bytes ("!!" + CR), so the byte delta is an
    # exact proxy for lines spent.
    var drained_bytes = before_total - after_total;
    assert(drained_bytes > 0, "the drain made progress");
    # Unbudgeted, all 40 sessions would each lose up to RX_MAX_LINES lines in one
    # tick — 320 lines. Budgeted, at most DRAIN_LINES_MAX move across the lot.
    assert(drained_bytes <= DRAIN_LINES_MAX * 3,
           "the tick spent at most DRAIN_LINES_MAX lines across ALL sessions");
    # And it is not a stall: repeated ticks eventually clear the whole list.
    var guard = 0;
    while (after_total > 0) {
        drain_pending_rx();
        after_total = 0;
        i = 0;
        while (i < NS) { after_total = after_total + load64(load64(sessions + i * 8) + SS_RX_LEN); i = i + 1; }
        guard = guard + 1;
        if (guard > 10000) { after_total = 0; }
    }
    assert(guard <= 10000, "the whole backlog drains across successive ticks");

    # --- E1: a session marked SS_QUIT is torn down by the tick, not left to be
    # fed forever. This is what made MAX_LOGIN_FAILS a no-op: SS_QUIT was only
    # honoured on the epoll event path, so a silent socket kept its condemned
    # session alive and being charged 8 keypair derivations a tick.
    var q = _armed_rx_sess(20);
    store64(q + SS_QUIT, 1);
    store64(q + SS_NEXT, 0);
    g_session_head = q;
    # A fresh telnet parser and no real fd — drop_session frees the session, so
    # everything it owns must be owned solely by it (as _armed_rx_sess builds it).
    assert_eq(_sess_list_len(), 1, "the condemned session is on the list");
    drain_pending_rx();
    assert_eq(_sess_list_len(), 0, "a SS_QUIT session is dropped by the tick, not fed by it");

    # --- The caller-supplied cap itself. Above only exercises take == 8, since
    # DRAIN_LINES_MAX is a multiple of RX_MAX_LINES — so the parameter would look
    # honoured even if it were ignored. Drive it directly with a cap BELOW
    # RX_MAX_LINES, which is the case the last session of a partly-spent budget
    # actually hits.
    var c = _armed_rx_sess(20);
    var fired[8];
    session_consume_rx_max(c, 3, &fired);
    assert_eq(load64(&fired), 3, "a cap below RX_MAX_LINES is honoured exactly");
    session_consume_rx_max(c, 1, &fired);
    assert_eq(load64(&fired), 1, "and so is a cap of one");
    session_consume_rx_max(c, RX_MAX_LINES, &fired);
    assert_eq(load64(&fired), RX_MAX_LINES, "the full slice still fires RX_MAX_LINES");
    # A cap of zero must consume nothing, not fall through to the default.
    var before_len = load64(c + SS_RX_LEN);
    session_consume_rx_max(c, 0, &fired);
    assert_eq(load64(&fired), 0, "a zero cap dispatches nothing");
    assert_eq(load64(c + SS_RX_LEN), before_len, "and leaves the buffer untouched");

    g_session_head = saved_head;
    g_epfd = saved_epfd;
    return 0;
}

# === E3 + E4 (1.6.10) — the character-creation path is bounded and exclusive. ===
fn test_create_guards(): i64 {
    test_group("create-guards");
    persist_init();

    # Start from a clean slate: this group SAVES a record for "Createling" (that
    # is the point of the last case), so without this the second run of the
    # suite finds the record already on disk, E4's player_exists re-test refuses
    # the very first creation, and five assertions fail. Passed once, failed
    # forever after — a test that is not idempotent is a landmine.
    _player_unlink("Createling", 10);   # unlink(2); absent is fine

    # A session parked mid-creation: identity forged by the newpass step, waiting
    # on the confirm line. login_on_confirm re-derives from what it is given and
    # compares public keys — the passphrase itself is never stored.
    var saved_head = g_session_head;
    g_session_head = 0;

    var s = _mk_sess("Createling", 10);
    store64(s + SS_LINE_BUF, fl_alloc(LINE_CAP));
    store64(s + SS_FD, 0 - 1);
    store64(s + SS_PHASE, PHASE_CONFIRMPASS);
    var blk = sess_ident(s);
    var salt = alloc(SALT_LEN);
    var q = 0;
    while (q < SALT_LEN) { store8(salt + q, 11 + q); q = q + 1; }
    memcpy(blk, salt, SALT_LEN);
    ident_derive(blk, "rightphrase", 11, blk + IDENT_SK, blk + IDENT_PK);

    # --- E3: every mismatched confirm costs a counted attempt, and the fifth
    # closes the session. Unbounded before 1.6.10: each mismatch is TWO Ed25519
    # keypair derivations (~2.16 ms) for ten bytes of input, with no counter, no
    # rate limit and — alone among the failure paths here — no audit trail.
    var i = 0;
    while (i < MAX_LOGIN_FAILS - 1) {
        _tx_reset(s);
        login_on_confirm(s, "wrongphrase", 11);
        assert_eq(load64(s + SS_FAILS), i + 1, "a mismatched confirm counts an attempt");
        assert_eq(load64(s + SS_QUIT), 0, "and does not close the session early");
        i = i + 1;
    }
    _tx_reset(s);
    login_on_confirm(s, "wrongphrase", 11);
    assert_eq(load64(s + SS_FAILS), MAX_LOGIN_FAILS, "the cap is reached");
    assert_eq(load64(s + SS_QUIT), 1, "and MAX_LOGIN_FAILS closes the creation session");
    assert_eq(load64(s + SS_AUTHED), 0, "a capped-out session is never sealed");
    assert_eq(_contains(load64(s + SS_TX_BUF), load64(s + SS_TX_LEN), "Too many failed"), 1,
              "and it is told why");

    # A CORRECT confirm on a fresh session seals it and clears the counter, so
    # the cap cannot leak across a successful creation.
    var ok = _mk_sess("Createling", 10);
    store64(ok + SS_LINE_BUF, fl_alloc(LINE_CAP));
    store64(ok + SS_FD, 0 - 1);
    store64(ok + SS_PHASE, PHASE_CONFIRMPASS);
    var okblk = sess_ident(ok);
    memcpy(okblk, salt, SALT_LEN);
    ident_derive(okblk, "rightphrase", 11, okblk + IDENT_SK, okblk + IDENT_PK);
    store64(ok + SS_FAILS, 3);
    _tx_reset(ok);
    login_on_confirm(ok, "rightphrase", 11);
    assert_eq(load64(ok + SS_AUTHED), 1, "a matching confirm seals the identity");
    assert_eq(load64(ok + SS_FAILS), 0, "and resets the attempt counter");
    assert_eq(load64(ok + SS_QUIT), 0, "and does not close the session");

    # --- E4: the same name must not be sealed twice concurrently. H11 (1.6.6)
    # refused a second LOGIN for an existing character but left creation open,
    # and the window is not a race — it is the whole passphrase + confirm +
    # class-prompt sequence. Both sessions would forge DIFFERENT keypairs and
    # both write the record, so the last writer's passphrase became the only one
    # that opened the account.
    store64(ok + SS_NEXT, 0);
    g_session_head = ok;                       # `ok` is authed and holds the name
    var rival = _mk_sess("Createling", 10);
    store64(rival + SS_LINE_BUF, fl_alloc(LINE_CAP));
    store64(rival + SS_FD, 0 - 1);
    store64(rival + SS_PHASE, PHASE_CONFIRMPASS);
    var rblk = sess_ident(rival);
    var rsalt = alloc(SALT_LEN);
    q = 0;
    while (q < SALT_LEN) { store8(rsalt + q, 200 + q); q = q + 1; }
    memcpy(rblk, rsalt, SALT_LEN);
    ident_derive(rblk, "rivalphrase", 11, rblk + IDENT_SK, rblk + IDENT_PK);
    _tx_reset(rival);
    login_on_confirm(rival, "rivalphrase", 11);
    assert_eq(load64(rival + SS_AUTHED), 0,
              "a second concurrent creation of the same name is refused");
    assert_eq(load64(rival + SS_QUIT), 1, "and the rival session is closed");
    assert_eq(_contains(load64(rival + SS_TX_BUF), load64(rival + SS_TX_LEN), "just taken"), 1,
              "and told the name was taken, not silently overwritten");
    assert_eq(load64(ok + SS_AUTHED), 1, "the session that got there first is untouched");

    # The other half of the window: the first creator finished and DISCONNECTED
    # while the rival was still typing. No session holds the name any more, so
    # session_already_online cannot see it — only the record on disk can. That is
    # what the player_exists re-test is for, and it is a distinct path.
    store64(ok + SS_ROOM, 0 - 1);
    store64(ok + SS_HP, 10); store64(ok + SS_MAXHP, 10);
    assert_eq(player_save(ok), 1, "the first creator's record reaches disk");
    g_session_head = 0;                        # ...and then they disconnect
    assert_eq(session_already_online("Createling", 10, 0), 0,
              "no live session holds the name any more");

    var late = _mk_sess("Createling", 10);
    store64(late + SS_LINE_BUF, fl_alloc(LINE_CAP));
    store64(late + SS_FD, 0 - 1);
    store64(late + SS_PHASE, PHASE_CONFIRMPASS);
    var lblk = sess_ident(late);
    var lsalt = alloc(SALT_LEN);
    q = 0;
    while (q < SALT_LEN) { store8(lsalt + q, 77 + q); q = q + 1; }
    memcpy(lblk, lsalt, SALT_LEN);
    ident_derive(lblk, "latephrase", 10, lblk + IDENT_SK, lblk + IDENT_PK);
    _tx_reset(late);
    login_on_confirm(late, "latephrase", 10);
    assert_eq(load64(late + SS_AUTHED), 0,
              "a creation that would overwrite an existing record is refused");
    assert_eq(load64(late + SS_QUIT), 1, "and that session is closed too");

    g_session_head = saved_head;
    return 0;
}

# === E5 (1.6.10) — the reset counts the whole world, not one room's floor. ===
fn test_object_maxexist(): i64 {
    test_group("object-maxexist");
    if (g_room_count == 0)    { assert(0, "maxexist: needs a loaded world"); return 0; }
    if (g_obj_tpl_count == 0) { assert(0, "maxexist: needs object templates"); return 0; }

    # Take the first id room 0 authors, and start from a fully-stocked world.
    var sp = room_objspawn(room_at(0));
    if (sp == 0) { assert(0, "maxexist: room 0 authors no objects"); return 0; }
    var p = str_data(sp);
    var idlen = 0;
    while (idlen < str_len(sp)) {
        if ((load8(p + idlen) & 0xFF) == 32) { idlen = str_len(sp); }
        else { idlen = idlen + 1; }
    }
    if (idlen > str_len(sp)) { idlen = str_len(sp); }

    zone_reset_objs();                       # top the world up to the ceiling
    var authored = _obj_id_authored_count(p, idlen);
    assert(authored >= 1, "the id is authored somewhere");
    assert_eq(_obj_id_world_count(p, idlen), authored,
              "a freshly-reset world holds exactly the authored count");
    assert_eq(zone_reset_objs(), 0, "and a second reset mints nothing");

    # --- The 1.6.7 driver: hide the instance inside a container, in its own
    # room. The old scan walked oi_next and never descended OI_CONTENTS, so the
    # room read as empty and the reset minted a duplicate — once per cycle,
    # forever. Reproduced live before the fix (`@reset` reported `objs +1`).
    var slot = room_at(0) + RM_OBJ_HEAD;
    # Find the instance carrying THIS authored id, by id — not by keyword.
    # (ilist_find_kw_nth with a zero-length noun matches nothing: kw_matches
    # returns 0 for nlen <= 0. Using it here silently selected nothing and left
    # three mutations undetected, which is how this was caught.)
    var target = 0;
    var scan = load64(slot);
    while (scan != 0) {
        if (_oi_id_eq(scan, p, idlen) == 1) { target = scan; scan = 0; }
        else { scan = oi_next(scan); }
    }
    assert(target != 0, "room 0 holds an instance of its own authored id");
    var box = item_new(ot_at(1));
    ilist_push(slot, box);
    if (target != 0) {
        ilist_remove(slot, target);
        ilist_push(box + OI_CONTENTS, target);
    }
    # The instance is now INSIDE box, so nothing of that id is on the room's
    # top level. A scan that walks only oi_next therefore returns 0 here; one
    # that descends OI_CONTENTS returns 1. That difference is the whole bug.
    assert_eq(_obj_id_count_list(load64(slot), p, idlen), 1,
              "the room count descends into containers to find the hidden instance");
    assert_eq(_obj_id_world_count(p, idlen), authored,
              "hiding an instance in a container does not make it vanish from the count");
    assert_eq(zone_reset_objs(), 0, "so the reset does NOT mint a duplicate");

    # --- The OTHER driver, and the one the world-wide ceiling exists for:
    # carry the object to a DIFFERENT room and leave it there. Room 0's own
    # scan now reads zero however thoroughly it descends, so only a world-wide
    # count can tell "relocated" from "gone". Without the ceiling the reset
    # mints a duplicate here — the pre-existing growth path, named verbatim in
    # server.cyr's H11 comment.
    if (g_room_count > 1) {
        ilist_remove(box + OI_CONTENTS, target);
        var away = room_at(1) + RM_OBJ_HEAD;
        ilist_push(away, target);
        assert_eq(_obj_id_count_list(load64(slot), p, idlen), 0, "room 0 no longer holds one");
        assert_eq(_obj_id_world_count(p, idlen), authored, "but the world still does");
        assert_eq(zone_reset_objs(), 0, "so the reset does NOT mint a replacement");
        # Put it back where the rest of this group expects it.
        ilist_remove(away, target);
        ilist_push(box + OI_CONTENTS, target);
    }

    # --- The pre-existing driver: an instance genuinely leaves the world. The
    # population is short, so the zone SHOULD restock — the max-exist rule must
    # not turn into "never respawn anything".
    if (target != 0) {
        ilist_remove(box + OI_CONTENTS, target);
        obj_free(target);
        assert_eq(_obj_id_world_count(p, idlen), authored - 1, "the world is one short");
        assert_eq(zone_reset_objs(), 1, "and the reset restocks exactly one");
        assert_eq(_obj_id_world_count(p, idlen), authored, "back to the authored ceiling");
    }

    # A player carrying one counts too — otherwise logging in with an authored
    # item in hand would restock the world for free, which is the same
    # duplication by another route.
    var carried = 0;
    scan = load64(slot);
    while (scan != 0) {
        if (_oi_id_eq(scan, p, idlen) == 1) { carried = scan; scan = 0; }
        else { scan = oi_next(scan); }
    }
    if (carried != 0) {
        var saved_head = g_session_head;
        var holder = _mk_sess("Holder", 6);
        ilist_remove(slot, carried);
        ilist_push(holder + SS_INV, carried);
        store64(holder + SS_NEXT, 0);
        g_session_head = holder;
        assert_eq(_obj_id_world_count(p, idlen), authored,
                  "an item in a player's inventory still counts against the ceiling");
        # Put it back so the world is left exactly as this group found it.
        ilist_remove(holder + SS_INV, carried);
        ilist_push(slot, carried);
        g_session_head = saved_head;
    }

    ilist_remove(slot, box);
    obj_free(box);
    assert_eq(_obj_id_world_count(p, idlen), authored, "the world is left at the ceiling");
    return 0;
}

# === E6 (1.6.10) — a stun decays even when nobody is fighting the mob. ===
fn test_stun_decay(): i64 {
    test_group("stun-decay");
    if (g_mob_tpl_count == 0) { assert(0, "stun-decay: needs a mob template"); return 0; }

    var tpl = mt_at(0);
    var m = mob_spawn(tpl, 0);
    var saved_head = g_session_head;
    g_session_head = 0;                     # nobody engaged with it at all

    # Stun it the way `emp` does, then run ticks with no player anywhere near.
    # Before 1.6.10 stun was decremented ONLY inside the player-versus-target
    # round, so this mob stayed stunned forever: _mob_can_act returns 0 while
    # MI_STUN is positive, so it never wandered, never assisted and never fought
    # again — permanently inert furniture wherever a player last used bash or emp.
    mi_set_stun(m, 2);
    mob_tick_all(g_tick_count + 1);
    assert_eq(mi_stun(m), 1, "an unengaged stunned mob sheds a point per tick");
    mob_tick_all(g_tick_count + 2);
    assert_eq(mi_stun(m), 0, "and reaches zero");
    assert_eq(_mob_can_act(m), 1, "so it can act again");

    # It must not go negative, and a mob that is not stunned is untouched.
    mob_tick_all(g_tick_count + 3);
    assert_eq(mi_stun(m), 0, "a mob with no stun stays at zero");

    # Exactly one point per tick, not two: mob_tick_all walks EVERY mob, so if
    # combat.cyr still decayed as well an engaged mob would lose both points in
    # a single tick and `emp` would be worth half what it says.
    mi_set_stun(m, 2);
    mob_tick_all(g_tick_count + 4);
    assert_eq(mi_stun(m), 1, "one point per tick, never two");

    # --- And the engaged case, through the REAL advance_tick. This is the one
    # that catches a double decay: mob_tick_all walks every mob including the
    # player's current target, so if combat.cyr still decremented as well, an
    # engaged mob would shed two points a tick and `emp` would be worth half
    # what it claims. Only a live combat round can see that.
    var s = _mk_sess("Stunner", 7);
    store64(s + SS_ROOM, 0);
    store64(s + SS_PHASE, PHASE_CMD);
    store64(s + SS_FD, 0 - 1);
    store64(s + SS_HP, 500); store64(s + SS_MAXHP, 500);
    store64(s + SS_NDICE, 1); store64(s + SS_DSIZE, 1); store64(s + SS_DMOD, 0);
    var em = mob_spawn(tpl, 0);
    mi_set_hp(em, 5000);                    # survives the round, so the tick is clean
    store64(s + SS_TARGET, em);
    mi_set_target(em, s);
    store64(s + SS_NEXT, 0);
    g_session_head = s;
    obs_init();

    mi_set_stun(em, 2);
    advance_tick();
    assert_eq(mi_stun(em), 1, "an ENGAGED mob sheds exactly one point per tick, not two");
    advance_tick();
    assert_eq(mi_stun(em), 0, "and reaches zero on the next");

    store64(s + SS_TARGET, 0);
    mi_set_target(em, 0);
    mob_remove(em);
    g_session_head = 0;

    mi_set_stun(m, 0);
    mob_remove(m);
    g_session_head = saved_head;
    return 0;
}

# === 1.6.11 — the tail the re-run left. ===
fn test_tail_guards(): i64 {
    test_group("tail-guards");

    # --- F2: world_start_room must not name a room in a zero-room world. It
    # returned g_start_room unconditionally, and that is 0 both by default and
    # after H9 zeroes it on a rejected load — a valid-LOOKING index into a null
    # table, which every `room >= 0` guard downstream then reads as "placed".
    var saved_count = g_room_count;
    var saved_rooms = g_rooms;
    var saved_start = g_start_room;
    assert(world_start_room() >= 0, "a loaded world has a real start room");
    g_room_count = 0;
    g_rooms = 0;
    g_start_room = 0;
    assert_eq(world_start_room(), 0 - 1, "a zero-room world reports UNPLACED, not room 0");
    g_room_count = saved_count;
    g_rooms = saved_rooms;
    g_start_room = saved_start;

    # --- F3: a token's recorded length must equal the bytes actually stored.
    # pa_emit_byte stores nothing once the norm buffer is full and returns 0;
    # the count advanced anyway, so tok_len outran the buffer and every consumer
    # — tok_eq, qual_parse, kw_matches, session_appendtx_tok — read past it.
    var pa = parser_new();
    var big = alloc(LINE_CAP + 64);
    var i = 0;
    while (i < LINE_CAP) { store8(big + i, 97 + (i % 26)); i = i + 1; }
    # Drive the parser PAST NORM_CAP directly. A normal line cannot do this —
    # LINE_CAP == NORM_CAP, which is the load-bearing invariant that keeps the
    # defect latent — so the test hands parser_parse a longer buffer than any
    # socket line could produce. That is the parser's own robustness contract,
    # and it is the only way to reach the saturating branch.
    var huge = alloc(NORM_CAP + 512);
    i = 0;
    while (i < NORM_CAP + 400) { store8(huge + i, 97 + (i % 26)); i = i + 1; }
    parser_parse(pa, huge, NORM_CAP + 400);
    var tn = parser_count(pa);
    var over = 0;
    var total = 0;
    var k = 0;
    while (k < tn) {
        if (tok_len(pa, k) > NORM_CAP) { over = over + 1; }
        total = total + tok_len(pa, k);
        k = k + 1;
    }
    assert_eq(over, 0, "no single token claims more bytes than the norm buffer holds");
    assert(total <= NORM_CAP, "and the tokens together never claim more than was stored");

    # --- F4: a parser token is player-typed, so it goes through the sanitizer.
    # telnet_feed decodes `IAC IAC` to a literal 0xFF data byte, which survives
    # into the token; every not-found reply echoed it bare.
    var s = _tx_sess();
    store64(s + SS_LINE_BUF, fl_alloc(LINE_CAP));
    var raw = alloc(16);
    store8(raw + 0, 122);            # 'z'
    store8(raw + 1, 0 - 1);          # 0xFF — a lone IAC if echoed raw
    store8(raw + 2, 122);            # 'z'
    parser_parse(pa, raw, 3);
    _tx_reset(s);
    session_appendtx_tok(s, pa, 0);
    assert_eq(_lone_iac_count(load64(s + SS_TX_BUF), load64(s + SS_TX_LEN)), 0,
              "an echoed token never puts a lone IAC on the wire");

    # --- F6: a rejected load must unpublish, including on the pre-alloc paths
    # (missing file, empty, over cap) that sit above the old zeroing line.
    var saved_objs = g_obj_tpl_count;
    var saved_mobs = g_mob_tpl_count;
    assert(g_obj_tpl_count > 0, "objects are loaded to begin with");
    assert(world_load_objs("tests/fixtures/nosuchfile.cyml") < 0, "a missing objs file is rejected");
    assert_eq(g_obj_tpl_count, 0, "and leaves NO table published");
    assert(world_load_mobs("tests/fixtures/nosuchfile.cyml") < 0, "a missing mobs file is rejected");
    assert_eq(g_mob_tpl_count, 0, "and leaves no mob table published");
    assert(world_load_objs(DP_OBJS) > 0, "the real object table reloads");
    assert(world_load_mobs(DP_MOBS) >= 0, "and the real mob table");
    assert_eq(g_obj_tpl_count, saved_objs, "back to the authored object count");
    assert_eq(g_mob_tpl_count, saved_mobs, "and the authored mob count");

    # --- F1: render_who (`@who`) bounds the room index at BOTH ends. It tested
    # only `room >= 0` and then dereferenced — cmd_who three hundred lines below
    # has always checked both. Drive it with a session parked past the end of
    # the room table: a half-guarded render_who walks off g_rooms and dies.
    var saved_head = g_session_head;
    var w = _tx_sess();
    store64(w + SS_NAME_BUF, fl_alloc(NAME_CAP));
    memcpy(load64(w + SS_NAME_BUF), "Ghosty", 6);
    store64(w + SS_NAME_LEN, 6);
    store64(w + SS_ROOM, g_room_count + 500);       # positive, and nonexistent
    store64(w + SS_NEXT, 0);
    g_session_head = w;
    var viewer = _tx_sess();
    _tx_reset(viewer);
    render_who(viewer);
    assert(load64(viewer + SS_TX_LEN) > 0, "render_who answers instead of dereferencing a bad index");
    assert_eq(_contains(load64(viewer + SS_TX_BUF), load64(viewer + SS_TX_LEN), "no one in-world"), 1,
              "and an out-of-range session is not counted as in-world");
    g_session_head = saved_head;

    # --- F9: class stats are clamped where a character is MADE, matching the
    # bound player_auth_load already applies where a record is READ.
    if (g_class_count > 0) {
        var c = cl_at(0);
        var saved_hp = load64(c + CL_HP);
        var saved_en = load64(c + CL_ENERGY);
        store64(c + CL_HP, 0 - 5);        # an authored `hp = -5`
        store64(c + CL_ENERGY, 0 - 5);
        var pc = _mk_sess("Clamped", 7);
        apply_class(pc, 0);
        assert(load64(pc + SS_MAXHP) >= 1, "a negative authored hp cannot make a dead-on-arrival player");
        assert_eq(load64(pc + SS_HP), load64(pc + SS_MAXHP), "and hp starts at max");
        assert(load64(pc + SS_MAXENERGY) >= 0, "energy is floored too");
        store64(c + CL_HP, saved_hp);
        store64(c + CL_ENERGY, saved_en);
    }

    # --- F10: the killing blow emits the same tail as every other exit from
    # combat_round. It returned straight after mob_died, so the one round a
    # player most wants to read ended with no HP line and no prompt.
    if (g_mob_tpl_count > 0) {
        if (g_room_count > 0) {
            var ks = _mk_sess("Finisher", 8);
            store64(ks + SS_ROOM, 0);
            store64(ks + SS_PHASE, PHASE_CMD);
            store64(ks + SS_FD, 0 - 1);
            store64(ks + SS_HP, 500); store64(ks + SS_MAXHP, 500);
            store64(ks + SS_NDICE, 20); store64(ks + SS_DSIZE, 20); store64(ks + SS_DMOD, 9000);
            store64(ks + SS_HIT, 100);          # always hits, always kills
            var km = mob_spawn(mt_at(0), 0);
            mi_set_hp(km, 1);
            store64(ks + SS_TARGET, km);
            mi_set_target(km, ks);
            var kh = g_session_head;
            store64(ks + SS_NEXT, 0);
            g_session_head = ks;

            # Retry until the blow lands. SS_HIT = 100 does NOT mean "always
            # hits": combat_try_hit returns 0 on a natural 1 whatever the bonus
            # is, so a single round is a 1-in-20 flake — which is exactly how
            # this failed on CI while passing here. The mob has 1 HP and the
            # damage profile is enormous, so the first HIT is the kill; looping
            # makes the assertion about the killing blow's TAIL, which is what
            # it was always meant to be about, rather than about a d20.
            var tries = 0;
            var killed = 0;
            while (killed == 0) {
                if (tries > 60) { killed = 0 - 1; continue; }
                _tx_reset(ks);
                combat_round(ks);
                if (_contains(load64(ks + SS_TX_BUF), load64(ks + SS_TX_LEN), "collapses") == 1) {
                    killed = 1;
                }
                tries = tries + 1;
            }
            g_session_head = kh;
            assert_eq(killed, 1, "the mob died within 60 rounds (a natural 1 only misses)");
            assert_eq(_contains(load64(ks + SS_TX_BUF), load64(ks + SS_TX_LEN), "[ hp "), 1,
                      "and the killing blow still prints the condition line");
            assert_eq(_contains(load64(ks + SS_TX_BUF), load64(ks + SS_TX_LEN), "> "), 1,
                      "and the prompt");
            store64(ks + SS_TARGET, 0);
            _drain_ilist(room_at(0) + RM_OBJ_HEAD);   # the corpse it left
        }
    }

    # --- F11: `get X from Y` finds a CARRIED container, matching cmd_put's own
    # claim to be "the exact inverse of get X from Y". Put accepted a carried
    # container and get only ever searched the room, so anything put into a bag
    # in your own hands could never be taken out again.
    if (g_obj_tpl_count >= 2) {
        if (g_room_count > 0) {
            var gs = _mk_sess("Fetcher", 7);
            store64(gs + SS_ROOM, 0);
            store64(gs + SS_PHASE, PHASE_CMD);
            store64(gs + SS_FD, 0 - 1);
            var bag = item_new(ot_at(1));
            var gem = item_new(ot_at(0));
            ilist_push(gs + SS_INV, bag);
            ilist_push(bag + OI_CONTENTS, gem);      # as cmd_put would leave it
            var gpa = parser_new();
            var gcmd = alloc(160);
            var gco = _str_into(gcmd, 0, "get ");
            gco = _str_into(gcmd, gco, _kw1(oi_kw_ptr(gem), alloc(64)));
            gco = _str_into(gcmd, gco, " from ");
            gco = _str_into(gcmd, gco, _kw1(oi_kw_ptr(bag), alloc(64)));
            _tx_reset(gs);
            parser_parse(gpa, gcmd, gco);
            cmd_get(gs, gpa);
            assert_eq(_on_ilist(gs + SS_INV, gem), 1, "the item comes out of a carried container");
            assert_eq(_on_ilist(bag + OI_CONTENTS, gem), 0, "and is no longer inside it");

            # --- F11b: and it SURVIVES a disconnect. _build_record walked only
            # the top-level SS_INV chain, so anything in a carried bag was never
            # written — and session_drop_inv then obj_free'd it, recursing
            # through OI_CONTENTS. Put your scrip in a sack, log out, gone.
            ilist_remove(gs + SS_INV, gem);
            ilist_push(bag + OI_CONTENTS, gem);       # back inside the bag
            _player_unlink("Bagman", 6);              # unlink any prior run
            var bsalt = alloc(SALT_LEN);
            var bq = 0;
            while (bq < SALT_LEN) { store8(bsalt + bq, 31 + bq); bq = bq + 1; }
            memcpy(load64(gs + SS_NAME_BUF), "Bagman", 6);
            store64(gs + SS_NAME_LEN, 6);
            var bblk = sess_ident(gs);
            memcpy(bblk, bsalt, SALT_LEN);
            ident_derive(bsalt, "bagpassphrase", 13, bblk + IDENT_SK, bblk + IDENT_PK);
            store64(gs + SS_HP, 10); store64(gs + SS_MAXHP, 10);
            store64(gs + SS_ROOM, 0 - 1);
            store64(gs + SS_AUTHED, 1);
            assert_eq(player_save(gs), 1, "the character saves with a full bag");

            var back = _mk_sess("Bagman", 6);
            assert_eq(player_auth_load(back, "bagpassphrase", 13), 1, "and loads again");
            var restored = 0;
            var ro = load64(back + SS_INV);
            while (ro != 0) { restored = restored + 1; ro = oi_next(ro); }
            assert_eq(restored, 2, "BOTH the bag and what was inside it come back");
            _drain_ilist(back + SS_INV);
            _drain_ilist(gs + SS_INV);
        }
    }

    return 0;
}

# === 1.6.12 — bound the CLASS: every loop that dispatches lines has a budget. ===
fn test_event_budget(): i64 {
    test_group("event-budget");

    # --- G1: one epoll pass spends EVENT_LINES_MAX lines across ALL sessions,
    # not RX_MAX_LINES each. The batch drains up to MAX_EPOLL_EVENTS = 64 events
    # and the tick-deadline check sits OUTSIDE that loop, so an unbudgeted batch
    # ran to completion whatever it cost: measured 4.12 s from 6.6 kB of input,
    # 164% of the entire tick interval, swallowing a whole combat tick.
    #
    # The budget is threaded, not global: dispatch_session_max reports what it
    # spent so the caller can charge accurately. Drive that directly — the loop
    # itself lives behind a socket and a signalfd.
    var s = _armed_rx_sess(20);
    var fired[8];
    dispatch_session_max(0, s, EPOLLIN, 0, 3, &fired);
    assert_eq(load64(&fired), 3, "a budget below RX_MAX_LINES is honoured exactly");

    # And on event_batch_step itself, with a budget that is NOT a multiple of
    # RX_MAX_LINES. EVENT_LINES_MAX is 2 x RX_MAX_LINES, so a loop test alone
    # only ever exercises take == 8 and cannot tell a budgeted step from one
    # that always takes a full slice. (It couldn't. Three mutations passed.)
    var s3 = _armed_rx_sess(20);
    var keep3[8];
    var left3 = event_batch_step(0, s3, EPOLLIN, 0, 3, &keep3);
    assert_eq(left3, 0, "a 3-line budget is spent exactly, not rounded up to a slice");
    var s4 = _armed_rx_sess(20);
    var left4 = event_batch_step(0, s4, EPOLLIN, 0, 5, &keep3);
    assert_eq(left4, 0, "and a 5-line budget likewise");
    var s5 = _armed_rx_sess(2);              # only 2 lines queued
    var left5 = event_batch_step(0, s5, EPOLLIN, 0, RX_MAX_LINES, &keep3);
    assert_eq(left5, RX_MAX_LINES - 2, "a session with less to do is charged only what it used");
    dispatch_session_max(0, s, EPOLLIN, 0, 0, &fired);
    assert_eq(load64(&fired), 0, "a spent budget dispatches nothing");
    dispatch_session_max(0, s, EPOLLIN, 0, RX_MAX_LINES, &fired);
    assert_eq(load64(&fired), RX_MAX_LINES, "and a full slice still fires RX_MAX_LINES");

    # The batch arithmetic the loops implement: min(budget, RX_MAX_LINES) per
    # session, budget decremented by what was actually spent, so N sessions can
    # never cost N x RX_MAX_LINES.
    # Drive event_batch_step — the function BOTH loops call — rather than
    # reimplementing its arithmetic here. The first version of this test did
    # reimplement it, and three mutations to the real code passed unnoticed
    # because the test was only ever checking its own copy.
    var budget = EVENT_LINES_MAX;
    var served = 0;
    var spent = 0;
    var guard = 0;
    while (budget > 0) {
        if (guard > 1000) { budget = 0; continue; }
        var s2 = _armed_rx_sess(20);
        var keep[8];
        var left = event_batch_step(0, s2, EPOLLIN, 0, budget, &keep);
        spent = spent + (budget - left);
        budget = left;
        served = served + 1;
        guard = guard + 1;
    }
    assert_eq(spent, EVENT_LINES_MAX, "a whole pass spends exactly the batch budget");
    # Assert the SESSION count too, not just the budget delta. A step that
    # charged a flat 1 per session would still make `spent` reach the budget —
    # after servicing 16 sessions at a full slice each, i.e. the very thing the
    # budget exists to prevent. This is the assertion that sees that.
    assert_eq(served, EVENT_LINES_MAX / RX_MAX_LINES,
              "and services exactly budget/slice sessions, not one per unit of budget");
    assert(served < MAX_EPOLL_EVENTS,
           "far short of MAX_EPOLL_EVENTS sessions each having had a full slice");
    # The number that matters: unbudgeted, one pass was MAX_EPOLL_EVENTS x
    # RX_MAX_LINES = 512 lines. Budgeted it is EVENT_LINES_MAX = 16 — a 32x
    # reduction in the worst-case cost of a single event-loop pass. Asserted as
    # "at least 8x" so tuning either constant does not turn this into a flake,
    # with the exact ratio pinned separately.
    assert(spent * 8 <= MAX_EPOLL_EVENTS * RX_MAX_LINES,
           "a bounded pass costs at most an eighth of the unbounded one");
    assert_eq((MAX_EPOLL_EVENTS * RX_MAX_LINES) / spent, 32,
              "and on today's constants exactly a 32x reduction");

    return 0;
}

# === G2 (1.6.12) — the `passwd` re-key is metered, like its two siblings. ===
fn test_passwd_meter(): i64 {
    test_group("passwd-meter");
    persist_init();

    # Third instance of one defect: 1.6.2 capped login, E3 (1.6.10) capped
    # creation and called it "structurally identical" to login — and this path,
    # structurally identical to both, was never looked at. Measured before the
    # fix: 1000 attacker lines = 1103 ms of loop time, SS_FAILS still 0,
    # SS_QUIT still 0, still cycling.
    var s = _mk_sess("Rekeyer2", 8);
    store64(s + SS_LINE_BUF, fl_alloc(LINE_CAP));
    store64(s + SS_FD, 0 - 1);
    store64(s + SS_AUTHED, 1);
    store64(s + SS_PHASE, PHASE_CMD);
    passwd_begin(s);
    assert_eq(load64(s + SS_PHASE), PHASE_CHPASS_NEW, "passwd enters the re-key flow");

    var i = 0;
    while (i < MAX_LOGIN_FAILS - 1) {
        _tx_reset(s);
        chpass_on_new(s, "alphaphrase", 11);
        assert_eq(load64(s + SS_PHASE), PHASE_CHPASS_CONFIRM, "the new passphrase is taken");
        chpass_on_confirm(s, "bravophrase", 11);
        assert_eq(load64(s + SS_FAILS), i + 1, "a mismatched confirm counts an attempt");
        assert_eq(load64(s + SS_PHASE), PHASE_CHPASS_NEW, "and rewinds for another try");
        i = i + 1;
    }
    _tx_reset(s);
    chpass_on_new(s, "alphaphrase", 11);
    chpass_on_confirm(s, "bravophrase", 11);
    assert_eq(load64(s + SS_PHASE), PHASE_CMD, "the cap abandons the re-key");
    assert_eq(load64(s + SS_FAILS), 0, "and clears the counter for the next invocation");
    assert_eq(_contains(load64(s + SS_TX_BUF), load64(s + SS_TX_LEN), "UNCHANGED"), 1,
              "telling the player their passphrase is untouched");
    # An authenticated player is NOT disconnected — they can type `passwd` again.
    # That still bounds the work per invocation, which is the point.
    assert_eq(load64(s + SS_QUIT), 0, "a fumbling player is not thrown off the server");
    assert_eq(load64(s + SS_IDENT_CAND), 0, "and the candidate key is released");

    # --- G3: the attacker-paced audit events fire ONCE per session, at the cap,
    # not once per attempt. Each audit_event costs 1640 bytes of bump arena that
    # alloc() can never reclaim (most of it upstream in libro) plus ~360 bytes
    # appended to a never-rotated data/audit.libro. Five per connection at the
    # unauthenticated creation path measured ~755 kB/s of permanently-lost arena.
    #
    # Counted through the durable store, which is where the entries actually
    # land — the streaming chain retains nothing by design (1.6.1), so its
    # length is not the observable.
    # 1.7.1 — counted with g_audit_emitted, not by diffing the store file's byte
    # length. The old form read the whole append-only store into a 64 MB buffer and
    # compared lengths, which needed a "refuse to assert if the read saturates"
    # guard (it had silently always passed once), and — worse — could only ever
    # assert `after > before`. That cannot tell ONE entry from a hundred, which is
    # exactly the claim these assertions exist to make. The counter makes them
    # EXACT, and the buffer goes away.
    # 1.7.1 — reset the rollup windows first. Coalescing is per (severity, action)
    # key across the whole process, so an earlier group that already tripped
    # create.fail leaves that key's window OPEN, and this group's occurrence is
    # then correctly TALLIED rather than written. Without this the assertions below
    # measure test-execution order instead of the behaviour under test.
    audit_coalesce_reset();
    var before = g_audit_emitted;
    var cs = _mk_sess("Auditee", 7);
    store64(cs + SS_LINE_BUF, fl_alloc(LINE_CAP));
    store64(cs + SS_FD, 0 - 1);
    store64(cs + SS_PHASE, PHASE_CONFIRMPASS);
    var cblk = sess_ident(cs);
    var csalt = alloc(SALT_LEN);
    var cq = 0;
    while (cq < SALT_LEN) { store8(csalt + cq, 5 + cq); cq = cq + 1; }
    memcpy(cblk, csalt, SALT_LEN);
    ident_derive(csalt, "auditphrase", 11, cblk + IDENT_SK, cblk + IDENT_PK);

    var k = 0;
    while (k < MAX_LOGIN_FAILS - 1) {
        login_on_confirm(cs, "wrongphrase", 11);
        k = k + 1;
    }
    var mid = g_audit_emitted;
    # 1.7.6 — the contract CHANGED, deliberately, and for the better.
    #
    # G3 (1.6.12) made this fire once at the cap, because each entry cost 1944
    # permanently-unreclaimable bytes and the attacker set the rate. The rollup
    # window (1.7.1) removed that constraint, so 1.7.6 audits every attempt again:
    # the FIRST occurrence opens the window and is written verbatim, and every
    # later one is tallied at zero allocation. A flood is now visible from the
    # first attempt instead of only from the fifth, and the rollup's count is the
    # true attempt total rather than a count of sessions that reached the cap.
    assert_eq(mid - before, 1,
              "the FIRST failed creation attempt is durable — a flood is visible immediately");
    login_on_confirm(cs, "wrongphrase", 11);           # the fifth trips the cap
    assert_eq(load64(cs + SS_QUIT), 1, "the cap fired");
    assert_eq(g_audit_emitted - mid, 0,
              "...and the attempts after it are TALLIED, not written — the arena cost is flat");
    # The count is not lost: it is carried by the rollup, which is the whole point
    # of taking G3's trade back.
    assert(load64(_audit_slot(AK_CREATE_FAIL) + AKE_SUPP) > 0,
           "the suppressed attempts are counted for the rollup to report");

    # The SAME assertion on the returning-player path. Covering one of two
    # symmetric paths is precisely the mistake this release exists to correct —
    # 1.6.2 capped login and left creation, 1.6.10 capped creation and left
    # `passwd`. Both audit paths, or neither.
    _player_unlink("Auditee2", 8);
    var ls = _mk_sess("Auditee2", 8);
    var lsalt = alloc(SALT_LEN);
    cq = 0;
    while (cq < SALT_LEN) { store8(lsalt + cq, 90 + cq); cq = cq + 1; }
    var lblk2 = sess_ident(ls);
    memcpy(lblk2, lsalt, SALT_LEN);
    ident_derive(lsalt, "realphrase", 10, lblk2 + IDENT_SK, lblk2 + IDENT_PK);
    store64(ls + SS_ROOM, 0 - 1);
    store64(ls + SS_HP, 10); store64(ls + SS_MAXHP, 10);
    store64(ls + SS_AUTHED, 1);
    assert_eq(player_save(ls), 1, "a record to fail against");

    var lp = _mk_sess("Auditee2", 8);
    store64(lp + SS_LINE_BUF, fl_alloc(LINE_CAP));
    store64(lp + SS_FD, 0 - 1);
    audit_coalesce_reset();
    var lbase = g_audit_emitted;
    k = 0;
    while (k < MAX_LOGIN_FAILS - 1) {
        login_on_pass(lp, "wrongphrase", 11);
        k = k + 1;
    }
    assert_eq(g_audit_emitted - lbase, 0,
              "four wrong passphrases write NO durable audit entries either");
    login_on_pass(lp, "wrongphrase", 11);
    assert_eq(load64(lp + SS_QUIT), 1, "the login cap fired");
    assert_eq(g_audit_emitted - lbase, 1,
              "and it writes exactly one entry at the cap — the assertion the byte delta could not make");

    return 0;
}

# === G1 (1.6.13) — the carry cap, and the net under it. ===
fn test_carry_cap(): i64 {
    test_group("carry-cap");
    persist_init();
    if (g_obj_tpl_count == 0) { assert(0, "carry-cap: needs object templates"); return 0; }
    if (g_room_count == 0)    { assert(0, "carry-cap: needs a world"); return 0; }

    var s = _mk_sess("Hoarder", 7);
    store64(s + SS_ROOM, 0);
    store64(s + SS_PHASE, PHASE_CMD);
    store64(s + SS_FD, 0 - 1);

    # --- The counter, and the cap predicate.
    assert_eq(inv_count(s), 0, "an empty inventory counts zero");
    var i = 0;
    while (i < MAX_INV) { ilist_push(s + SS_INV, item_new(ot_at(0))); i = i + 1; }
    assert_eq(inv_count(s), MAX_INV, "counts up to the cap");
    _tx_reset(s);
    assert_eq(inv_full(s), 1, "and reports full at the cap");
    assert_eq(_contains(load64(s + SS_TX_BUF), load64(s + SS_TX_LEN), "full"), 1,
              "telling the player, which is the whole point — the old failure was silent");

    # --- `get` refuses at the cap rather than overfilling.
    var room_slot = room_at(0) + RM_OBJ_HEAD;
    _drain_ilist(room_slot);
    var floor_item = item_new(ot_at(0));
    ilist_push(room_slot, floor_item);
    var pa = parser_new();
    var cmd = alloc(160);
    var co = _str_into(cmd, 0, "get ");
    co = _str_into(cmd, co, _kw1(oi_kw_ptr(floor_item), alloc(64)));
    _tx_reset(s);
    parser_parse(pa, cmd, co);
    cmd_get(s, pa);
    assert_eq(inv_count(s), MAX_INV, "get does not push past the cap");
    assert_eq(_on_ilist(room_slot, floor_item), 1, "and the item stays on the floor");

    # --- `get all` stops at the cap mid-sweep instead of silently overfilling.
    var j = 0;
    while (j < 5) { ilist_push(room_slot, item_new(ot_at(0))); j = j + 1; }
    _tx_reset(s);
    parse_lit(pa, "get all");
    cmd_get(s, pa);
    assert_eq(inv_count(s), MAX_INV, "get all stops at the cap");

    # --- Below the cap it still works — the guard must not break ordinary play.
    var head = load64(s + SS_INV);
    ilist_remove(s + SS_INV, head);
    obj_free(head);
    assert_eq(inv_count(s), MAX_INV - 1, "one slot free");
    _tx_reset(s);
    parse_lit(pa, "get all");
    cmd_get(s, pa);
    assert_eq(inv_count(s), MAX_INV, "and exactly one more item is taken");

    # --- The cap keeps the record inside SAVE_CAP even at the WORST id length.
    # This is the number that makes 100 the right cap: the object format allows
    # 31-byte ids, and the record refused outright from the 113th such item.
    _drain_ilist(s + SS_INV);
    var salt = alloc(SALT_LEN);
    var q = 0;
    while (q < SALT_LEN) { store8(salt + q, 60 + q); q = q + 1; }
    var blk = sess_ident(s);
    memcpy(blk, salt, SALT_LEN);
    ident_derive(salt, "hoardpassphrase", 15, blk + IDENT_SK, blk + IDENT_PK);
    store64(s + SS_ROOM, 0 - 1);
    store64(s + SS_HP, 20); store64(s + SS_MAXHP, 20);
    store64(s + SS_AUTHED, 1);
    i = 0;
    while (i < MAX_INV) {
        var w = item_new(ot_at(0));
        store64(w + OI_TPL_ID_LEN,
                copy_bytes_capped(w + OI_TPL_ID, OI_TPL_ID_CAP - 1,
                                  "abcdefghijklmnopqrstuvwxyz01234", 31));
        ilist_push(s + SS_INV, w);
        i = i + 1;
    }
    assert(_build_record(s) > 0, "a FULL inventory of maximum-length ids still serializes");

    # --- The net: past the budget the record TRUNCATES, it does not refuse.
    # Before 1.6.13 this returned -1 and kept returning -1, so the character
    # stopped persisting entirely — room, HP, class and all — with nothing said.
    i = 0;
    while (i < 60) {
        var x = item_new(ot_at(0));
        store64(x + OI_TPL_ID_LEN,
                copy_bytes_capped(x + OI_TPL_ID, OI_TPL_ID_CAP - 1,
                                  "abcdefghijklmnopqrstuvwxyz01234", 31));
        ilist_push(s + SS_INV, x);
        i = i + 1;
    }
    assert(inv_count(s) > MAX_INV, "now deliberately over the cap (as a stale record could be)");
    assert(_build_record(s) > 0, "the record still serializes — truncated, not refused");
    assert(_build_record(s) > 0, "and again: the failure is not sticky");


    # --- `give` respects the RECIPIENT's cap. Handing someone their 101st item
    # would push them past a limit they neither see nor chose — and the GIVER is
    # the one told, since they are the one acting.
    _drain_ilist(s + SS_INV);
    var gh = g_session_head;
    var giver = _mk_sess("Giver2", 6);
    store64(giver + SS_ROOM, 0); store64(giver + SS_PHASE, PHASE_CMD); store64(giver + SS_FD, 0 - 1);
    var taker = _mk_sess("Taker2", 6);
    store64(taker + SS_ROOM, 0); store64(taker + SS_PHASE, PHASE_CMD); store64(taker + SS_FD, 0 - 1);
    store64(giver + SS_NEXT, taker); store64(taker + SS_NEXT, 0);
    g_session_head = giver;
    var k2 = 0;
    while (k2 < MAX_INV) { ilist_push(taker + SS_INV, item_new(ot_at(0))); k2 = k2 + 1; }
    var gift = item_new(ot_at(0));
    ilist_push(giver + SS_INV, gift);
    var gcmd = alloc(160);
    var gco = _str_into(gcmd, 0, "give ");
    gco = _str_into(gcmd, gco, _kw1(oi_kw_ptr(gift), alloc(64)));
    gco = _str_into(gcmd, gco, " to Taker2");
    _tx_reset(giver);
    parser_parse(pa, gcmd, gco);
    cmd_give(giver, pa);
    assert_eq(inv_count(taker), MAX_INV, "give does not push the recipient past the cap");
    assert_eq(_on_ilist(giver + SS_INV, gift), 1, "the gift stays with the giver");
    assert_eq(_contains(load64(giver + SS_TX_BUF), load64(giver + SS_TX_LEN), "can't carry"), 1,
              "and the giver is told why");
    g_session_head = gh;
    _drain_ilist(giver + SS_INV);
    _drain_ilist(taker + SS_INV);
    _drain_ilist(s + SS_INV);
    _drain_ilist(room_slot);
    return 0;
}

# Write raw bytes as a player's record, creating the shard directory first, and
# ASSERT the write landed.
#
# Both halves are load-bearing, and CI proved it. Since 1.7.2 `_path_for` returns
# `data/players/<c>/<name>.cyml`, and on a FRESH checkout that directory does not
# exist — so a bare `file_write_all` fails, the record never lands, and whatever
# reads it back reports something unrelated. A forged-record test failed CI with
# "got -1, expected -2" — "no record" rather than "tampered" — which points
# nowhere near a missing directory.
#
# It passed locally for the worst possible reason: a stale pre-sharding flat file
# was still on disk and the compatibility fallback found it. A test that depends
# on leftover state is not a test, which is the same lesson the shard-mkdir
# mutation taught one commit earlier.
fn _write_record_raw(name, nl, buf, len): i64 {
    _shard_mkdir(name, nl);
    _path_for(name, nl, g_persist_path);
    var w = file_write_all(g_persist_path, buf, len);
    assert(w >= 0, "test fixture: the record file was actually written");
    return w;
}

# Remove a player's record from BOTH layouts (1.7.2).
#
# Since 1.7.2 records are written to `data/players/<c>/<name>.cyml` and the flat
# `data/players/<name>.cyml` is still READ as a compatibility fallback. A test
# that clears only the sharded path leaves the legacy file behind, player_exists
# still finds it, and the name stays taken — so the test fails for a reason with
# nothing to do with what it is testing. Clearing both is what "this name does not
# exist" now means.
fn _player_unlink(name, nl): i64 {
    _path_for(name, nl, g_persist_path);
    syscall(87, g_persist_path);
    _path_for_flat(name, nl, g_persist_path);
    syscall(87, g_persist_path);
    return 0;
}

# Items hanging directly off SS_INV, ignoring container contents. Distinct from
# inv_count (which counts the total) precisely so a test can tell a MOVE from a
# refusal — both leave the total alone.
fn _top_count(s): i64 {
    var n = 0;
    var o = load64(s + SS_INV);
    while (o != 0) { n = n + 1; o = oi_next(o); }
    return n;
}

# === 1.7.2 — operator config and the account cap. ===
#
# The cap is OFF by default and always will be: how many characters a world holds
# is an operator's decision, not this server's. What 1.7.2 adds is a way to SET
# one — `data/server.cyml`, overridden by YD_MAX_ACCOUNTS.
#
# `accounts_full` is a pure predicate over (count, cap) so the rule is enumerable
# without a filesystem, which is the same seam save_sweep_due and
# chpass_rate_limited use.
fn test_account_cap(): i64 {
    test_group("account-cap");

    # --- UNLIMITED is the default, and 0 is what expresses it. This is the
    # assertion that stops someone "tidying" the sentinel into a MAX_INT.
    assert_eq(accounts_full(0, 0), 0, "a cap of 0 means unlimited");
    assert_eq(accounts_full(999999, 0), 0, "...at any count whatsoever");
    assert_eq(accounts_full(999999, 0 - 1), 0,
              "a negative cap is unlimited too, not inverted into 'always full'");

    # --- A real cap is a boundary, and the boundary is 'at or above'.
    assert_eq(accounts_full(2499, 2500), 0, "one under the cap admits a new character");
    assert_eq(accounts_full(2500, 2500), 1, "exactly at the cap refuses");
    assert_eq(accounts_full(2501, 2500), 1, "over the cap refuses");
    assert_eq(accounts_full(0, 1), 0, "a cap of 1 admits the first character");
    assert_eq(accounts_full(1, 1), 1, "...and refuses the second");

    # --- 1.7.6: the count must survive the SHARDED layout.
    #
    # This counted top-level ENTRIES, which was right for the flat layout and wrong
    # from the moment 1.7.2 sharded records into `data/players/<c>/` — in the SAME
    # release. Entries then become mostly shard DIRECTORIES, so the count collapses
    # towards the number of distinct first letters: 26 counted against 40 real
    # records mid-migration. An operator who set `max_accounts` had a cap that
    # silently stopped enforcing.
    #
    # Asserted against records this test WRITES, so it does not depend on whatever
    # the working data directory happens to hold.
    var base = accounts_count_disk();
    _player_unlink("Countaa", 7);
    _player_unlink("Zountaa", 7);
    var c1 = _mk_sess("Countaa", 7);
    var csalt2 = alloc(SALT_LEN);
    var cq2 = 0;
    while (cq2 < SALT_LEN) { store8(csalt2 + cq2, 13 + cq2); cq2 = cq2 + 1; }
    var cb1 = sess_ident(c1);
    memcpy(cb1, csalt2, SALT_LEN);
    ident_derive(csalt2, "countphrase", 11, cb1 + IDENT_SK, cb1 + IDENT_PK);
    store64(cb1 + IDENT_CREATED, 1000000);
    store64(c1 + SS_ROOM, 0 - 1);
    store64(c1 + SS_HP, 4); store64(c1 + SS_MAXHP, 4);
    store64(c1 + SS_AUTHED, 1);
    assert_eq(player_save(c1), 1, "a sharded record is written");
    assert_eq(accounts_count_disk(), base + 1,
              "a record in a SHARD DIRECTORY is counted — the whole point of the fix");

    # A second record under a DIFFERENT shard letter, so the count cannot be
    # passing by accident on a single directory.
    var c2 = _mk_sess("Zountaa", 7);
    var cb2 = sess_ident(c2);
    memcpy(cb2, csalt2, SALT_LEN);
    ident_derive(csalt2, "countphrase", 11, cb2 + IDENT_SK, cb2 + IDENT_PK);
    store64(cb2 + IDENT_CREATED, 1000000);
    store64(c2 + SS_ROOM, 0 - 1);
    store64(c2 + SS_HP, 4); store64(c2 + SS_MAXHP, 4);
    store64(c2 + SS_AUTHED, 1);
    assert_eq(player_save(c2), 1, "a record under another shard letter is written");
    assert_eq(accounts_count_disk(), base + 2,
              "...and records across DIFFERENT shards are both counted");

    # A legacy flat record counts too — both layouts are live during migration.
    var rec = alloc(SLURP_CAP);
    _path_for("Countaa", 7, g_persist_path);
    var rn2 = file_read_all(g_persist_path, rec, SLURP_CAP - 1);
    assert(rn2 > 0, "the sharded record reads back");
    _path_for_flat("Legacycount", 11, g_persist_path);
    assert(file_write_all(g_persist_path, rec, rn2) >= 0, "a legacy flat record is planted");
    assert_eq(accounts_count_disk(), base + 3,
              "a LEGACY flat record is counted as well — both layouts are live");
    syscall(87, g_persist_path);

    # And a shard DIRECTORY is not itself an account.
    assert_eq(accounts_count_disk(), base + 2, "removing that record removes exactly one");
    _player_unlink("Countaa", 7);
    _player_unlink("Zountaa", 7);
    assert_eq(accounts_count_disk(), base,
              "...and the count returns to where it started — directories are not accounts");

    # --- The config file. An absent file must leave the default alone, because
    # every existing deployment has no such file and must behave as 1.7.1 did.
    g_max_accounts = 0;
    assert_eq(config_load("data/does-not-exist-server.cyml"), 0,
              "an absent config file is not an error");
    assert_eq(g_max_accounts, 0, "...and leaves the default untouched");

    # A real file is read from the document PREAMBLE, so the operator's config is
    # two lines rather than an [[entries]] block with a prose body.
    assert_eq(config_load("tests/fixtures/server.cyml"), 1, "a config file parses");
    assert_eq(g_max_accounts, 2500, "...and its max_accounts is applied");

    # A malformed value must fail OPEN to unlimited, never to a smaller cap: a
    # typo in a config file must not lock an operator out of their own world.
    assert_eq(config_load("tests/fixtures/server-bad.cyml"), 1, "a malformed config still parses");
    assert_eq(g_max_accounts, 0, "...and a bad max_accounts falls back to UNLIMITED, not to 0 slots");
    assert_eq(accounts_full(999999, g_max_accounts), 0,
              "so a typo cannot refuse every new character");

    # A NEGATIVE value specifically. The first version of this group used a
    # non-numeric value, which toml_int turns into the default before the clamp is
    # ever reached — so the clamp survived mutation. A negative literal is the only
    # input that exercises it.
    assert_eq(config_load("tests/fixtures/server-neg.cyml"), 1, "a negative config parses");
    assert_eq(g_max_accounts, 0, "a NEGATIVE max_accounts clamps to unlimited, not to 'always full'");

    # --- THE ENFORCEMENT POINT. The predicate being right is not the same as it
    # being consulted; nothing above drives creation, and the first version of this
    # group let "the cap is never enforced" survive mutation because of it.
    _player_unlink("Capped", 6);            # unlink — the name must not exist
    var cap_s = _mk_sess("Capped", 6);
    store64(cap_s + SS_LINE_BUF, fl_alloc(LINE_CAP));
    store64(cap_s + SS_FD, 0 - 1);
    store64(cap_s + SS_PHASE, PHASE_CONFIRMPASS);
    var cap_blk = sess_ident(cap_s);
    var cap_salt = alloc(SALT_LEN);
    var cz = 0;
    while (cz < SALT_LEN) { store8(cap_salt + cz, 61 + cz); cz = cz + 1; }
    memcpy(cap_blk, cap_salt, SALT_LEN);
    ident_derive(cap_salt, "cappedphrase", 12, cap_blk + IDENT_SK, cap_blk + IDENT_PK);

    var saved_max = g_max_accounts;
    var saved_cnt = g_account_count;
    g_max_accounts = 1;
    g_account_count = 1;                    # already at the cap
    login_on_confirm(cap_s, "cappedphrase", 12);
    assert_eq(load64(cap_s + SS_QUIT), 1, "a correct confirm at the cap is REFUSED");
    assert(load64(cap_s + SS_PHASE) != PHASE_CLASS,
           "...and the session never reaches class selection");
    assert_eq(g_account_count, 1, "...and no account was counted");
    assert_eq(player_exists("Capped", 6), 0, "...and no record was written");

    # And with room, the same session commits normally — otherwise this group
    # would pass with creation broken outright.
    var ok_s = _mk_sess("Capped", 6);
    store64(ok_s + SS_LINE_BUF, fl_alloc(LINE_CAP));
    store64(ok_s + SS_FD, 0 - 1);
    store64(ok_s + SS_PHASE, PHASE_CONFIRMPASS);
    var ok_blk = sess_ident(ok_s);
    memcpy(ok_blk, cap_salt, SALT_LEN);
    ident_derive(cap_salt, "cappedphrase", 12, ok_blk + IDENT_SK, ok_blk + IDENT_PK);
    g_account_count = 0;                    # room for one
    login_on_confirm(ok_s, "cappedphrase", 12);
    assert_eq(load64(ok_s + SS_QUIT), 0, "under the cap, creation is not refused");
    assert_eq(load64(ok_s + SS_PHASE), PHASE_CLASS, "...and it proceeds to class selection");
    assert_eq(g_account_count, 1, "...and the account is counted");

    g_max_accounts = saved_max;
    g_account_count = saved_cnt;
    _player_unlink("Capped", 6);

    g_max_accounts = 0;
    return 0;
}

# Byte-equality for the rotation group's hash comparisons.
fn _audit_bytes_same_t(a, b, n): i64 {
    var i = 0;
    while (i < n) {
        if ((load8(a + i) & 0xFF) != (load8(b + i) & 0xFF)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# === 1.7.6 — a room listing never runs the tx buffer dry. ===
#
# MEASURED before the fix, driving the real `cmd_on_line(s, "look", 4)`: at 86
# floor objects the stream ended `" here."` then a bare ESC '[' — an incomplete
# SGR sequence, no CRLF, no colour reset, and NO PROMPT. A conformant terminal
# then eats the opening characters of whatever arrives next, and it never recovers
# because a floor only grows.
#
# This is a wire-CORRECTNESS bug of the same class as M10's sanitizer work, not a
# performance one. 1.7.5's ground decay bounds a floor to 30 minutes of
# accumulation and does not fix it: a busy town square passes 86 items well inside
# 30 minutes.
fn test_room_listing_bounds(): i64 {
    test_group("room-listing");

    if (g_obj_tpl_count == 0) { assert(0, "room-listing: needs object templates"); return 0; }
    if (world_room_count() == 0) { assert(0, "room-listing: needs a zone"); return 0; }

    # --- The predicate, over its domain. Pure, so the rule is enumerable without
    # a socket or a stuffed room.
    var s = _freeable_sess();
    store64(s + SS_TX_LEN, 0);
    assert_eq(room_line_fits(s, 10), 1, "a short line fits an empty buffer");
    assert_eq(room_line_fits(s, TX_CAP - ROOM_TAIL_RESERVE), 1, "exactly up to the reserve fits");
    assert_eq(room_line_fits(s, TX_CAP - ROOM_TAIL_RESERVE + 1), 0, "one byte past the reserve does not");
    store64(s + SS_TX_LEN, TX_CAP - ROOM_TAIL_RESERVE);
    assert_eq(room_line_fits(s, 1), 0, "a full-to-the-reserve buffer fits nothing more");
    assert(ROOM_TAIL_RESERVE > 0, "the reserve is real");
    store64(s + SS_TX_LEN, 0);

    # --- THE BUG. Stuff a floor well past the old 86-object threshold and drive
    # the REAL look through the parser, exactly as a player does.
    var slot = room_at(0) + RM_OBJ_HEAD;
    var pre = load64(slot);
    store64(slot, 0);
    var made = 0;
    while (made < 400) { ilist_push(slot, item_new(ot_at(0))); made = made + 1; }

    store64(s + SS_ROOM, 0);
    store64(s + SS_PHASE, PHASE_CMD);
    store64(s + SS_FD, 0 - 1);
    store64(s + SS_AUTHED, 1);
    _tx_reset(s);
    cmd_on_line(s, "look", 4);

    var tx = load64(s + SS_TX_BUF);
    var n = load64(s + SS_TX_LEN);
    assert(n > 0, "look produced output");
    assert(n <= TX_CAP, "...within the buffer");

    # THE ASSERTION THIS GROUP EXISTS FOR. The old failure ended mid-escape with
    # the prompt discarded; a player was left with colour bleeding and no prompt.
    assert(_contains(tx, n, "> ") == 1,
           "the PROMPT reaches the client — the failure this release fixes");

    # And the stream does not end inside an escape sequence. ESC is 27; a
    # well-formed tail cannot have one in the last two bytes with no terminator.
    var tail1 = load8(tx + n - 1) & 0xFF;
    var tail2 = load8(tx + n - 2) & 0xFF;
    assert(tail1 != 27, "the stream does not end ON an ESC");
    assert(tail2 != 27, "...nor one byte into an escape sequence");

    # The listing is honest about what it left out, rather than silently showing
    # fewer things than are present — that is how a player walks past what they
    # came for.
    assert_eq(_contains(tx, n, "more items lie here."), 1,
              "...and it says how many items it did not list");

    # --- With a small floor nothing is omitted and no summary appears.
    _drain_ilist(slot);
    store64(slot, 0);
    made = 0;
    while (made < 3) { ilist_push(slot, item_new(ot_at(0))); made = made + 1; }
    _tx_reset(s);
    cmd_on_line(s, "look", 4);
    tx = load64(s + SS_TX_BUF); n = load64(s + SS_TX_LEN);
    assert_eq(_contains(tx, n, "more items lie here."), 0,
              "a normal room gets no truncation notice");
    assert_eq(_contains(tx, n, "> "), 1, "...and still gets its prompt");
    assert(n < TX_CAP, "...well inside the buffer");

    _drain_ilist(slot);
    store64(slot, pre);
    session_free(s);
    return 0;
}

# === 1.7.5 — ground decay for player-dropped items. ===
#
# Nothing reclaimed a dropped item: obj_free could not reach a non-corpse object
# on a floor, so ordinary play (kill, loot, drop, quit) grew the floor forever —
# measured 40 cycles taking it 0 -> 80, monotonic — and `look` walked it every
# time, 801 us at 10,000 objects, charged ZERO by the 1.7.0 meter because the cost
# is unbounded in the WORLD STATE rather than in the line.
#
# The lifetime is TWO ZONE-RESET INTERVALS: 30 minutes at the authored 900 s
# cadence. The floor is how players hand things to each other, and a handoff is
# minutes.
fn test_ground_decay(): i64 {
    test_group("ground-decay");

    if (g_obj_tpl_count == 0) { assert(0, "ground-decay: needs object templates"); return 0; }
    if (world_room_count() == 0) { assert(0, "ground-decay: needs a zone"); return 0; }

    # --- The threshold is DERIVED from the zone's own cadence, so a zone authored
    # with a faster rhythm reclaims faster and an operator lowering YD_RESET_SECS
    # gets faster decay for free. No new knob; ADR 0007 stays clean.
    var saved_override = g_reset_secs_override;
    var saved_tick = g_tick_ms;
    g_reset_secs_override = 0;
    g_tick_ms = 2500;
    var expect = clamp_reset_secs(g_zone_reset_secs) * 1000 * GROUND_RESET_MULT / 2500;
    assert_eq(ground_decay_ticks(), expect, "the threshold is two reset intervals in ticks");
    assert_eq(ground_decay_ticks(), 720,
              "...which at the authored 900 s cadence is 720 ticks — 30 minutes");

    # An operator override drives it too.
    # Above GROUND_TICKS_MIN, so this tests the DERIVATION rather than the floor —
    # 60 s would compute 48 ticks and be clamped to 120, which would have made
    # this assertion silently about the clamp instead.
    g_reset_secs_override = 300;
    assert_eq(ground_decay_ticks(), 300 * 1000 * GROUND_RESET_MULT / 2500,
              "YD_RESET_SECS drives ground decay as well as the reset itself");
    assert(ground_decay_ticks() > GROUND_TICKS_MIN, "...and that value is above the floor");

    # And it is FLOORED. A zone authored `reset_secs = 1` would otherwise reclaim
    # a dropped item inside a second, which is a handoff nobody can complete.
    g_reset_secs_override = 1;
    assert_eq(ground_decay_ticks(), GROUND_TICKS_MIN,
              "an absurdly fast zone still leaves time to pick something up");
    assert(GROUND_TICKS_MIN >= CORPSE_TICKS,
           "...and a dropped item never expires faster than a corpse");
    g_reset_secs_override = saved_override;

    # --- ARMING. Authored zone furniture is minted at OI_AGE 0 and must NEVER
    # decay, or a room loses its own contents between resets. Only a player
    # putting something on a floor arms the clock.
    var slot = room_at(0) + RM_OBJ_HEAD;
    var pre = load64(slot);
    store64(slot, 0);                       # isolate this room's floor
    var live0 = g_obj_live;

    var furniture = item_new(ot_at(0));     # as zone_reset_room_objs mints it
    ilist_push(slot, furniture);
    assert_eq(load64(furniture + OI_AGE), 0, "authored furniture is minted UNARMED");

    var dropped = item_new(ot_at(0));
    ilist_push(slot, dropped);
    ground_arm(dropped);
    assert_eq(load64(dropped + OI_AGE), 1, "a player-dropped item is armed");

    # --- Run the sweep past the threshold. The armed item goes; the furniture stays.
    g_reset_secs_override = 1;              # threshold = GROUND_TICKS_MIN
    var k = 0;
    while (k < GROUND_TICKS_MIN + 2) { corpse_decay_sweep(); k = k + 1; }
    assert_eq(_on_ilist(slot, dropped), 0, "the dropped item is reclaimed past its lifetime");
    assert_eq(_on_ilist(slot, furniture), 1,
              "...and the zone's own furniture is UNTOUCHED, however long it sits");
    assert_eq(g_obj_live, live0 + 1, "exactly one instance was freed");

    # --- Re-arming restarts the clock: passing something hand to hand must not
    # hand along an almost-expired timer.
    var relay = item_new(ot_at(0));
    ilist_push(slot, relay);
    ground_arm(relay);
    k = 0;
    while (k < GROUND_TICKS_MIN - 10) { corpse_decay_sweep(); k = k + 1; }
    assert_eq(_on_ilist(slot, relay), 1, "still there just under the threshold");
    ground_arm(relay);                      # picked up and dropped again
    assert_eq(load64(relay + OI_AGE), 1, "a re-drop restarts the clock at 1");
    k = 0;
    while (k < 20) { corpse_decay_sweep(); k = k + 1; }
    assert_eq(_on_ilist(slot, relay), 1,
              "...so it survives past where the ORIGINAL clock would have expired");

    # Retire the relay before the next section. It is still ARMED, so it would
    # expire during the bag's sweep and be counted as one of the bag's contents —
    # which is exactly the kind of cross-contamination that makes an instance
    # count prove the wrong thing.
    ilist_remove(slot, relay); obj_free(relay);

    # --- A bag decays as one unit; obj_free recurses through OI_CONTENTS.
    var bag = item_new(ot_at(0));
    ilist_push(slot, bag);
    ground_arm(bag);
    var bk = 0;
    while (bk < 4) { ilist_push(bag + OI_CONTENTS, item_new(ot_at(0))); bk = bk + 1; }
    var live_bag = g_obj_live;
    k = 0;
    while (k < GROUND_TICKS_MIN + 2) { corpse_decay_sweep(); k = k + 1; }
    assert_eq(_on_ilist(slot, bag), 0, "a dropped bag decays");
    assert_eq(g_obj_live, live_bag - 5,
              "...and takes its four contents with it, so nothing is orphaned");

    # --- ground_arm refuses a corpse, asserted DIRECTLY.
    #
    # No drop path can reach here with one today — get_from refuses to pick a
    # corpse up and cmd_give refuses to hand one over — so this guard is
    # defensive, and the mutation removing it survives every behavioural test.
    # Asserted at the function rather than left as decoration: a corpse armed for
    # ground decay would get the 30-minute clock instead of its own 5-minute one,
    # which is a body lying around six times too long.
    var body = corpse_new("a test corpse", 13);
    store64(body + OI_AGE, 7);
    ground_arm(body);
    assert_eq(load64(body + OI_AGE), 7,
              "arming a CORPSE is refused — its own shorter clock is untouched");
    obj_free(body);

    # --- Cleanup.
    ilist_remove(slot, furniture); obj_free(furniture);
    store64(slot, pre);
    g_reset_secs_override = saved_override;
    g_tick_ms = saved_tick;
    return 0;
}

# === 1.7.4 — audit-log rotation (ADR 0009). ===
#
# Seal and continue: rename the live log to data/audit.libro.<N> and keep
# appending, so the first entry after the rename carries the sealed tail as its
# prev_hash. The boundary is recorded BY THE CHAIN, not by metadata.
#
# The crash window is why this waited a release. Rename succeeds, process dies
# before the first append: the live file is gone, a naive boot restarts the chain
# at genesis, and there is one broken link per boundary — indistinguishable from a
# deletion, which is the H11 bug of 1.6.6 reintroduced as a feature.
fn test_audit_rotation(): i64 {
    test_group("audit-rotation");

    # A private log for this group. DP_AUDIT is the seam the whole suite already
    # uses; restoring it at the end matters because later groups audit too.
    var saved_audit = DP_AUDIT;
    var saved_hi = g_audit_seg_hi;
    DP_AUDIT = "data/rot-test.libro";
    xunlink(DP_AUDIT);
    var sp = alloc(PATH_CAP);
    var sn = 1;
    while (sn <= AUDIT_SEG_KEEP + 3) { _audit_seg_path(sn, sp); xunlink(sp); sn = sn + 1; }
    g_audit_seg_hi = 0 - 1;

    # --- The trigger predicate, over its domain. A TICK COUNT, not a clock: on
    # AGNOS sys_uptime_ms is documented frozen, so a `now - last` rule would
    # silently disable rotation on one of the two supported targets.
    assert_eq(audit_rotate_check_due(0), 0, "tick 0 does not probe");
    assert_eq(audit_rotate_check_due(1), 0, "an arbitrary tick does not probe");
    assert_eq(audit_rotate_check_due(AUDIT_ROTATE_TICKS), 1, "the Nth tick probes");
    assert_eq(audit_rotate_check_due(AUDIT_ROTATE_TICKS * 3), 1, "...and every Nth after");
    assert_eq(audit_rotate_check_due(AUDIT_ROTATE_TICKS + 1), 0, "...and only those");
    assert_eq(audit_rotate_check_due(0 - 5), 0, "a negative tick count never probes");

    # --- Segment paths.
    assert(_audit_seg_path(1, sp) > 0, "a segment path builds");
    assert(_find_cstr(sp, PATH_CAP, "rot-test.libro.1") >= 0, "...and is <live>.<n>");
    assert(_audit_seg_path(4096, sp) > 0, "a high segment number builds too");
    assert(_find_cstr(sp, PATH_CAP, "rot-test.libro.4096") >= 0, "...with the number appended");

    # --- Rotation seals the live file and continues.
    var chain_save = g_audit_chain;
    var store_save = g_audit_store;
    g_audit_chain = chain_new_streaming();
    g_audit_store = filestore_open(str_from(DP_AUDIT));
    audit_coalesce_reset();

    var i = 0;
    while (i < 6) { audit_event(SEV_INFO, "rot.seed", "seeder", 6); i = i + 1; }
    var live_before = _audit_store_size();
    assert(live_before > 0, "the live log has content to seal");

    # Capture the tail the sealed segment will end on — this is what the first
    # entry of the new live file must chain to.
    var tail = alloc(AUDIT_HEAD_CAP);
    var tlen = _audit_tail_hash(DP_AUDIT, tail);
    assert(tlen > 0, "the live log's tail hash is readable");
    store8(tail + tlen, 0);      # _find_cstr uses strlen; do not rely on alloc zeroing

    var rots = g_audit_rotations;
    assert_eq(audit_rotate_now(1000), 1, "rotation happens");
    assert_eq(g_audit_rotations - rots, 1, "...and is counted once");
    assert_eq(_audit_seg_path(1, sp), _audit_seg_path(1, sp), "path build is stable");
    _audit_seg_path(1, sp);
    assert_eq(file_exists(sp), 1, "the sealed segment exists on disk");

    # THE BOUNDARY. The first entry written after the rename must record the
    # sealed segment's tail as its predecessor — that is the entire ADR.
    var newtail = alloc(AUDIT_HEAD_CAP);
    var nlen = _audit_tail_hash(sp, newtail);
    assert_eq(nlen, tlen, "the sealed segment ends on the hash we captured");
    assert_eq(_audit_bytes_same_t(newtail, tail, tlen), 1, "...byte for byte");

    var livebuf = alloc(SLURP_CAP);
    var ln = file_read_all(DP_AUDIT, livebuf, SLURP_CAP - 1);
    assert(ln > 0, "the live log was recreated by the first append");
    assert(_find_cstr(livebuf, ln, "audit.rotate") >= 0,
           "the new live file opens with an audit.rotate marker");
    # The marker names the segment AND carries its head hash: a marker naming a
    # file with no hash attests nothing.
    assert(_find_cstr(livebuf, ln, "details") >= 0,
           "...and the marker carries a details field");
    # The marker names the segment AND its head hash. Checking for the hash text
    # is the assertion that matters: a marker naming a file with no hash attests
    # nothing, which is exactly what pruning-before-reading would produce.
    # Search for the MARKER TEXT — "<segno> <hash>" — not for the hash alone. The
    # hash also appears in this very entry's prev_hash field (that is the whole
    # point of seal-and-continue), so a bare hash search finds it whether or not
    # the marker carries it, and cannot tell the two apart. It could not: zeroing
    # the marker's hash survived mutation against the weaker assertion.
    var want = alloc(AUDIT_MARK_CAP);
    var wo = _str_into(want, 0, "1 ");
    memcpy(want + wo, tail, tlen);
    store8(want + wo + tlen, 0);
    assert(_find_cstr(livebuf, ln, want) >= 0,
           "...and the marker itself names the segment AND its head hash");

    # --- THE CRASH WINDOW. Rename, then die before the first append. A boot must
    # resume from the newest SEGMENT, not restart at genesis.
    xunlink(DP_AUDIT);                     # the process died here
    g_audit_chain = chain_new_streaming();
    assert_eq(chain_prev_hash(g_audit_chain), 0, "a fresh chain starts at genesis");
    _audit_resume_head();
    var resumed = chain_prev_hash(g_audit_chain);
    assert(resumed != 0,
           "with the live file GONE, the head resumes from the newest segment");
    assert(str_len(resumed) > 0, "...with a real hash, not an empty string");

    # --- Prune: the segment falling out of the keep window is attested, then
    # removed. Deletion must be recorded inside the chain that survives.
    var pr = g_audit_pruned;
    g_audit_store = filestore_open(str_from(DP_AUDIT));
    _audit_seg_path(1, sp);
    assert_eq(file_exists(sp), 1, "segment 1 is still there before the prune");
    # Capture the victim's head hash BEFORE it is deleted — that is what the
    # attestation must carry, and it is unreadable afterwards.
    var vhash = alloc(AUDIT_HEAD_CAP);
    var vlen = _audit_tail_hash(sp, vhash);
    assert(vlen > 0, "the victim segment's head hash is readable before pruning");
    store8(vhash + vlen, 0);

    _audit_prune(1 + AUDIT_SEG_KEEP, 2000);
    assert_eq(g_audit_pruned - pr, 1, "the victim segment is pruned");
    _audit_seg_path(1, sp);
    assert_eq(file_exists(sp), 0, "...and is gone from disk");
    var pl = file_read_all(DP_AUDIT, livebuf, SLURP_CAP - 1);
    assert(_find_cstr(livebuf, pl, "audit.prune") >= 0,
           "...with the deletion attested in the surviving chain");
    # THE ORDERING GUARD. The marker must carry the victim's hash, which is only
    # possible if it was read BEFORE the unlink. Asserting the marker merely
    # exists does not catch unlink-first — the entry is still written, it just
    # attests nothing. That weaker assertion let the mutation survive.
    var pwant = alloc(AUDIT_MARK_CAP);
    var pwo = _str_into(pwant, 0, "1 ");
    memcpy(pwant + pwo, vhash, vlen);
    store8(pwant + pwo + vlen, 0);
    assert(_find_cstr(livebuf, pl, pwant) >= 0,
           "...and the attestation carries the deleted segment's HASH, so it was read first");

    # A victim that does not exist is a no-op, not an error — pruning is
    # self-correcting if an operator removed a file by hand.
    var pr2 = g_audit_pruned;
    _audit_prune(1 + AUDIT_SEG_KEEP, 2001);
    assert_eq(g_audit_pruned - pr2, 0, "pruning an absent segment does nothing");

    # --- Never clobber a sealed segment. rename(2) replaces silently, so a stale
    # cache would be an unrecoverable deletion of attested history.
    _audit_seg_path(2, sp);
    file_write_all(sp, "planted", 7);
    g_audit_seg_hi = 1;                   # stale: says the next free is 2
    var rots2 = g_audit_rotations;
    assert_eq(audit_rotate_now(3000), 0, "rotation REFUSES to overwrite a sealed segment");
    assert_eq(g_audit_rotations - rots2, 0, "...and is not counted");
    assert_eq(g_audit_seg_hi, 0 - 1, "...and drops its cache so the next check re-scans");
    var chk = alloc(64);
    assert_eq(file_read_all(sp, chk, 64), 7, "the planted segment is untouched");
    xunlink(sp);

    # --- Cleanup.
    _audit_seg_path(1, sp); xunlink(sp);
    sn = 1;
    while (sn <= AUDIT_SEG_KEEP + 3) { _audit_seg_path(sn, sp); xunlink(sp); sn = sn + 1; }
    xunlink(DP_AUDIT);
    DP_AUDIT = saved_audit;
    g_audit_seg_hi = saved_hi;
    g_audit_chain = chain_save;
    g_audit_store = store_save;
    audit_coalesce_reset();
    return 0;
}

# === 1.7.3 — a failing save backs off instead of retrying every tick. ===
#
# `player_save` clears SS_SAVE_DIRTY only after a successful rename, so a session
# whose save fails stays dirty AND stays due: the "last success" stamp never
# advances either, so `save_sweep_due` said yes on every tick. Four signed saves
# every 2.5 s, from sessions merely sitting there, unbounded in time — and under
# ENOSPC the audit log grows fastest exactly when it can least afford to.
#
# `now` is a parameter, so the whole backoff window is enumerable without a clock.
fn test_save_backoff(): i64 {
    test_group("save-backoff");

    var s = _freeable_sess();
    store64(s + SS_AUTHED, 1);
    store64(s + SS_SAVE_DIRTY, 1);
    store64(s + SS_LAST_SAVE_MS, 0);
    store64(s + SS_LAST_SAVE_TRY_MS, 0);

    # Never attempted: due immediately. The zero-stamp guard matters because
    # clock_now_ms is ms since BOOT — reading 0 as "attempted at time 0" would
    # suppress the first autosave of every session on a young host, which is the
    # bug 1.6.8 found in this very function.
    assert_eq(save_sweep_due(s, 0), 1, "a never-attempted dirty session is due at now == 0");
    assert_eq(save_sweep_due(s, 1000), 1, "...and at any later now");

    # After an attempt, it backs off for SAVE_RETRY_MIN_MS — whether or not the
    # attempt succeeded, which is the point: failure must not get MORE attention.
    store64(s + SS_LAST_SAVE_TRY_MS, 10000);
    assert_eq(save_sweep_due(s, 10000), 0, "an attempt just now is not retried immediately");
    assert_eq(save_sweep_due(s, 10000 + SAVE_RETRY_MIN_MS - 1), 0,
              "...nor one millisecond inside the backoff");
    assert_eq(save_sweep_due(s, 10000 + SAVE_RETRY_MIN_MS), 1,
              "...and is retried once the backoff has passed");

    # Clean sessions are still never due, backoff or not.
    store64(s + SS_SAVE_DIRTY, 0);
    assert_eq(save_sweep_due(s, 10000 + SAVE_RETRY_MIN_MS), 0,
              "a session with nothing to save is never due");
    store64(s + SS_SAVE_DIRTY, 1);

    # The retry gap is deliberately shorter than the autosave cadence: a transient
    # failure should recover in seconds, not in five minutes.
    assert(SAVE_RETRY_MIN_MS < SAVE_SWEEP_MIN_MS,
           "the retry backoff is shorter than the autosave interval");

    # --- The real writer stamps the attempt even when it FAILS. Drive an actual
    # failure: an unwritable path. Without the stamp the session is due again on
    # the very next tick, which is the defect.
    var nm = load64(s + SS_NAME_BUF);
    memcpy(nm, "Backoff", 7);
    store64(s + SS_NAME_LEN, 7);
    var salt = alloc(SALT_LEN);
    var q = 0;
    while (q < SALT_LEN) { store8(salt + q, 51 + q); q = q + 1; }
    var blk = sess_ident(s);
    memcpy(blk, salt, SALT_LEN);
    ident_derive(salt, "backoffphrase", 13, blk + IDENT_SK, blk + IDENT_PK);
    store64(s + SS_ROOM, 0 - 1);
    store64(s + SS_LAST_SAVE_TRY_MS, 0);

    var saved_dir = DP_PLAYERS_S;
    DP_PLAYERS_S = "/proc/nonexistent-dir-for-test/";   # writes here cannot succeed
    var rc = player_save(s);
    DP_PLAYERS_S = saved_dir;
    assert_eq(rc, 0 - 1, "the save really did fail");
    assert(load64(s + SS_LAST_SAVE_TRY_MS) != 0,
           "a FAILED save still stamps the attempt, so the retry backs off");
    assert_eq(load64(s + SS_SAVE_DIRTY), 1, "...and the session stays dirty, so nothing is lost");

    session_free(s);
    return 0;
}

# === 1.7.3 — two guards that predate the mutation habit. ===
#
# Both were found by a coverage check, not by a failure: reverting either changed
# no test. A guard with no test is a guard that will be removed by someone tidying
# up, and these two protect a secret key and a duplicated character respectively.
fn test_legacy_guards(): i64 {
    test_group("legacy-guards");

    # --- F: the `passwd` candidate block holds a DERIVED SECRET KEY, and
    # sess_cand_clear wipes it before returning the block to the freelist. That
    # matters because fl_free reuses blocks WITHOUT zeroing (H8, 1.6.4), so an
    # unwiped candidate would hand the next allocation someone's private key.
    var s = _freeable_sess();
    var cand = sess_cand(s);
    assert(cand != 0, "the candidate block allocates");
    # Fill it the way a real re-key does — a recognisable non-zero pattern.
    var i = 0;
    while (i < CAND_LEN) { store8(cand + i, 0xA5); i = i + 1; }
    var nonzero = 0;
    i = 0;
    while (i < CAND_LEN) {
        if ((load8(cand + i) & 0xFF) != 0) { nonzero = nonzero + 1; }
        i = i + 1;
    }
    assert_eq(nonzero, CAND_LEN, "the candidate really is full of key material");

    sess_cand_clear(s);
    assert_eq(load64(s + SS_IDENT_CAND), 0, "the session no longer references the block");
    # Read the freed block deliberately. This is the only way to assert the wipe:
    # the bytes are what the next fl_alloc of this size class will hand out, and
    # fl_free does not zero them.
    var still = 0;
    i = 0;
    while (i < CAND_LEN) {
        if ((load8(cand + i) & 0xFF) != 0) { still = still + 1; }
        i = i + 1;
    }
    assert_eq(still, 0,
              "the secret key is WIPED before the block returns to the freelist");
    session_free(s);

    # --- G: the double-login refusal, asserted AT ITS CALL SITE. The predicate
    # had a test; the refusal did not, so replacing the check with a constant
    # false broke nothing. Two sessions on one character means two writers to one
    # save record — the inventory duplication 1.6.6 fixed.
    var gh = g_session_head;
    _player_unlink("Twinned", 7);
    var first = _mk_sess("Twinned", 7);
    var fsalt = alloc(SALT_LEN);
    var fq = 0;
    while (fq < SALT_LEN) { store8(fsalt + fq, 23 + fq); fq = fq + 1; }
    var fblk = sess_ident(first);
    memcpy(fblk, fsalt, SALT_LEN);
    ident_derive(fsalt, "twinnedphrase", 13, fblk + IDENT_SK, fblk + IDENT_PK);
    store64(fblk + IDENT_CREATED, 1000000);
    store64(first + SS_ROOM, 0 - 1);
    store64(first + SS_HP, 8); store64(first + SS_MAXHP, 8);
    store64(first + SS_AUTHED, 1);
    assert_eq(player_save(first), 1, "the first session has a record");

    # Put the authenticated first session on the live list — that is what
    # session_already_online walks.
    store64(first + SS_NEXT, 0);
    g_session_head = first;

    var second = _mk_sess("Twinned", 7);
    store64(second + SS_LINE_BUF, fl_alloc(LINE_CAP));
    store64(second + SS_FD, 0 - 1);
    store64(second + SS_PHASE, PHASE_PASS);
    _tx_reset(second);
    login_on_pass(second, "twinnedphrase", 13);
    # The refusal CONDEMNS the session (SS_QUIT) rather than un-authenticating it:
    # player_auth_load has already proved who they are by this point, which is
    # deliberate — checking earlier would let the prompt be used to probe who is
    # online. So the observable is SS_QUIT, not SS_AUTHED.
    assert_eq(load64(second + SS_QUIT), 1,
              "a SECOND login to a character already online is REFUSED");
    assert(load64(second + SS_PHASE) != PHASE_CMD,
           "...and never reaches the command prompt");
    assert_eq(load64(first + SS_QUIT), 0,
              "...while the session that got there first is untouched");
    assert_eq(_contains(load64(second + SS_TX_BUF), load64(second + SS_TX_LEN),
                        "already connected"), 1,
              "...and the second session is told why");

    g_session_head = gh;
    _player_unlink("Twinned", 7);
    return 0;
}

# === 1.7.2 — player records are sharded, and the old layout still works. ===
#
# Records move from `data/players/<name>.cyml` to `data/players/<c>/<name>.cyml`
# so a world with thousands of accounts is not one directory with thousands of
# files. The whole risk of the change is EXISTING deployments, so that is what
# this group is about: a migration that locks out current players is not a
# migration, it is an outage.
fn test_player_sharding(): i64 {
    test_group("player-sharding");

    # --- The path itself.
    _path_for("Shardy", 6, g_persist_path);
    assert(_find_cstr(g_persist_path, 40, "/s/shardy.cyml") >= 0,
           "a record's path carries a one-character shard directory");
    _path_for_flat("Shardy", 6, g_persist_path);
    assert(_find_cstr(g_persist_path, 40, "/shardy.cyml") >= 0,
           "and the legacy builder still produces the flat path");
    assert_eq(_find_cstr(g_persist_path, 40, "/s/shardy.cyml"), 0 - 1,
              "...which is NOT the sharded one");

    # The length bound at the primitive. PATH_CAP sized the buffers and was
    # compared against nothing; an over-long name is now clamped rather than
    # written past the end. Not reachable through login_name_ok — this is the
    # 0.9.0 hex_decode_into lesson applied to a primitive that trusted its caller.
    var longnm = alloc(4096);
    var q = 0;
    while (q < 4000) { store8(longnm + q, 97); q = q + 1; }
    var wrote = _path_for(longnm, 4000, g_persist_path);
    assert(wrote < PATH_CAP,
           "an over-long name cannot write past the path buffer");
    assert(wrote <= strlen(DP_PLAYERS_S) + 2 + NAME_MAX + 5,
           "...because the name is clamped to NAME_MAX");

    # --- THE MIGRATION. Write a record the OLD way, then prove it still loads.
    _player_unlink("Legacyman", 9);
    var old_s = _mk_sess("Legacyman", 9);
    var lsalt = alloc(SALT_LEN);
    var li = 0;
    while (li < SALT_LEN) { store8(lsalt + li, 17 + li); li = li + 1; }
    var lblk = sess_ident(old_s);
    memcpy(lblk, lsalt, SALT_LEN);
    ident_derive(lsalt, "legacyphrase", 12, lblk + IDENT_SK, lblk + IDENT_PK);
    store64(lblk + IDENT_CREATED, 1000000);
    store64(old_s + SS_ROOM, 0 - 1);
    store64(old_s + SS_HP, 21); store64(old_s + SS_MAXHP, 21);
    store64(old_s + SS_AUTHED, 1);
    assert_eq(player_save(old_s), 1, "a record saves");

    # Move it to where a pre-1.7.2 server would have put it.
    _path_for("Legacyman", 9, g_persist_path);
    var rec = alloc(SLURP_CAP);
    var rn = file_read_all(g_persist_path, rec, SLURP_CAP - 1);
    assert(rn > 0, "the sharded record is readable");
    syscall(87, g_persist_path);                     # remove the sharded copy
    _path_for_flat("Legacyman", 9, g_persist_path);
    assert(file_write_all(g_persist_path, rec, rn) >= 0, "the legacy copy is written");

    # This is the assertion that matters: a player who has not logged in since
    # before 1.7.2 must still be found and must still authenticate.
    assert_eq(player_exists("Legacyman", 9), 1,
              "a LEGACY flat record is still found — the name is still taken");
    var back = _mk_sess("Legacyman", 9);
    assert_eq(player_auth_load(back, "legacyphrase", 12), 1,
              "...and still authenticates, so nobody is locked out by the layout change");
    assert_eq(load64(back + SS_HP), 21, "...with their state intact");

    # And saving migrates them, lazily, with no operator action.
    assert_eq(player_save(back), 1, "their next save succeeds");
    _path_for("Legacyman", 9, g_persist_path);
    assert(file_read_all(g_persist_path, rec, SLURP_CAP - 1) > 0,
           "the record is now at the SHARDED path");
    _path_for_flat("Legacyman", 9, g_persist_path);
    # file_read_all returns a NEGATIVE error for a missing file, not 0 — assert
    # "not readable" rather than pinning the exact errno.
    assert(file_read_all(g_persist_path, rec, SLURP_CAP - 1) <= 0,
           "...and the legacy copy is retired, so it cannot go stale");

    _player_unlink("Legacyman", 9);

    # --- A FRESH deployment, where the shard directory does not exist yet.
    #
    # This is the case the rest of this group cannot see: every other assertion
    # here passes whether or not player_save creates the directory, because
    # earlier runs left `data/players/a` … `d` lying around. Deleting the mkdir
    # therefore SURVIVED mutation while being an outage on a first boot — every
    # save failing because its directory is missing. So the directory is removed
    # first, deliberately, and the save must still land.
    #
    # 'z' is chosen because no other fixture in this suite starts with it, so the
    # rmdir cannot race another group's records.
    _player_unlink("Zephyr", 6);
    var zdir = alloc(64);
    memcpy(zdir, DP_PLAYERS_S, strlen(DP_PLAYERS_S));
    store8(zdir + strlen(DP_PLAYERS_S), 122);          # 'z'
    store8(zdir + strlen(DP_PLAYERS_S) + 1, 0);
    syscall(84, zdir);                                  # rmdir(2); ENOENT is fine

    var zs = _mk_sess("Zephyr", 6);
    var zsalt = alloc(SALT_LEN);
    var zi = 0;
    while (zi < SALT_LEN) { store8(zsalt + zi, 71 + zi); zi = zi + 1; }
    var zblk = sess_ident(zs);
    memcpy(zblk, zsalt, SALT_LEN);
    ident_derive(zsalt, "zephyrphrase", 12, zblk + IDENT_SK, zblk + IDENT_PK);
    store64(zblk + IDENT_CREATED, 1000000);
    store64(zs + SS_ROOM, 0 - 1);
    store64(zs + SS_HP, 13); store64(zs + SS_MAXHP, 13);
    store64(zs + SS_AUTHED, 1);
    assert_eq(player_save(zs), 1,
              "a save into a shard directory that does not exist yet CREATES it and succeeds");
    assert_eq(player_exists("Zephyr", 6), 1, "...and the record is findable afterwards");
    var zback = _mk_sess("Zephyr", 6);
    assert_eq(player_auth_load(zback, "zephyrphrase", 12), 1, "...and loads back");
    _player_unlink("Zephyr", 6);

    return 0;
}

# === 1.7.2 — the carry cap is a bound, and a full bag never poisons a save. ===
#
# Two halves of one defect, and the second is the reason the first mattered.
#
# `inv_count` walked only the top-level SS_INV chain while `cmd_put` moved items
# into a carried container without counting them — so an ordinary player could
# fill their hands, put the lot in a sack, and acquire another full load, without
# bound. Meanwhile `_build_record` FLATTENS one level back into the same `inv`
# field, so the bytes a save must serialise are the TOTAL. The cap and the
# serialiser were counting two different collections.
#
# And when the serialiser ran out of budget, its inner contents loop set SAVE_ERR
# — which M11-D turns into "refuse the whole record" — ten lines below a comment
# saying to truncate instead. So the 1.6.13 defect (a player silently stops
# persisting, forever, until they drop something) was fully reachable through a
# bag, by a player with no malice at all.
fn test_carry_cap_container(): i64 {
    test_group("carry-cap-container");

    var s = _freeable_sess();
    store64(s + SS_AUTHED, 1);
    store64(s + SS_ROOM, 0 - 1);
    store64(s + SS_INV, 0);

    # --- inv_count sees what is in the bag.
    assert_eq(inv_count(s), 0, "an empty session carries nothing");
    if (g_obj_tpl_count == 0) { assert(0, "carry-cap-container: needs object templates"); return 0; }
    var bag = item_new(ot_at(0));
    assert(bag != 0, "an object instance is available to test with");
    ilist_push(s + SS_INV, bag);
    assert_eq(inv_count(s), 1, "the bag itself counts");

    var k = 0;
    while (k < 5) {
        ilist_push(bag + OI_CONTENTS, item_new(ot_at(0)));
        k = k + 1;
    }
    # THE ASSERTION. Before 1.7.2 this read 1: the five items were invisible to
    # the cap because they had left SS_INV.
    assert_eq(inv_count(s), 6,
              "items inside a carried container COUNT — the bag is not a loophole");

    # --- ...but the cap must not OVER-apply. Counting bag contents made
    # `get <x> from <my own bag>` fail at the cap, because the total is unchanged
    # by that move and `inv_full` refused it anyway — so a player at 100 could
    # never retrieve their own belongings. A regression introduced by the line
    # above, caught by the class sweep, and the reason the cap now asks whether
    # the SOURCE is already yours.
    assert_eq(inv_owns_slot(s, s + SS_INV), 1, "your own inventory slot is yours");
    assert_eq(inv_owns_slot(s, bag + OI_CONTENTS), 1, "a bag you carry is yours");
    var loose = item_new(ot_at(0));
    assert_eq(inv_owns_slot(s, loose + OI_CONTENTS), 0,
              "a container you are NOT carrying is not yours");
    assert_eq(inv_owns_slot(s, 0), 0, "and a null slot is not yours");

    # Drive the real verb at the cap: taking from a carried bag must succeed.
    var atcap = _freeable_sess();
    store64(atcap + SS_AUTHED, 1);
    store64(atcap + SS_ROOM, 0 - 1);
    store64(atcap + SS_INV, 0);
    var cbag = item_new(ot_at(0));
    ilist_push(atcap + SS_INV, cbag);
    var ci2 = 0;
    while (ci2 < MAX_INV + 10) {
        ilist_push(cbag + OI_CONTENTS, item_new(ot_at(0)));
        ci2 = ci2 + 1;
    }
    assert_eq(inv_full(atcap), 1, "this session really is over the cap");
    # Count the TOP LEVEL, not the total. The total is unchanged whether the item
    # moved or the move was refused, so asserting on it cannot tell success from
    # failure — the first version of this assertion did exactly that and let the
    # regression survive mutation.
    var before_top = _top_count(atcap);
    var before_all = inv_count(atcap);
    get_from(atcap, cbag + OI_CONTENTS, atcap + SS_INV, 0,
             oi_kw_ptr(load64(cbag + OI_CONTENTS)), 1, 1, "in your bag");
    assert_eq(_top_count(atcap), before_top + 1,
              "taking from your OWN bag at the cap REALLY MOVES the item into your hands");
    assert_eq(inv_count(atcap), before_all,
              "...and the total you carry is unchanged, which is why the cap must not apply");
    _drain_ilist(atcap + SS_INV);
    session_free(atcap);

    # And the cap is therefore a real bound on what a save must serialise.
    var full = _freeable_sess();
    store64(full + SS_AUTHED, 1);
    store64(full + SS_ROOM, 0 - 1);
    store64(full + SS_INV, 0);
    var fbag = item_new(ot_at(0));
    ilist_push(full + SS_INV, fbag);
    var j = 0;
    while (j < MAX_INV + 20) {
        ilist_push(fbag + OI_CONTENTS, item_new(ot_at(0)));
        j = j + 1;
    }
    assert(inv_count(full) > MAX_INV, "the fixture really is over the cap");
    assert_eq(inv_full(full), 1,
              "a session whose bag is over the cap is FULL — acquisition is refused");
    _drain_ilist(full + SS_INV);
    session_free(full);

    # --- `give` must count what is INSIDE the gift.
    #
    # It tested `>= MAX_INV` and then transferred the item AND its contents, so
    # handing a full bag to someone under the cap left them well past it — the
    # same shape as the acquisition hole 1.7.2 closed: the check counted one
    # collection, the transfer moved another.
    #
    # Driven through the REAL verb and parser. An earlier draft of this assertion
    # recomputed the cap arithmetic in the test instead, which is the shape that
    # let three mutations survive in 1.6.12 — a test that reimplements the rule it
    # is checking cannot fail when the rule changes.
    var pa = parser_new();
    var ggh = g_session_head;
    var bgiver = _mk_sess("Bagman1", 7);
    store64(bgiver + SS_ROOM, 0); store64(bgiver + SS_PHASE, PHASE_CMD); store64(bgiver + SS_FD, 0 - 1);
    var btaker = _mk_sess("Bagman2", 7);
    store64(btaker + SS_ROOM, 0); store64(btaker + SS_PHASE, PHASE_CMD); store64(btaker + SS_FD, 0 - 1);
    store64(bgiver + SS_NEXT, btaker); store64(btaker + SS_NEXT, 0);
    g_session_head = bgiver;

    # Recipient sits 10 under the cap: a bare item would fit, a 51-item bag must not.
    var bk = 0;
    while (bk < MAX_INV - 10) { ilist_push(btaker + SS_INV, item_new(ot_at(0))); bk = bk + 1; }
    var fullbag = item_new(ot_at(0));
    ilist_push(bgiver + SS_INV, fullbag);
    bk = 0;
    while (bk < 50) { ilist_push(fullbag + OI_CONTENTS, item_new(ot_at(0))); bk = bk + 1; }

    var taker_before = inv_count(btaker);
    assert(taker_before < MAX_INV, "the recipient starts UNDER the cap");
    assert(taker_before + 51 > MAX_INV, "...but the gift plus its contents would exceed it");

    var bcmd = alloc(160);
    var bco = _str_into(bcmd, 0, "give ");
    bco = _str_into(bcmd, bco, _kw1(oi_kw_ptr(fullbag), alloc(64)));
    bco = _str_into(bcmd, bco, " to Bagman2");
    _tx_reset(bgiver);
    parser_parse(pa, bcmd, bco);
    cmd_give(bgiver, pa);

    assert_eq(inv_count(btaker), taker_before,
              "a gift whose CONTENTS would breach the cap is refused whole");
    assert_eq(_on_ilist(bgiver + SS_INV, fullbag), 1, "...and the bag stays with the giver");
    assert(inv_count(btaker) <= MAX_INV, "the recipient is never pushed past MAX_INV");

    # A bare item still goes through, so the check bounds rather than blocks.
    var bare = item_new(ot_at(0));
    ilist_push(bgiver + SS_INV, bare);
    bco = _str_into(bcmd, 0, "give ");
    bco = _str_into(bcmd, bco, _kw1(oi_kw_ptr(bare), alloc(64)));
    bco = _str_into(bcmd, bco, " to Bagman2");
    _tx_reset(bgiver);
    parser_parse(pa, bcmd, bco);
    cmd_give(bgiver, pa);
    assert_eq(inv_count(btaker), taker_before + 1,
              "a single item under the cap is still handed over");

    g_session_head = ggh;
    _drain_ilist(bgiver + SS_INV);
    _drain_ilist(btaker + SS_INV);

    # --- THE DATA-LOSS HALF, and the one that matters most.
    #
    # A bag holding enough items to exhaust the record's byte budget must
    # TRUNCATE the list, exactly as the top-level walk does — not poison the
    # record. Poisoning means `_build_record` returns -1, M11-D refuses the whole
    # record, and the player stops persisting entirely: not just the overflow
    # items but their room, HP, class and every future change, silently, until
    # they happen to drop something.
    #
    # This drives the real writer end to end, because the bug lives in the
    # interaction between the outer and inner walks. An assertion on `inv_count`
    # alone does NOT reach it — the first version of this group proved that by
    # letting the poison mutation survive.
    var poison = _mk_sess("Hoarder", 7);
    var psalt = alloc(SALT_LEN);
    var pq = 0;
    while (pq < SALT_LEN) { store8(psalt + pq, 33 + pq); pq = pq + 1; }
    var pblk = sess_ident(poison);
    memcpy(pblk, psalt, SALT_LEN);
    ident_derive(psalt, "hoarderpass", 11, pblk + IDENT_SK, pblk + IDENT_PK);
    store64(pblk + IDENT_CREATED, 1000000);
    store64(poison + SS_ROOM, 0 - 1);
    store64(poison + SS_HP, 7); store64(poison + SS_MAXHP, 7);
    store64(poison + SS_AUTHED, 1);
    store64(poison + SS_INV, 0);

    # Three loose items — comfortably under MAX_INV, which is the point: nothing
    # on the acquisition path was ever going to notice this.
    ilist_push(poison + SS_INV, item_new(ot_at(0)));
    ilist_push(poison + SS_INV, item_new(ot_at(0)));
    var sack = item_new(ot_at(0));
    ilist_push(poison + SS_INV, sack);
    var pi = 0;
    while (pi < 900) {
        ilist_push(sack + OI_CONTENTS, item_new(ot_at(0)));
        pi = pi + 1;
    }

    var pa0 = g_audit_emitted;
    audit_coalesce_reset();
    assert(_build_record(poison) > 0,
           "a record whose bag overflows the byte budget is BUILT, not refused");
    assert_eq(player_save(poison), 1,
              "...and it SAVES — the player keeps persisting, minus the overflow items");
    assert(g_audit_emitted - pa0 > 0,
           "and the truncation is audited, so an operator can see it happened");

    # It is genuinely still loadable afterwards — a truncated record is only
    # useful if it round-trips.
    var back = _mk_sess("Hoarder", 7);
    assert_eq(player_auth_load(back, "hoarderpass", 11), 1,
              "the truncated record loads back cleanly");
    assert_eq(load64(back + SS_HP), 7, "...with the non-inventory fields intact");
    # NOT session_free'd: _mk_sess leaves SS_TS == 0 and session_free calls
    # telnet_state_free unconditionally, which dereferences null. The suite's
    # _freeable_sess exists for sessions that must be torn down; these are
    # fixtures that simply go out of scope, as elsewhere in this file.
    _drain_ilist(back + SS_INV);
    _drain_ilist(poison + SS_INV);

    _drain_ilist(s + SS_INV);
    session_free(s);
    return 0;
}

# === 1.7.1 — the audit rollup window. ===
#
# Every audit_event costs 1944 permanently-unreclaimable bytes (1640 bump, which
# has no free, plus 304 of freelist blocks nothing ever releases). At 100
# reconnects/s that was 667 MiB/hour with no ceiling, unauthenticated.
#
# The bound is asserted through `audit_keyed`, which takes `now_ms` as a PARAMETER
# so a whole hour of window behaviour is enumerable without a clock.
fn test_audit_coalesce(): i64 {
    test_group("audit-coalesce");

    audit_coalesce_init();
    audit_coalesce_reset();

    var nm = alloc(8);
    memcpy(nm, "Flooder", 7);

    # --- The first occurrence of a key is written VERBATIM. Normal operation is
    # byte-identical to 1.7.0, which is what makes this safe to land.
    var e0 = g_audit_emitted;
    assert_eq(audit_keyed(AK_LOGIN_FAIL, SEV_WARNING, "login.fail", nm, 7, 1000), 1,
              "the first occurrence of a key is written verbatim");
    assert_eq(g_audit_emitted - e0, 1, "...and it really is one durable entry");

    # --- Every later occurrence in the window writes NOTHING.
    var e1 = g_audit_emitted;
    var i = 0;
    while (i < 500) {
        audit_keyed(AK_LOGIN_FAIL, SEV_WARNING, "login.fail", nm, 7, 1000 + i);
        i = i + 1;
    }
    assert_eq(g_audit_emitted - e1, 0, "500 further occurrences write NO durable entries");
    assert_eq(g_audit_dropped, 0, "...and none has been reported yet — they are still pending");

    # --- The clock arm. Crossing the window rolls up the pending count and opens
    # a fresh window, so the flood remains VISIBLE. That is the acceptance
    # criterion for this item: bound the bytes, keep the signal.
    var e2 = g_audit_emitted;
    var r2 = g_audit_rollups;
    audit_keyed(AK_LOGIN_FAIL, SEV_WARNING, "login.fail", nm, 7, 1000 + AUDIT_WINDOW_MS);
    assert_eq(g_audit_rollups - r2, 1, "crossing the window emits exactly one rollup");
    assert_eq(g_audit_emitted - e2, 2, "...which is the rollup plus the new window's verbatim entry");
    assert_eq(g_audit_dropped, 500, "and the rollup reports the EXACT suppressed count");

    # --- Distinct names are captured, deduped, and bounded.
    audit_coalesce_reset();
    var a = alloc(8); memcpy(a, "Alice", 5);
    var b = alloc(8); memcpy(b, "Bob", 3);
    audit_keyed(AK_CREATE_FAIL, SEV_WARNING, "create.fail", a, 5, 2000);   # verbatim
    audit_keyed(AK_CREATE_FAIL, SEV_WARNING, "create.fail", a, 5, 2001);   # tallied
    audit_keyed(AK_CREATE_FAIL, SEV_WARNING, "create.fail", b, 3, 2002);   # tallied, new name
    audit_keyed(AK_CREATE_FAIL, SEV_WARNING, "create.fail", a, 5, 2003);   # tallied, dupe
    var slot = _audit_slot(AK_CREATE_FAIL);
    assert_eq(load64(slot + AKE_SUPP), 3, "three occurrences tallied");
    assert_eq(load64(slot + AKE_NNAMES), 2,
              "two DISTINCT names captured — a repeat name does not consume a slot");

    # A name flood cannot grow the table: names are bounded at AUDIT_NAMES_MAX and
    # the count keeps counting. Keying on the name instead would have handed the
    # attacker the key space, which is why the key is a call-site constant.
    audit_coalesce_reset();
    audit_keyed(AK_CREATE_DUP, SEV_WARNING, "create.dup", a, 5, 3000);
    i = 0;
    while (i < 50) {
        var un = alloc(24);
        memcpy(un, "Attacker", 8);
        store8(un + 8, 65 + (i % 26));
        store8(un + 9, 65 + (i / 26));
        audit_keyed(AK_CREATE_DUP, SEV_WARNING, "create.dup", un, 10, 3000 + i);
        i = i + 1;
    }
    var dslot = _audit_slot(AK_CREATE_DUP);
    assert_eq(load64(dslot + AKE_SUPP), 50, "all 50 distinct-name occurrences are counted");
    assert_eq(load64(dslot + AKE_NNAMES), AUDIT_NAMES_MAX,
              "...but the names captured are capped, so the table cannot grow");

    # --- THE COUNT ARM, and it reads no clock. This is where the bound lives: on
    # AGNOS clock_now_ms is sys_uptime_ms and is documented FROZEN for a
    # foreground `run` program, so a clock-only design would be NO design there.
    # Driven at a literal constant `now` to prove it.
    audit_coalesce_reset();
    var e3 = g_audit_emitted;
    var r3 = g_audit_rollups;
    i = 0;
    while (i < AUDIT_SUPPRESS_MAX + 10) {
        audit_keyed(AK_SAVE_FAIL_SWEEP, SEV_WARNING, "save.fail.sweep", nm, 7, 0);
        i = i + 1;
    }
    assert_eq(g_audit_rollups - r3, 1,
              "with the clock FROZEN at 0, the count arm still reports — exactly once per 8192");
    assert_eq(g_audit_emitted - e3, 2,
              "...one verbatim opener plus one rollup, for 8202 occurrences");
    # The property that matters, stated as arithmetic: entries grow like N/8192,
    # not like N. 8202 occurrences that would have cost 8202 x 1944 = 15.9 MB now
    # cost two entries.
    assert(g_audit_emitted - e3 < (AUDIT_SUPPRESS_MAX + 10) / 100,
           "a frozen-clock flood costs entries proportional to N/8192, not to N");

    # --- audit_flush_due lands the tail of a flood that STOPPED. Without it a
    # finished attack stays counted but unwritten until its key fires again, which
    # for an attack that ended is never.
    audit_coalesce_reset();
    audit_keyed(AK_LOAD_TAMPER, SEV_SECURITY, "load.tamper", nm, 7, 5000);
    audit_keyed(AK_LOAD_TAMPER, SEV_SECURITY, "load.tamper", nm, 7, 5001);
    assert_eq(audit_flush_due(5000 + AUDIT_WINDOW_MS - 1), 0,
              "a window that has not expired is not flushed early");
    assert_eq(audit_flush_due(5000 + AUDIT_WINDOW_MS), 1,
              "an expired window is flushed by the tick even though the key went quiet");
    assert_eq(audit_flush_due(5000 + AUDIT_WINDOW_MS), 0,
              "...and flushing is idempotent — nothing pending, nothing written");

    # --- audit_flush_all ignores the clock entirely, for shutdown.
    audit_coalesce_reset();
    audit_keyed(AK_PASSWD_FAIL, SEV_WARNING, "passwd.fail", nm, 7, 9000);
    audit_keyed(AK_PASSWD_FAIL, SEV_WARNING, "passwd.fail", nm, 7, 9001);
    assert_eq(audit_flush_all(), 1, "shutdown flushes a pending tally whatever the clock says");
    assert_eq(audit_flush_all(), 0, "...and is idempotent");

    # --- Fail OPEN on an out-of-range key: behave as 1.7.0 rather than index past
    # the table. A forgotten AK_NKEYS bump must degrade, not corrupt.
    var e4 = g_audit_emitted;
    assert_eq(audit_keyed(AK_NKEYS, SEV_INFO, "test.oob", nm, 7, 1), 1,
              "an out-of-range key falls back to writing verbatim");
    assert_eq(audit_keyed(0 - 1, SEV_INFO, "test.neg", nm, 7, 1), 1,
              "...and so does a negative one");
    assert_eq(g_audit_emitted - e4, 2, "both wrote a durable entry rather than being lost");

    # --- Keys are independent: one hot key must not suppress another. A flood of
    # create.fail must not hide a single load.tamper.
    audit_coalesce_reset();
    i = 0;
    while (i < 100) {
        audit_keyed(AK_CREATE_FAIL, SEV_WARNING, "create.fail", nm, 7, 7000);
        i = i + 1;
    }
    var e5 = g_audit_emitted;
    assert_eq(audit_keyed(AK_LOAD_TAMPER, SEV_SECURITY, "load.tamper", nm, 7, 7000), 1,
              "a SECURITY event is written verbatim despite another key flooding");
    assert_eq(g_audit_emitted - e5, 1, "...as its own durable entry");

    # --- The table is sized as the arithmetic says. If someone adds a key without
    # bumping AK_NKEYS, or changes AUDIT_NAMES_MAX without AKE_SIZE, this fails.
    assert_eq(AKE_SIZE, AKE_NAMES + AUDIT_NAMES_MAX * AKE_NSTRIDE,
              "AKE_SIZE is exactly the header plus the name slots");
    assert_eq(AKE_NSTRIDE, 8 + NAME_MAX, "a name slot is a length plus NAME_MAX bytes");
    assert(AUDIT_SUPPRESS_MAX > 6000,
           "the count arm sits above the design flood's per-window count, so the clock arm governs there");
    assert(1 + 20 + AUDIT_NAMES_MAX * (1 + NAME_MAX) <= AUDIT_DET_CAP,
           "the worst-case rollup details fits the scratch buffer");

    # --- 1.7.2: the count arm must NOT re-stamp the window.
    #
    # 1.7.1's count arm pushed AKE_WOPEN forward on every fire, so above the
    # crossover rate the 60 s clock arm never came due again and freshness
    # silently disappeared — while the comment beside it asserted the ceiling
    # "carries NO rate term". This is the sixth instance of the defect class this
    # project keeps hitting, and it was inside the fix for the fifth.
    audit_coalesce_reset();
    audit_keyed(AK_LOGIN_DUP, SEV_WARNING, "login.dup", nm, 7, 1000);   # opens at t=1000
    var wslot = _audit_slot(AK_LOGIN_DUP);
    assert_eq(load64(wslot + AKE_WOPEN), 1000, "the window records when it opened");
    var w = 0;
    while (w < AUDIT_SUPPRESS_MAX + 5) {
        audit_keyed(AK_LOGIN_DUP, SEV_WARNING, "login.dup", nm, 7, 1001);
        w = w + 1;
    }
    assert_eq(load64(wslot + AKE_WOPEN), 1000,
              "the count arm does NOT move the window's start — the clock arm stays due");
    # And it really does still fire on schedule afterwards.
    var rr = g_audit_rollups;
    assert_eq(audit_flush_due(1000 + AUDIT_WINDOW_MS), 1,
              "...so an expired window is still flushed after a count-arm burst");
    assert(g_audit_rollups > rr, "and that flush produced a rollup");

    # AUDIT_VERBATIM_MAX is READ by the code, not merely documented. Until 1.7.2
    # it appeared only in prose — including the arithmetic that multiplies by it.
    assert_eq(AUDIT_VERBATIM_MAX, 1, "one verbatim entry opens a window");
    audit_coalesce_reset();
    var v0 = g_audit_emitted;
    audit_keyed(AK_SAVE, SEV_INFO, "save", nm, 7, 2000);
    audit_keyed(AK_SAVE, SEV_INFO, "save", nm, 7, 2001);
    assert_eq(g_audit_emitted - v0, AUDIT_VERBATIM_MAX,
              "exactly AUDIT_VERBATIM_MAX occurrences are written verbatim per window");

    # --- ADR 0009's size seam. A pure boundary predicate, so the threshold is
    # testable without an 8 MiB file — and 1.7.2's rotation trigger calls the SAME
    # predicate with the SAME constant, so the warning and the rotation cannot
    # disagree about where the line is.
    assert_eq(audit_size_warn_due(0), 0, "an empty log does not warn");
    assert_eq(audit_size_warn_due(AUDIT_SIZE_WARN_BYTES - 1), 0, "one byte under does not warn");
    assert_eq(audit_size_warn_due(AUDIT_SIZE_WARN_BYTES), 1, "exactly at the threshold warns");
    assert_eq(audit_size_warn_due(AUDIT_SIZE_WARN_BYTES + 1), 1, "over the threshold warns");
    # An unreadable store is not "large". Without this an absent log would warn on
    # every boot of a fresh deployment, which is the opposite of a useful signal.
    assert_eq(audit_size_warn_due(0 - 1), 0, "an unreadable store does not warn");
    # And the probe returns a real size for a store that exists.
    assert(_audit_store_size() >= 0, "the size probe reads the fixture store");

    audit_coalesce_reset();
    return 0;
}

# === 1.7.1 — an audit entry must verify as written. ===
#
# libro's read path (lib/libro.cyr:4155) substitutes str_from("{}") when a loaded
# record's `details` is absent or zero-length. The entry hash covers the details,
# so an entry WRITTEN with "" is READ BACK as "{}", recomputes to a different
# hash, and fails entry_verify — and since each entry links to its predecessor,
# it breaks chain verification from that point on.
#
# Every audit_event call site passes SS_NAME_LEN, which is 0 until a name is
# accepted. Measured in the live data/audit.libro when this was found: 436 of
# 37902 records, all create.fail / create.dup / save / char.create. A
# tamper-evident log that manufactures its own tamper reports is worse than no
# log, because it teaches an operator to ignore the alarm.
#
# This drives audit_event for real and then verifies what landed on disk, rather
# than asserting on the argument — the whole bug lives in the round trip.
fn test_audit_verifiable(): i64 {
    test_group("audit-verifiable");

    if (g_audit_chain == 0) {
        assert(0, "no audit chain — persist_init did not run, this group cannot check anything");
        return 0;
    }

    # An entry with a ZERO-LENGTH name: the exact shape that used to write a
    # self-reported forgery.
    var n0 = g_audit_emitted;
    audit_event(SEV_INFO, "test.emptyname", 0, 0);
    assert_eq(g_audit_emitted - n0, 1, "an empty-name event still writes one entry");

    # And one with a real name, so the comparison is like-for-like.
    var nm = alloc(8);
    memcpy(nm, "Verifee", 7);
    audit_event(SEV_INFO, "test.realname", nm, 7);
    assert_eq(g_audit_emitted - n0, 2, "and a named event writes one more");

    # Now read the durable store back and verify EVERY entry libro parses. This is
    # the assertion the bug fails: before the fix, the empty-details entry read
    # back as "{}" and its recomputed hash did not match the one on disk.
    var st = filestore_open(str_from(DP_AUDIT));
    var loaded = filestore_load_all(st);
    var n = vec_len(loaded);
    assert(n >= 2, "the store contains at least the two entries just written");

    # Check the TAIL — the two entries this test wrote. Verifying the whole file
    # would fail on the 436 pre-existing records, which are deliberately NOT
    # repaired: rewriting a hash-chained log is the one thing it exists to
    # prevent. So this asserts the property for what THIS release writes.
    var bad = 0;
    var i = n - 2;
    while (i < n) {
        if (entry_verify(vec_get(loaded, i)) != 1) { bad = bad + 1; }
        i = i + 1;
    }
    assert_eq(bad, 0,
              "both entries just written verify against their own recorded hash");

    # The adjacent-link check over the same tail — an entry can self-verify and
    # still break the chain, so both properties are asserted.
    var tail = vec_new();
    i = n - 2;
    while (i < n) { vec_push(tail, vec_get(loaded, i)); i = i + 1; }
    assert_eq(verify_chain(tail, 1), 0,
              "...and they link to each other, so the chain is intact across them");

    return 0;
}

# === 1.7.1 — `passwd` has a rate, and the rate is bounded. ===
#
# G2 (1.6.12) capped the attempts inside one re-key and then RESET the counter on
# abandoning it, so invocations were unbounded. PHASE_CHPASS_CONFIRM is the
# dearest line reachable without a victim's credential — a derive and a sign.
#
# `chpass_rate_limited` takes `now_ms` as a parameter precisely so this group can
# enumerate its domain instead of sleeping, which is what a wall-clock assertion
# would degenerate into on a shared runner.
fn test_chpass_rate(): i64 {
    test_group("chpass-rate");

    var s = _freeable_sess();
    store64(s + SS_AUTHED, 1);

    # --- The predicate, over its whole domain.
    store64(s + SS_LAST_CHPASS_MS, 0);
    assert_eq(chpass_rate_limited(s, 0), 0,
              "a session that has never re-keyed is not limited, even at now == 0");
    assert_eq(chpass_rate_limited(s, 5), 0,
              "...and not limited on a host that booted 5 ms ago either");
    # THE GUARD THAT MATTERS. clock_now_ms() is ms since BOOT, so without the
    # `last == 0` check `now - 0 < CHPASS_MIN_INTERVAL_MS` refuses the first
    # `passwd` on any server up for less than ten seconds. This is the exact bug
    # 1.6.8 found in save_sweep_due, and the reason it is asserted here rather
    # than trusted.
    assert_eq(chpass_rate_limited(s, CHPASS_MIN_INTERVAL_MS - 1), 0,
              "never-re-keyed is not limited even inside the interval since boot");

    store64(s + SS_LAST_CHPASS_MS, 1000);
    assert_eq(chpass_rate_limited(s, 1000), 1, "a re-key at the same instant is limited");
    assert_eq(chpass_rate_limited(s, 1000 + CHPASS_MIN_INTERVAL_MS - 1), 1,
              "one ms inside the interval is still limited");
    assert_eq(chpass_rate_limited(s, 1000 + CHPASS_MIN_INTERVAL_MS), 0,
              "exactly at the interval is allowed — the bound is a minimum GAP");
    assert_eq(chpass_rate_limited(s, 1000 + CHPASS_MIN_INTERVAL_MS + 1), 0,
              "and past it, allowed");

    # The rate is deliberately slower than the `save` gate, because a re-key is a
    # rare deliberate act and the line behind it is far dearer. If someone
    # collapses the two constants this fails.
    assert(CHPASS_MIN_INTERVAL_MS > SAVE_MIN_INTERVAL_MS,
           "the re-key gate is slower than the anti-burst gate on `save`");

    # --- The verb honours it, and stamps on the way through.
    store64(s + SS_LAST_CHPASS_MS, 0);
    store64(s + SS_PHASE, PHASE_CMD);
    passwd_begin(s);
    assert_eq(load64(s + SS_PHASE), PHASE_CHPASS_NEW, "a first `passwd` starts the re-key");
    assert(load64(s + SS_LAST_CHPASS_MS) != 0, "...and stamps the invocation time");

    # Immediately again: refused, and the phase must NOT move — a session left in
    # PHASE_CHPASS_NEW by a refused invocation would have echo off and be waiting
    # for a passphrase nobody asked it for.
    store64(s + SS_PHASE, PHASE_CMD);
    passwd_begin(s);
    assert_eq(load64(s + SS_PHASE), PHASE_CMD,
              "a re-key inside the interval is refused and leaves the phase alone");

    # And it is a RATE limit, not a one-shot: rewinding the stamp past the
    # interval lets it through again.
    store64(s + SS_LAST_CHPASS_MS, 1);
    store64(s + SS_PHASE, PHASE_CMD);
    passwd_begin(s);
    assert_eq(load64(s + SS_PHASE), PHASE_CHPASS_NEW,
              "once the interval has passed, `passwd` works again");

    # --- An UNAUTHENTICATED session is still refused for its own reason, and the
    # rate gate must not have moved ahead of that check: an unauthed session owns
    # no record, so re-keying it is meaningless whatever the clock says.
    var u = _freeable_sess();
    store64(u + SS_AUTHED, 0);
    store64(u + SS_PHASE, PHASE_CMD);
    passwd_begin(u);
    assert_eq(load64(u + SS_PHASE), PHASE_CMD, "an unauthed session cannot start a re-key");
    assert_eq(load64(u + SS_LAST_CHPASS_MS), 0,
              "...and is not charged a rate-limit stamp for the attempt");
    session_free(u);
    session_free(s);

    return 0;
}

# === 1.7.0 — the charge window. ===
#
# The budget that replaced a line count. `charge_stop` is a PURE function of its
# three arguments — no clock, no globals — specifically so the suite can
# enumerate its domain instead of arranging a socket, and so reverting any clause
# fails a test rather than only a bench.
fn test_charge_window(): i64 {
    test_group("charge-window");

    # --- The four clauses of the guard, each isolated.
    assert_eq(charge_stop(999999, 0, 0), 0, "cap 0 is UNMETERED — 1.6.15 behaviour");
    assert_eq(charge_stop(999999, 0 - 5, 0), 0, "a negative cap is unmetered too, not inverted");
    assert_eq(charge_stop(0, 20, 0), 0, "PROGRESS: the first line of a window always runs");
    assert_eq(charge_stop(0, 20, 999), 0, "...even when its own bound exceeds the whole cap");
    assert_eq(charge_stop(20, 20, 0), 1, "METERED: spend == cap stops");
    assert_eq(charge_stop(21, 20, 0), 1, "...and over-spend stops");
    assert_eq(charge_stop(19, 20, 0), 0, "under cap with no known bound proceeds");
    assert_eq(charge_stop(19, 20, 1), 0, "...and proceeds when the bound just fits (19+1 == 20)");
    assert_eq(charge_stop(19, 20, 2), 1, "PRE-CHARGE: a bound that would overshoot waits");
    assert_eq(charge_stop(14, 20, 7), 1, "two wrong passphrases fit; a third is pre-charged out");

    # The progress clause is what makes the window safe rather than a deadlock.
    # A successful login is CHG_DERIVE + CHG_VERIFY = 54 units against a cap of
    # 20; without progress it could never run at any cap and the session would
    # wedge forever. This is the assertion that would catch removing it.
    assert(CHG_DERIVE + CHG_VERIFY > PASS_CHARGE_MAX,
           "the dearest line really is dearer than the cap — so progress is load-bearing");
    assert_eq(charge_stop(0, PASS_CHARGE_MAX, CHG_DERIVE + CHG_VERIFY), 0,
              "a login dearer than the whole cap still runs as a window's first line");

    # --- The charge table must not UNDERCHARGE the measurements it was derived
    # from. This is the arithmetic that used to live in a comment and be wrong.
    # A comment cannot fail CI; these can.
    assert(CHG_DERIVE * CHARGE_UNIT_US >= MEAS_DERIVE_US,
           "CHG_DERIVE covers a measured ident_derive");
    assert(CHG_SIGN * CHARGE_UNIT_US >= MEAS_SIGN_LINE_US,
           "CHG_SIGN covers the dearest measured sign-bearing line");
    assert(CHG_VERIFY * CHARGE_UNIT_US >= MEAS_VERIFY_US,
           "CHG_VERIFY covers a measured ed25519_verify");
    assert((CHG_DERIVE + CHG_VERIFY) * CHARGE_UNIT_US >= MEAS_DEAREST_US,
           "a full login charge covers the measured dearest line");
    assert((CHG_DERIVE + CHG_SIGN) * CHARGE_UNIT_US >= MEAS_DEAR_UNAUTH_US,
           "the dearest UNAUTHENTICATED line is covered by its charge");

    # --- The four sizing constraints on PASS_CHARGE_MAX, asserted rather than
    # asserted-in-prose. Each is a separate claim and each can rot alone.
    assert(2 * PASS_CHARGE_MAX * CHARGE_UNIT_US <= ADR1_DRIFT_US / 5,
           "two sustained windows stay inside a fifth of the drift allowance");
    assert(CHG_DERIVE + CHG_SIGN <= PASS_CHARGE_MAX,
           "the cap admits the dearest unauthenticated line from the cap, not by luck");
    assert(CHG_DERIVE + CHG_SIGN + CHG_DERIVE + CHG_SIGN > PASS_CHARGE_MAX,
           "...but not two of them");
    assert(PASS_CHARGE_MAX < CHG_DERIVE + CHG_VERIFY,
           "the cap is below the dearest line, so a window overruns by at most one");

    # --- line_crypto_bound: the passphrase phases are known-cost, the open-ended
    # ones deliberately are not.
    # The bound is what the line is CERTAIN to spend, not the most it could: a
    # PHASE_PASS line always derives, and only verifies if the derived key
    # matches. Charging the verify up front would halve throughput on the
    # wrong-passphrase path for no gain in the bound, since the progress clause
    # absorbs an over-cap line either way.
    assert_eq(line_crypto_bound(PHASE_PASS), CHG_DERIVE,
              "PHASE_PASS pre-charges the CERTAIN derive, not the conditional verify");
    assert_eq(line_crypto_bound(PHASE_NEWPASS), CHG_DERIVE, "PHASE_NEWPASS is one derive");
    assert_eq(line_crypto_bound(PHASE_CONFIRMPASS), CHG_DERIVE, "PHASE_CONFIRMPASS is one derive");
    assert_eq(line_crypto_bound(PHASE_CHPASS_CONFIRM), CHG_DERIVE,
              "PHASE_CHPASS_CONFIRM's sign is conditional on the confirm matching");
    assert_eq(line_crypto_bound(PHASE_CLASS), CHG_SIGN, "PHASE_CLASS always saves, so the sign is certain");
    # The property that makes the cheaper bound safe: either way, one window
    # cannot exceed the dearest single line.
    assert(PASS_CHARGE_MAX < CHG_DERIVE + CHG_VERIFY,
           "a window's overrun is bounded by one dear line, not by cap + one dear line");
    assert_eq(charge_stop(CHG_DERIVE, PASS_CHARGE_MAX, CHG_DERIVE), 0,
              "two wrong passphrases fit one window (7 + 7 <= 20)");
    assert_eq(charge_stop(2 * CHG_DERIVE, PASS_CHARGE_MAX, CHG_DERIVE), 1,
              "...and a third does not (14 + 7 > 20)");
    assert_eq(charge_stop(CHG_DERIVE + CHG_VERIFY, PASS_CHARGE_MAX, CHG_DERIVE), 1,
              "a successful login spends the window in one line and stops the pass");
    assert_eq(line_crypto_bound(PHASE_CMD), 0,
              "PHASE_CMD is NOT flat (46 us to 4050 us) — metered after the fact, not predicted");
    assert_eq(line_crypto_bound(PHASE_NAME), 0, "PHASE_NAME is a stat(2) — nothing to pre-charge");

    # --- The window snapshots rather than zeroes, so work done BEFORE it opened
    # is not billed to it. This is what keeps save_sweep's four signs out of the
    # drain's window when both run in one advance_tick.
    var d_before = g_charge_derives;
    var sk = alloc(64); var pk = alloc(32); var salt = alloc(SALT_LEN);
    var i = 0;
    while (i < SALT_LEN) { store8(salt + i, 21 + i); i = i + 1; }
    ident_derive(salt, "prewindowwork", 13, sk, pk);
    assert_eq(g_charge_derives, d_before + 1, "a derive outside any window still counts globally");
    charge_window_open(PASS_CHARGE_MAX);
    assert_eq(charge_spent(), 0, "a freshly opened window has spent NOTHING of the prior work");
    ident_derive(salt, "inwindowwork", 12, sk, pk);
    assert_eq(charge_spent(), CHG_DERIVE, "...and bills a derive performed inside it");
    ident_derive(salt, "inwindowwork2", 13, sk, pk);
    assert_eq(charge_spent(), 2 * CHG_DERIVE, "charges accumulate within a window");
    charge_window_close();
    assert_eq(g_charge_cap, 0, "closing a window returns to unmetered");
    assert_eq(charge_stop(charge_spent(), g_charge_cap, 0), 0,
              "and a closed window never stops anything");

    # --- Prose is charged by bytes ESCAPED, not bytes offered. Charging `len`
    # after a TX_CAP truncation would bill a peer for work the server declined,
    # which turns the meter into a way to exhaust a shared budget cheaply.
    var t = _freeable_sess();
    charge_window_open(PASS_CHARGE_MAX);
    var pb = g_charge_prose_bytes;
    var wrote = session_appendtx_prose(t, "hello", 5);
    assert_eq(wrote, 5, "five printable bytes are written");
    assert_eq(g_charge_prose_bytes - pb, 5, "...and exactly five are charged");

    # The cases where ESCAPED and OFFERED genuinely differ. The first draft of
    # this test used only w == len cases plus a full-queue case that returns
    # before the charge line, so charging `len` instead of `w` SURVIVED
    # mutation — the assertions could not tell the two apart. These can.

    # (a) Control bytes are DROPPED, so w < len. Charging `len` would bill for
    # bytes that were never escaped and never sent.
    var pb_ctl = g_charge_prose_bytes;
    var ctl = alloc(4);
    store8(ctl + 0, 97); store8(ctl + 1, 1); store8(ctl + 2, 7); store8(ctl + 3, 98);
    assert_eq(session_appendtx_prose(t, ctl, 4), 2, "two control bytes are dropped");
    assert_eq(g_charge_prose_bytes - pb_ctl, 2,
              "prose charges bytes ESCAPED (2), not bytes OFFERED (4)");

    # (b) An IAC is DOUBLED, so w > len. The meter must follow the wire, not the
    # request — this is the direction that would under-charge a fan-out.
    var pb_iac = g_charge_prose_bytes;
    var iac = alloc(2);
    store8(iac + 0, 255); store8(iac + 1, 255);
    assert_eq(session_appendtx_prose(t, iac, 2), 4, "two IACs become four wire bytes");
    assert_eq(g_charge_prose_bytes - pb_iac, 4,
              "...and all four are charged — the escape expansion is real work");

    # (c) Truncation mid-buffer: room for some but not all. The charge follows
    # what fit.
    var pb_trunc = g_charge_prose_bytes;
    store64(t + SS_TX_LEN, TX_CAP - 3);
    var big = alloc(64);
    var bi = 0;
    while (bi < 64) { store8(big + bi, 65); bi = bi + 1; }
    assert_eq(session_appendtx_prose(t, big, 64), 3, "only three bytes fit");
    assert_eq(g_charge_prose_bytes - pb_trunc, 3,
              "a truncated append charges what fit, not what was offered");

    # (d) A completely full queue returns before charging anything.
    store64(t + SS_TX_LEN, TX_CAP);
    var pb2 = g_charge_prose_bytes;
    assert_eq(session_appendtx_prose(t, "ignored", 7), 0, "a full tx queue writes nothing");
    assert_eq(g_charge_prose_bytes - pb2, 0, "...and is charged nothing");
    charge_window_close();
    session_free(t);

    # --- The drain really opens a window, and really sets the re-arm flag.
    #
    # Forgetting `charge_window_open` inside drain_pending_rx is NOT a compile
    # error (unlike forgetting event_pass_begin, which leaves `budget`
    # undefined), so this is the only thing holding it in place. Driven through
    # the real function against real records, because the whole point of the
    # charge meter is that it counts what actually happened.
    var salt2 = alloc(SALT_LEN);
    var k2 = 0;
    while (k2 < SALT_LEN) { store8(salt2 + k2, 44 + k2); k2 = k2 + 1; }
    var victim = _mk_sess("Meterr", 6);
    var vb = sess_ident(victim);
    memcpy(vb, salt2, SALT_LEN);
    ident_derive(salt2, "meterpassphrase", 15, vb + IDENT_SK, vb + IDENT_PK);
    store64(victim + SS_ROOM, 0 - 1);
    store64(victim + SS_HP, 9); store64(victim + SS_MAXHP, 9);
    store64(victim + SS_AUTHED, 1);
    assert_eq(player_save(victim), 1, "the meter fixture record saves");

    # Eight sessions, each parked in PHASE_PASS with 8 wrong-passphrase lines
    # queued: 64 dear lines offered in one walk. The old line budget would admit
    # DRAIN_LINES_MAX = 16 of them.
    g_session_head = 0;
    var made = 0;
    while (made < 8) {
        var a = _armed_pass_sess("Meterr", 6, 4);   # <= MAX_LOGIN_FAILS
        session_list_push(a);
        made = made + 1;
    }
    var d0 = g_charge_derives;
    drain_pending_rx();
    var admitted = g_charge_derives - d0;
    assert(admitted > 0, "the drain admits at least one line — the progress clause holds");
    assert(admitted < DRAIN_LINES_MAX,
           "the drain is bounded by the CHARGE window, not by DRAIN_LINES_MAX = 16");
    assert(admitted * CHG_DERIVE <= PASS_CHARGE_MAX + CHG_DERIVE + CHG_VERIFY,
           "one window's spend never exceeds the cap plus one dear line");
    assert(g_rx_backlog > 0,
           "refused lines set the re-arm flag — epoll cannot see bytes in SS_RX_BUF");
    assert_eq(g_charge_cap, 0, "the drain closes its window on the way out");
    g_session_head = 0;

    # --- The CONDEMNED arm. This is the 1.7.0 finding that the drain's SS_QUIT
    # branch never consulted any budget: drop_session's first act is an
    # unconditional player_save, i.e. an ed25519_sign, so N condemned
    # AUTHENTICATED sessions cost N signs in one walk with nothing bounding N.
    # Measured 81 ms at 64 and ~325 ms projected at MAX_SESSIONS — inside the
    # very function E2 added a line budget to. The line budget and the charge
    # window both LOOKED like they covered this walk; neither did, because the
    # expensive work here is not a line.
    #
    # Without this test the teardown charge survived mutation, so it is the only
    # thing holding the fix in place.
    g_session_head = 0;
    var csalt = alloc(SALT_LEN);
    var ci = 0;
    while (ci < SALT_LEN) { store8(csalt + ci, 91 + ci); ci = ci + 1; }
    var cond = 0;
    while (cond < 8) {
        var c = _freeable_sess();
        var cn = load64(c + SS_NAME_BUF);
        memcpy(cn, "Doomed", 6);
        store8(cn + 6, 65 + cond);
        store64(c + SS_NAME_LEN, 7);
        var cb = sess_ident(c);
        memcpy(cb, csalt, SALT_LEN);
        ident_derive(csalt, "doomedpassphrase", 16, cb + IDENT_SK, cb + IDENT_PK);
        store64(cb + IDENT_CREATED, 1000000);
        store64(c + SS_ROOM, 0 - 1);
        store64(c + SS_HP, 5); store64(c + SS_MAXHP, 5);
        store64(c + SS_AUTHED, 1);      # authed => drop_session will SIGN a save
        store64(c + SS_QUIT, 1);        # condemned => the unbudgeted arm
        session_list_push(c);
        cond = cond + 1;
    }
    var sg0 = g_charge_signs;
    drain_pending_rx();
    var signs = g_charge_signs - sg0;
    assert(signs > 0, "at least one condemned session is torn down per pass");
    assert(signs < 8,
           "the condemned teardown is CHARGED — 8 authed drops are not all done in one walk");
    assert(signs * CHG_SIGN <= PASS_CHARGE_MAX + CHG_SIGN,
           "teardown spend never exceeds the cap plus one save");
    assert(g_rx_backlog > 0, "the un-reaped condemned keep the loop from sleeping");
    g_session_head = 0;

    return 0;
}

# === 1.7.0 — authentication is evaluated before integrity. ===
#
# `player_auth_load` must decide both "is this record intact" and "is this the
# right passphrase", and BOTH have to pass. It used to ask the 7107 us question
# (ed25519_verify) before the 1077 us one (ident_derive + compare), so a wrong
# passphrase paid for an answer that could not change the outcome. 8006 us ->
# 1066 us on the line an unauthenticated peer can queue for free.
#
# A pure reordering has no observable result to assert — every return code is
# unchanged, by design, which is exactly what makes it safe. So the guard is the
# CALL COUNT: a wrong passphrase must perform zero verifies. That is
# deterministic (no clock, no timing), and reverting the reorder flips it to one.
#
# This is why `g_charge_verifies` exists in session.cyr. It is the 1.7.0 charge
# meter's counter, and it doubles as the only honest instrument for holding an
# ordering in place.
fn test_auth_order(): i64 {
    test_group("auth-order");

    # A real record, signed with a key derived from a known passphrase.
    var s = _mk_sess("Orderly", 7);
    var salt = alloc(SALT_LEN);
    var i = 0;
    while (i < SALT_LEN) { store8(salt + i, 70 + i); i = i + 1; }
    var blk = sess_ident(s);
    memcpy(blk, salt, SALT_LEN);
    ident_derive(salt, "orderlypass", 11, blk + IDENT_SK, blk + IDENT_PK);
    store64(s + SS_ROOM, 0 - 1);
    store64(s + SS_HP, 12); store64(s + SS_MAXHP, 12);
    store64(s + SS_AUTHED, 1);
    assert_eq(player_save(s), 1, "the order fixture record saves");

    # --- The guard. A WRONG passphrase must not reach ed25519_verify at all.
    var v0 = g_charge_verifies;
    var d0 = g_charge_derives;
    assert_eq(player_auth_load(_mk_sess("Orderly", 7), "wrongpassphrase", 15), 0,
              "a wrong passphrase is still rejected");
    assert_eq(g_charge_verifies - v0, 0,
              "a wrong passphrase performs ZERO ed25519_verify calls");
    assert_eq(g_charge_derives - d0, 1,
              "...and exactly one derive — the cheap question is the one asked");

    # --- The right passphrase must still pay for integrity. If this reads 0 the
    # verify has been skipped altogether, which would be a forged-record hole
    # rather than an optimisation — so the two assertions bracket the change.
    var v1 = g_charge_verifies;
    assert_eq(player_auth_load(_mk_sess("Orderly", 7), "orderlypass", 11), 1,
              "the right passphrase still authenticates");
    assert_eq(g_charge_verifies - v1, 1,
              "a correct passphrase DOES verify the signature — integrity is not skipped");

    # --- A passphrase rejected on LENGTH costs neither operation. This is H5
    # (1.6.2) and it still holds after the reorder: the bounds moved with the
    # block they guard, so they are still the first thing evaluated.
    var v2 = g_charge_verifies;
    var d2 = g_charge_derives;
    assert_eq(player_auth_load(_mk_sess("Orderly", 7), "ab", 2), 0,
              "an under-length passphrase is rejected");
    assert_eq(g_charge_verifies - v2, 0, "a too-short passphrase performs no verify");
    assert_eq(g_charge_derives - d2, 0, "...and no derive either — H5 still first");

    # --- Tamper detection survives the reorder for the realistic case: edit a
    # field, leave salt+pubkey alone. The owner's passphrase still matches the
    # untouched pubkey, so the verify still runs and still reports tampering.
    # (A full salt+pubkey substitution degrades to a wrong-passphrase result —
    # documented at the reorder, and out of reach without write access to
    # data/players/.)
    _path_for("Orderly", 7, g_persist_path);
    var tn = file_read_all(g_persist_path, g_persist_slurp, SLURP_CAP - 1);
    var hp_at = _find_cstr(g_persist_slurp, tn, "hp = 12");
    assert(hp_at >= 0, "the fixture record contains the hp field to corrupt");
    store8(g_persist_slurp + hp_at + 5, 57);          # hp = 12 -> hp = 92
    _write_record_raw("Orderly", 7, g_persist_slurp, tn);
    var v3 = g_charge_verifies;
    assert_eq(player_auth_load(_mk_sess("Orderly", 7), "orderlypass", 11), 0 - 2,
              "a field-tampered record is still refused as tampered");
    assert_eq(g_charge_verifies - v3, 1,
              "...and the tamper is caught BY the verify, which therefore ran");

    return 0;
}

# === 1.6.14 — the dormant tail. ===
fn test_hygiene_tail(): i64 {
    test_group("hygiene-tail");

    # --- H1: the epoll_event layout. The reader and the writer must agree, and
    # they now go through the same two accessors — which is the actual fix. The
    # old bug was that the WRITE used the stdlib's per-arch helper and the READ
    # used a hardcoded x86 offset, so on aarch64 they disagreed and the loop
    # dereferenced a session pointer built from the wrong bytes.
    assert(epoll_ev_size() >= 12, "the event stride is a real size");
    assert(epoll_ev_size() <= 16, "and never larger than the 16 bytes allocated per slot");
    assert(epoll_data_off() >= 4, "the data offset is past the u32 events field");
    assert(epoll_data_off() + 8 <= 16, "and the u64 fits inside the slot");

    # Round-trip through the same buffer the loop reads: write a tagged event,
    # read it back the way the dispatch loop does. Arch-independent by
    # construction — whatever this target's layout is, the two halves match.
    var probe = 0x5EED1234;
    var ev = ev_scratch(EPOLLIN, probe);
    assert_eq(load32(ev), EPOLLIN, "the event mask round-trips");
    assert_eq(load64(ev + epoll_data_off()), probe, "and so does the tag the loop reads back");

    # --- H2: one reusable struct, not one allocation per accept. `epoll_ctl`
    # copies the struct, so a single buffer serves every call; the old helper
    # took 16 bytes of never-reclaimed bump arena per accept and per EPOLLOUT
    # arm/disarm.
    var before = alloc_used();
    var i = 0;
    while (i < 200) { ev_scratch(EPOLLIN, i); i = i + 1; }
    assert_eq(alloc_used() - before, 0, "200 events allocate nothing at all");
    assert_eq(ev_scratch(EPOLLIN, 1), ev_scratch(EPOLLOUT, 2), "because it is one buffer, reused");

    # --- H3: a class id leaves room for a terminator, like the two fields beside
    # it. Safe today only because every reader uses CL_ID_LEN — a trap for the
    # first caller that treats it as a cstr, and the same shape as the object-id
    # mismatch 1.6.6 fixed without sweeping classes.
    # Drive the REAL loader over a fixture whose id is exactly CL_ID_CAP bytes —
    # the only length at which the CAP vs CAP-1 copy is observable. Every
    # authored class id is ~8 bytes and round-trips either way, so asserting
    # against the shipped file proves nothing. (It didn't: this assertion passed
    # unchanged when the bug was reintroduced.)
    var saved_cc = g_class_count;
    assert(world_load_classes("tests/fixtures/longid.classes.cyml") > 0,
           "the maximal-id class fixture loads");
    assert_eq(load64(cl_at(0) + CL_ID_LEN), CL_ID_CAP - 1,
              "a 32-byte class id is stored at CAP-1, leaving room for the NUL");
    assert_eq(load8(cl_at(0) + CL_ID + CL_ID_CAP - 1) & 0xFF, 0,
              "and the last byte of the slot really is a terminator");
    assert(world_load_classes(DP_CLASSES) > 0, "the real class table reloads");
    assert_eq(g_class_count, saved_cc, "back to the authored class count");

    # --- H4: the rest of the 1.6.7 sign sweep. These four were clamped where a
    # saved character is READ and unclamped where one is MADE.
    if (g_class_count > 0) {
        var c2 = cl_at(0);
        var sv_str = load64(c2 + CL_STR); var sv_dex = load64(c2 + CL_DEX);
        var sv_con = load64(c2 + CL_CON); var sv_tec = load64(c2 + CL_TEC);
        var sv_nd  = load64(c2 + CL_NDICE);
        store64(c2 + CL_STR, 0 - 5); store64(c2 + CL_DEX, 0 - 5);
        store64(c2 + CL_CON, 0 - 5); store64(c2 + CL_TEC, 0 - 5);
        store64(c2 + CL_NDICE, 999999);          # a roll() trip count
        var pc = _mk_sess("Clamped2", 8);
        apply_class(pc, 0);
        assert(load64(pc + SS_STR) >= 1, "an authored negative str is clamped at creation");
        assert(load64(pc + SS_DEX) >= 1, "and dex");
        assert(load64(pc + SS_CON) >= 1, "and con");
        assert(load64(pc + SS_TEC) >= 1, "and tec");
        assert(load64(pc + SS_NDICE) <= 100,
               "and ndice is bounded — it is a loop trip count, not a stat");
        store64(c2 + CL_STR, sv_str); store64(c2 + CL_DEX, sv_dex);
        store64(c2 + CL_CON, sv_con); store64(c2 + CL_TEC, sv_tec);
        store64(c2 + CL_NDICE, sv_nd);
    }

    # --- H4: the same bound on the mob side, where the dice come from the zone.
    if (g_mob_tpl_count > 0) {
        var mt = mt_at(0);
        var sv = load64(mt + MT_NDICE);
        store64(mt + MT_NDICE, 999999);
        var mm = mob_spawn(mt, 0);
        assert(mt_ndice(mt) <= 100, "an absurd authored mob dice count is bounded at spawn");
        mob_remove(mm);
        store64(mt + MT_NDICE, sv);
    }

    return 0;
}

fn test_freeze(): i64 {
    test_group("freeze");
    persist_init();

    # The @-admin namespace is off unless YD_ADMIN enabled it (default 0).
    assert_eq(g_admin_enabled, 0, "admin namespace disabled by default");

    # Save stamps schema = 1; the record loads back.
    var s = _mk_sess("FreezeHero", 10);
    var blk = sess_ident(s);
    random_bytes(blk, SALT_LEN);
    ident_derive(blk, "freezepass", 10, blk + IDENT_SK, blk + IDENT_PK);
    store64(blk + IDENT_CREATED, 1);
    store64(s + SS_ROOM, 0 - 1); store64(s + SS_AUTHED, 1);
    store64(s + SS_HP, 20); store64(s + SS_MAXHP, 20); store64(s + SS_CLASS, 0);
    assert_eq(player_save(s), 1, "save ok");

    _path_for("FreezeHero", 10, g_persist_path);
    var n = file_read_all(g_persist_path, g_persist_slurp, SLURP_CAP - 1);
    assert(_contains(g_persist_slurp, n, "schema = 1") == 1, "record stamps schema = 1");
    var s2 = _mk_sess("FreezeHero", 10);
    assert_eq(player_auth_load(s2, "freezepass", 10), 1, "v1 record loads");

    # Forge a validly-signed schema = 2 record (we own the key) → rejected as
    # too new for this server. Proves the migration gate.
    var rec = alloc(1024);
    var o = _str_into(rec, 0, "[player]\nschema = 2\nsalt = \"");
    o = _str_into(rec, o, hex_encode(blk, SALT_LEN));
    o = _str_into(rec, o, "\"\npubkey = \"");
    o = _str_into(rec, o, hex_encode(blk + IDENT_PK, PK_LEN));
    o = _str_into(rec, o, "\"\n");
    var sig = alloc(SIG_LEN);
    ed25519_sign(blk + IDENT_SK, rec, o, sig);   # sign the prefix
    o = _str_into(rec, o, "sig = \"");
    o = _str_into(rec, o, hex_encode(sig, SIG_LEN));
    o = _str_into(rec, o, "\"\n");
    _write_record_raw("FreezeHero", 10, rec, o);
    var s3 = _mk_sess("FreezeHero", 10);
    # M11-B: a too-new record gets its OWN code, distinct from the
    # unreadable/tampered code. It is intact and correctly signed — it just
    # post-dates this server, which is what a rolled-back deploy looks like.
    assert_eq(player_auth_load(s3, "freezepass", 10), PL_ERR_SCHEMA,
              "schema = 2 rejected as too-new, not as tampered");

    return 0;
}

# Build a validly-signed record for FreezeHero with an arbitrary body, sign it,
# and write it to that player's save path. `body` is the field block that sits
# between the [player] header and the signature; salt + pubkey are appended
# automatically since every load path needs them. Returns nothing useful — the
# caller re-reads via player_auth_load.
fn _plant_record(blk, body): i64 {
    var rec = alloc(2048);
    var o = _str_into(rec, 0, "[player]\n");
    o = _str_into(rec, o, body);
    o = _str_into(rec, o, "salt = \"");
    o = _str_into(rec, o, hex_encode(blk, SALT_LEN));
    o = _str_into(rec, o, "\"\npubkey = \"");
    o = _str_into(rec, o, hex_encode(blk + IDENT_PK, PK_LEN));
    o = _str_into(rec, o, "\"\n");
    var sig = alloc(SIG_LEN);
    ed25519_sign(blk + IDENT_SK, rec, o, sig);
    o = _str_into(rec, o, "sig = \"");
    o = _str_into(rec, o, hex_encode(sig, SIG_LEN));
    o = _str_into(rec, o, "\"\n");
    _write_record_raw("FreezeHero", 10, rec, o);
    return 0;
}

# Parse a record body into a toml pairs vec, the way player_auth_load does, so
# _record_schema can be driven directly.
fn _pairs_of(body): i64 {
    var secs = toml_parse(str_from(body));
    if (vec_len(secs) == 0) { return 0; }
    return toml_section_pairs(vec_get(secs, 0));
}

# === M11 — save-record migration gate + writer bounds (1.3.0) ===
fn test_migration(): i64 {
    test_group("migration");
    persist_init();

    # --- M11-A: what version does a record DECLARE? ---
    #
    # This is the invariant the 2.0 bump rests on: a record with no `schema` key
    # is v1 forever, independent of what this server's SCHEMA_VERSION is. The
    # pre-1.3.0 code defaulted to SCHEMA_VERSION, so those records would have
    # re-labelled themselves as v2 the moment the constant moved and skipped the
    # v1 read path entirely.
    #
    # HONEST NOTE: while SCHEMA_VERSION == 1 the old and new defaults agree, so
    # this next assertion cannot distinguish them and passes either way — it is a
    # PIN, not a proof. It earns its keep at M14: the moment SCHEMA_VERSION
    # becomes 2, reintroducing the SCHEMA_VERSION default makes it fail loudly.
    # The assertions below it (clamp, non-integer) do discriminate today.
    assert_eq(_record_schema(_pairs_of("[player]\nname = \"x\"\n")), 1,
              "missing schema key reads as v1");
    assert_eq(_record_schema(_pairs_of("[player]\nschema = 1\n")), 1, "schema = 1 reads as 1");
    assert_eq(_record_schema(_pairs_of("[player]\nschema = 2\n")), 2, "schema = 2 reads as 2");
    # Garbage clamps toward v1 rather than inventing a version. toml_int returns
    # its default for a non-integer or negative; 0 clamps up so every caller can
    # branch on `>= 2` without a third case.
    assert_eq(_record_schema(_pairs_of("[player]\nschema = 0\n")), 1, "schema = 0 clamps to v1");
    assert_eq(_record_schema(_pairs_of("[player]\nschema = \"abc\"\n")), 1,
              "non-integer schema falls back to v1");

    # --- M11-A seam + M11-B: the ceiling is the only thing that gates ---
    var s = _mk_sess("FreezeHero", 10);
    var blk = sess_ident(s);
    random_bytes(blk, SALT_LEN);
    ident_derive(blk, "freezepass", 10, blk + IDENT_SK, blk + IDENT_PK);
    store64(blk + IDENT_CREATED, 1);

    _plant_record(blk, "schema = 2\nname = \"FreezeHero\"\nroom = \"\"\ninv = \"\"\n");
    assert_eq(player_auth_load(_mk_sess("FreezeHero", 10), "freezepass", 10), PL_ERR_SCHEMA,
              "schema = 2 refused at a v1 ceiling");
    # Raise the ceiling: the same record now loads. Proves the refusal is the
    # ceiling talking, not a parse failure.
    g_schema_max = 2;
    assert_eq(player_auth_load(_mk_sess("FreezeHero", 10), "freezepass", 10), 1,
              "schema = 2 loads once the ceiling allows it");
    # A stamp-less record still loads under a raised ceiling — it is v1, and v1
    # is below 2. This is the case a 0.7.0 save hits after the 2.0 bump.
    _plant_record(blk, "name = \"FreezeHero\"\nroom = \"\"\ninv = \"\"\n");
    assert_eq(player_auth_load(_mk_sess("FreezeHero", 10), "freezepass", 10), 1,
              "stamp-less v1 record loads under a schema-2 ceiling");
    g_schema_max = SCHEMA_VERSION;   # restore; later groups assume the default

    # --- M11-C: the control-byte guard, tested directly ---
    #
    # _find_sig_offset ends the signed prefix at the first line beginning `sig `,
    # so a newline inside a value could plant a forged signature line and move
    # that boundary. No v1 field can carry a newline today — the CYML parser ends
    # a value at the newline before _has_ctrl would ever see it — so a planted
    # record is already refused by the signature check, for a different reason.
    # That makes an end-to-end test prove nothing about this guard. Test the
    # predicate itself; it is what 2.0's free-text fields will actually lean on.
    assert_eq(_has_ctrl(str_from("plain")), 0, "clean value passes the control-byte guard");
    assert_eq(_has_ctrl(str_from("a\nsig = ")), 1, "embedded newline is caught");
    assert_eq(_has_ctrl(str_from("tab\there")), 1, "embedded tab is caught");
    assert_eq(_has_ctrl(0), 0, "absent value is not suspicious");

    # --- M11-D: the record writer refuses to overflow, tested directly ---
    #
    # Before 1.3.0 the appenders memcpy'd into the 4096-byte g_persist_save with
    # no bound. The only guard was inside _build_record's inventory loop, so a
    # huge inventory ALREADY failed cleanly — an end-to-end save test would pass
    # against the old code too and prove nothing. What was unbounded was every
    # other append: name, room, the hex fields, the signature line. None can
    # overflow today given their caps, which is exactly why this is a guard for
    # 2.0's variable-length fields rather than a fix for a live overflow. So
    # drive the appenders at the boundary directly.
    assert_eq(_sv_bad(0), 0, "offset 0 is healthy");
    assert_eq(_sv_bad(SAVE_ERR), 1, "poisoned offset reads as bad");
    # A write that exactly fills the buffer is allowed.
    assert_eq(_ap(SAVE_CAP - 4, "abcd", 4), SAVE_CAP, "exact fit is accepted");
    # One byte more is refused, and poisons rather than truncating.
    assert_eq(_sv_bad(_ap(SAVE_CAP - 4, "abcde", 5)), 1, "over-long append is refused");
    assert_eq(_sv_bad(_ac(SAVE_CAP - 2, "toolong")), 1, "over-long cstr append is refused");
    assert_eq(_sv_bad(_ai(SAVE_CAP - 1, 123456)), 1, "over-long int append is refused");
    # Poison is sticky: once bad, later appends must not resume writing.
    assert_eq(_sv_bad(_ac(_ap(SAVE_CAP - 4, "abcde", 5), "x")), 1, "poison propagates");

    # A normal-sized record still saves and round-trips — the bound must not have
    # broken the ordinary path.
    var ok = _mk_sess("FreezeHero", 10);
    var oblk = sess_ident(ok);
    random_bytes(oblk, SALT_LEN);
    ident_derive(oblk, "freezepass", 10, oblk + IDENT_SK, oblk + IDENT_PK);
    store64(oblk + IDENT_CREATED, 1);
    store64(ok + SS_AUTHED, 1); store64(ok + SS_ROOM, 0 - 1);
    store64(ok + SS_HP, 20); store64(ok + SS_MAXHP, 20); store64(ok + SS_CLASS, 0);
    assert_eq(player_save(ok), 1, "normal record still saves after the bound");
    assert_eq(player_auth_load(_mk_sess("FreezeHero", 10), "freezepass", 10), 1,
              "normal record still loads after the bound");

    return 0;
}

fn main() {
    alloc_init();

    # 1.7.1 — the suite writes to a FIXTURE audit log, not the operator's.
    #
    # Every group that calls persist_init() was appending to data/audit.libro, the
    # real append-only hash chain. Measured when this was found: 1545 of its 37902
    # records were written by test sessions — Auditee, TestPlayer, Doomed and
    # friends — permanently interleaved with real operational history in a log that
    # by design cannot be edited afterwards.
    #
    # DP_AUDIT is a plain `var`, and persist_init reads it, so one assignment ahead
    # of the first group redirects the whole suite. This must stay BEFORE any
    # persist_init() call, which is why it lives here rather than in a group.
    #
    # It is also a hard prerequisite for the audit-log rotation coming in 1.7.2:
    # with a size threshold, the first append during `cyrius test` would rotate the
    # operator's 13 MB log out from under them.
    DP_AUDIT = "data/test-audit.libro";

    test_group("smoke");
    assert(1, "true is true");
    assert_eq(1 + 1, 2, "math works");

    test_telnet();
    test_negotiation();
    test_login();
    test_tokenize();
    test_verbs();
    test_resolve();
    test_prep();
    test_qual();
    test_world();
    test_combat();
    test_classes();
    test_idle();
    test_persist();
    test_reset();
    test_login_polish();
    test_security();
    test_freeze();
    test_migration();
    test_wire_hygiene();
    test_lifecycle();
    test_actor_tick();
    test_hardening();
    test_preauth_meter();
    test_accept_limits();
    test_assist_real();
    test_chpass_isolation();
    test_load_and_save_failure();
    test_state_integrity();
    test_item_verbs();
    test_reset_bounds();
    test_tick_schedule();
    test_tick_coalescing();
    test_tx_compaction();
    test_save_meter();
    test_hex_identity();
    test_roomless_safety();
    test_preauth_scale();
    test_create_guards();
    test_object_maxexist();
    test_stun_decay();
    test_tail_guards();
    test_event_budget();
    test_passwd_meter();
    test_carry_cap();
    test_hygiene_tail();
    test_auth_order();
    test_charge_window();
    test_chpass_rate();
    test_audit_verifiable();
    test_audit_coalesce();
    test_carry_cap_container();
    test_account_cap();
    test_player_sharding();
    test_legacy_guards();
    test_save_backoff();
    test_audit_rotation();
    test_ground_decay();
    test_room_listing_bounds();
    test_carry_cap_get_contents();
    test_listing_bounds();
    test_preauth_alloc();
    test_rx_bounds();
    test_tick_and_menu_bounds();


    return assert_summary();
}

# Length of an intrusive object list — used by the 1.7.7 groups to assert that a
# rationed ECHO still performed the whole EFFECT.
fn _ilist_len(slot): i64 {
    var n = 0;
    var o = load64(slot);
    while (o != 0) { n = n + 1; o = oi_next(o); }
    return n;
}

# === 1.7.7 — `get` asks the cap about what it is actually going to move. ===
#
# MEASURED on this tree before the fix: holding 99, `oi_move_count` of a bag
# containing 99 is 100, and the old guard — a bare `inv_full(s)`, which asks only
# "am I at the cap right now" — returned 0. One ordinary `get` therefore landed
# the player at **199 against a cap of 100**, with the server saying only
# "You take ...". The gate sweep pushed the same shape to 721 carried, where
# `_build_record` filled 4048 bytes of SAVE_CAP 4096, `player_save` returned
# SUCCESS, and the reload came back with 591: **130 items destroyed, silently.**
#
# This is the SIXTH appearance in this tree of one defect — *a check that asks
# about a different collection than the mutation below it touches.* The correct
# version had existed since 1.7.3 in `cmd_give`, 230 lines below in the same file,
# and was never carried across. Both now go through `oi_move_count`, so there is
# exactly one answer to "how much does this move move" and no site can hold a
# different one.
fn test_carry_cap_get_contents(): i64 {
    test_group("carry-cap-get");

    if (g_obj_tpl_count == 0) { assert(0, "carry-cap-get: needs object templates"); return 0; }
    if (world_room_count() == 0) { assert(0, "carry-cap-get: needs a world"); return 0; }

    # --- The shared arithmetic, over its domain. This is the function whose
    # ABSENCE was the bug, so it is asserted directly rather than only through
    # its callers.
    var bare = item_new(ot_at(0));
    assert_eq(oi_move_count(bare), 1, "a bare item moves one slot");
    var bag = item_new(ot_at(0));
    var b = 0;
    while (b < 49) { ilist_push(bag + OI_CONTENTS, item_new(ot_at(0))); b = b + 1; }
    assert_eq(oi_move_count(bag), 50,
              "a bag of 49 moves FIFTY — itself and its contents, which is what ilist_push carries");

    # --- The guard, over the boundary. `inv_would_exceed` is the predicate the
    # acquisition paths now consult.
    var g = _freeable_sess();
    store64(g + SS_INV, 0);
    var gi = 0;
    while (gi < MAX_INV - 50) { ilist_push(g + SS_INV, item_new(ot_at(0))); gi = gi + 1; }
    assert_eq(inv_count(g), MAX_INV - 50, "the fixture carries exactly fifty short of the cap");
    assert_eq(inv_would_exceed(g, 50), 0, "a move landing EXACTLY on the cap is allowed");
    assert_eq(inv_would_exceed(g, 51), 1, "...and one slot past it is refused");
    assert_eq(inv_full(g), 0, "the bare 'is one more OK' question still answers under the cap");

    # --- THE BUG. The old guard and the new one disagree, and the old one is the
    # one that let 199 happen. Asserting the DISAGREEMENT is what makes this test
    # discriminating: an assertion only on the new guard would pass against a
    # reverted fix if the fixture happened to sit at the cap.
    var s = _freeable_sess();
    store64(s + SS_INV, 0);
    var h = 0;
    while (h < MAX_INV - 1) { ilist_push(s + SS_INV, item_new(ot_at(0))); h = h + 1; }
    assert_eq(inv_count(s), MAX_INV - 1, "holding one short of the cap");

    var big = item_new(ot_at(2));                  # 'shard' — a distinct keyword
    var k = 0;
    while (k < MAX_INV - 1) { ilist_push(big + OI_CONTENTS, item_new(ot_at(0))); k = k + 1; }
    assert_eq(oi_move_count(big), MAX_INV, "the bag plus its contents is a whole cap's worth");
    assert_eq(inv_full(s), 0,
              "the OLD question — 'are you at the cap' — says there is room, and it is wrong");
    assert_eq(inv_would_exceed(s, oi_move_count(big)), 1,
              "the NEW question — 'would this MOVE exceed it' — refuses. This is the fix.");
    assert_eq(inv_count(s) + oi_move_count(big), 199,
              "...because the old answer landed the player at 199 against a cap of 100");

    # --- End to end through the real parser, exactly as a player types it.
    var slot = room_at(0) + RM_OBJ_HEAD;
    var pre = load64(slot);
    store64(slot, 0);
    ilist_push(slot, big);
    store64(s + SS_ROOM, 0);
    store64(s + SS_PHASE, PHASE_CMD);
    store64(s + SS_FD, 0 - 1);
    store64(s + SS_AUTHED, 1);
    _tx_reset(s);
    cmd_on_line(s, "get shard", 9);
    assert_eq(inv_count(s), MAX_INV - 1, "a typed `get` of the bag leaves the player where they were");
    assert(inv_count(s) <= MAX_INV, "...and never above the cap");
    assert_eq(_ilist_len(slot), 1, "...and the bag is still on the floor");
    var tx = load64(s + SS_TX_BUF);
    var n = load64(s + SS_TX_LEN);
    # Told, and told the TRUE thing: this player is at 99 of 100, so they are not
    # "full" — the bag they reached for is simply bigger than the room left.
    assert_eq(_contains(tx, n, "You can't carry all of that."), 1,
              "...and the player is TOLD, rather than silently overfilled");
    assert_eq(_contains(tx, n, "hands and pockets are full"), 0,
              "...with the message that is actually true at 99 of 100, not the one that isn't");

    # --- THE `get all` ARM, WHICH IS A SEPARATE GUARD AND NEEDS A SEPARATE TEST.
    #
    # This assertion exists because the first version of this group did NOT have
    # it, and the mutation that reverts the all-arm to a bare `inv_full` SURVIVED.
    # The reason is worth writing down: the `get all` case above uses bare floor
    # items, and for a bare item `oi_move_count` is 1, so the old guard and the new
    # one are the SAME FUNCTION. The test looked like it covered the arm and could
    # not have failed whatever the arm did.
    #
    # Discriminating requires a floor container whose contents push the player past
    # the cap on their own — 50 held plus a bag of 99 is 150, which the new guard
    # refuses and the old one waves through.
    var aslot = room_at(0) + RM_OBJ_HEAD;
    var apre = load64(aslot);
    store64(aslot, 0);
    var abag = item_new(ot_at(2));
    var ac = 0;
    while (ac < MAX_INV - 1) { ilist_push(abag + OI_CONTENTS, item_new(ot_at(0))); ac = ac + 1; }
    ilist_push(aslot, abag);

    var a = _freeable_sess();
    store64(a + SS_ROOM, 0);
    store64(a + SS_PHASE, PHASE_CMD);
    store64(a + SS_FD, 0 - 1);
    store64(a + SS_AUTHED, 1);
    store64(a + SS_INV, 0);
    var ah = 0;
    while (ah < 50) { ilist_push(a + SS_INV, item_new(ot_at(0))); ah = ah + 1; }
    assert_eq(inv_count(a), 50, "the sweep fixture holds fifty — HALF the cap, so 'am I full' says no");
    assert_eq(inv_full(a), 0, "...which is exactly why the old all-arm guard let this through");
    _tx_reset(a);
    cmd_on_line(a, "get all", 7);
    assert_eq(inv_count(a), 50, "`get all` of a bag that would overflow the cap takes nothing");
    assert(inv_count(a) <= MAX_INV, "...and the player is never above the cap");
    assert_eq(_ilist_len(aslot), 1, "...and the bag stays on the floor");

    assert_eq(_contains(load64(a + SS_TX_BUF), load64(a + SS_TX_LEN), "carry all of that"), 1,
              "...and the refusal is HONEST: a player at half the cap is not told their hands are full");

    # A REFUSED ITEM MUST NOT BLOCK THE ONES BEHIND IT. Before this release the
    # arm aborted the whole sweep on refusal, which was correct while the only
    # question was "are you full" — if you are, nothing else fits either. Once the
    # question became per-item that stopped being true, and the abort would have
    # made `get all` take NOTHING for a player carrying nothing whose floor
    # happened to start with an oversized bag. A regression introduced BY the fix,
    # of exactly the shape 1.7.2 shipped and this project keeps rediscovering.
    _drain_ilist(a + SS_INV); store64(a + SS_INV, 0);
    _drain_ilist(aslot); store64(aslot, 0);
    var loose = 0;
    while (loose < 5) { ilist_push(aslot, item_new(ot_at(0))); loose = loose + 1; }
    var huge = item_new(ot_at(2));
    var hc = 0;
    while (hc < MAX_INV + 50) { ilist_push(huge + OI_CONTENTS, item_new(ot_at(0))); hc = hc + 1; }
    ilist_push(aslot, huge);                    # pushed last -> scanned FIRST
    assert(oi_move_count(huge) > MAX_INV, "the bag cannot fit at ANY carried total");
    assert_eq(inv_count(a), 0, "the player starts carrying nothing at all");
    _tx_reset(a);
    cmd_on_line(a, "get all", 7);
    assert_eq(inv_count(a), 5, "the five loose items behind the un-liftable bag are still taken");
    assert_eq(_ilist_len(aslot), 1, "...and only the bag is left on the floor");
    assert_eq(_contains(load64(a + SS_TX_BUF), load64(a + SS_TX_LEN), "carry all of that"), 1,
              "...and the player is told once why one thing stayed behind");

    # The positive half, so this group cannot pass by refusing everything.
    _drain_ilist(a + SS_INV); store64(a + SS_INV, 0);
    _drain_ilist(aslot); store64(aslot, 0);
    var fits = item_new(ot_at(2));
    var fc = 0;
    while (fc < 5) { ilist_push(fits + OI_CONTENTS, item_new(ot_at(0))); fc = fc + 1; }
    ilist_push(aslot, fits);
    _tx_reset(a);
    cmd_on_line(a, "get all", 7);
    assert_eq(inv_count(a), 6, "a bag that DOES fit is taken whole — itself and its five contents");
    assert_eq(_ilist_len(aslot), 0, "...and the floor is cleared");
    assert_eq(_contains(load64(a + SS_TX_BUF), load64(a + SS_TX_LEN), "carry all of that"), 0,
              "...with no refusal message when nothing was refused");

    # The OTHER branch of the refusal message, so the honest-message logic is
    # covered in both directions rather than only the one that changed.
    _drain_ilist(a + SS_INV); store64(a + SS_INV, 0);
    _drain_ilist(aslot); store64(aslot, 0);
    var atcap = 0;
    while (atcap < MAX_INV) { ilist_push(a + SS_INV, item_new(ot_at(0))); atcap = atcap + 1; }
    ilist_push(aslot, item_new(ot_at(0)));
    assert_eq(inv_count(a), MAX_INV, "this session is exactly at the cap");
    _tx_reset(a);
    cmd_on_line(a, "get all", 7);
    assert_eq(inv_count(a), MAX_INV, "...so one more bare item is refused");
    assert_eq(_contains(load64(a + SS_TX_BUF), load64(a + SS_TX_LEN), "hands and pockets are full"), 1,
              "...and NOW 'your hands and pockets are full' is the true statement");

    _drain_ilist(a + SS_INV); store64(a + SS_INV, 0);
    _drain_ilist(aslot); store64(aslot, apre);
    session_free(a);

    # --- The 1.7.2 exemption survives. Counting contents is exactly what made the
    # cap over-apply last time: moving an item out of a bag you already hold
    # changes no total, and a player at the cap who cannot reach their own
    # belongings is a worse bug than the one being fixed here.
    var own = _freeable_sess();
    store64(own + SS_ROOM, 0);
    store64(own + SS_PHASE, PHASE_CMD);
    store64(own + SS_FD, 0 - 1);
    store64(own + SS_AUTHED, 1);
    store64(own + SS_INV, 0);
    var mybag = item_new(ot_at(2));
    ilist_push(own + SS_INV, mybag);
    var m = 0;
    while (m < MAX_INV - 1) { ilist_push(mybag + OI_CONTENTS, item_new(ot_at(0))); m = m + 1; }
    assert_eq(inv_count(own), MAX_INV, "this session is AT the cap, all of it inside its own bag");
    var before_own = inv_count(own);
    _tx_reset(own);
    get_from(own, mybag + OI_CONTENTS, own + SS_INV, 0, "scrip", 5, 1, "in there");
    assert_eq(inv_count(own), before_own,
              "taking from your OWN bag at the cap is still allowed — it moves nothing net");
    assert_eq(_ilist_len(own + SS_INV), 2, "...and the item really did move to the top level");

    _drain_ilist(own + SS_INV); store64(own + SS_INV, 0);
    _drain_ilist(s + SS_INV);   store64(s + SS_INV, 0);
    _drain_ilist(g + SS_INV);   store64(g + SS_INV, 0);
    _drain_ilist(slot);         store64(slot, pre);
    session_free(own); session_free(s); session_free(g);
    return 0;
}

# === 1.7.7 — the four listings 1.7.6 did not reach. ===
#
# 1.7.6 removed this defect from `look` and wired `room_line_fits` /
# `room_append_more` into `session_show_room`'s three sections AND NOWHERE ELSE.
# Four sibling loops kept the original shape: one coloured line per element into
# the 4 kB queue with no fit check, cut at whatever byte it ran out on, colour
# never closed, and NO PROMPT after it — the session simply looks hung.
#
# MEASURED on this tree, driving the old loops inlined against the real buffer:
#
#   | listing | last size that worked | first size that lost the prompt |
#   |---|---|---|
#   | `inventory`, longest authored name (30 B) | 94 items, 4063 B | **95 items, 4096 B** |
#   | `who`, 16-char names + Hub room titles    | 78 players, 4062 B | **79 players, 4096 B** |
#
# 95 is UNDER the game's own MAX_INV of 100 — this is a limit the server hands
# the player, not one they have to work to reach. At 90 sessions the `who` cut
# landed on byte 0x80, a UTF-8 continuation byte: the em-dash separator sliced in
# half mid-character.
#
# The rule these groups exist to hold: **rationing the ECHO must never ration the
# EFFECT.** `drop all` and `get all` are commands, not reports — a player who
# types `drop all` must end up carrying nothing however much of the receipt fits.
fn test_listing_bounds(): i64 {
    test_group("listing-bounds");

    if (g_obj_tpl_count == 0) { assert(0, "listing-bounds: needs object templates"); return 0; }
    if (world_room_count() == 0) { assert(0, "listing-bounds: needs a zone"); return 0; }

    # --- The generalised tail. 1.7.6's helper hard-coded " here.", which is a
    # false statement in `who` — a listing whose whole subject is players who are
    # somewhere else.
    var w = _freeable_sess();
    _tx_reset(w);
    assert_eq(list_append_more(w, 0, "items", " carried.\r\n"), 0, "nothing omitted emits nothing");
    assert_eq(load64(w + SS_TX_LEN), 0, "...and writes no bytes at all");
    list_append_more(w, 7, "items", " carried.\r\n");
    assert_eq(_contains(load64(w + SS_TX_BUF), load64(w + SS_TX_LEN), "...and 7 more items carried."), 1,
              "the tail names the count and the subject, and does not claim they are 'here'");
    _tx_reset(w);
    room_append_more(w, 3, "items lie");
    assert_eq(_contains(load64(w + SS_TX_BUF), load64(w + SS_TX_LEN), "...and 3 more items lie here."), 1,
              "the room spelling is unchanged — 1.7.6's three sections keep their wording");

    # Longest authored object name: the size at which the measurements above hold.
    var big = 0; var bl = 0; var t = 0;
    while (t < g_obj_tpl_count) {
        if (load64(ot_at(t) + OT_NAME_LEN) > bl) { bl = load64(ot_at(t) + OT_NAME_LEN); big = t; }
        t = t + 1;
    }
    assert_eq(bl, 30, "the Hub's longest object name is 30 bytes — the figure the table above uses");

    # --- INVENTORY. 95 items is the measured break, and it is under MAX_INV.
    var s = _freeable_sess();
    store64(s + SS_ROOM, 0);
    store64(s + SS_PHASE, PHASE_CMD);
    store64(s + SS_FD, 0 - 1);
    store64(s + SS_AUTHED, 1);
    store64(s + SS_INV, 0);
    var i = 0;
    while (i < MAX_INV) { ilist_push(s + SS_INV, item_new(ot_at(big))); i = i + 1; }
    assert(MAX_INV > 94, "the carry cap really does let a player reach the measured break point");
    _tx_reset(s);
    cmd_on_line(s, "inv", 3);
    var tx = load64(s + SS_TX_BUF);
    var n = load64(s + SS_TX_LEN);
    assert(n <= TX_CAP, "the reply stays inside the buffer");
    assert_eq(_contains(tx, n, "> "), 1,
              "THE PROMPT REACHES THE CLIENT — the failure this group exists for");
    assert(n < TX_CAP, "...and the buffer is not run dry, so the prompt was not merely lucky");
    assert_eq(_contains(tx, n, "more items carried."), 1,
              "...and the listing says how much of the inventory it did not show");
    var tail1 = load8(tx + n - 1) & 0xFF;
    var tail2 = load8(tx + n - 2) & 0xFF;
    assert(tail1 != 27, "the stream does not end ON an ESC");
    assert(tail2 != 27, "...nor one byte into an escape sequence");

    # A normal inventory is untouched: no notice, no truncation.
    _drain_ilist(s + SS_INV); store64(s + SS_INV, 0);
    i = 0;
    while (i < 5) { ilist_push(s + SS_INV, item_new(ot_at(big))); i = i + 1; }
    _tx_reset(s);
    cmd_on_line(s, "inv", 3);
    tx = load64(s + SS_TX_BUF); n = load64(s + SS_TX_LEN);
    assert_eq(_contains(tx, n, "more items carried."), 0, "an ordinary inventory gets no truncation notice");
    assert_eq(_contains(tx, n, "> "), 1, "...and still gets its prompt");

    # --- drop all / get all: THE EFFECT IS COMPLETE WHILE THE ECHO IS RATIONED.
    # This is the assertion that distinguishes a correct fix from a lazy one — a
    # fit check placed around the whole loop body would pass every prompt
    # assertion above and silently leave items in the player's hands.
    var slot = room_at(0) + RM_OBJ_HEAD;
    var pre = load64(slot);
    store64(slot, 0);
    _drain_ilist(s + SS_INV); store64(s + SS_INV, 0);
    var d = 0;
    while (d < 150) { ilist_push(s + SS_INV, item_new(ot_at(big))); d = d + 1; }
    assert_eq(inv_count(s), 150, "carrying far more than one reply can describe");
    _tx_reset(s);
    cmd_on_line(s, "drop all", 8);
    tx = load64(s + SS_TX_BUF); n = load64(s + SS_TX_LEN);
    assert_eq(inv_count(s), 0, "`drop all` DROPS ALL — the effect is not rationed with the echo");
    assert_eq(_ilist_len(slot), 150, "...every one of them reached the floor");
    assert_eq(_contains(tx, n, "> "), 1, "...the prompt still arrives");
    assert_eq(_contains(tx, n, "more items dropped."), 1, "...and the receipt says what it did not list");

    # And back again — `get all` fills to exactly the cap and no further.
    _tx_reset(s);
    cmd_on_line(s, "get all", 7);
    tx = load64(s + SS_TX_BUF); n = load64(s + SS_TX_LEN);
    assert_eq(inv_count(s), MAX_INV, "`get all` stops at the cap, not one item past it");
    assert_eq(_ilist_len(slot), 50, "...and leaves the remainder on the floor");
    assert_eq(_contains(tx, n, "> "), 1, "...the prompt still arrives");
    assert_eq(_contains(tx, n, "more items taken."), 1, "...and the receipt is honest about the rest");

    _drain_ilist(s + SS_INV); store64(s + SS_INV, 0);
    _drain_ilist(slot); store64(slot, pre);

    # --- WHO. Measured break at 79 players; MAX_SESSIONS allows far more.
    var saved_head = g_session_head;
    g_session_head = 0;
    var chain = 0;
    var j = 0;
    while (j < 100) {
        var p = _freeable_sess();
        store64(p + SS_PHASE, PHASE_CMD);
        store64(p + SS_ROOM, j % world_room_count());
        memcpy(load64(p + SS_NAME_BUF), "Wanderer00000000", 16);
        store64(p + SS_NAME_LEN, 16);
        store64(p + SS_NEXT, chain);
        chain = p;
        j = j + 1;
    }
    g_session_head = chain;
    assert(100 > 78, "the fixture population is past the measured break point");

    _tx_reset(w);
    cmd_who(w);
    session_appendtx_cstr(w, "> ");                 # the prompt the dispatcher owes
    var wtx = load64(w + SS_TX_BUF);
    var wn = load64(w + SS_TX_LEN);
    assert(wn < TX_CAP, "`who` at 100 players leaves the buffer with room to spare");
    assert_eq(_contains(wtx, wn, "> "), 1, "...so the prompt reaches the client");
    assert_eq(_contains(wtx, wn, "more online not shown."), 1, "...and it says how many it omitted");
    assert_eq(_contains(wtx, wn, "(100 online)"), 1,
              "...while the COUNT still answers for everyone, listed or not");

    # The admin twin, dormant behind YD_ADMIN and fixed in the same pass —
    # leaving the sleeping half of a defect in place is how three of the four
    # findings that reopened the 1.x gate came to exist.
    _tx_reset(w);
    render_who(w);
    session_appendtx_cstr(w, "> ");
    wtx = load64(w + SS_TX_BUF); wn = load64(w + SS_TX_LEN);
    assert(wn < TX_CAP, "@who is bounded too");
    assert_eq(_contains(wtx, wn, "> "), 1, "...and keeps its prompt");
    assert_eq(_contains(wtx, wn, "more in-world not shown."), 1, "...and reports what it omitted");
    assert_eq(_contains(wtx, wn, "in-world: 100"), 1, "...while its total still counts everyone");

    # A small population is listed in full, with no notice.
    var few = chain;
    var kept = 0;
    while (kept < 4) { few = load64(few + SS_NEXT); kept = kept + 1; }
    store64(few + SS_NEXT, 0);
    _tx_reset(w);
    cmd_who(w);
    wtx = load64(w + SS_TX_BUF); wn = load64(w + SS_TX_LEN);
    assert_eq(_contains(wtx, wn, "more online not shown."), 0, "five players get no truncation notice");
    assert_eq(_contains(wtx, wn, "(5 online)"), 1, "...and all five are counted");

    g_session_head = saved_head;
    session_free(s);
    session_free(w);
    return 0;
}

# Build a validly-signed record for `name` from an arbitrary field block, so a
# crafted record can be made to VERIFY. Without this every crafted record is
# refused by the signature check and no assertion can reach the guards that sit
# behind it — which is exactly how the first version of this group let three
# mutations survive.
fn _sign_record_as(name, nl, blk, body): i64 {
    var rec = alloc(SLURP_CAP);
    var o = _str_into(rec, 0, "[player]\n");
    o = _str_into(rec, o, body);
    var sig = alloc(SIG_LEN);
    ed25519_sign(blk + IDENT_SK, rec, o, sig);      # sign the prefix, as _build_record does
    o = _str_into(rec, o, "sig = \"");
    o = _str_into(rec, o, hex_encode(sig, SIG_LEN));
    o = _str_into(rec, o, "\"\n");
    _write_record_raw(name, nl, rec, o);
    return 0;
}

# Count raw numeric syscalls in a source file, ignoring comment lines.
#
# THE ONLY GUARD THAT COULD HAVE CAUGHT 1.7.8's AGNOS BUG. `syscall(82, ...)` and
# `syscall(87, ...)` are rename and unlink on x86_64 and GPU dispatch / GPU blit
# on AGNOS, so NO test running on this target can tell the two apart — the suite
# was green for seven releases with the tree unable to save a single record on
# `--agnos`. Compiling `--agnos` in CI (added this release) catches a signature
# change; it does not catch a raw number, because a raw number compiles fine on
# both. Reading the source does.
fn _raw_syscalls_in(path): i64 {
    var buf = alloc(200000);
    var n = file_read_all(path, buf, 200000 - 1);
    if (n <= 0) { return 0 - 1; }
    var hits = 0;
    var i = 0;
    var line_is_comment = 0;
    while (i < n) {
        var c = load8(buf + i) & 0xFF;
        if (c == 10) { line_is_comment = 0; i = i + 1; continue; }   # newline ends a comment
        # A '#' ANYWHERE starts a comment, not just in column 0 — the first
        # version of this only handled leading '#' and so flagged this release's
        # own trailing notes ("# 1.7.8 — not syscall(82)"), which is a scanner
        # that reports the thing it was written to prove absent.
        if (c == 35) { line_is_comment = 1; }
        if (line_is_comment == 0) {
            if (c == 115) {                                 # 's'
                if (_bytes_eq(buf + i, "syscall(", 8) == 1) {
                    var d = load8(buf + i + 8) & 0xFF;
                    if (d >= 48) { if (d <= 57) { hits = hits + 1; } }   # a DIGIT, not a named constant
                }
            }
        }
        i = i + 1;
    }
    return hits;
}

# === 1.7.8 — a wrong passphrase must not cost the server memory. ===
#
# MEASURED on this tree. `player_auth_load` parsed the whole record with
# `toml_parse` BEFORE checking the passphrase, and that memory is never
# reclaimed: the bump allocator has no free at all and the freelist never
# munmaps. Contrast, both measured here and asserted below:
#
#   toml_parse of one record ............ 2,248 bytes, permanently
#   a wrong-passphrase login (after) .... 0 bytes
#
# Reachable by anyone who can open a socket. No account is needed to find a
# target either — the login prompt itself answers whether a name exists
# ("Passphrase:" vs "No record answers to that name") — and 1.7.1's rollup window
# correctly suppresses the repeated audit entries, so the instrument stays quiet
# while it happens. Five guesses per connection is ~11 kB gone per connection.
#
# This is 1.7.0's argument one resource along. That release stopped a wrong
# passphrase paying for a 7 ms `ed25519_verify` it could not use; the parse was
# left where it stood, and unlike CPU, arena never comes back.
fn test_preauth_alloc(): i64 {
    test_group("preauth-alloc");
    persist_init();

    # --- The raw scanner, over its domain. It is deliberately STRICTER than
    # bayan: exactly `<key> = "<value>"` at the start of a line, which is exactly
    # what `_fhex` writes. Strictness here is fail-closed — an unrecognised shape
    # yields 0 and the caller refuses the record.
    var vlen[8];
    var buf = alloc(512);
    var o = _str_into(buf, 0, "[player]\nsalt = \"abcd\"\npubkey = \"ef01\"\n");
    var r = _scan_kv(buf, o, "salt", &vlen);
    assert(r != 0, "the scanner finds a well-formed key");
    assert_eq(load64(&vlen), 4, "...with the right length");
    assert_eq(load8(r) & 0xFF, 97, "...pointing at the value, not the key");
    r = _scan_kv(buf, o, "pubkey", &vlen);
    assert(r != 0, "...and finds a later key too");
    assert_eq(load8(r) & 0xFF, 101, "...at its own value ('e')");
    assert_eq(_scan_kv(buf, o, "nosuchkey", &vlen), 0, "a missing key yields nothing");
    # A key name that is a PREFIX of a present one must not match it.
    assert_eq(_scan_kv(buf, o, "sal", &vlen), 0, "a prefix of a real key does not match");

    # Unterminated and newline-interrupted values are refused rather than run on.
    var bad = alloc(256);
    var bo = _str_into(bad, 0, "[player]\nsalt = \"abcd\n");
    assert_eq(_scan_kv(bad, bo, "salt", &vlen), 0, "a value with no closing quote is refused");
    bo = _str_into(bad, 0, "[player]\nsalt = abcd\"\n");
    assert_eq(_scan_kv(bad, bo, "salt", &vlen), 0, "a value with no OPENING quote is refused");
    bo = _str_into(bad, 0, "[player]\nsalt=\"abcd\"\n");
    assert_eq(_scan_kv(bad, bo, "salt", &vlen), 0, "the loose `key=\"v\"` shape is refused (fail-closed)");

    # --- A real record, and the headline measurement.
    var s = _mk_sess("AllocHero", 9);
    var blk = sess_ident(s);
    random_bytes(blk, SALT_LEN);
    ident_derive(blk, "rightpass", 9, blk + IDENT_SK, blk + IDENT_PK);
    store64(blk + IDENT_CREATED, 1);
    store64(s + SS_ROOM, 0 - 1); store64(s + SS_AUTHED, 1);
    store64(s + SS_HP, 20); store64(s + SS_MAXHP, 20);
    assert_eq(player_save(s), 1, "a real record is on disk");

    # Warm every one-time-init path FIRST. Without this the measurement below
    # picks up first-touch singletons and reports a per-attempt cost that is not
    # per-attempt at all — the 1.6.9 lesson about control arms, in miniature.
    var warm = _mk_sess("AllocHero", 9);
    assert_eq(player_auth_load(warm, "wrongpass", 9), 0, "a wrong passphrase is refused");

    var N = 20;
    var b0 = alloc_used();
    var i = 0;
    while (i < N) {
        var t = _mk_sess("AllocHero", 9);
        assert_eq(player_auth_load(t, "wrongpass", 9), 0, "...refused every time");
        i = i + 1;
    }
    var spent = alloc_used() - b0;
    assert_eq(spent, 0,
              "THE ASSERTION THIS GROUP EXISTS FOR: 20 wrong-passphrase logins allocate ZERO bytes");

    # The CONTRAST, so the zero above cannot be passing because the record is
    # unreadable or the function is short-circuiting for some other reason. This
    # is the cost that used to be paid on the line an attacker can queue for free.
    _path_for(load64(s + SS_NAME_BUF), load64(s + SS_NAME_LEN), g_persist_path);
    var n = file_read_all(g_persist_path, g_persist_slurp, SLURP_CAP - 1);
    assert(n > 0, "the record really is readable");
    var c0 = alloc_used();
    toml_parse(str_new(g_persist_slurp, n));
    var parse_cost = alloc_used() - c0;
    assert(parse_cost > 1000,
           "...and parsing it really does cost real, unreclaimable memory (measured 2248 B)");

    # And the right passphrase still works — otherwise a function that simply
    # refused everything would pass every assertion above.
    var good = _mk_sess("AllocHero", 9);
    assert_eq(player_auth_load(good, "rightpass", 9), 1, "the correct passphrase still loads");
    assert_eq(load64(good + SS_HP), 20, "...and restores the record's fields");

    # --- NO PARSER DIFFERENTIAL. Two readers now look at one record.
    #
    # This is a hole the fix ITSELF could have opened, and the guard against it is
    # load-bearing rather than decorative — verified, not assumed. bayan accepts
    # shapes the strict scanner skips (`salt="x"`, `salt  =  "x"`, a leading
    # indent, a tab before the `=`), and on a duplicate key BOTH take the FIRST
    # match. So a loose line placed ahead of the real one is read by bayan and
    # skipped by the scanner: the scanner authenticates against the REAL salt
    # while every field below would have been restored from the ATTACKER'S.
    #
    # Measured: all four loose shapes produce that disagreement.
    #
    # THE CRAFTED RECORD MUST VERIFY, or this proves nothing. The first version of
    # this assertion spliced a loose line into an existing record, which changed
    # the signed prefix — so `ed25519_verify` refused it and the assertion passed
    # with the guard DELETED. Three mutations survived on that. A player owns
    # their signing key (ADR 0004), so the honest adversary here signs their own
    # crafted record, and the test must do the same.
    var loose = alloc(512);
    var lo = _str_into(loose, 0, "salt=\"");
    var z = 0;
    while (z < SALT_LEN * 2) { store8(loose + lo, 97); lo = lo + 1; z = z + 1; }   # 'a' x32
    lo = _str_into(loose, lo, "\"\nsalt = \"");
    lo = _str_into(loose, lo, hex_encode(blk, SALT_LEN));          # the REAL salt, strict shape
    lo = _str_into(loose, lo, "\"\npubkey = \"");
    lo = _str_into(loose, lo, hex_encode(blk + IDENT_PK, PK_LEN));
    lo = _str_into(loose, lo, "\"\n");
    store8(loose + lo, 0);
    _sign_record_as("Crafted", 7, blk, loose);

    var cs = _mk_sess("Crafted", 7);
    var cres = player_auth_load(cs, "rightpass", 9);
    assert_eq(cres, 0 - 2,
              "a validly-signed record the two readers DISAGREE about is refused");
    assert(cres != 1, "...and above all it does not authenticate");

    # The same record without the decoy loads, so the refusal above is the
    # disagreement and not something incidental about hand-signed records.
    var clean = alloc(512);
    var qo = _str_into(clean, 0, "salt = \"");
    qo = _str_into(clean, qo, hex_encode(blk, SALT_LEN));
    qo = _str_into(clean, qo, "\"\npubkey = \"");
    qo = _str_into(clean, qo, hex_encode(blk + IDENT_PK, PK_LEN));
    qo = _str_into(clean, qo, "\"\n");
    store8(clean + qo, 0);
    _sign_record_as("Crafted", 7, blk, clean);
    var cs2 = _mk_sess("Crafted", 7);
    assert_eq(player_auth_load(cs2, "rightpass", 9), 1,
              "...the identical record WITHOUT the decoy line loads normally");

    # --- THE FAST PATH IS AN OPTIMISATION, NOT A SECOND RECORD FORMAT.
    #
    # The scanner is stricter than bayan on purpose, and the first version of this
    # fix returned a TERMINAL -2 whenever the strict scan failed. That would have
    # turned every shape bayan accepts but the scanner skips — a leading indent,
    # `salt="x"` with no spaces, tabs around the `=` — from "loads fine" into
    # "your character is corrupt", i.e. it would have quietly given this server a
    # second, narrower save format. A failed scan must FALL THROUGH to the parser.
    var lshape = alloc(512);
    var lso = _str_into(lshape, 0, "salt=\"");                 # loose: no spaces
    lso = _str_into(lshape, lso, hex_encode(blk, SALT_LEN));
    lso = _str_into(lshape, lso, "\"\n  pubkey  =  \"");       # loose: indent + wide spacing
    lso = _str_into(lshape, lso, hex_encode(blk + IDENT_PK, PK_LEN));
    lso = _str_into(lshape, lso, "\"\n");
    store8(lshape + lso, 0);
    # Neither key is in the canonical shape, so the scanner must decline both...
    var chk[8];
    assert_eq(_scan_kv(lshape, lso, "salt", &chk), 0, "the scanner declines the loose salt");
    assert_eq(_scan_kv(lshape, lso, "pubkey", &chk), 0, "...and the loose pubkey");
    # ...and the record must STILL load, via the parser, exactly as before 1.7.8.
    _sign_record_as("Crafted", 7, blk, lshape);
    var ls = _mk_sess("Crafted", 7);
    assert_eq(player_auth_load(ls, "rightpass", 9), 1,
              "a record only BAYAN can read still loads — the fast path falls through, it does not refuse");
    # And a wrong passphrase against that same record is still re-promptable (0),
    # never terminal — the slow path owes the same authentication.
    var ls2 = _mk_sess("Crafted", 7);
    assert_eq(player_auth_load(ls2, "wrongpass", 9), 0,
              "...and a wrong passphrase on the slow path is still 0, not -2");

    # THE LENGTH HALF OF THE GUARD, which the byte comparison alone does NOT
    # cover. Give bayan a value whose first 32 bytes ARE the scanner's value and
    # which then runs on: the memcmp is handed the scanner's length, compares 32
    # bytes, and passes. Only the length check sees the difference — and without
    # it the comparison would also be reading `slen` bytes out of a string that
    # may be shorter, which is the memory-safety half of why it is there.
    var pfx = alloc(512);
    var fo = _str_into(pfx, 0, "salt=\"");
    fo = _str_into(pfx, fo, hex_encode(blk, SALT_LEN));        # a PREFIX-MATCHING decoy...
    z = 0;
    while (z < SALT_LEN * 2) { store8(pfx + fo, 97); fo = fo + 1; z = z + 1; }   # ...that keeps going
    fo = _str_into(pfx, fo, "\"\nsalt = \"");
    fo = _str_into(pfx, fo, hex_encode(blk, SALT_LEN));
    fo = _str_into(pfx, fo, "\"\npubkey = \"");
    fo = _str_into(pfx, fo, hex_encode(blk + IDENT_PK, PK_LEN));
    fo = _str_into(pfx, fo, "\"\n");
    store8(pfx + fo, 0);
    _sign_record_as("Crafted", 7, blk, pfx);
    var cs6 = _mk_sess("Crafted", 7);
    assert_eq(player_auth_load(cs6, "rightpass", 9), 0 - 2,
              "a decoy whose value merely STARTS with the real one is still refused");

    # A decoy on `pubkey` is refused the same way — the guard covers both fields.
    var pdec = alloc(512);
    var po = _str_into(pdec, 0, "pubkey=\"");
    z = 0;
    while (z < PK_LEN * 2) { store8(pdec + po, 97); po = po + 1; z = z + 1; }
    po = _str_into(pdec, po, "\"\nsalt = \"");
    po = _str_into(pdec, po, hex_encode(blk, SALT_LEN));
    po = _str_into(pdec, po, "\"\npubkey = \"");
    po = _str_into(pdec, po, hex_encode(blk + IDENT_PK, PK_LEN));
    po = _str_into(pdec, po, "\"\n");
    store8(pdec + po, 0);
    _sign_record_as("Crafted", 7, blk, pdec);
    var cs3 = _mk_sess("Crafted", 7);
    assert_eq(player_auth_load(cs3, "rightpass", 9), 0 - 2,
              "a decoy `pubkey` line is refused too");

    # KEYS MUST START A LINE. `xsalt = "..."` is a different key and must not be
    # read as `salt`; a scanner that matched anywhere would take the decoy's value
    # and the real passphrase would then fail to derive it.
    var pre = alloc(512);
    var xo = _str_into(pre, 0, "xsalt = \"");
    z = 0;
    while (z < SALT_LEN * 2) { store8(pre + xo, 97); xo = xo + 1; z = z + 1; }
    xo = _str_into(pre, xo, "\"\nsalt = \"");
    xo = _str_into(pre, xo, hex_encode(blk, SALT_LEN));
    xo = _str_into(pre, xo, "\"\npubkey = \"");
    xo = _str_into(pre, xo, hex_encode(blk + IDENT_PK, PK_LEN));
    xo = _str_into(pre, xo, "\"\n");
    store8(pre + xo, 0);
    _sign_record_as("Crafted", 7, blk, pre);
    var cs4 = _mk_sess("Crafted", 7);
    assert_eq(player_auth_load(cs4, "rightpass", 9), 1,
              "a key that merely ENDS with the name we want is not that key");

    # An over-long `pubkey` hex is refused BEFORE the decode, exactly as the
    # 0.9.0 salt guard is. `hex_decode_into` writes len/2 bytes with no
    # destination bound, so without this the 256-byte g_persist_dec overflows —
    # pre-authentication, from a planted file.
    var big = alloc(SLURP_CAP);
    var bo2 = _str_into(big, 0, "[player]\nsalt = \"");
    bo2 = _str_into(big, bo2, hex_encode(blk, SALT_LEN));
    bo2 = _str_into(big, bo2, "\"\npubkey = \"");
    z = 0;
    while (z < 5000) { store8(big + bo2, 97); bo2 = bo2 + 1; z = z + 1; }
    bo2 = _str_into(big, bo2, "\"\nsig = \"");
    z = 0;
    while (z < SIG_LEN * 2) { store8(big + bo2, 48); bo2 = bo2 + 1; z = z + 1; }
    bo2 = _str_into(big, bo2, "\"\n");
    _write_record_raw("Crafted", 7, big, bo2);
    var cs5 = _mk_sess("Crafted", 7);
    assert_eq(player_auth_load(cs5, "rightpass", 9), 0 - 2,
              "an over-long pubkey hex is rejected before decode (no overflow)");

    _player_unlink("Crafted", 7);

    # --- THE AGNOS GUARD. No test on this target can distinguish rename from GPU
    # dispatch, because on x86_64 syscall 82 really IS rename. The source can.
    assert_eq(_raw_syscalls_in("src/persist.cyr"), 0,
              "persist.cyr calls NO raw numeric syscall — every one goes through a portable wrapper");
    assert_eq(_raw_syscalls_in("src/session.cyr"), 0, "...nor does session.cyr");
    assert_eq(_raw_syscalls_in("src/item.cyr"), 0, "...nor item.cyr");
    # And the scanner is not vacuous: it finds one when one is there.
    var probe = alloc(256);
    var pl = _str_into(probe, 0, "# syscall(82, a, b) in a comment does not count\nfn f() { syscall(87, x); }\n");
    _write_record_raw("SyscallProbe", 12, probe, pl);
    _path_for("SyscallProbe", 12, g_persist_path);
    assert_eq(_raw_syscalls_in(g_persist_path), 1,
              "...and the scanner counts a real one while ignoring the commented one");
    _player_unlink("SyscallProbe", 12);

    # --- 1.7.8's other half: the portable mkdir. On this target it takes the
    # #else (mode) branch; on AGNOS the length branch. Either way a save must be
    # able to create its shard directory, which is what failed on AGNOS.
    assert_eq(player_save(s), 1, "a save still creates its shard directory and publishes");
    assert_eq(player_exists("AllocHero", 9), 1, "...and the record is findable afterwards");

    _player_unlink("AllocHero", 9);
    return 0;
}

# Count complete IAC triples from `from`, and whether the stream ends inside one.
# A trailing partial is the defect: `IAC WONT` with no option byte makes a
# conformant client eat the next data byte as the option code.
fn _iac_scan(buf, n, from, out_partial): i64 {
    var i = from;
    var triples = 0;
    store64(out_partial, 0);
    while (i < n) {
        if ((load8(buf + i) & 0xFF) == 255) {
            if (i + 2 < n) { triples = triples + 1; i = i + 3; }
            else { store64(out_partial, 1); i = n; }
        } else {
            i = i + 1;
        }
    }
    return triples;
}

# === 1.7.9 — the RX loop must be able to afford its own replies. ===
#
# MEASURED on this tree, driving the real `session_consume_rx_max` with a TX
# queue 4001 bytes full (a slow-reading peer) and 50 `IAC DO 42` triples of input:
#
#   | | TX after | complete triples | trailing PARTIAL escape | RX retained |
#   |---|---|---|---|---|
#   | before | **4096 — run dry** | 31 | **YES** | 0 |
#   | after  | 4034 | 11 | no | 117, re-armed |
#
# The partial is a bare `IAC WONT` with no option byte, and the 19 further
# replies were discarded outright because `telnet_tx_consume` clears the source
# whether or not the append fit.
#
# NEITHER EXISTING BOUND COULD SEE IT, which is the part worth keeping:
# `RX_MAX_LINES` counts COMPLETED LINES and a negotiation triple yields EV_NONE,
# so `fired` stays 0; the 1.7.0 charge window bills only `ed25519_*` and prose
# bytes, and negotiation costs neither. Every option except ECHO(1) and SGA(3) is
# untracked and the refusal is STATELESS for untracked options, so there is no
# Q-method state to damp the repeat either.
fn test_rx_bounds(): i64 {
    test_group("rx-bounds");

    # --- The atomic appender, over its domain. This is the primitive the RX
    # path needed and did not have.
    var a = _freeable_sess();
    _tx_reset(a);
    assert_eq(session_appendtx_atomic_cstr(a, "abc"), 1, "a short append into an empty queue is written");
    assert_eq(load64(a + SS_TX_LEN), 3, "...all of it");
    store64(a + SS_TX_LEN, TX_CAP - 3);
    assert_eq(session_appendtx_atomic_cstr(a, "xyz"), 1, "an append that EXACTLY fills the queue is written");
    assert_eq(load64(a + SS_TX_LEN), TX_CAP, "...to the last byte");
    assert_eq(session_appendtx_atomic_cstr(a, "!"), 0, "one byte past the end is refused");
    assert_eq(load64(a + SS_TX_LEN), TX_CAP, "...and writes NOTHING — all or nothing, never a prefix");
    store64(a + SS_TX_LEN, TX_CAP - 2);
    assert_eq(session_appendtx_atomic_cstr(a, "abc"), 0, "a 3-byte escape into 2 bytes of room is refused");
    assert_eq(load64(a + SS_TX_LEN), TX_CAP - 2,
              "...and leaves no partial escape behind, which is the whole point");
    session_free(a);

    # --- The IAC sites that fire for EVERY real client: the passphrase prompt
    # raises WILL ECHO and drops it again with WONT ECHO, both AFTER the prompt
    # prose is already queued — so they meet a full buffer sooner than the
    # negotiation path does, not later.
    var e = _freeable_sess();
    _tx_reset(e);
    store64(e + SS_TX_LEN, TX_CAP - 2);
    assert_eq(session_echo_off(e), 0, "WILL ECHO is refused rather than sent in halves");
    assert_eq(load64(e + SS_TX_LEN), TX_CAP - 2, "...leaving no bare IAC");
    assert_eq(session_echo_on(e), 0, "WONT ECHO likewise");
    assert_eq(load64(e + SS_TX_LEN), TX_CAP - 2, "...likewise");
    _tx_reset(e);
    assert_eq(session_echo_off(e), 1, "with room, the option really is announced");
    assert_eq(load64(e + SS_TX_LEN), 3, "...all three bytes of it");
    session_free(e);

    # --- session_tx_room over its domain. Pure, so it needs no socket.
    var r = _freeable_sess();
    store64(r + SS_TX_LEN, 0);
    assert_eq(session_tx_room(r), TX_CAP, "an empty queue has the whole buffer free");
    store64(r + SS_TX_LEN, TX_CAP);
    assert_eq(session_tx_room(r), 0, "a full queue has none");
    store64(r + SS_TX_LEN, TX_CAP - 10);
    assert_eq(session_tx_room(r), 10, "...and the arithmetic in between");
    session_free(r);

    # --- THE BUG. A slow-reading peer leaves TX nearly full; 4001 is chosen so
    # the remaining room (95) is NOT a multiple of 3 and the cut therefore lands
    # INSIDE a triple rather than neatly between two.
    var s = _freeable_sess();
    store64(s + SS_PHASE, PHASE_CMD);
    store64(s + SS_AUTHED, 1);
    _tx_reset(s);
    var pad = 0;
    while (pad < 4001) { session_appendtx_cstr(s, "x"); pad = pad + 1; }
    assert_eq(load64(s + SS_TX_LEN), 4001, "the queue really is nearly full");

    var rx = load64(s + SS_RX_BUF);
    var k = 0;
    while (k < 150) {                          # 50 x `IAC DO 42`, an UNTRACKED option
        store8(rx + k, IAC); store8(rx + k + 1, DO); store8(rx + k + 2, 42);
        k = k + 3;
    }
    store64(s + SS_RX_LEN, 150);
    var fired[8];
    var ret = session_consume_rx_max(s, RX_MAX_LINES, &fired);

    var tx = load64(s + SS_TX_BUF);
    var n = load64(s + SS_TX_LEN);
    var partial[8];
    var triples = _iac_scan(tx, n, 4001, &partial);

    assert_eq(load64(&partial), 0,
              "THE ASSERTION THIS GROUP EXISTS FOR: no bare IAC reaches the wire");
    assert(triples > 0, "...and the replies that DID fit were still sent");
    assert_eq(load64(&fired), 0,
              "negotiation completes NO line — which is why the line cap could never bound this");

    # INPUT IS NOT COUPLED TO OUTPUT. An earlier cut of this fix refused to READ
    # while the queue was full, which deadlocked: every pass consumed nothing,
    # drain_pending_rx re-armed off SS_RX_LEN > 0, and the event loop clamped its
    # timeout to zero — a 100% CPU spin the idle sweep could not collect, because
    # session_on_readable_max refreshes the activity stamp off retained bytes.
    # Bounding the OUTPUT has neither problem, and this pins that difference.
    assert_eq(load64(s + SS_RX_LEN), 0, "the whole read is still consumed even with a full queue");
    assert_eq(ret, 0, "...so no spurious backlog, and no spin");

    # --- An ORDINARY client is unaffected: with room, every triple is answered
    # and the whole read is consumed. Without this the group would pass with the
    # loop refusing to do anything at all.
    _tx_reset(s);
    k = 0;
    while (k < 150) {
        store8(rx + k, IAC); store8(rx + k + 1, DO); store8(rx + k + 2, 42);
        k = k + 3;
    }
    store64(s + SS_RX_LEN, 150);
    ret = session_consume_rx_max(s, RX_MAX_LINES, &fired);
    n = load64(s + SS_TX_LEN);
    triples = _iac_scan(load64(s + SS_TX_BUF), n, 0, &partial);
    assert_eq(triples, 50, "with room, every one of the 50 triples is answered");
    assert_eq(load64(&partial), 0, "...none of them truncated");
    assert_eq(load64(s + SS_RX_LEN), 0, "...the whole read is consumed");
    assert_eq(ret, 0, "...and there is no backlog");

    # --- THE ROOM HEADER, which ran AHEAD of the three sections 1.7.6 guarded.
    #
    # The title is capped by the loader (RM_TITLE_CAP = 80). The PROSE is not — it
    # is a raw (ptr, len) borrowed straight from the parsed CYML buffer — so an
    # authored room with a large body consumed the whole queue INCLUDING the 512
    # bytes those sections hold back for the prompt. Guarding three sections and
    # not the write that precedes them is the same partial application this
    # release line keeps finding.
    var hs = _freeable_sess();
    store64(hs + SS_ROOM, 0);
    store64(hs + SS_PHASE, PHASE_CMD);
    store64(hs + SS_FD, 0 - 1);
    store64(hs + SS_AUTHED, 1);
    var rr = room_at(0);
    var old_ptr = load64(rr + RM_PROSE_PTR);
    var old_len = load64(rr + RM_PROSE_LEN);
    var huge = alloc(6000);
    memset(huge, 46, 6000);                       # 6000 '.' — well past TX_CAP
    store64(rr + RM_PROSE_PTR, huge);
    store64(rr + RM_PROSE_LEN, 6000);
    _tx_reset(hs);
    cmd_on_line(hs, "look", 4);
    var hn = load64(hs + SS_TX_LEN);
    var htx = load64(hs + SS_TX_BUF);
    assert(hn <= TX_CAP, "an oversized room body stays inside the buffer");
    assert(hn < TX_CAP, "...without running it dry");
    assert_eq(_contains(htx, hn, "> "), 1,
              "...and the PROMPT still reaches the client, which is what the reserve is for");
    assert_eq(_contains(htx, hn, " ..."), 1, "...and the prose says it was cut");
    store64(rr + RM_PROSE_PTR, old_ptr);
    store64(rr + RM_PROSE_LEN, old_len);
    # The ordinary room is untouched — no marker, and still well inside the buffer.
    _tx_reset(hs);
    cmd_on_line(hs, "look", 4);
    hn = load64(hs + SS_TX_LEN); htx = load64(hs + SS_TX_BUF);
    assert_eq(_contains(htx, hn, " ..."), 0, "an authored room is not truncated");
    assert_eq(_contains(htx, hn, "> "), 1, "...and still gets its prompt");
    session_free(hs);

    # --- ITEM X: the passphrase mask is a 2x amplifier and had no bound either.
    # One '*' per printable byte and THREE ("\b \b") per BS/DEL, so an interleave
    # costs 4 TX bytes per 2 RX bytes. LINE_CAP equals RX_CAP, so it bounds
    # nothing for a single read, and PASS_MAX is a line-dispatch check, never a
    # per-byte one. The same reserve covers it.
    store64(s + SS_PHASE, PHASE_PASS);
    store64(s + SS_LINE_LEN, 0);
    _tx_reset(s);
    pad = 0;
    while (pad < 4001) { session_appendtx_cstr(s, "x"); pad = pad + 1; }
    k = 0;
    while (k < 200) {                          # printable / DEL interleave
        store8(rx + k, 97); store8(rx + k + 1, 127);
        k = k + 2;
    }
    store64(s + SS_RX_LEN, 200);
    ret = session_consume_rx_max(s, RX_MAX_LINES, &fired);
    n = load64(s + SS_TX_LEN);
    assert(n <= TX_CAP, "the mask cannot overrun the queue");
    assert_eq(load64(s + SS_RX_LEN), 0, "...and it does not stall input either");
    assert_eq(ret, 0, "...no backlog");

    session_free(s);
    return 0;
}

# === 1.7.9 — the two remaining loops of the 1.7.6 class, and the tick path. ===
#
# `class_send_prompt` is DORMANT at the four shipped classes; nothing flushes
# between the lines of one read, so up to RX_MAX_LINES bad choices stack menus
# into a single queue, and at MAX_ENTRIES = 32 authored classes two stacked menus
# pass TX_CAP. `mob_swing` is on the TICK path, where `combat_flush` only marks
# the session dirty (1.6.8 coalesced writes to one per session per tick) — so
# every mob latched onto one player appends into the same 4 kB queue before
# anything drains it.
#
# The rule both follow is 1.7.7's: ration the ECHO, never the EFFECT.
fn test_tick_and_menu_bounds(): i64 {
    test_group("tick-menu-bounds");

    if (g_class_count == 0) { assert(0, "tick-menu-bounds: needs classes"); return 0; }

    # --- THE CLASS MENU. Rather than authoring 32 classes, fill the queue to
    # where a menu line cannot fit: the fit check is the thing under test, not
    # the class count.
    var s = _freeable_sess();
    _tx_reset(s);
    var pad = 0;
    while (pad < TX_CAP - ROOM_TAIL_RESERVE - 8) { session_appendtx_cstr(s, "x"); pad = pad + 1; }
    class_send_prompt(s);
    var tx = load64(s + SS_TX_BUF);
    var n = load64(s + SS_TX_LEN);
    assert(n <= TX_CAP, "the menu stays inside the buffer");
    assert(n < TX_CAP, "...without running it dry");
    assert_eq(_contains(tx, n, "more callings not shown."), 1,
              "...and it says how many callings it could not list");
    assert_eq(_contains(tx, n, "Enter a number or name: "), 1,
              "...while the PROMPT still reaches the client");

    # With room, every class is listed and no notice appears.
    _tx_reset(s);
    class_send_prompt(s);
    tx = load64(s + SS_TX_BUF); n = load64(s + SS_TX_LEN);
    assert_eq(_contains(tx, n, "more callings not shown."), 0,
              "an ordinary menu is not truncated");
    assert_eq(_contains(tx, n, "Enter a number or name: "), 1, "...and still prompts");
    assert(n < TX_CAP, "...well inside the buffer");
    session_free(s);

    # --- MOB SWING. THE EFFECT MUST SURVIVE THE ECHO BEING DROPPED. A player
    # must never take unreported damage and then survive because a buffer was
    # full — nor take none because it was.
    if (g_mob_tpl_count == 0) { assert(0, "tick-menu-bounds: needs mob templates"); return 0; }
    if (world_room_count() == 0) { assert(0, "tick-menu-bounds: needs a world"); return 0; }

    var p = _freeable_sess();
    store64(p + SS_ROOM, 0);
    store64(p + SS_PHASE, PHASE_CMD);
    store64(p + SS_FD, 0 - 1);
    store64(p + SS_AUTHED, 1);
    store64(p + SS_HP, 100000);            # survive every swing, so the loop runs
    store64(p + SS_MAXHP, 100000);
    store64(p + SS_AC, 50);                # HIGH ac = easy to hit (lower is harder)
    var m = mob_spawn(mt_at(0), 0);

    # A queue with no room for a combat line at all.
    _tx_reset(p);
    pad = 0;
    while (pad < TX_CAP - ROOM_TAIL_RESERVE - 4) { session_appendtx_cstr(p, "x"); pad = pad + 1; }
    var hp_before = load64(p + SS_HP);
    # combat_try_hit misses on a natural 1 whatever the bonus, so swing until it
    # connects rather than asserting a single roll — CI has caught this exact
    # assumption before (1.6.12's "guaranteed hit" that wasn't).
    var tries = 0;
    while (tries < 40) {
        mob_swing(p, m);
        if (load64(p + SS_HP) < hp_before) { tries = 40; } else { tries = tries + 1; }
    }
    var hp_after = load64(p + SS_HP);
    var n2 = load64(p + SS_TX_LEN);

    assert(hp_after < hp_before,
           "THE ASSERTION THIS EXISTS FOR: the swing still LANDS when its prose cannot be sent");
    assert(n2 <= TX_CAP, "...and the queue is not overrun");
    assert(n2 < TX_CAP, "...nor run dry");
    assert_eq(_contains(load64(p + SS_TX_BUF), n2, "hits you for"), 0,
              "...the line itself was the thing dropped");

    # With room, the same swing reports itself normally.
    _tx_reset(p);
    hp_before = load64(p + SS_HP);
    var saw = 0;
    tries = 0;
    while (tries < 40) {
        _tx_reset(p);
        mob_swing(p, m);
        if (_contains(load64(p + SS_TX_BUF), load64(p + SS_TX_LEN), "hits you for") == 1) {
            saw = 1; tries = 40;
        } else { tries = tries + 1; }
    }
    assert(load64(p + SS_HP) < hp_before, "with room the swing still lands");
    assert_eq(saw, 1, "...and now it is reported");

    mob_remove(m);
    session_free(p);
    return 0;
}

var exit_code = main();
syscall(60, exit_code);

