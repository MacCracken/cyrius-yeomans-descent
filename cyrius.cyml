[package]
name = "cyrius-yeomans-descent"
version = "${file:VERSION}"
description = "Yeoman's Descent — a Cyrius-native text MUD server set in a techno-feudal arcology"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.6.20"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "cyrius-yeomans-descent"

[deps]
# M1 stdlib surface. Adds: args (argv dispatch), net (lib/net.cyr socket
# primitives — see ADR 0002), chrono (clock_now_ms — the tick scheduler
# uses absolute-time computation per ADR 0003), result + tagged (used
# by net.cyr's Result return shape), fnptr (vec internals), freelist
# (per-session arena freed at disconnect per ADR 0003).
#
# M6 chain (persistence) — the crypto/store stdlib leaves (ct/keccak/random/
# thread/thread_local for sigil; fs/process/hashmap/slice + bayan [json/bigint
# carved into bayan @6.1.25] for libro) are NO LONGER hand-listed here. As of
# cyrius 6.2.46/.47/.48 the libro fold ships a `dist/libro.deps` SIDECAR that
# declares exactly those leaves; `cyrius deps` auto-resolves them (in topological
# order, fail-loud on a missing one) when [deps.libro] resolves. That ENDS the
# omit-one→runtime-SIGILL trap this 29-element hand-ordered list used to paper
# over — and the hand-ordering with it. sigil/sakshi/patra resolve TRANSITIVELY
# via [deps.libro] (and are excluded from the sidecar so they don't double-write).
# Only descent's OWN direct M1 surface remains below.
#
# v6.3.32 (cyrius modularity lever-1 Phase D): the 7 universal-core leaves
# (string/fmt/alloc/io/vec/str/syscalls) are now the built-in `std` DEFAULT GROUP
# — `std` expands to exactly those, in the same order, so this resolves the SAME
# symbol set as the old hand list with no boilerplate + no order-sensitivity. Only
# descent's non-core surface is listed explicitly.
#
# v6.4.83: `cyml` and `toml` are NO LONGER stdlib leaves — they were carved into
# **bayan** (same carve that took json/bigint at 6.1.25); the stdlib has shipped
# no cyml.cyr / toml.cyr since. Listing them here only ever resolved because
# descent's committed lib/ still held the pre-carve Jun-2026 copies, which then
# defined cyml_*/toml_* a SECOND time on top of bayan's (pulled in by libro's
# sidecar) — 40 "duplicate fn … last definition wins" warnings, with the zone /
# class loader silently running on whichever copy include order happened to pick.
# bayan is now listed directly: descent's own world.cyr + classes.cyr call
# cyml_*, so it is a first-party need, not an accident of the libro sidecar.
#
# v6.6.18 / libro 2.10.8: the sidecar above SHRANK from 27 leaves to 1
# (`hashmap`). `distlib` now writes it as exactly the leaves its compile-verify
# proves the BUNDLE needs, and sigil-mldsa + patra carry their own `# Requires`
# blocks for the rest — so a leaf a CONSUMER calls from its own code is no
# longer delivered by accident. `fs` is that leaf here: persist.cyr's boot census
# calls `dir_list` directly. Without it 6.6.20 refuses to emit the binary
# ("1 reachable undefined function"), where older toolchains emitted a ud2 trap.
stdlib = ["std", "assert", "bench", "args", "net", "chrono", "result", "tagged", "fnptr", "freelist", "fs", "bayan"]

# M6 persistence (ADR 0004 Ed25519 identity + crash-safe hash-chain store).
# libro = append-only SHA-256 hash-linked store (FileStore: flock +
# .tmp/rename atomic replace) — the real crash-safe primitive behind the
# "T.Ron" persistence subsystem. Pulls sigil 3.13.10 (Ed25519) + patra 1.15.2
# TRANSITIVELY (libro dropped its own [deps.agnosys] at the agnosys → agnodrm
# decomposition; the trust stack lives in sigil now).
#
# NO `path` LINE, deliberately (1.7.24). It used to read `path = "../libro"`,
# and below cyrius 6.7.6 `path` BEATS `tag` on every `cyrius build`, not just on
# `cyrius deps`. Once the sibling moved past this pin (2.11.x targets 6.7.18) a
# local build silently swapped in its libro + patra 1.16.6 — 6.7-only syntax —
# and failed, while CI kept building the tag. Without `path` this machine and
# CI resolve the same bytes. libro's own manifest ships without one for the same
# reason. From 6.7.6 a `path` is a dev override read only under CYRIUS_LOCAL, so
# it can come back then (roadmap: "Recorded by cyrius 6.7.6").
#
# NOTE — libro 2.8.0 thinned its sigil surface to capability sub-bundles, so
# this dep now lands lib/sigil-mldsa.cyr (Ed25519) + lib/sigil_sha256.cyr +
# lib/sigil_sha_ni.cyr + lib/sigil_hex.cyr, which cyrius auto-includes. That
# covers descent's ENTIRE sigil surface. Do NOT add `include "lib/sigil.cyr"`
# back: the monolith redefines every one of those symbols and drags in the
# x509/RSA bignum tables — ~13 MB of .bss nothing here calls. See src/main.cyr.
#
# ⚠ THE TRANSITIVE DOWNGRADE. `cyrius deps` applies a declared dep's copy ON TOP
# OF the `cyrius lib sync --full` snapshot on every resolve, so a dep that
# declares an OLDER tag than the pinned toolchain folds will silently DOWNGRADE
# that file for everything downstream. It is invisible on any machine with a
# sibling checkout (`path` beats `tag`) and invisible to `deps --verify` (the
# lock is regenerated FROM the downgraded file, so it agrees with itself) — only
# CI, which has no siblings, takes the hit. libro 2.8.8/2.8.10 exist to keep
# `[deps.patra]` equal to the patra the pinned cyrius folds. When bumping the
# toolchain pin above, check the pairing still holds (the sibling checkout no
# longer tracks the pin, so read libro's manifest AT THE TAG):
#     head -3 ~/.cyrius/versions/<pin>/lib/patra.cyr     # 6.6.20 folds 1.15.2
#     grep -A3 -F '[deps.patra]' ~/.cyrius/deps/libro/<tag>/cyrius.cyml
#                                                        # libro 2.10.8 pins 1.15.2
# (sigil pairs the same way: 6.6.20 folds 3.13.10, libro 2.10.8 pins 3.13.10.)
#
# That pairing is why there is no "./lib/ shadows version-pinned" warning. At
# 6.6.20 all 113 vendored stdlib files (106 at the top level + the 7 in
# lib/unicode/) are byte-identical to ~/.cyrius/versions/6.6.20/lib; the only
# files in lib/ that are NOT from that snapshot are libro's own bundle and the
# four sigil sub-bundles, which is exactly what [deps.libro] is supposed to land.
#
# The sakshi half of this was closed earlier, at 1.7.10, and sigil 3.12.7 removed
# the cause for good by moving sakshi out of its `[deps.sakshi]` git dep and into
# `[deps].stdlib` — it tracks the toolchain fold (2.5.7 at 6.6.20) now, so it can
# no longer downgrade lib/sakshi.cyr under a consumer.
[deps.libro]
git = "https://github.com/MacCracken/libro"
tag = "2.10.8"
modules = ["dist/libro.cyr"]
