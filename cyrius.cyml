[package]
name = "cyrius-yeomans-descent"
version = "${file:VERSION}"
description = "Yeoman's Descent — a Cyrius-native text MUD server set in a techno-feudal arcology"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.4.86"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "cyrius-yeomans-descent"

[deps]
# M1 stdlib surface. Adds: args (argv dispatch), net (lib/net.cyr socket
# primitives — see ADR 0002), chrono (clock_now_ms — the tick scheduler
# uses absolute-time computation per ADR 0003), result + tagged (used
# by net.cyr's Result return shape), fnptr (vec internals), freelist
# (per-session arena freed at disconnect per ADR 0003).
#
# M6 chain (persistence) — the crypto/store stdlib leaves (ct/keccak/random/
# thread/thread_local for sigil; fs/process/hashmap/slice + bayan [json/bigint
# carved into bayan @6.1.25] for libro) are NO LONGER hand-listed here. As of
# cyrius 6.2.46/.47/.48 the libro fold ships a `dist/libro.deps` SIDECAR that
# declares exactly those leaves; `cyrius deps` auto-resolves them (in topological
# order, fail-loud on a missing one) when [deps.libro] resolves. That ENDS the
# omit-one→runtime-SIGILL trap this 29-element hand-ordered list used to paper
# over — and the hand-ordering with it. sigil/sakshi/patra resolve TRANSITIVELY
# via [deps.libro] (and are excluded from the sidecar so they don't double-write).
# Only descent's OWN direct M1 surface remains below.
#
# v6.3.32 (cyrius modularity lever-1 Phase D): the 7 universal-core leaves
# (string/fmt/alloc/io/vec/str/syscalls) are now the built-in `std` DEFAULT GROUP
# — `std` expands to exactly those, in the same order, so this resolves the SAME
# symbol set as the old hand list with no boilerplate + no order-sensitivity. Only
# descent's non-core surface is listed explicitly.
#
# v6.4.83: `cyml` and `toml` are NO LONGER stdlib leaves — they were carved into
# **bayan** (same carve that took json/bigint at 6.1.25); the 6.4.83 stdlib ships
# no cyml.cyr / toml.cyr at all. Listing them here only ever resolved because
# descent's committed lib/ still held the pre-carve Jun-2026 copies, which then
# defined cyml_*/toml_* a SECOND time on top of bayan's (pulled in by libro's
# sidecar) — 40 "duplicate fn … last definition wins" warnings, with the zone /
# class loader silently running on whichever copy include order happened to pick.
# bayan is now listed directly: descent's own world.cyr + classes.cyr call
# cyml_*, so it is a first-party need, not an accident of the libro sidecar.
stdlib = ["std", "assert", "bench", "args", "net", "chrono", "result", "tagged", "fnptr", "freelist", "bayan"]

# M6 persistence (ADR 0004 Ed25519 identity + crash-safe hash-chain store).
# libro = append-only SHA-256 hash-linked store (FileStore: flock +
# .tmp/rename atomic replace) — the real crash-safe primitive behind the
# "T.Ron" persistence subsystem. Pulls sigil 3.12.1 (Ed25519) + sakshi 2.4.3 +
# patra 1.12.12 TRANSITIVELY (libro dropped its own [deps.agnosys] at the
# agnosys → agnodrm decomposition; the trust stack lives in sigil now).
# `path` resolves from the local sibling checkout (currently libro 2.8.3) —
# the `tag` documents the pinned release and must track that checkout's VERSION.
#
# NOTE — libro 2.8.0 thinned its sigil surface to capability sub-bundles, so
# this dep now lands lib/sigil-mldsa.cyr (Ed25519) + lib/sigil_sha256.cyr +
# lib/sigil_sha_ni.cyr + lib/sigil_hex.cyr, which cyrius auto-includes. That
# covers descent's ENTIRE sigil surface. Do NOT add `include "lib/sigil.cyr"`
# back: the monolith redefines every one of those symbols and drags in the
# x509/RSA bignum tables — ~13 MB of .bss nothing here calls. See src/main.cyr.
#
# sakshi resolves to 2.4.3 because sigil 3.12.1 pins that tag, while the 6.4.86
# toolchain bundles 2.4.6 — hence the standing "./lib/ shadows version-pinned"
# build warning. Needs a sigil-side bump; not fixable from descent.
[deps.libro]
git = "https://github.com/MacCracken/libro"
path = "../libro"
tag = "2.8.3"
modules = ["dist/libro.cyr"]
