# cyrius-yeomans-descent benchmarks
# Stdlib auto-included via cyrius.cyml; project modules included explicitly.
#
# M1-G: the Telnet IAC parser is the per-byte hot path — every inbound
# wire byte from every connection passes through telnet_feed(). This
# locks the M1-close baseline; re-run at every minor through 1.0 and
# compare ns/byte against it (roadmap M9-C).
#
# Pattern: bench_batch_start -> tight loop -> bench_batch_stop(total) ->
# bench_report. Sub-1us ops need batched timing to amortize the
# clock_gettime overhead — see lib/bench.cyr header.

include "src/telnet.cyr"

# Fill `buf` with a representative wire stream: runs of printable data
# interleaved with an IAC WILL ECHO negotiation triple and a CR LF per
# line. Ends cleanly in DATA state so the parser state is identical at
# the start of every repeat. Returns the byte length written.
fn build_wire_mixed(buf, cap): i64 {
    var n = 0;
    while (n < cap - 80) {
        var j = 0;
        while (j < 60) { store8(buf + n, 65 + (j % 26)); n = n + 1; j = j + 1; }
        store8(buf + n, IAC);      n = n + 1;
        store8(buf + n, WILL);     n = n + 1;
        store8(buf + n, OPT_ECHO); n = n + 1;
        store8(buf + n, 13);       n = n + 1;   # CR
        store8(buf + n, 10);       n = n + 1;   # LF
    }
    return n;
}

# Pure printable data — the fast path with no IAC dispatch.
fn build_wire_data(buf, cap): i64 {
    var n = 0;
    while (n < cap) { store8(buf + n, 65 + (n % 26)); n = n + 1; }
    return n;
}

# === 1.7.17 (AW) — this bench now GATES. ===
#
# It measured, printed, and returned 0 unconditionally: no budget constant, no
# comparison, no way to fail. `cyrius audit` has reported "6 passed" throughout
# while two of those six could not fail — this one and the scaffold placeholder
# at tests/*.bcyr — so the gate has been a five-bench gate wearing a six.
#
# That is the 1.7.12 lesson (*a bench that cannot reach the path reports a budget
# that is met and tells you nothing*) one level up, in the gate itself.
#
# The budget is 30 ns/byte against a measured 5-6 ns on this host, stable since
# 0.2.0. Deliberately 5x headroom rather than a tight gate: this is the per-byte
# hot path of every connection, and what it must catch is a REGRESSION IN KIND —
# a syscall, an allocation, or an accidental O(n^2) in the IAC state machine —
# not a slower CI runner. This repo has been burned twice by nondeterministic
# gates, and a tight number on a shared host is a coin flip.
enum TelnetBudget { TELNET_NS_PER_BYTE_MAX = 30; }

fn main(): i64 {
    alloc_init();
    var bad = 0;

    var cap = 4096;
    var wire = alloc(cap);
    var ts = telnet_state_new();

    # --- Mixed traffic (data + negotiation triples) ---
    var mlen = build_wire_mixed(wire, cap);
    var bm = bench_new("telnet_feed mixed (per byte)");
    var rounds = 4000;
    bench_batch_start(bm);
    var r = 0;
    while (r < rounds) {
        var k = 0;
        while (k < mlen) { telnet_feed(ts, load8(wire + k)); k = k + 1; }
        telnet_tx_consume(ts);   # drop negotiation replies; not the measured path
        r = r + 1;
    }
    var mixed_ns = bench_batch_stop(bm, rounds * mlen);
    bench_report(bm);
    print("    budget: ", 12); print_num(TELNET_NS_PER_BYTE_MAX); println(" ns/byte");
    if (mixed_ns > TELNET_NS_PER_BYTE_MAX) {
        println("    RESULT: FAIL — mixed traffic is over the per-byte budget");
        bad = 1;
    } else { println("    RESULT: PASS"); }

    # --- Pure data (fast path) ---
    var dlen = build_wire_data(wire, cap);
    var bd = bench_new("telnet_feed pure-data (per byte)");
    bench_batch_start(bd);
    var r2 = 0;
    while (r2 < rounds) {
        var k2 = 0;
        while (k2 < dlen) { telnet_feed(ts, load8(wire + k2)); k2 = k2 + 1; }
        r2 = r2 + 1;
    }
    var data_ns = bench_batch_stop(bd, rounds * dlen);
    bench_report(bd);
    print("    budget: ", 12); print_num(TELNET_NS_PER_BYTE_MAX); println(" ns/byte");
    if (data_ns > TELNET_NS_PER_BYTE_MAX) {
        println("    RESULT: FAIL — the pure-data fast path is over the per-byte budget");
        bad = 1;
    } else { println("    RESULT: PASS"); }

    return bad;
}

var r = main();
syscall(60, r);
