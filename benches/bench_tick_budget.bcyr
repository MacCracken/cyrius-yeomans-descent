# cyrius-yeomans-descent — one event-loop pass, against the drift allowance
# (1.7.0).
#
# This bench exists because of what it caught. Every per-tick budget in the tree
# was individually justified in a comment, and NOTHING summed them. The gate
# sweep measured one pass with every budget at its cap at 261 ms, from sixteen
# connections sending wrong passphrases. No account required.
#
# The defect was a comment that did its arithmetic against the wrong number.
# `DRAIN_LINES_MAX` budgeted `16 x ~1.08 ms (a keypair derivation)`. A keypair
# derivation is not the costliest line an unauthenticated connection can send —
# a wrong passphrase against a name that EXISTS is, because it paid a full
# `player_auth_load`. That was ~8 ms, seven times the assumed cost, and the
# correct figure was already written down twice in the same file (server.cyr
# "measured 7.66 ms" and "~8.1 ms for a wrong-passphrase verify"). The budget
# comment used neither. So: **a per-component budget justified in prose is not a
# budget.** A comment cannot fail CI. This can.
#
# WHAT IS GATED, AND WHY IT IS NOT "THE WHOLE PASS".
#
# The first version of this bench summed all four components against 50 ms and
# called the result 504%. That was the same species of loose as the comment it
# indicts, and it is worth spelling out because it would otherwise get
# reintroduced. `record_tick_drift(now - next_tick)` (server.cyr) takes a
# PRE-WORK sample, and the F8 comment beside it says any overrun shorter than one
# interval is "invisible to the drift metric by construction". So:
#
#   - The drift allowance constrains work done BEFORE the tick check:
#     handle_accept, the event batch, and — since 1.7.0 moved it there —
#     drain_pending_rx. That is what this bench GATES.
#   - save_sweep and sweep_idle run inside advance_tick. They are tick-BODY
#     occupancy: real cost, different quantity, measured against the 2.5 s
#     interval rather than the drift allowance. Those are REPORTED, not gated.
#
# Gating the sum of the two would mix in 43.3 ms of legitimate combat fan-out
# (bench_combat BIGPLAYERS, passing) that nothing in this release can reduce, and
# the pressure would then be to quietly size the threshold to whatever the tree
# happens to measure. That is exactly how a budget stops meaning anything.
# **Gate what the fix guarantees; report the rest.**
#
# Pre-1.7.0 the gated quantity was ~247 ms; the property that this bench fails
# against the old code is preserved.

include "lib/thread.cyr"
include "lib/thread_local.cyr"
include "lib/sakshi.cyr"
include "lib/libro.cyr"

include "src/telnet.cyr"
include "src/parser.cyr"
include "src/world.cyr"
include "src/mob.cyr"
include "src/session.cyr"
include "src/item.cyr"
include "src/combat.cyr"
include "src/classes.cyr"
include "src/persist.cyr"
include "src/server.cyr"

# TB_ prefix throughout: enum constants share ONE FLAT namespace across the whole
# program, so a bare `DRIFT_BUDGET_US` here could silently capture a same-named
# constant in src/ — bench_combat.bcyr already defines a bare `BUDGET_NS` while
# including src/server.cyr, which is precisely this hazard.
enum TickBudgetBench {
    TB_ATTACKERS = 16;   # sessions used to try to fill each window
    TB_SAVERS    = 8;    # dirty/idle sessions offered to the sweeps (> the caps)
    TB_NDERIVE   = 20;   # reps for the calibration probe
    # The calibration tripwire. Every charge in ChargeUnits is a reference-host
    # measurement, and on a much slower box each one under-values the real cost,
    # so the true bound is looser than the constants claim. An absolute threshold
    # cannot catch that; a ratio can. 2x is the point at which the derived
    # constants stop describing this machine.
    TB_CALIB_MAX_PCT = 200;
}

var g_tb_fail = 0;

fn tb_line(label, us): i64 {
    print("    ", 4); print(label, strlen(label));
    print(" : ", 3); print_num(us / 1000); println(" ms");
    return 0;
}

# A session parked in PHASE_PASS with `nlines` wrong-passphrase lines queued.
# SS_FD is -1 so flushes fail harmlessly — the cost measured is the dispatch.
fn tb_armed_pass(nlines): i64 {
    var s = fl_alloc(SS_SIZE);
    memset(s, 0, SS_SIZE);
    store64(s + SS_TX_BUF,   fl_alloc(TX_CAP));
    store64(s + SS_RX_BUF,   fl_alloc(RX_CAP));
    store64(s + SS_LINE_BUF, fl_alloc(LINE_CAP));
    var nm = fl_alloc(NAME_CAP);
    memcpy(nm, "Victim", 6);
    store64(s + SS_NAME_BUF, nm);
    store64(s + SS_NAME_LEN, 6);
    store64(s + SS_TS, telnet_state_new());
    store64(s + SS_FD, 0 - 1);
    store64(s + SS_ROOM, 0 - 1);
    store64(s + SS_PHASE, PHASE_PASS);
    # Each line is >= PASS_MIN so it survives the H5 (1.6.2) length pre-check and
    # actually reaches the identity check. A line rejected on length costs
    # nothing and would understate the worst case.
    var rx = load64(s + SS_RX_BUF);
    var o = 0;
    var line = 0;
    while (line < nlines) {
        var k = 0;
        while (k < 11) { store8(rx + o, 119 + (line % 2)); o = o + 1; k = k + 1; }
        store8(rx + o, 13); o = o + 1;
        line = line + 1;
    }
    store64(s + SS_RX_LEN, o);
    return s;
}

# An authenticated session with a real derived identity, dirty and due a save.
fn tb_saver(seed): i64 {
    var s = fl_alloc(SS_SIZE);
    memset(s, 0, SS_SIZE);
    store64(s + SS_TX_BUF,   fl_alloc(TX_CAP));
    store64(s + SS_RX_BUF,   fl_alloc(RX_CAP));
    store64(s + SS_LINE_BUF, fl_alloc(LINE_CAP));
    var nm = fl_alloc(NAME_CAP);
    memcpy(nm, "Saver", 5);
    store8(nm + 5, 65 + (seed % 26));
    store64(s + SS_NAME_BUF, nm);
    store64(s + SS_NAME_LEN, 6);
    store64(s + SS_TS, telnet_state_new());
    store64(s + SS_FD, 0 - 1);
    var salt = alloc(SALT_LEN);
    var i = 0;
    while (i < SALT_LEN) { store8(salt + i, seed + i); i = i + 1; }
    var blk = sess_ident(s);
    memcpy(blk, salt, SALT_LEN);
    ident_derive(salt, "benchpassphrase", 15, blk + IDENT_SK, blk + IDENT_PK);
    store64(blk + IDENT_CREATED, 1000000);
    store64(s + SS_ROOM, 0 - 1);
    store64(s + SS_HP, 20); store64(s + SS_MAXHP, 20);
    store64(s + SS_CLASS, 0);
    store64(s + SS_AUTHED, 1);
    store64(s + SS_PHASE, PHASE_CMD);
    store64(s + SS_SAVE_DIRTY, 1);
    store64(s + SS_LAST_SAVE_MS, 0);   # never saved -> due
    return s;
}

fn main(): i64 {
    alloc_init();
    persist_init();
    if (world_load_rooms(DP_ROOMS) != WL_OK) { println("  setup: rooms failed to load"); return 1; }
    world_load_objs(DP_OBJS);
    world_load_mobs(DP_MOBS);
    g_epfd = 0;

    # A real signed record for the attackers to fail against. This is what makes
    # the worst case reachable without an account: the attacker needs ONE name
    # that exists, and creating one is free.
    var v = tb_saver(11);
    store64(v + SS_NAME_LEN, 6);
    memcpy(load64(v + SS_NAME_BUF), "Victim", 6);
    if (player_save(v) != 1) { println("  setup: could not write the victim record"); return 1; }

    # Warm every lazy init (the filestore opens on first append).
    var warm = tb_armed_pass(1);
    session_list_push(warm);
    drain_pending_rx();
    g_session_head = 0;

    # === CALIBRATION TRIPWIRE ==============================================
    # Does the charge table still describe THIS machine? Every constant in
    # ChargeUnits is a reference-host figure; on much slower hardware each one
    # under-values the real cost and the true bound is looser than claimed.
    println("charge-table calibration:");
    var sk = alloc(64);
    var pk = alloc(32);
    var cs = alloc(SALT_LEN);
    var ci = 0;
    while (ci < SALT_LEN) { store8(cs + ci, 3 + ci); ci = ci + 1; }
    ident_derive(cs, "calibrationpass", 15, sk, pk);      # warm
    var ct0 = clock_now_ns();
    ci = 0;
    while (ci < TB_NDERIVE) { ident_derive(cs, "calibrationpass", 15, sk, pk); ci = ci + 1; }
    var derive_us = (clock_now_ns() - ct0) / 1000 / TB_NDERIVE;
    var charged_us = CHG_DERIVE * CHARGE_UNIT_US;
    var pct = derive_us * 100 / charged_us;
    print("    ident_derive here : ", 24); print_num(derive_us);
    print(" us   charged: ", 17); print_num(charged_us);
    print(" us   (", 8); print_num(pct); println("% of charge)");
    if (pct > TB_CALIB_MAX_PCT) {
        println("    RESULT: FAIL — this host is far slower than the charge table assumes;");
        println("            every charge under-values real cost, so the bound is looser");
        println("            than ChargeUnits claims. Re-derive the table on this host.");
        g_tb_fail = 1;
    } else {
        println("    RESULT: PASS (charge table still describes this host)");
    }

    # === GATED: work done BEFORE the tick check =============================
    println("pre-tick-check work (what the drift allowance constrains):");

    # --- The event batch, driven through the REAL window the loops open. Using
    # event_pass_begin() rather than a bare count is the point: a bare count
    # leaves g_charge_cap at 0, which is unmetered, and would measure 1.6.15.
    var eb = event_pass_begin();
    var t1 = clock_now_ns();
    var j = 0;
    while (j < TB_ATTACKERS) {
        var keep[8];
        eb = event_batch_step(0, tb_armed_pass(2), EPOLLIN, 0, eb, &keep);
        j = j + 1;
    }
    var event_us = (clock_now_ns() - t1) / 1000;
    event_pass_end();
    tb_line("event_batch_step (one window)  ", event_us);

    # --- The drain, which since 1.7.0 also runs per PASS rather than per tick,
    # and opens its own window.
    var i = 0;
    while (i < TB_ATTACKERS) {
        session_list_push(tb_armed_pass(2));
        i = i + 1;
    }
    var t0 = clock_now_ns();
    drain_pending_rx();
    var drain_us = (clock_now_ns() - t0) / 1000;
    g_session_head = 0;
    tb_line("drain_pending_rx (one window)  ", drain_us);

    var gated_us = event_us + drain_us;
    print("    ---", 7); println("");
    print("    GATED: pre-tick-check total : ", 34);
    print_num(gated_us / 1000); print(" ms   (", 8);
    print_num(gated_us * 100 / ADR1_DRIFT_US); print("% of ", 5);
    print_num(ADR1_DRIFT_US / 1000); println(" ms)");
    if (gated_us >= ADR1_DRIFT_US) {
        println("    RESULT: FAIL — one pass delays a scheduled tick by more than the");
        println("            drift allowance. Each component is justified in a comment;");
        println("            the SUM is the quantity that actually matters.");
        g_tb_fail = 1;
    } else {
        println("    RESULT: PASS");
    }

    # === REPORTED, NOT GATED: tick-body occupancy ===========================
    # Real cost, different quantity. A pre-work drift sample cannot see it (F8),
    # so it is measured against the 2.5 s interval, not the drift allowance.
    println("tick-body occupancy (reported — the drift metric cannot see this):");
    g_save_interval_ticks = 1;
    i = 0;
    while (i < TB_SAVERS) {
        session_list_push(tb_saver(20 + i));
        i = i + 1;
    }
    var t2 = clock_now_ns();
    save_sweep();
    var save_us = (clock_now_ns() - t2) / 1000;
    tb_line("save_sweep (SAVE_BATCH_MAX)    ", save_us);

    var s = g_session_head;
    while (s != 0) {
        store64(s + SS_LAST_MS, 1);
        store64(s + SS_SAVE_DIRTY, 1);
        s = load64(s + SS_NEXT);
    }
    var t3 = clock_now_ns();
    sweep_idle(0, g_idle_timeout_ms + 100000);
    var idle_us = (clock_now_ns() - t3) / 1000;
    g_session_head = 0;
    tb_line("sweep_idle (IDLE_REAP_MAX)     ", idle_us);
    println("    plus combat fan-out, 256 co-located: 43 ms (bench_combat, passing)");
    print("    tick-body total (excl. combat) : ", 37);
    print_num((save_us + idle_us) / 1000); print(" ms of the ", 11);
    print_num(g_tick_ms); println(" ms interval");
    println("    NOT GATED HERE — see the header. Bounding combat fan-out is a 2.0 item.");

    if (g_tb_fail != 0) { return 1; }
    println("  RESULT: PASS");
    return 0;
}

var r = main();
syscall(60, r);
