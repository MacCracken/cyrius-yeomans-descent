# cyrius-yeomans-descent — one whole event-loop pass, against the ADR 0001
# drift budget (1.7.0).
#
# This bench exists because of what it caught. Every per-tick budget in the tree
# was individually justified in a comment, and NOTHING summed them. The gate
# sweep measured one pass with every budget at its cap at **252 ms** — 504% of
# the 50 ms p99 drift allowance in
# docs/adr/0001-tick-based-combat.md, and 10% of the entire 2.5 s tick — from
# sixteen connections sending wrong passphrases. No account required.
#
# The defect was a comment that did its arithmetic against the wrong number.
# `DRAIN_LINES_MAX` budgeted `16 x ~1.08 ms (a keypair derivation)`. A keypair
# derivation is not the costliest line an unauthenticated connection can send —
# a wrong passphrase against a name that EXISTS is, because it pays a full
# `player_auth_load` (read + toml parse + 3 hex decodes + ed25519_verify). That
# is ~8 ms, seven times the assumed cost, and the correct figure was already
# written down twice elsewhere in the same file (server.cyr:347 "measured
# 7.66 ms", server.cyr:371 "~8.1 ms for a wrong-passphrase verify"). The budget
# comment used neither.
#
# So the lesson this bench encodes is narrow and specific: **a per-component
# budget justified in prose is not a budget.** bench_combat gates the combat
# tick. bench_persist gates one save and reasons about four. Neither could see
# that the sum was 5x over, because a sum was never taken. This one takes the
# sum, drives the REAL functions both event loops call, and fails CI when a pass
# exceeds what ADR 0001 promises.
#
# It is deliberately built to fail against the pre-1.7.0 code. A bench that went
# green on a tree with a known 252 ms pass would be measuring something other
# than the defect.

include "lib/thread.cyr"
include "lib/thread_local.cyr"
include "lib/sakshi.cyr"
include "lib/libro.cyr"

include "src/telnet.cyr"
include "src/parser.cyr"
include "src/world.cyr"
include "src/mob.cyr"
include "src/session.cyr"
include "src/item.cyr"
include "src/combat.cyr"
include "src/classes.cyr"
include "src/persist.cyr"
include "src/server.cyr"

# TB_ prefix throughout: enum constants share ONE FLAT namespace across the whole
# program, so an unprefixed `DRIFT_BUDGET_US` here could silently capture a
# same-named constant in src/.
enum TickBudgetBench {
    # ADR 0001's p99 tick-drift allowance. The whole point of the file.
    TB_DRIFT_BUDGET_US = 50000;
    # Sessions used to fill each budget. Each is parked in PHASE_PASS against a
    # real signed record with wrong-passphrase lines queued, which is the
    # costliest line an unauthenticated connection can queue.
    TB_ATTACKERS = 16;
    # Dirty / idle sessions offered to the save and reap sweeps. More than the
    # caps, so the sweeps are measured saturated rather than under-fed.
    TB_SAVERS = 8;
}

var g_tb_fail = 0;

# Report one component of the pass. `budget_us` of 0 means "no budget of its own
# — it is a contributor to the aggregate", which is the honest description of
# most of these: individually none of them is the problem.
fn tb_report(label, us, budget_us): i64 {
    print("  ", 2); print(label, strlen(label));
    print(" : ", 3); print_num(us / 1000); print(" ms", 3);
    if (budget_us > 0) {
        print("   (", 4); print_num(us * 100 / budget_us); print("% of the 50 ms budget)", 23);
        if (us >= budget_us) {
            g_tb_fail = 1;
            print("   OVER", 7);
        }
    }
    println("");
    return 0;
}

# A session parked in PHASE_PASS with `nlines` wrong-passphrase lines queued in
# rx. SS_FD is -1 so every flush fails harmlessly rather than writing to a real
# socket; the cost being measured is the dispatch, not the write.
fn tb_armed_pass(nlines): i64 {
    var s = fl_alloc(SS_SIZE);
    memset(s, 0, SS_SIZE);
    store64(s + SS_TX_BUF,   fl_alloc(TX_CAP));
    store64(s + SS_RX_BUF,   fl_alloc(RX_CAP));
    store64(s + SS_LINE_BUF, fl_alloc(LINE_CAP));
    var nm = fl_alloc(NAME_CAP);
    memcpy(nm, "Victim", 6);
    store64(s + SS_NAME_BUF, nm);
    store64(s + SS_NAME_LEN, 6);
    store64(s + SS_TS, telnet_state_new());
    store64(s + SS_FD, 0 - 1);
    store64(s + SS_ROOM, 0 - 1);
    store64(s + SS_PHASE, PHASE_PASS);
    # Queue nlines wrong passphrases. Each is >= PASS_MIN so it survives the
    # H5 (1.6.2) length pre-check and actually reaches ed25519_verify — a line
    # rejected on length costs nothing and would understate the worst case.
    var rx = load64(s + SS_RX_BUF);
    var o = 0;
    var line = 0;
    while (line < nlines) {
        var k = 0;
        while (k < 11) { store8(rx + o, 119 + (line % 2)); o = o + 1; k = k + 1; }
        store8(rx + o, 13); o = o + 1;
        line = line + 1;
    }
    store64(s + SS_RX_LEN, o);
    return s;
}

# An authenticated session with a real derived identity, dirty and due a save.
fn tb_saver(seed): i64 {
    var s = fl_alloc(SS_SIZE);
    memset(s, 0, SS_SIZE);
    store64(s + SS_TX_BUF,   fl_alloc(TX_CAP));
    store64(s + SS_RX_BUF,   fl_alloc(RX_CAP));
    store64(s + SS_LINE_BUF, fl_alloc(LINE_CAP));
    var nm = fl_alloc(NAME_CAP);
    memcpy(nm, "Saver", 5);
    store8(nm + 5, 65 + (seed % 26));
    store64(s + SS_NAME_BUF, nm);
    store64(s + SS_NAME_LEN, 6);
    store64(s + SS_TS, telnet_state_new());
    store64(s + SS_FD, 0 - 1);
    var salt = alloc(SALT_LEN);
    var i = 0;
    while (i < SALT_LEN) { store8(salt + i, seed + i); i = i + 1; }
    var blk = sess_ident(s);
    memcpy(blk, salt, SALT_LEN);
    ident_derive(salt, "benchpassphrase", 15, blk + IDENT_SK, blk + IDENT_PK);
    store64(blk + IDENT_CREATED, 1000000);
    store64(s + SS_ROOM, 0 - 1);
    store64(s + SS_HP, 20); store64(s + SS_MAXHP, 20);
    store64(s + SS_CLASS, 0);
    store64(s + SS_AUTHED, 1);
    store64(s + SS_PHASE, PHASE_CMD);
    store64(s + SS_SAVE_DIRTY, 1);
    store64(s + SS_LAST_SAVE_MS, 0);   # never saved → due (1.6.8's G-fix)
    return s;
}

fn tb_clear_sessions(): i64 {
    g_session_head = 0;
    return 0;
}

fn main(): i64 {
    alloc_init();
    persist_init();
    # The loaders publish g_rooms / g_obj_tpls / g_mob_tpls, which the dispatch
    # and save paths both read. Without them a `look` faults and the measurement
    # is of a crash, not a tick.
    if (world_load_rooms(DP_ROOMS) != WL_OK) { println("  setup: rooms failed to load"); return 1; }
    world_load_objs(DP_OBJS);
    world_load_mobs(DP_MOBS);
    g_epfd = 0;

    println("one event-loop pass, every budget at its cap:");

    # A real signed record for the attackers to fail against. This is the part
    # that makes the worst case reachable without an account: an attacker needs
    # ONE name that exists, and creating one is free.
    var v = tb_saver(11);
    store64(v + SS_NAME_LEN, 6);
    memcpy(load64(v + SS_NAME_BUF), "Victim", 6);
    if (player_save(v) != 1) { println("  setup: could not write the victim record"); return 1; }

    # Warm every lazy init (the filestore opens on first append) so the first
    # measured component is not paying one-time setup.
    var warm = tb_armed_pass(1);
    session_list_push(warm);
    drain_pending_rx();
    tb_clear_sessions();

    # --- 1. drain_pending_rx: the tick-side budget, DRAIN_LINES_MAX lines.
    var i = 0;
    while (i < TB_ATTACKERS) {
        session_list_push(tb_armed_pass(2));
        i = i + 1;
    }
    var t0 = clock_now_ns();
    drain_pending_rx();
    var drain_us = (clock_now_ns() - t0) / 1000;
    tb_clear_sessions();
    tb_report("drain_pending_rx  (tick side, DRAIN_LINES_MAX)     ", drain_us, 0);

    # --- 2. event_batch_step: EVENT_LINES_MAX lines, spent BEFORE the tick
    # check, which is what makes this the half that can swallow a tick whole.
    # Driving the shared step rather than either loop: the loops sit behind a
    # socket and a signalfd and are not reachable from a bench, which is exactly
    # why G1 (1.6.12) extracted this function.
    var t1 = clock_now_ns();
    var budget = EVENT_LINES_MAX;
    var j = 0;
    while (j < TB_ATTACKERS) {
        var keep[8];
        budget = event_batch_step(0, tb_armed_pass(2), EPOLLIN, 0, budget, &keep);
        j = j + 1;
    }
    var event_us = (clock_now_ns() - t1) / 1000;
    tb_report("event_batch_step  (before the tick check)          ", event_us, 0);

    # --- 3. save_sweep at SAVE_BATCH_MAX. Offered more dirty sessions than the
    # cap so the sweep is measured saturated.
    g_save_interval_ticks = 1;
    i = 0;
    while (i < TB_SAVERS) {
        session_list_push(tb_saver(20 + i));
        i = i + 1;
    }
    var t2 = clock_now_ns();
    save_sweep();
    var save_us = (clock_now_ns() - t2) / 1000;
    tb_report("save_sweep        (SAVE_BATCH_MAX signed saves)    ", save_us, 0);

    # --- 4. sweep_idle at IDLE_REAP_MAX. drop_session's first act is a save, so
    # a reap costs about what a save costs; the sessions are still on the list
    # from step 3 and are now made stale.
    var s = g_session_head;
    while (s != 0) {
        store64(s + SS_LAST_MS, 1);        # last byte exchanged: long ago
        store64(s + SS_SAVE_DIRTY, 1);
        s = load64(s + SS_NEXT);
    }
    var t3 = clock_now_ns();
    sweep_idle(0, g_idle_timeout_ms + 100000);
    var idle_us = (clock_now_ns() - t3) / 1000;
    tb_clear_sessions();
    tb_report("sweep_idle        (IDLE_REAP_MAX reaps, each saves)", idle_us, 0);

    # --- The number nobody was computing.
    var total_us = drain_us + event_us + save_us + idle_us;
    println("  ---");
    tb_report("ONE PASS, ALL BUDGETS AT CAP                      ", total_us, TB_DRIFT_BUDGET_US);

    if (g_tb_fail != 0) {
        println("  RESULT: FAIL — one pass exceeds the ADR 0001 50 ms p99 drift budget.");
        println("          Every component above is individually justified in a comment.");
        println("          The sum is what ADR 0001 actually constrains.");
        return 1;
    }
    println("  RESULT: PASS");
    return 0;
}

var r = main();
syscall(60, r);
