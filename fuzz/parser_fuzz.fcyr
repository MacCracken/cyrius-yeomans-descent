# Fuzz: M2 verb-noun parser — parser_parse + resolve_* must never crash,
# hang, or grow memory without bound on hostile input.
#
# Discovered + run by `cyrius fuzz` (scans fuzz/*.fcyr). The roadmap M2-F
# gate: 100k random byte sequences, every byte value (incl. embedded NUL
# and 0xFF), every length from empty to over-long. Invariants checked
# every iteration:
#   - the token count never exceeds PA_MAX_TOKENS
#   - the norm buffer never exceeds NORM_CAP
#   - every token's [off, off+len) stays inside the norm buffer
#   - every parse-result token index is in range (or the -1 sentinel)
#   - resolve_all never writes past its caller-supplied cap
# A non-zero exit code flags the first violated invariant; a clean run
# prints "parser_fuzz: ok" and exits 0.
#
# One Parser is reused across all iterations — a per-iteration leak would
# show as the freelist growing without bound, which the long loop surfaces.

include "src/parser.cyr"

alloc_init();

# Deterministic xorshift64 PRNG (no wall-clock seed — the run must be
# reproducible so a failing seed is debuggable).
var rng_state = 0x9E3779B97F4A7C15;
fn rng_next(): i64 {
    var x = rng_state;
    x = x ^ (x << 13);
    x = x ^ ((x >> 7) & 0x01FFFFFFFFFFFFFF);   # logical-ish shift via mask
    x = x ^ (x << 17);
    rng_state = x;
    return x;
}

# Bias random bytes toward parser-significant values: space, tab, quote,
# dot, digits, letters, NUL, 0xFF — the bytes most likely to expose an
# edge in tokenization, prep split, or qualifier parsing.
fn fuzz_byte(r): i64 {
    var k = r & 15;
    if (k == 0) { return 32; }        # space
    if (k == 1) { return 32; }        # space (weighted — drives token splits)
    if (k == 2) { return 9; }         # tab
    if (k == 3) { return 34; }        # quote
    if (k == 4) { return 46; }        # dot (qualifier separator)
    if (k == 5) { return 48 + ((r >> 8) % 10); }   # digit
    if (k == 6) { return 0; }         # embedded NUL
    if (k == 7) { return 255; }       # 0xFF
    # letters a..z, biased so verb/keyword words can form
    return 97 + ((r >> 8) % 26);
}

# A small synthetic scope to drive the resolve_* paths during fuzzing.
var names[32];
store64(&names + 0,  "rusted drone");
store64(&names + 8,  "shock pike");
store64(&names + 16, "battered drone");
store64(&names + 24, "ration pack");
var scope_n = 4;

var pa = parser_new();
# 1.7.17 (AQ) — 8192, not 512. The old buffer bounded the generator to inputs so
# short that PA_NORM_LEN could never approach NORM_CAP (4096), so `pa_emit_byte`'s
# cap branch — the one F3 (1.6.11) was written for — had NEVER EXECUTED in 100k
# iterations. A fuzz gate that cannot reach the guard it exists to defend is a
# gate that passes and tells you nothing.
var inbuf = alloc(8192);
var out = alloc(PA_MAX_TOKENS * 8);

# --- Directed adversarial cases first (each must survive) ---
parser_parse(pa, "", 0);
parser_parse(pa, "   ", 3);
parser_parse(pa, "\"\"\"\"\"\"", 6);            # only quotes
parser_parse(pa, "all.", 4);                     # qualifier, empty base
parser_parse(pa, "2.", 2);                       # nth, empty base
parser_parse(pa, ".....", 5);                    # only dots
parser_parse(pa, "get . in .", 10);              # dots as nouns
parser_parse(pa, "put a in b on c with d", 22);  # many prepositions

# An over-long all-letters line: more tokens than PA_MAX_TOKENS can hold.
var li = 0;
while (li < 500) {
    var c = 97;
    if ((li % 2) == 1) { c = 32; }               # alternate letter / space
    store8(inbuf + li, c);
    li = li + 1;
}
parser_parse(pa, inbuf, 500);
if (parser_count(pa) > PA_MAX_TOKENS) { syscall(60, 10); }

# --- 100k random iterations ---
# 1.7.17 (AQ) — COVERAGE IS ASSERTED, not assumed. The whole reason this gate was
# worthless is that nobody checked whether its inputs reached the code it guards.
# These counters make the harness prove its own reach, so the next time someone
# changes the generator the gate says so instead of quietly going green.
var max_norm = 0;
var max_len_fed = 0;
var hit_norm_cap = 0;
var hit_token_cap = 0;
var iter = 0;
while (iter < 100000) {
    var r = rng_next();
    # 1.7.17 (AQ) — MASK THE SIGN. `rng_next` is an xorshift over a signed i64 and
    # returns negative roughly half the time, so `r % 320` was negative on
    # **49,585 of 100,000 iterations** — measured by replicating the shipped seed
    # and generator byte for byte. Those iterations fed a negative length, wrote
    # no bytes, and parsed nothing: the headline "100k random inputs" was really
    # about fifty thousand, and the longest input ever fed was 319 bytes.
    #
    # The ceiling now runs past LINE_CAP so the over-long path is exercised too.
    # Production never hands the parser more than LINE_CAP (session_push_line_byte
    # caps it), which is exactly why the parser's own bound needs fuzzing rather
    # than trusting: it is the last line of defence if that cap ever moves.
    var len = (r & 0x7FFFFFFFFFFFFFFF) % 6000;   # 0..5999 bytes
    var i = 0;
    # 1.7.17 (AQ) — TWO GENERATOR MODES, because one could not reach the guard.
    #
    # Uniform random bytes produce a delimiter every few bytes, so the token cap
    # (PA_MAX_TOKENS = 64) trips long before the norm buffer fills: measured at a
    # max PA_NORM_LEN of 747 against NORM_CAP = 4096 even with 5999-byte inputs,
    # with the cap branch still never executed. Reaching it needs the opposite
    # shape — long runs with NO delimiters — which random bytes essentially never
    # produce. So a quarter of iterations generate exactly that.
    var mode = (r >> 32) & 3;
    if (mode == 0) {
        # One enormous token: drives PA_NORM_LEN straight at NORM_CAP.
        while (i < len) {
            store8(inbuf + i, 97 + (rng_next() & 0x0F));   # 'a'..'p', no delimiters
            i = i + 1;
        }
    } else {
        while (i < len) {
            store8(inbuf + i, fuzz_byte(rng_next()) & 0xFF);
            i = i + 1;
        }
    }
    parser_parse(pa, inbuf, len);
    if (len > max_len_fed) { max_len_fed = len; }

    # Invariant 1: token count bounded.
    var count = parser_count(pa);
    if (count < 0)          { syscall(60, 20); }
    if (count > PA_MAX_TOKENS) { syscall(60, 21); }

    # Invariant 2: norm buffer bounded.
    var norm_len = load64(pa + PA_NORM_LEN);
    if (norm_len < 0)        { syscall(60, 22); }
    if (norm_len > NORM_CAP) { syscall(60, 23); }
    if (norm_len > max_norm)  { max_norm = norm_len; }
    if (norm_len == NORM_CAP) { hit_norm_cap = hit_norm_cap + 1; }
    if (count == PA_MAX_TOKENS) { hit_token_cap = hit_token_cap + 1; }

    # Invariant 3: every token lies inside the norm buffer.
    var t = 0;
    while (t < count) {
        var off = tok_off(pa, t);
        var tl  = tok_len(pa, t);
        if (off < 0)            { syscall(60, 24); }
        if (tl  < 1)            { syscall(60, 25); }
        if (off + tl > norm_len) { syscall(60, 26); }
        t = t + 1;
    }

    # Invariant 4: parse-result indices are in range or the -1 sentinel.
    var di = parsed_dobj(pa);
    var ii = parsed_iobj(pa);
    var pi = load64(pa + PA_PREP_IDX);
    if (di < 0 - 1)      { syscall(60, 30); }
    if (di >= count)     { syscall(60, 31); }
    if (ii < 0 - 1)      { syscall(60, 32); }
    if (ii >= count)     { syscall(60, 33); }
    if (pi < 0 - 1)      { syscall(60, 34); }
    if (pi >= count)     { syscall(60, 35); }

    # Drive the resolve paths on whichever object tokens the parse found.
    if (di >= 0) {
        var kind[8]; var num[8]; var bp[8]; var bl[8];
        qual_parse(pa, di, &kind, &num, &bp, &bl);
        var k = load64(&kind);
        if (k == QUAL_ALL) {
            var w = resolve_all(load64(&bp), load64(&bl), &names, scope_n, out, PA_MAX_TOKENS);
            # Invariant 5: never write past the cap.
            if (w > PA_MAX_TOKENS) { syscall(60, 40); }
            if (w < 0)          { syscall(60, 41); }
        }
        if (k == QUAL_NTH) {
            resolve_nth(load64(&bp), load64(&bl), &names, scope_n, load64(&num));
        }
        if (k == QUAL_NONE) {
            resolve_tok(pa, di, &names, scope_n);
        }
    }
    if (ii >= 0) {
        resolve_tok(pa, ii, &names, scope_n);
    }

    iter = iter + 1;
}

parser_free(pa);

# === 1.7.17 (AQ) — the gate now gates its own COVERAGE. ===
#
# Every invariant above is a "must not happen" check, and a generator that feeds
# nothing satisfies all of them. That is precisely the state this harness shipped
# in: half its iterations fed a negative length and the longest input it ever
# produced was 319 bytes against a 4096-byte norm buffer, so `pa_emit_byte`'s cap
# branch — the guard F3 (1.6.11) exists for — had never once executed while the
# gate reported PASS for eleven releases.
#
# These are "must happen" checks. They fail the run if the inputs stop reaching
# the guards, which is the only way a fuzz gate can notice it has been defanged.
print("  max input fed   : ", 20); print_num(max_len_fed); println("");
print("  max norm reached: ", 20); print_num(max_norm);
print(" of ", 4); print_num(NORM_CAP); println("");
print("  hit NORM_CAP    : ", 20); print_num(hit_norm_cap); println("");
print("  hit token cap   : ", 20); print_num(hit_token_cap); println("");
if (max_len_fed <= 320) {
    println("parser_fuzz: FAIL — the generator never fed a line longer than the old ceiling.");
    syscall(60, 30);
}
if (hit_norm_cap == 0) {
    println("parser_fuzz: FAIL — NORM_CAP was never reached, so pa_emit_byte's cap");
    println("            branch was never executed. The gate is not testing its guard.");
    syscall(60, 31);
}
if (hit_token_cap == 0) {
    println("parser_fuzz: FAIL — PA_MAX_TOKENS was never reached.");
    syscall(60, 32);
}
syscall(1, 1, "parser_fuzz: ok\n", 16);
syscall(60, 0);
